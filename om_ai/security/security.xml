<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_ai" model="res.groups.privilege">
        <field name="name">AI</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_ai_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Use the AI features and see their own AI usage.</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ai"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ai_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Set up AI providers, keys, models, tools, prompts and limits, and see the AI usage of all users.</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ai"/>
        <field name="implied_ids" eval="[(4, ref('om_ai.group_ai_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('om_ai.group_ai_manager'))]"/>
    </record>
</odoo>
