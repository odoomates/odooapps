<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="demo_provider_ollama" model="om.ai.provider">
        <field name="name">Ollama (local)</field>
        <field name="preset">ollama</field>
        <field name="api_type">openai_compatible</field>
        <field name="base_url">http://localhost:11434/v1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="demo_model_ollama_llama" model="om.ai.model">
        <field name="name">Llama 3.2</field>
        <field name="model_id">llama3.2</field>
        <field name="provider_id" ref="demo_provider_ollama"/>
        <field name="context_size">128000</field>
    </record>

    <record id="base.main_company" model="res.company">
        <field name="om_ai_chat_model_id" ref="demo_model_ollama_llama"/>
    </record>

    <record id="base.user_demo" model="res.users">
        <field name="group_ids" eval="[(4, ref('om_ai.group_ai_user'))]"/>
    </record>
</odoo>
