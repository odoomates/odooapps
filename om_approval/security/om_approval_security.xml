<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_approval" model="ir.module.category">
            <field name="name">Approvals</field>
            <field name="parent_id" ref="base.module_category_productivity"/>
        </record>

        <record id="group_approval_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_approval"/>
            <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        </record>

        <!-- the requests a user asked, or is an approver of; every request for the approval managers -->
        <record id="om_approval_request_rule_user" model="ir.rule">
            <field name="name">Approval requests: asked or to approve</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('requester_id', '=', user.id), ('line_ids.approver_user_ids', 'in', user.id)]</field>
        </record>

        <record id="om_approval_request_rule_manager" model="ir.rule">
            <field name="name">Approval requests: all</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="groups" eval="[Command.link(ref('group_approval_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="om_approval_line_rule_user" model="ir.rule">
            <field name="name">Approvals: asked or to approve</field>
            <field name="model_id" ref="model_approval_line"/>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="domain_force">['|', ('request_id.requester_id', '=', user.id), ('request_id.line_ids.approver_user_ids', 'in', user.id)]</field>
        </record>

        <record id="om_approval_line_rule_manager" model="ir.rule">
            <field name="name">Approvals: all</field>
            <field name="model_id" ref="model_approval_line"/>
            <field name="groups" eval="[Command.link(ref('group_approval_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- users delegate their own approvals and read those delegated to them -->
        <record id="approval_delegation_rule_own" model="ir.rule">
            <field name="name">Approval delegations: own</field>
            <field name="model_id" ref="model_approval_delegation"/>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <record id="approval_delegation_rule_substitute" model="ir.rule">
            <field name="name">Approval delegations: substitute</field>
            <field name="model_id" ref="model_approval_delegation"/>
            <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
            <field name="domain_force">[('delegate_id', '=', user.id)]</field>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="approval_delegation_rule_manager" model="ir.rule">
            <field name="name">Approval delegations: all</field>
            <field name="model_id" ref="model_approval_delegation"/>
            <field name="groups" eval="[Command.link(ref('group_approval_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- multi-company -->
        <record id="om_approval_request_company_rule" model="ir.rule">
            <field name="name">Approval requests: multi-company</field>
            <field name="model_id" ref="model_approval_request"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="approval_rule_company_rule" model="ir.rule">
            <field name="name">Approval flows: multi-company</field>
            <field name="model_id" ref="model_approval_rule"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="approval_line_company_rule" model="ir.rule">
            <field name="name">Approvals: multi-company</field>
            <field name="model_id" ref="model_approval_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
