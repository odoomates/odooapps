<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_approval_flow_view_list" model="ir.ui.view">
        <field name="name">approval.rule.view.list</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <tree string="Approval Flows" js_class="approval_flow_list">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="button_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="om_approval_flow_view_search" model="ir.ui.view">
        <field name="name">approval.rule.view.search</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="om_approval_flow_view_form" model="ir.ui.view">
        <field name="name">approval.rule.view.form</field>
        <field name="model">approval.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Flow">
                <header>
                    <button name="action_open_designer" string="Open the Designer" type="object" class="btn-primary"
                            attrs="{'invisible': [('id', '=', False)]}"/>
                    <button name="action_simulate" string="Test on a Record" type="object" class="btn-secondary"
                            attrs="{'invisible': ['|', ('id', '=', False), ('model_id', '=', False)]}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sale orders above 10,000"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <label for="button_id" attrs="{'invisible': [('model_id', '=', False)]}"/>
                            <div class="o_row" attrs="{'invisible': [('model_id', '=', False)]}">
                                <field name="button_id" options="{'no_create': True, 'no_open': True}"
                                       attrs="{'required': [('is_document', '=', False)]}"/>
                                <button name="action_refresh_buttons" type="object" icon="fa-refresh"
                                        title="List the buttons of the model again" class="btn-link"/>
                            </div>
                            <field name="model" invisible="1"/>
                            <field name="is_document" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="fallback_group_id"/>
                            <field name="self_approve"/>
                            <field name="run_on_approval" attrs="{'invisible': [('button_id', '=', False)]}"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('model', '=', False)]}">
                        <field name="domain" widget="domain" options="{'model': 'model', 'in_dialog': True}"/>
                        <label for="amount_field"/>
                        <div class="o_row">
                            <field name="amount_field" placeholder="e.g. amount_total"/>
                            <span attrs="{'invisible': [('amount_field', '=', False)]}">above</span>
                            <field name="amount_min" attrs="{'invisible': [('amount_field', '=', False)]}"/>
                            <field name="amount_currency_id" attrs="{'invisible': [('amount_field', '=', False)]}"
                                   groups="base.group_multi_currency"/>
                        </div>
                        <field name="note" placeholder="Shown when the button is stopped"
                               attrs="{'invisible': [('button_id', '=', False)]}"/>
                    </group>
                    <group attrs="{'invisible': [('button_id', '=', False)]}" string="While It Waits">
                        <group>
                            <field name="lock_record"/>
                            <field name="lock_after" widget="radio" attrs="{'invisible': [('lock_record', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <group>
                            <field name="request_note" widget="radio" options="{'horizontal': true}"
                                   attrs="{'invisible': [('button_id', '=', False)]}"/>
                            <field name="approve_note" widget="radio" options="{'horizontal': true}"/>
                            <field name="refuse_note" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                    <field name="step_ids" context="{'default_flow_id': id}">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="approver_type"/>
                            <field name="group_id"
                                   attrs="{'invisible': [('approver_type', '!=', 'group')], 'required': [('approver_type', '=', 'group')]}"/>
                            <field name="user_ids" widget="many2many_avatar_user"
                                   attrs="{'invisible': [('approver_type', '!=', 'user')], 'required': [('approver_type', '=', 'user')]}"/>
                            <field name="field_path" placeholder="e.g. user_id"
                                   attrs="{'invisible': [('approver_type', '!=', 'field')], 'required': [('approver_type', '=', 'field')]}"/>
                            <field name="model" invisible="1"/>
                            <field name="domain" widget="domain" options="{'model': 'model', 'in_dialog': True}"
                                   optional="show"/>
                            <field name="amount_min" optional="hide"/>
                            <field name="approval_mode" optional="show"/>
                            <field name="approval_count" optional="show"
                                   attrs="{'invisible': [('approval_mode', '!=', 'count')]}"/>
                            <field name="remind_days" optional="show"/>
                            <field name="escalate_days" optional="show"/>
                            <field name="escalate_type" optional="show" attrs="{'invisible': [('escalate_days', '=', 0)]}"/>
                            <field name="escalate_user_ids" widget="many2many_avatar_user" optional="show"
                                   attrs="{'invisible': ['|', ('escalate_days', '=', 0), ('escalate_type', '!=', 'user')], 'required': [('escalate_days', '!=', 0), ('escalate_type', '=', 'user')]}"/>
                            <field name="escalate_group_id" optional="show"
                                   attrs="{'invisible': ['|', ('escalate_days', '=', 0), ('escalate_type', '!=', 'group')], 'required': [('escalate_days', '!=', 0), ('escalate_type', '=', 'group')]}"/>
                        </tree>
                    </field>
                    <div class="text-muted">
                        The steps are approved in turn. A step finding nobody is approved by the approvers when
                        nobody is found. Without a step, the approval administrators approve.
                    </div>
                    <div class="alert alert-light border mt-3 mb-0" role="status" attrs="{'invisible': [('summary', '=', False)]}">
                        <div class="fw-bold mb-1">In short</div>
                        <field name="summary" nolabel="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="om_approval_flow_action" model="ir.actions.act_window">
        <field name="name">Approval Flows</field>
        <field name="res_model">approval.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an approval flow</p>
            <p>Choose a button of any app, e.g. Confirm on the sale orders, and who approves it before it runs.
               Start from a template: the flow opens in the Approval Designer.</p>
        </field>
    </record>

</odoo>
