<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_approval.RecordSelector" owl="1">
        <div class="o_approval_record_selector o_field_widget" t-att-class="this.props.multi ? 'o_field_many2many_tags' : 'o_field_many2one'">
            <div t-if="this.props.multi" class="o_field_tags d-inline-flex flex-wrap o_tags_input o_input">
                <TagsList tags="this.tags"/>
                <div class="o_field_many2many_selection d-inline-flex w-100">
                    <Many2XAutocomplete resModel="this.props.resModel" fieldString="this.props.placeholder" activeActions="{}"
                                        placeholder="this.tags.length ? '' : this.props.placeholder"
                                        getDomain.bind="this.getDomain" isToMany="true" autoSelect="true"
                                        update.bind="this.onUpdate"/>
                </div>
            </div>
            <div t-else="" class="o_field_many2one_selection">
                <Many2XAutocomplete resModel="this.props.resModel" fieldString="this.props.placeholder" activeActions="{}"
                                    value="this.value" placeholder="this.props.placeholder"
                                    getDomain.bind="this.getDomain" autoSelect="true" update.bind="this.onUpdate"/>
            </div>
        </div>
    </t>

</templates>
