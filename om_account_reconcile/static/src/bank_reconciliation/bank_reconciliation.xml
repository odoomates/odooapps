<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_account_reconcile.BankReconciliation">
        <div class="o_action o_om_bank_rec">
            <ControlPanel>
                <t t-set-slot="control-panel-buttons">
                    <button class="btn btn-secondary o_om_bank_rec_auto" t-att-disabled="this.state.busy"
                            t-on-click="() => this.autoReconcile()">
                        Auto-reconcile
                    </button>
                </t>
                <t t-set-slot="control-panel-actions">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="btn-group" role="group">
                            <button t-foreach="[['bank', 'Bank'], ['open_items', 'Open Items']]"
                                    t-as="mode" t-key="mode[0]"
                                    t-att-class="'btn btn-secondary' + (this.state.mode === mode[0] ? ' active' : '')"
                                    t-att-data-mode="mode[0]"
                                    t-on-click="() => this.setMode(mode[0])" t-out="mode[1]"/>
                        </div>
                        <t t-if="this.state.mode === 'open_items'">
                            <div class="btn-group" role="group">
                                <button t-foreach="[['receivable', 'Customers'], ['payable', 'Vendors']]"
                                        t-as="kind" t-key="kind[0]"
                                        t-att-class="'btn btn-secondary' + (this.state.accountType === kind[0] ? ' active' : '')"
                                        t-on-click="() => this.setAccountType(kind[0])" t-out="kind[1]"/>
                            </div>
                            <input type="search" class="form-control w-auto o_om_open_items_search"
                                   placeholder="Search partner, entry or amount"
                                   t-att-value="this.state.search"
                                   t-on-input="(ev) => this.onOpenItemsSearchInput(ev)"/>
                        </t>
                        <t t-else="">
                        <select class="form-select w-auto o_om_bank_rec_journal" t-on-change="(ev) => this.onJournalChange(ev)">
                            <option t-foreach="this.state.journals" t-as="journal" t-key="journal.id"
                                    t-att-value="journal.id" t-att-selected="journal.id === this.state.journalId"
                                    t-out="journal.display_name"/>
                        </select>
                        <div class="btn-group" role="group">
                            <button t-foreach="[['to_reconcile', 'To Reconcile'], ['to_review', 'To Check'], ['reconciled', 'Reconciled'], ['all', 'All']]"
                                    t-as="filter" t-key="filter[0]"
                                    t-att-class="'btn btn-secondary' + (this.state.filter === filter[0] ? ' active' : '')"
                                    t-att-data-filter="filter[0]"
                                    t-on-click="() => this.setFilter(filter[0])" t-out="filter[1]"/>
                        </div>
                        <input type="search" class="form-control w-auto o_om_bank_rec_search"
                               placeholder="Search label, partner or amount"
                               t-att-value="this.state.search" t-on-input="(ev) => this.onSearchInput(ev)"/>
                        </t>
                    </div>
                </t>
            </ControlPanel>

            <t t-if="this.state.mode === 'open_items'"
               t-call="om_account_reconcile.BankReconciliation.OpenItems"/>
            <div t-else="" class="o_content o_om_bank_rec_content">
                <div class="o_om_bank_rec_list">
                    <div t-if="!this.state.transactions.length" class="o_om_bank_rec_empty text-muted p-4">
                        <t t-if="this.state.search">
                            No transaction matches your search.
                        </t>
                        <t t-elif="this.state.filter === 'reconciled'">
                            Nothing is reconciled on this journal yet.
                        </t>
                        <t t-elif="this.state.filter === 'to_review'">
                            No transaction of this journal is marked to check.
                        </t>
                        <t t-else="">
                            <p class="mb-2">Nothing left to reconcile on this journal.</p>
                            <p class="mb-0 small">
                                What is reconciled here are the transactions of your bank: import a bank
                                statement, or add a transaction on the journal, and it shows up in this list.
                                A payment registered on an invoice waits on the outstanding account until the
                                transaction of the bank confirms it.
                            </p>
                            <button t-if="this.state.journalId" class="btn btn-link px-0 mt-1"
                                    t-on-click="() => this.openJournal()">
                                Go to the transactions of the journal
                            </button>
                        </t>
                    </div>
                    <div t-foreach="this.state.transactions" t-as="tr" t-key="tr.id"
                         t-att-class="'o_om_bank_rec_transaction' + (tr.id === this.state.selectedId ? ' o_selected' : '') + (tr.is_reconciled ? ' o_reconciled' : '')"
                         t-att-data-id="tr.id"
                         t-on-click="() => this.selectTransaction(tr.id)">
                        <div class="d-flex justify-content-between gap-2">
                            <span class="text-muted small" t-out="tr.date_display"/>
                            <span t-att-class="'fw-bold text-nowrap ' + (tr.amount &lt; 0 ? 'text-danger' : '')"
                                  t-out="this.format(tr.amount, tr.currency_id)"/>
                        </div>
                        <div class="text-truncate" t-out="tr.label"/>
                        <div class="d-flex justify-content-between gap-2 small">
                            <span class="text-truncate text-muted" t-out="tr.partner_name"/>
                            <span t-if="tr.is_reconciled" class="badge text-bg-success">Reconciled</span>
                            <span t-elif="tr.review_state === 'todo'" class="badge text-bg-warning">To check</span>
                        </div>
                    </div>
                    <button t-if="this.state.transactions.length &lt; this.state.count"
                            class="btn btn-link w-100" t-on-click="() => this.loadMore()">
                        Load more
                    </button>
                </div>

                <div class="o_om_bank_rec_panel">
                    <div t-if="!this.transaction" class="o_om_bank_rec_empty text-muted p-4">
                        Select a transaction to reconcile it.
                    </div>
                    <t t-else="" t-call="om_account_reconcile.BankReconciliation.Panel"/>
                </div>
            </div>
        </div>
    </t>

    <t t-name="om_account_reconcile.BankReconciliation.Panel">
        <t t-set="tr" t-value="this.transaction"/>
        <div class="o_om_bank_rec_header card mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <div class="flex-grow-1">
                        <div class="text-muted small">
                            <t t-out="tr.date_display"/> · <t t-out="tr.journal_name"/>
                        </div>
                        <h4 class="mb-2 o_om_bank_rec_label" t-out="tr.label"/>
                        <div class="o_om_bank_rec_partner" style="max-width: 360px;">
                            <RecordSelector t-if="!this.isReconciled"
                                            resModel="'res.partner'"
                                            resId="this.state.proposal.partner_id"
                                            update.bind="this.setPartner"
                                            placeholder="'Partner'"/>
                            <span t-else="" t-out="tr.partner_name"/>
                        </div>
                    </div>
                    <div class="text-end">
                        <div t-att-class="'fs-3 fw-bold ' + (tr.amount &lt; 0 ? 'text-danger' : '')"
                             t-out="this.format(tr.amount, tr.currency_id)"/>
                        <div t-if="!this.isReconciled" class="o_om_bank_rec_remaining">
                            <span class="text-muted">To reconcile: </span>
                            <span t-att-class="this.remaining ? 'fw-bold text-warning' : 'fw-bold text-success'"
                                  t-out="this.formatAbs(this.remaining, tr.currency_id)"/>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-2">
                            <button class="btn btn-link btn-sm" t-on-click="() => this.openMove(tr.move_id)">Open entry</button>
                            <button t-if="!this.isReconciled" class="btn btn-link btn-sm o_om_bank_rec_to_check"
                                    t-on-click="() => this.toggleToCheck()"
                                    t-out="tr.review_state === 'todo' ? 'Mark as checked' : 'To check'"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <t t-if="this.isReconciled">
            <table class="table table-sm o_om_bank_rec_entry">
                <thead>
                    <tr><th>Account</th><th>Label</th><th>Matched with</th><th class="text-end">Amount</th></tr>
                </thead>
                <tbody>
                    <tr t-foreach="this.state.data.entry_lines" t-as="line" t-key="line.id">
                        <td t-out="line.account_display"/>
                        <td t-out="line.label"/>
                        <td t-out="line.matched_move_names.join(', ')"/>
                        <td class="text-end" t-out="this.format(line.amount_currency, line.currency_id)"/>
                    </tr>
                </tbody>
            </table>
            <button class="btn btn-secondary o_om_bank_rec_undo" t-att-disabled="this.state.busy" t-on-click="() => this.undo()">
                Undo reconciliation
            </button>
        </t>

        <t t-else="">
            <div class="card mb-3 o_om_bank_rec_proposal">
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Counterpart</th>
                                <th>Account</th>
                                <th class="text-end">Open amount</th>
                                <th class="text-end" style="width: 11rem;">Reconciled amount</th>
                                <th style="width: 2rem;"/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.state.data.entry_lines.filter((line) => !line.is_suspense)" t-as="line" t-key="'existing' + line.id" class="text-muted">
                                <td><t t-out="line.label"/> <span class="badge text-bg-light">already reconciled</span></td>
                                <td t-out="line.account_display"/>
                                <td/>
                                <td class="text-end" t-out="this.formatAbs(line.amount_currency, line.currency_id)"/>
                                <td/>
                            </tr>
                            <tr t-foreach="this.state.proposal.matches" t-as="match" t-key="'match' + match.aml_id" class="o_om_bank_rec_match_row">
                                <td>
                                    <a href="#" t-on-click.prevent="() => this.openMove(match.candidate.move_id)" t-out="match.candidate.move_name"/>
                                    <div class="small text-muted" t-out="match.candidate.partner_name"/>
                                </td>
                                <td class="small" t-out="match.candidate.account_display"/>
                                <td class="text-end" t-out="this.formatAbs(match.candidate.residual_currency, match.candidate.currency_id)"/>
                                <td class="text-end">
                                    <input type="text" class="o_input text-end o_om_bank_rec_match_amount"
                                           t-att-value="match.amount === null ? '' : match.amount"
                                           t-att-placeholder="this.formatAbs(this.previewAmountFor(match), match.candidate.currency_id)"
                                           t-on-change="(ev) => this.setMatchAmount(match_index, ev)"/>
                                </td>
                                <td><button class="btn btn-link text-danger p-0" title="Remove" t-on-click="() => this.removeMatch(match_index)">×</button></td>
                            </tr>
                            <tr t-foreach="this.state.proposal.writeoffs" t-as="writeoff" t-key="'writeoff' + writeoff_index" class="o_om_bank_rec_writeoff_row">
                                <td t-out="writeoff.label or tr.label"/>
                                <td class="small" t-out="this.writeoffPreviewLine(writeoff_index).account_display or ''"/>
                                <td/>
                                <td class="text-end" t-out="this.formatAbs(this.writeoffPreviewLine(writeoff_index).amount_transaction ?? writeoff.amount, tr.currency_id)"/>
                                <td><button class="btn btn-link text-danger p-0" title="Remove" t-on-click="() => this.removeWriteoff(writeoff_index)">×</button></td>
                            </tr>
                            <tr t-foreach="(this.state.preview?.lines or []).filter((line) => line.kind === 'tax')" t-as="line" t-key="'tax' + line_index" class="text-muted">
                                <td t-out="line.label"/>
                                <td class="small" t-out="line.account_display"/>
                                <td/>
                                <td class="text-end" t-out="this.formatAbs(line.amount_transaction, tr.currency_id)"/>
                                <td/>
                            </tr>
                            <tr t-if="!this.state.proposal.matches.length and !this.state.proposal.writeoffs.length">
                                <td colspan="5" class="text-muted text-center py-3">
                                    Add journal items to match or a counterpart below.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <span class="text-muted">Left on the suspense account: </span>
                        <span t-att-class="this.remaining ? 'fw-bold text-warning' : 'fw-bold text-success'"
                              t-out="this.formatAbs(this.remaining, tr.currency_id)"/>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-secondary" t-on-click="() => this.resetProposal()">Reset</button>
                        <button class="btn btn-primary o_om_bank_rec_validate" t-att-disabled="!this.canValidate"
                                title="Ctrl+Enter" t-on-click="() => this.validate()">
                            <t t-out="this.state.preview?.is_complete ? 'Validate' : 'Validate (partial)'"/>
                        </button>
                    </div>
                </div>
            </div>

            <ul class="nav nav-tabs mb-2">
                <li class="nav-item">
                    <a href="#" t-att-class="'nav-link' + (this.state.tab === 'match' ? ' active' : '')"
                       data-tab="match" t-on-click.prevent="() => this.state.tab = 'match'">Match journal items</a>
                </li>
                <li class="nav-item">
                    <a href="#" t-att-class="'nav-link' + (this.state.tab === 'writeoff' ? ' active' : '')"
                       data-tab="writeoff" t-on-click.prevent="() => this.state.tab = 'writeoff'">Counterpart</a>
                </li>
                <li class="nav-item" t-if="this.state.data.models.length">
                    <a href="#" t-att-class="'nav-link' + (this.state.tab === 'models' ? ' active' : '')"
                       data-tab="models" t-on-click.prevent="() => this.state.tab = 'models'">Reconciliation models</a>
                </li>
            </ul>

            <div t-if="this.state.tab === 'match'" class="o_om_bank_rec_candidates">
                <input type="search" class="form-control mb-2 o_om_bank_rec_candidate_search"
                       placeholder="Search a reference, a partner or an amount"
                       t-att-value="this.state.candidateSearch" t-on-input="(ev) => this.onCandidateSearchInput(ev)"/>
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Entry</th><th>Partner</th><th>Date</th><th>Due</th><th>Account</th>
                            <th class="text-end">Open amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="this.state.candidates" t-as="candidate" t-key="candidate.id"
                            t-att-class="'o_om_bank_rec_candidate' + (this.matchedIds.has(candidate.id) ? ' table-active' : '')"
                            t-att-data-id="candidate.id"
                            t-on-click="() => this.addMatch(candidate)">
                            <td>
                                <t t-out="candidate.move_name"/>
                                <span t-if="candidate.score &gt;= 60" class="badge text-bg-info ms-1">Suggested</span>
                                <div class="small text-muted" t-out="candidate.label"/>
                            </td>
                            <td t-out="candidate.partner_name"/>
                            <td t-out="candidate.date_display"/>
                            <td t-out="candidate.date_maturity_display"/>
                            <td class="small" t-out="candidate.account_display"/>
                            <td t-att-class="'text-end ' + (candidate.residual_currency &lt; 0 ? 'text-danger' : '')"
                                t-out="this.format(candidate.residual_currency, candidate.currency_id)"/>
                        </tr>
                        <tr t-if="!this.state.candidates.length">
                            <td colspan="6" class="text-muted text-center py-3">No open journal item found.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div t-if="this.state.tab === 'writeoff'" class="card o_om_bank_rec_writeoff_form">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Account</label>
                            <RecordSelector resModel="'account.account'" resId="this.state.writeoff.account_id"
                                            domain="this.accountDomain" update.bind="this.setWriteoffAccount"
                                            placeholder="'Account'"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Label</label>
                            <input type="text" class="o_input o_om_bank_rec_writeoff_label" t-att-value="this.state.writeoff.label"
                                   t-att-placeholder="tr.label" t-on-change="(ev) => this.state.writeoff.label = ev.target.value"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Taxes</label>
                            <MultiRecordSelector resModel="'account.tax'" resIds="this.state.writeoff.tax_ids"
                                                 domain="this.taxDomain" update.bind="this.setWriteoffTaxes"
                                                 placeholder="'Taxes'"/>
                            <div class="form-check mt-1">
                                <input type="checkbox" class="form-check-input" id="om_bank_rec_tax_included"
                                       t-att-checked="this.state.writeoff.tax_included"
                                       t-on-change="(ev) => this.state.writeoff.tax_included = ev.target.checked"/>
                                <label class="form-check-label" for="om_bank_rec_tax_included">The amount includes the taxes</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Amount</label>
                            <input type="text" class="o_input text-end o_om_bank_rec_writeoff_amount"
                                   t-att-value="this.state.writeoff.amount"
                                   t-on-change="(ev) => this.setWriteoffAmount(ev)"/>
                        </div>
                    </div>
                    <button class="btn btn-primary mt-3 o_om_bank_rec_add_writeoff" t-on-click="() => this.addWriteoff()">Add counterpart</button>
                </div>
            </div>

            <div t-if="this.state.tab === 'models'" class="d-flex flex-wrap gap-2 o_om_bank_rec_models">
                <button t-foreach="this.state.data.models" t-as="model" t-key="model.id"
                        t-att-class="'btn ' + (model.applicable ? 'btn-primary' : 'btn-secondary')"
                        t-on-click="() => this.applyModel(model)" t-out="model.name"/>
            </div>
        </t>
    </t>

    <!-- What the customers and the vendors have left to clear, without any transaction of the bank:
         a cash payment against its invoice, a credit note against an invoice, an invoice against a refund. -->
    <t t-name="om_account_reconcile.BankReconciliation.OpenItems">
        <div class="o_content o_om_bank_rec_content">
            <div class="o_om_bank_rec_list">
                <div t-if="!this.state.groups.length" class="o_om_bank_rec_empty text-muted p-4">
                    <t t-if="this.state.search">No partner matches your search.</t>
                    <t t-else="">Nothing left to clear here.</t>
                </div>
                <div t-foreach="this.state.groups" t-as="group" t-key="group.partner_id + '-' + group.account_id"
                     t-att-class="'o_om_bank_rec_transaction' + (this.state.selectedGroup and this.sameGroup(group, this.state.selectedGroup) ? ' o_selected' : '')"
                     t-on-click="() => this.selectGroup(group)">
                    <div class="d-flex justify-content-between gap-2">
                        <span class="text-truncate fw-bold" t-out="group.partner_name"/>
                        <span t-att-class="'fw-bold text-nowrap ' + (group.residual &lt; 0 ? 'text-danger' : '')"
                              t-out="this.format(group.residual, group.currency_id)"/>
                    </div>
                    <div class="d-flex justify-content-between gap-2 small text-muted">
                        <span class="text-truncate" t-out="group.account_display"/>
                        <span><t t-out="group.count"/> items</span>
                    </div>
                </div>
            </div>

            <div class="o_om_bank_rec_panel">
                <div t-if="!this.state.selectedGroup" class="o_om_bank_rec_empty text-muted p-4">
                    Select a customer or a vendor to clear what is open.
                </div>
                <t t-else="">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h5 class="mb-0" t-out="this.state.selectedGroup.partner_name"/>
                        <span class="text-muted small" t-out="this.state.selectedGroup.account_display"/>
                    </div>

                    <table class="table table-sm o_om_open_items_table">
                        <thead>
                            <tr>
                                <th/>
                                <th>Date</th>
                                <th>Entry</th>
                                <th>Label</th>
                                <th class="text-end">Amount Left</th>
                                <th/>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="this.state.openItems" t-as="item" t-key="item.id"
                                t-att-class="this.isPicked(item.id) ? 'table-active' : ''">
                                <td>
                                    <input type="checkbox" class="form-check-input o_om_open_item_pick"
                                           t-att-checked="this.isPicked(item.id)"
                                           t-on-change="() => this.toggleItem(item.id)"/>
                                </td>
                                <td class="text-nowrap" t-out="item.date_display"/>
                                <td class="text-nowrap" t-out="item.move_name"/>
                                <td class="text-truncate" t-out="item.label"/>
                                <td t-att-class="'text-end text-nowrap ' + (item.amount_residual &lt; 0 ? 'text-danger' : '')"
                                    t-out="this.format(item.amount_residual, item.company_currency_id)"/>
                                <td>
                                    <button class="btn btn-link btn-sm px-0" title="Open the entry"
                                            t-on-click="() => this.openItemMove(item)">
                                        <i class="oi" data-icon="open_in_new"/>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Closing the rest of a partial settlement: a discount given, a bad debt, a rounding. -->
                    <div t-if="this.canWriteOffItems" class="card o_om_open_items_writeoff mt-3">
                        <div class="card-body py-2">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input o_om_open_items_writeoff_toggle"
                                       id="om_open_items_writeoff"
                                       t-att-checked="this.state.itemWriteoff.enabled"
                                       t-on-change="() => this.toggleItemWriteoff()"/>
                                <label class="form-check-label" for="om_open_items_writeoff">
                                    Write the rest off instead of leaving it open
                                </label>
                            </div>
                            <div t-if="this.state.itemWriteoff.enabled" class="row g-2 mt-1">
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Account</label>
                                    <RecordSelector resModel="'account.account'"
                                                    resId="this.state.itemWriteoff.account_id"
                                                    domain="this.accountDomain"
                                                    update.bind="this.setItemWriteoffAccount"
                                                    placeholder="'e.g. Discount given'"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Journal</label>
                                    <RecordSelector resModel="'account.journal'"
                                                    resId="this.state.itemWriteoff.journal_id"
                                                    update.bind="this.setItemWriteoffJournal"
                                                    placeholder="'Journal'"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Label</label>
                                    <input type="text" class="o_input w-100 o_om_open_items_writeoff_label"
                                           t-att-value="this.state.itemWriteoff.label"
                                           placeholder="e.g. Early payment discount"
                                           t-on-change="(ev) => this.setItemWriteoffLabel(ev)"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-3">
                        <div class="small text-muted">
                            <div>To receive or to pay: <t t-out="this.format(this.state.openItemTotals.debit, this.state.selectedGroup.currency_id)"/></div>
                            <div>Already settled on the other side: <t t-out="this.format(this.state.openItemTotals.credit, this.state.selectedGroup.currency_id)"/></div>
                        </div>
                        <div class="text-end">
                            <div t-if="!this.pickedItems.length" class="text-muted">
                                Pick what is owed together with what settles it
                            </div>
                            <t t-elif="!this.canReconcileItems">
                                <div class="text-danger">
                                    These are all on the same side: add what settles them
                                </div>
                            </t>
                            <t t-else="">
                                <div t-if="this.stillOpenAfter" class="fw-bold">
                                    <t t-if="this.state.itemWriteoff.enabled">Written off: </t>
                                    <t t-else="">Stays open: </t>
                                    <t t-out="this.format(this.stillOpenAfter, this.state.selectedGroup.currency_id)"/>
                                </div>
                                <div t-else="" class="fw-bold text-success">
                                    Settles in full
                                </div>
                            </t>
                            <button class="btn btn-primary mt-2 o_om_open_items_reconcile"
                                    t-att-disabled="!this.canReconcileItems"
                                    t-on-click="() => this.reconcileItems()">
                                <t t-if="this.state.itemWriteoff.enabled">Reconcile and write off</t>
                                <t t-else="">Reconcile</t>
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
