<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om.account.reconcile</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="bank_cash" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="om_reconcile_auto">
                    <div class="o_setting_left_pane">
                        <field name="om_reconcile_auto"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="om_reconcile_auto"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Reconcile the new bank and cash transactions with the automatic reconciliation models and
                            the open items matching them exactly by amount and reference.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
