<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om.account.reconcile</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="bank_cash" position="inside">
                <setting id="om_reconcile_auto" company_dependent="1"
                         help="Reconcile the new bank and cash transactions with the automatic reconciliation models and the open items matching them exactly by amount and reference.">
                    <field name="om_reconcile_auto"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
