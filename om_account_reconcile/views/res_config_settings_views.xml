<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om.account.reconcile</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="bank_cash" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="om_reconcile_auto">
                    <div class="o_setting_left_pane">
                        <field name="om_reconcile_auto"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="om_reconcile_auto"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Reconcile the new bank and cash transactions with the automatic reconciliation models and
                            the open items matching them exactly by amount and reference.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="om_reconcile_find_partner">
                    <div class="o_setting_left_pane">
                        <field name="om_reconcile_find_partner"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="om_reconcile_find_partner"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Set the partner of a new transaction only when it is certain: the owner of the bank account, the company
                            with exactly the name written by the bank, or the partner of the invoice or bill it refers to. When
                            several partners fit, it stays empty.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="om_reconcile_tolerance">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Payment Tolerance</span>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Match a transaction with an open item differing by a small amount, or by a small percentage for an
                            item in another currency.
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="om_reconcile_tolerance" class="col-lg-5 o_light_label"/>
                                <field name="om_reconcile_tolerance"/>
                            </div>
                            <div class="row">
                                <label for="om_reconcile_fx_tolerance" class="col-lg-5 o_light_label"/>
                                <field name="om_reconcile_fx_tolerance"/>
                            </div>
                            <div class="row">
                                <label for="om_reconcile_tolerance_account_id" class="col-lg-5 o_light_label"/>
                                <field name="om_reconcile_tolerance_account_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="om_bank_fee_account">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Bank Fees</span>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Offer a reconciliation model booking the bank fees on this account on every bank journal.
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="om_bank_fee_account_id" class="col-lg-5 o_light_label"/>
                                <field name="om_bank_fee_account_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
