<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_bank_reconciliation" model="ir.actions.client">
        <field name="name">Bank Reconciliation</field>
        <field name="tag">om_bank_reconciliation</field>
    </record>

    <menuitem id="menu_reconciliation"
              name="Reconciliation"
              parent="account.menu_finance_entries"
              sequence="15"
              groups="account.group_account_basic"/>

    <menuitem id="menu_bank_reconciliation"
              name="Bank Reconciliation"
              action="action_bank_reconciliation"
              parent="menu_reconciliation"
              sequence="10"
              groups="account.group_account_basic"/>

    <!-- The same screen, opened on what the customers and the vendors have left to clear: what is settled
         without the bank, e.g. a cash payment, a credit note or an invoice against a refund. -->
    <record id="action_open_items_reconciliation" model="ir.actions.client">
        <field name="name">Open Items</field>
        <field name="tag">om_bank_reconciliation</field>
        <field name="params" eval="{'mode': 'open_items'}"/>
    </record>

    <menuitem id="menu_open_items_reconciliation"
              name="Open Items"
              action="action_open_items_reconciliation"
              parent="menu_reconciliation"
              sequence="20"
              groups="account.group_account_basic"/>

    <record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.om.account.reconcile</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='bank_cash_buttons']" position="attributes">
                <attribute name="class" add="flex-wrap" separator=" "/>
            </xpath>
            <xpath expr="//div[@name='bank_cash_buttons']" position="inside">
                <button t-if="dashboard.number_to_reconcile > 0" type="object"
                        name="om_action_open_bank_reconciliation" class="btn btn-secondary o_om_dashboard_reconcile"
                        groups="account.group_account_basic">
                    Reconcile <span class="badge rounded-pill text-bg-primary ms-1" t-out="dashboard.number_to_reconcile"/>
                </button>
                <button type="object" name="om_action_new_transaction" class="btn btn-secondary o_om_dashboard_new_transaction"
                        groups="account.group_account_basic">New Transaction</button>
                <button t-if="journal_type == 'cash'" type="object" name="om_action_new_statement"
                        class="btn btn-secondary o_om_dashboard_new_statement"
                        groups="account.group_account_basic">New Statement</button>
            </xpath>
            <!-- the figures the account module computes for the bank and cash cards without showing them -->
            <xpath expr="//div[@id='dashboard_bank_cash_balance']/.." position="after">
                <div class="row o_om_dashboard_last_statement"
                     t-if="dashboard.has_at_least_one_statement and dashboard.last_statement_visible">
                    <div class="col overflow-hidden text-start">
                        <a type="object" name="om_action_open_last_statement">Last Statement</a>
                    </div>
                    <div class="col-auto text-end">
                        <span dir="ltr"><t t-out="dashboard.last_balance"/></span>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='dashboard_bank_cash_right']/t[@t-call='JournalChecks']" position="before">
                <div class="row o_om_dashboard_to_review" t-if="dashboard.number_to_check > 0"
                     groups="account.group_account_basic">
                    <div class="col overflow-hidden text-start">
                        <a type="object" name="om_action_open_to_review"><t t-out="dashboard.number_to_check"/> To Review</a>
                    </div>
                    <div class="col-auto text-end">
                        <span dir="ltr"><t t-out="dashboard.to_check_balance"/></span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
