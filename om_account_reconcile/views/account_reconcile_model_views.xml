<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_reconcile_model_tree" model="ir.ui.view">
        <field name="name">account.reconcile.model.list.om.account.reconcile</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_tree"/>
        <field name="arch" type="xml">
            <field name="auto_reconcile" position="after">
                <field name="om_auto_created" optional="show" widget="boolean"/>
                <field name="om_use_count" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_reconcile_model_form" model="ir.ui.view">
        <field name="name">account.reconcile.model.form.om.account.reconcile</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="om_auto_created" invisible="1"/>
                <div class="alert alert-info" role="status" attrs="{'invisible': [('om_auto_created', '=', False)]}">
                    This model was learned from transactions booked by hand on the same account.
                    Check its conditions, then use it from the bank reconciliation, or set it to run automatically.
                </div>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="text-muted" attrs="{'invisible': [('om_use_count', '=', 0)]}">
                    Used <field name="om_use_count" class="oe_inline"/> times
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_account_reconcile_model_search" model="ir.ui.view">
        <field name="name">account.reconcile.model.search.om.account.reconcile</field>
        <field name="model">account.reconcile.model</field>
        <field name="inherit_id" ref="account.view_account_reconcile_model_search"/>
        <field name="arch" type="xml">
            <filter name="auto_validate" position="after">
                <filter string="Learned" name="om_learned" domain="[('om_auto_created', '=', True)]"/>
                <filter string="Bank Fees" name="om_bank_fees" domain="[('om_bank_fee_journal_id', '!=', False)]"/>
            </filter>
        </field>
    </record>

</odoo>
