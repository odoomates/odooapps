<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- after the dashboards of om_spreadsheet_account in the Finance section; the file is built by
         tools/build_dashboards.py, the sample by om_spreadsheet_account/tools/export_samples.py -->

    <record id="dashboard_assets" model="spreadsheet.dashboard">
        <field name="name">Assets</field>
        <field name="data" type="base64" file="om_spreadsheet_account_asset/data/files/assets_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.set([ref('account.group_account_readonly'), ref('account.group_account_manager')])]"/>
        <field name="sequence">40</field>
    </record>

</odoo>
