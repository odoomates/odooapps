#. module: om_data_remove
#: model_terms:ir.ui.view,arch_db:om_data_remove.view_om_data_remove_report_form
msgid ""
"<strong invisible=\"action != 'clear'\">The transactions were cleared.</strong>\n"
"                        <strong invisible=\"action != 'tables'\">The selected tables were emptied.</strong>"
msgstr ""

#. module: om_data_remove
#: model_terms:ir.ui.view,arch_db:om_data_remove.view_om_data_remove_form
msgid ""
"<strong>The transactions are deleted for good.</strong>\n"
"                        They are removed from the database tables directly, for all the companies and whatever their\n"
"                        state, posted entries included, and nothing can restore them. Make a backup of the database\n"
"                        first, and never do it on a database holding real data."
msgstr ""

#. module: om_data_remove
#: model_terms:ir.ui.view,arch_db:om_data_remove.view_om_data_remove_report_form
msgid ""
"A table still holding rows you do not want? Click <b>Delete Rows</b> on its line to empty it too.\n"
"                        The tables of the framework are protected, and relation tables are emptied with the records they link."
msgstr ""

