"                        because records that are kept still point to them:"
msgstr ""

#. module: om_data_remove
#: model:ir.ui.view,arch_db:om_data_remove.view_om_data_remove_form
msgid "<b>Clear All Transactions</b> deletes the documents below with their followers and attachments,\n"
"                        every message and activity of the database, and starts the numbering of the documents again\n"
"                        from 1. The master data stays:\n"
"                        partners, products, chart of accounts, journals, taxes, employees, bills of materials, projects\n"
"                        and the configuration."
msgstr ""

#. module: om_data_remove
#: model:ir.ui.view,arch_db:om_data_remove.view_om_data_remove_form
msgid "<span class=\"text-muted\" attrs=\"{'invisible': [('total_count', '!=', 0)]}\">There is no transaction left to delete.</span>"
msgstr ""

#. module: om_data_remove
#: model:ir.ui.view,arch_db:om_data_remove.view_om_data_remove_report_form
msgid "<strong attrs=\"{'invisible': [('action', '!=', 'clear')]}\">The transactions were cleared.</strong>\n"
"                        <strong attrs=\"{'invisible': [('action', '!=', 'tables')]}\">The selected tables were emptied.</strong>"
msgstr ""

#. module: om_data_remove
#: model:ir.ui.view,arch_db:om_data_remove.view_om_data_remove_form
msgid "<strong>The transactions are deleted for good.</strong>\n"
"                        They are removed from the database tables directly, for all the companies and whatever their\n"
"                        state, posted entries included, and nothing can restore them. Make a backup of the database\n"
"                        first, and never do it on a database holding real data."
msgstr ""

#. module: om_data_remove
#: model:ir.ui.view,arch_db:om_data_remove.view_om_data_remove_report_form
msgid "A table still holding rows you do not want? Click <b>Delete Rows</b> on its line to empty it too.\n"
"                        The tables of the framework are protected, and relation tables are emptied with the records they link."
msgstr ""

