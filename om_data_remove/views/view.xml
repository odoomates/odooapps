<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_remove_data" model="ir.ui.view">
        <field name="name">Remove Data</field>
        <field name="model">res.config.settings</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Data Cleaning" create="false">
                <sheet>
                    <div class="alert alert-danger" role="alert">
                        <strong>The data are deleted for good.</strong>
                        They are removed from the database tables directly, for all the companies, and nothing can
                        restore them. Make a backup of the database first.
                    </div>
                    <h4 class="mt-4 mb-2">Everything</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">All the transactions, the master data kept</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_all" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-danger"
                                context="{'om_removal': 'all'}" invisible="not om_remove_count_all"/>
                    </div>
                    <h4 class="mt-4 mb-2">Sales</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Sales orders</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_sales" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'sales'}" invisible="not om_remove_count_sales"/>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Point of Sale orders and sessions</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_pos" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'pos'}" invisible="not om_remove_count_pos"/>
                    </div>
                    <h4 class="mt-4 mb-2">Purchases and Expenses</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Purchase orders and requisitions</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_purchase" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'purchase'}" invisible="not om_remove_count_purchase"/>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Expenses and expense reports</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_expense" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'expense'}" invisible="not om_remove_count_expense"/>
                    </div>
                    <h4 class="mt-4 mb-2">Manufacturing</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Manufacturing orders</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_mrp" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'mrp'}" invisible="not om_remove_count_mrp"/>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Bills of materials</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_mrp_bom" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'mrp_bom'}" invisible="not om_remove_count_mrp_bom"/>
                    </div>
                    <h4 class="mt-4 mb-2">Inventory</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Moves, transfers, packages and lots</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_inventory" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'inventory'}" invisible="not om_remove_count_inventory"/>
                    </div>
                    <h4 class="mt-4 mb-2">Accounting</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Journal entries, invoices, bills and payments</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_account" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'account'}" invisible="not om_remove_count_account"/>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Chart of accounts, taxes and journals</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_account_chart" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'account_chart'}" invisible="not om_remove_count_account_chart"/>
                    </div>
                    <h4 class="mt-4 mb-2">Projects</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Projects and tasks</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_project" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'project'}" invisible="not om_remove_count_project"/>
                    </div>
                    <h4 class="mt-4 mb-2">Quality</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Quality checks and alerts</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_quality" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'quality'}" invisible="not om_remove_count_quality"/>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Quality control points</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_quality_setting" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'quality_setting'}" invisible="not om_remove_count_quality_setting"/>
                    </div>
                    <h4 class="mt-4 mb-2">Website</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Website pages and blog posts</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_website" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'website'}" invisible="not om_remove_count_website"/>
                    </div>
                    <h4 class="mt-4 mb-2">Master Data</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Products</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_product" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'product'}" invisible="not om_remove_count_product"/>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Product attributes</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_product_attribute" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'product_attribute'}" invisible="not om_remove_count_product_attribute"/>
                    </div>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Messages, followers and activities</div>
                        <div class="text-muted text-nowrap">
                            <field name="om_remove_count_message" class="oe_inline"/> records
                        </div>
                        <button name="action_om_open_removal" type="object" string="Delete" class="btn btn-sm btn-outline-danger"
                                context="{'om_removal': 'message'}" invisible="not om_remove_count_message"/>
                    </div>
                    <h4 class="mt-4 mb-2">Tools</h4>
                    <div class="d-flex align-items-center border-bottom py-2 gap-3">
                        <div class="flex-grow-1">Recompute the full names of the product categories and locations</div>
                        <button name="reset_cat_loc_name" type="object" string="Recompute" class="btn btn-sm btn-secondary"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_om_data_remove_wizard_form" model="ir.ui.view">
        <field name="name">om.data.remove.wizard.form</field>
        <field name="model">om.data.remove.wizard</field>
        <field name="arch" type="xml">
            <form string="Delete Data">
                <div class="alert alert-danger" role="alert">
                    <strong><field name="record_count" class="oe_inline"/> records</strong> will be deleted for good,
                    for all the companies. This cannot be undone.
                </div>
                <group>
                    <field name="removal"/>
                    <field name="model_names"/>
                    <field name="confirmation" placeholder="Type DELETE to confirm"/>
                </group>
                <footer>
                    <button name="action_remove" type="object" string="Delete" class="btn-danger" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_remove_data" model="ir.actions.act_window">
        <field name="name">Data Cleaning</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_remove_data"/>
    </record>

    <menuitem
            id="menu_remove_data"
            name="Data Cleaning"
            action="action_remove_data"
            parent="base.menu_administration"
            sequence="1"
            groups="base.group_system"/>

</odoo>
