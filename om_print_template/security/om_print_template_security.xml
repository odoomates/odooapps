<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="privilege_print" model="res.groups.privilege">
            <field name="name">Print Templates</field>
        </record>

        <record id="group_print_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_print"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('mail.group_mail_template_editor'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
