<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_print_wizard_view_form" model="ir.ui.view">
        <field name="name">print.wizard.view.form</field>
        <field name="model">print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print">
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <group>
                    <field name="template_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="addressee" invisible="record_count != 1"/>
                    <field name="record_count" invisible="record_count &lt; 2" string="Records"/>
                </group>
                <div invisible="not preview" class="o_om_print_preview border rounded p-3 bg-white">
                    <field name="preview" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button string="Issue &amp; Download" name="action_issue" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Edit Before Issuing" name="action_draft" type="object" class="btn-secondary"
                            data-hotkey="w"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
