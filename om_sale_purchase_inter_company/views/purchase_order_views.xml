<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_om_ic" model="ir.ui.view">
        <field name="name">purchase.order.form.om.ic</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0 d-flex align-items-center gap-2" role="alert" invisible="not om_ic_warning">
                    <i class="oi" data-icon="warning"/>
                    <span class="fw-bold text-nowrap">Inter-Company:</span>
                    <field name="om_ic_warning" class="flex-grow-1 mb-0"/>
                    <button name="action_om_ic_dismiss" type="object" string="Dismiss" class="btn btn-sm btn-link"/>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_om_ic_open" type="object" class="oe_stat_button" icon="swap_horiz"
                        invisible="not om_ic_link_name">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text"><field name="om_ic_link_company" readonly="1"/></span>
                        <span class="o_stat_value"><field name="om_ic_link_name" readonly="1"/></span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
