<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_om_quality_team_list" model="ir.ui.view">
        <field name="name">om.quality.team.list</field>
        <field name="model">om.quality.team</field>
        <field name="arch" type="xml">
            <list string="Quality Teams">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="member_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="alias_email" string="Email Alias" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_om_quality_team_form" model="ir.ui.view">
        <field name="name">om.quality.team.form</field>
        <field name="model">om.quality.team</field>
        <field name="arch" type="xml">
            <form string="Quality Team">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_points" type="object" class="oe_stat_button" icon="checklist">
                            <field name="point_count" widget="statinfo" string="Control Points"/>
                        </button>
                        <button name="action_view_checks_todo" type="object" class="oe_stat_button" icon="assignment">
                            <field name="check_todo_count" widget="statinfo" string="Checks to Do"/>
                        </button>
                        <button name="action_view_alerts" type="object" class="oe_stat_button" icon="warning">
                            <field name="alert_open_count" widget="statinfo" string="Non-conformances"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Incoming Inspection"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="member_ids" widget="many2many_avatar_user"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <label for="alias_name" string="Email Alias"/>
                            <div name="alias_def" class="d-flex align-items-baseline gap-2">
                                <field name="alias_id" invisible="1"/>
                                <field name="alias_name" placeholder="e.g. quality"/>
                                <span>@</span>
                                <field name="alias_domain_id" placeholder="e.g. mycompany.com" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <field name="alias_contact" string="Accept Emails From" invisible="not alias_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stages" name="stages">
                            <field name="stage_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_closed"/>
                                    <field name="fold"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_om_quality_team_kanban" model="ir.ui.view">
        <field name="name">om.quality.team.kanban</field>
        <field name="model">om.quality.team</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" class="o_kanban_dashboard" create="0">
                <field name="color"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Configuration</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline mb-3">
                            <field name="name" class="fw-bold fs-4"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <button name="action_view_checks_todo" type="object" class="btn btn-primary w-100">
                                    <field name="check_todo_count"/> Checks to Do
                                </button>
                            </div>
                            <div class="col-6">
                                <button name="action_view_alerts" type="object" class="btn btn-secondary w-100">
                                    <field name="alert_open_count"/> Non-conformances
                                </button>
                            </div>
                            <div class="col-6">
                                <a name="action_view_checks_failed" type="object" class="text-danger">
                                    <field name="check_failed_count"/> failed in 30 days
                                </a>
                            </div>
                            <div class="col-6">
                                <a name="action_view_alerts_urgent" type="object">
                                    <field name="alert_urgent_count"/> urgent
                                </a>
                            </div>
                            <div class="col-6">
                                <a name="action_view_points" type="object">
                                    <field name="point_count"/> control points
                                </a>
                            </div>
                            <div class="col-6">
                                <a name="action_view_actions_late" type="object" class="text-warning">
                                    <field name="action_late_count"/> late actions
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_om_quality_team" model="ir.actions.act_window">
        <field name="name">Quality Teams</field>
        <field name="res_model">om.quality.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a quality team</p>
            <p>A team follows its control points and non-conformances. Emails sent to its alias become non-conformances.</p>
        </field>
    </record>

    <record id="action_om_quality_team_overview" model="ir.actions.act_window">
        <field name="name">Quality Teams</field>
        <field name="res_model">om.quality.team</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="view_om_quality_team_kanban"/>
    </record>
</odoo>
