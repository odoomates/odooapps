<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_om_quality" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.om.quality</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Quality" data-string="Quality" name="om_quality" groups="om_quality.group_om_quality_manager">
                    <block title="Where to Check" name="om_quality_apps">
                        <setting id="om_quality_stock" help="Checks on receipts, deliveries and internal transfers, quarantine and lots on hold">
                            <field name="module_om_quality_stock"/>
                        </setting>
                        <setting id="om_quality_mrp" help="Checks on manufacturing orders, work orders and finished lots or serial numbers">
                            <field name="module_om_quality_mrp"/>
                        </setting>
                    </block>
                    <block title="Failures" name="om_quality_failures">
                        <setting id="om_quality_alert_on_failure" company_dependent="1"
                                 help="New control points raise a non-conformance when their check fails">
                            <field name="om_quality_alert_on_failure"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_om_quality_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_om_quality"/>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'om_quality', 'bin_size': False}</field>
    </record>
</odoo>
