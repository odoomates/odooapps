<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_om_quality" model="res.groups.privilege">
        <field name="name">Quality</field>
        <field name="sequence">8</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_om_quality_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_om_quality"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Records quality checks, raises non-conformances and works on their actions.</field>
    </record>

    <record id="group_om_quality_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_om_quality"/>
        <field name="implied_ids" eval="[(4, ref('group_om_quality_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Sets up control points, teams and templates, and overrides blocking checks.</field>
    </record>
</odoo>
