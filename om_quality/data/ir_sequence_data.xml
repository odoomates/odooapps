<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_om_quality_check" model="ir.sequence">
        <field name="name">Quality Check</field>
        <field name="code">om.quality.check</field>
        <field name="prefix">QC</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_om_quality_alert" model="ir.sequence">
        <field name="name">Non-conformance</field>
        <field name="code">om.quality.alert</field>
        <field name="prefix">NC</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_om_quality_point" model="ir.sequence">
        <field name="name">Control Point</field>
        <field name="code">om.quality.point</field>
        <field name="prefix">CP</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
