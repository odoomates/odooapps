<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_stage_list" model="ir.ui.view">
        <field name="name">om.helpdesk.stage.list</field>
        <field name="model">om.helpdesk.stage</field>
        <field name="arch" type="xml">
            <list string="Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags"/>
                <field name="template_id" optional="show"/>
                <field name="is_close"/>
                <field name="fold" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_stage_form" model="ir.ui.view">
        <field name="name">om.helpdesk.stage.form</field>
        <field name="model">om.helpdesk.stage</field>
        <field name="arch" type="xml">
            <form string="Stage">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. In Progress"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="template_id" context="{'default_model': 'om.helpdesk.ticket'}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_close"/>
                            <field name="fold"/>
                        </group>
                    </group>
                    <group string="Status Labels">
                        <group>
                            <field name="legend_normal"/>
                            <field name="legend_done"/>
                            <field name="legend_blocked"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Explain what this stage means to your agents..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">om.helpdesk.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a stage</p>
            <p>Stages are the steps of your tickets. A closing stage ends the ticket and can ask the customer for a rating.</p>
        </field>
    </record>
</odoo>
