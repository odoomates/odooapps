<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_om_helpdesk" model="ir.ui.view">
        <field name="name">res.partner.form.om.helpdesk</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_om_tickets" type="object" class="oe_stat_button" icon="confirmation_number"
                    groups="om_helpdesk.group_helpdesk_user" invisible="om_ticket_count == 0">
                    <field name="om_ticket_count" widget="statinfo" string="Tickets"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
