<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">om.helpdesk.ticket.search</field>
        <field name="model">om.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name" string="Ticket" filter_domain="['|', '|', ('name', 'ilike', self), ('number', 'ilike', self), ('email_from', 'ilike', self)]"/>
                <field name="number"/>
                <field name="partner_id" operator="child_of"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="ticket_type_id"/>
                <field name="tag_ids"/>
                <field name="stage_id"/>
                <filter string="My Tickets" name="my_tickets" domain="[('user_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('user_id', '=', False)]"/>
                <filter string="Followed" name="followed" domain="[('message_is_follower', '=', True)]"/>
                <separator/>
                <filter string="Open" name="open" domain="[('is_closed', '=', False)]"/>
                <filter string="Closed" name="closed" domain="[('is_closed', '=', True)]"/>
                <separator/>
                <filter name="priority" string="Priority">
                    <filter string="Urgent" name="urgent" domain="[('priority', '=', '3')]"/>
                    <filter string="High" name="high" domain="[('priority', '=', '2')]"/>
                    <filter string="Medium" name="medium" domain="[('priority', '=', '1')]"/>
                    <filter string="Low" name="low" domain="[('priority', '=', '0')]"/>
                </filter>
                <separator/>
                <filter string="SLA Failed" name="sla_failed" domain="[('sla_fail', '=', True)]"/>
                <filter string="SLA On Time" name="sla_ongoing" domain="[('sla_state', '=', 'ongoing')]"/>
                <filter string="SLA Reached" name="sla_reached" domain="[('sla_state', '=', 'reached')]"/>
                <separator/>
                <filter string="Blocked" name="blocked" domain="[('kanban_state', '=', 'blocked')]"/>
                <filter string="Ready" name="ready" domain="[('kanban_state', '=', 'done')]"/>
                <separator/>
                <filter string="Rated" name="rated" domain="[('rating_last_value', '!=', 0)]"/>
                <separator/>
                <filter string="Opened On" name="filter_date_open" date="date_open"/>
                <filter string="Closed On" name="filter_date_closed" date="date_closed"/>
                <separator/>
                <filter string="Late Activities" name="activities_overdue" domain="[('my_activity_date_deadline', '&lt;', 'today')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Team" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Assigned To" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'ticket_type_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'commercial_partner_id'}"/>
                    <filter string="SLA" name="group_sla_state" context="{'group_by': 'sla_state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Opened On" name="group_date_open" context="{'group_by': 'date_open'}"/>
                    <filter string="Closed On" name="group_date_closed" context="{'group_by': 'date_closed'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">om.helpdesk.ticket.list</field>
        <field name="model">om.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" multi_edit="1" sample="1">
                <header>
                    <button name="action_open_merge" type="object" string="Merge" groups="om_helpdesk.group_helpdesk_user"/>
                </header>
                <field name="number" readonly="1"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="ticket_type_id" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="sla_deadline" widget="remaining_days" optional="show" invisible="not sla_deadline or is_closed"/>
                <field name="sla_state" widget="badge" optional="show" invisible="sla_state == 'none'"
                    decoration-success="sla_state in ('ongoing', 'reached')" decoration-danger="sla_state == 'failed'"/>
                <field name="date_open" optional="hide"/>
                <field name="date_closed" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="stage_id" optional="show"/>
                <field name="is_closed" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">om.helpdesk.ticket.kanban</field>
        <field name="model">om.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" highlight_color="color" class="o_kanban_small_column" sample="1"
                quick_create_view="om_helpdesk.view_helpdesk_ticket_quick_create" on_create="quick_create">
                <field name="stage_id" options="{'group_by_tooltip': {'description': 'Description'}}"/>
                <field name="is_closed"/>
                <field name="sla_state"/>
                <field name="active"/>
                <field name="legend_blocked"/>
                <field name="legend_done"/>
                <field name="legend_normal"/>
                <progressbar field="kanban_state" colors='{"done": "success", "blocked": "danger", "normal": "200"}'/>
                <templates>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="name" class="fw-bold fs-5"/>
                        <div class="text-muted small">
                            <field name="number"/>
                            <span t-if="record.partner_id.raw_value"> - <field name="partner_id"/></span>
                        </div>
                        <field name="ticket_type_id" class="small"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <div t-if="record.sla_deadline.raw_value and !record.is_closed.raw_value" class="small">
                            <span t-attf-class="badge d-inline-flex align-items-center gap-1 #{record.sla_state.raw_value == 'failed' ? 'text-bg-danger' : 'text-bg-success'}">
                                <i class="oi" data-icon="timer" title="SLA deadline"/><field name="sla_deadline"/>
                            </span>
                        </div>
                        <div t-elif="record.sla_state.raw_value == 'failed'" class="small">
                            <span class="badge text-bg-danger">SLA failed</span>
                        </div>
                        <footer class="pt-1">
                            <div class="d-flex align-items-center gap-1">
                                <field name="priority" widget="priority"/>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                            <div class="d-flex align-items-center gap-2 ms-auto">
                                <field name="kanban_state" widget="state_selection"/>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_helpdesk_ticket_quick_create" model="ir.ui.view">
        <field name="name">om.helpdesk.ticket.quick.create</field>
        <field name="model">om.helpdesk.ticket</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="e.g. Printer does not print"/>
                    <field name="partner_id" placeholder="Customer"/>
                    <field name="team_id" invisible="context.get('default_team_id')"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="company_id" invisible="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">om.helpdesk.ticket.form</field>
        <field name="model">om.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <field name="is_closed" invisible="1"/>
                <field name="use_sla" invisible="1"/>
                <field name="use_rating" invisible="1"/>
                <field name="rating_count" invisible="1"/>
                <field name="legend_blocked" invisible="1"/>
                <field name="legend_done" invisible="1"/>
                <field name="legend_normal" invisible="1"/>
                <header>
                    <button name="action_assign_to_me" type="object" string="Assign to Me" class="btn-primary"
                        invisible="user_id or is_closed"/>
                    <button name="action_close" type="object" string="Close" invisible="is_closed or not id"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_partner_tickets" type="object" class="oe_stat_button" icon="confirmation_number"
                            invisible="not partner_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Customer Tickets</span>
                            </div>
                        </button>
                        <field name="rating_avg" invisible="1" groups="base.group_user"/>
                        <button name="action_open_ratings" type="object" class="oe_stat_button" invisible="rating_count == 0" groups="base.group_user">
                            <i class="oi oi-fw o_button_icon" data-icon="sentiment_satisfied" invisible="rating_avg &lt; 3.66" title="Happy"/>
                            <i class="oi oi-fw o_button_icon" data-icon="sentiment_neutral" invisible="rating_avg &lt; 2.33 or rating_avg &gt;= 3.66" title="Neutral"/>
                            <i class="oi oi-fw o_button_icon" data-icon="sentiment_dissatisfied" invisible="rating_avg &gt;= 2.33" title="Unhappy"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="rating_avg_text" nolabel="1"/></span>
                                <span class="o_stat_text">Rating</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="SLA Failed" bg_color="text-bg-danger" invisible="not active or sla_state != 'failed' or is_closed"/>
                    <div class="text-muted">
                        <field name="number" readonly="1"/>
                    </div>
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <h1 class="d-flex w-100">
                            <field name="priority" widget="priority" class="me-3"/>
                            <field name="name" class="o_text_overflow w-100" placeholder="e.g. Printer does not print"/>
                        </h1>
                        <field name="kanban_state" widget="state_selection" class="ms-auto"/>
                    </div>
                    <group>
                        <group>
                            <field name="team_id" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="ticket_type_id" options="{'no_create': True}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="partner_id" widget="res_partner_many2one" context="{'res_partner_search_mode': 'customer'}"/>
                            <field name="partner_name" invisible="partner_id"/>
                            <field name="email_from" widget="email"/>
                            <field name="partner_phone" widget="phone"/>
                            <label for="sla_deadline" invisible="not use_sla or sla_state == 'none'"/>
                            <div class="d-flex align-items-center gap-2" invisible="not use_sla or sla_state == 'none'">
                                <field name="sla_deadline" invisible="not sla_deadline"/>
                                <field name="sla_state" widget="badge" decoration-success="sla_state in ('ongoing', 'reached')"
                                    decoration-danger="sla_state == 'failed'"/>
                            </div>
                            <field name="close_reason_id" invisible="not is_closed" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" type="html" options="{'collaborative': true}" placeholder="Describe the issue..."/>
                        </page>
                        <page string="SLA" name="sla" invisible="not use_sla">
                            <field name="sla_status_ids" readonly="1">
                                <list decoration-danger="status == 'failed'" decoration-success="status == 'reached'">
                                    <field name="sla_id"/>
                                    <field name="sla_stage_id"/>
                                    <field name="deadline"/>
                                    <field name="reached_datetime"/>
                                    <field name="status" widget="badge" decoration-danger="status == 'failed'"
                                        decoration-success="status == 'reached'" decoration-info="status == 'ongoing'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Extra Info" name="extra_info">
                            <group>
                                <group string="Dates">
                                    <field name="date_open"/>
                                    <field name="date_assign"/>
                                    <field name="date_first_response"/>
                                    <field name="date_closed"/>
                                    <field name="date_last_stage_update"/>
                                </group>
                                <group string="Durations (hours)">
                                    <field name="hours_to_assign" widget="float_time"/>
                                    <field name="hours_to_first_response" widget="float_time"/>
                                    <field name="hours_to_close" widget="float_time"/>
                                    <field name="merged_into_id" invisible="not merged_into_id"/>
                                    <field name="active" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_activity" model="ir.ui.view">
        <field name="name">om.helpdesk.ticket.activity</field>
        <field name="model">om.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <activity string="Tickets">
                <templates>
                    <div t-name="activity-box">
                        <field name="user_id" widget="many2one_avatar_user"/>
                        <div class="flex-grow-1">
                            <field name="name" display="full" class="o_text_block o_text_bold"/>
                            <field name="number" class="text-muted"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="view_helpdesk_ticket_calendar" model="ir.ui.view">
        <field name="name">om.helpdesk.ticket.calendar</field>
        <field name="model">om.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <calendar string="Tickets" date_start="sla_deadline" color="team_id" mode="month" quick_create="0" event_open_popup="1">
                <field name="number"/>
                <field name="partner_id"/>
                <field name="user_id" avatar_field="avatar_128"/>
                <field name="stage_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">om.helpdesk.ticket</field>
        <field name="path">helpdesk-tickets</field>
        <field name="view_mode">list,kanban,form,activity,calendar</field>
        <field name="search_view_id" ref="view_helpdesk_ticket_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tickets found. Let's create one!
            </p>
            <p>
                Tickets come from the email alias of each team, from the website form and from
                your agents. Track them through their stages and keep an eye on the SLA deadlines.
            </p>
        </field>
    </record>

    <record id="action_helpdesk_ticket_my" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">om.helpdesk.ticket</field>
        <field name="view_mode">list,kanban,form,activity,calendar</field>
        <field name="search_view_id" ref="view_helpdesk_ticket_search"/>
        <field name="context">{'search_default_open': 1, 'search_default_my_tickets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No ticket assigned to you
            </p>
        </field>
    </record>

    <record id="action_server_merge_tickets" model="ir.actions.server">
        <field name="name">Merge Tickets</field>
        <field name="model_id" ref="model_om_helpdesk_ticket"/>
        <field name="binding_model_id" ref="model_om_helpdesk_ticket"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('om_helpdesk.group_helpdesk_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_open_merge()</field>
    </record>
</odoo>
