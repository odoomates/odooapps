<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_helpdesk" model="res.groups.privilege">
        <field name="name">Helpdesk</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
    </record>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">User: Own Teams</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Sees the tickets of the teams they belong to, their own tickets and the tickets without team.</field>
    </record>

    <record id="group_helpdesk_user_all" model="res.groups">
        <field name="name">User: All Tickets</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="comment">Sees and handles the tickets of every team.</field>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user_all')), (4, ref('mail.group_mail_canned_response_admin'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Configures teams, stages, SLA policies and sees the reports.</field>
    </record>
</odoo>
