<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="base.user_demo" model="res.users">
            <field name="group_ids" eval="[(4, ref('om_helpdesk.group_helpdesk_user'))]"/>
        </record>

        <record id="type_question" model="om.helpdesk.ticket.type">
            <field name="name">Question</field>
            <field name="sequence">1</field>
        </record>
        <record id="type_issue" model="om.helpdesk.ticket.type">
            <field name="name">Issue</field>
            <field name="sequence">2</field>
        </record>
        <record id="type_installation" model="om.helpdesk.ticket.type">
            <field name="name">Installation</field>
            <field name="sequence">3</field>
        </record>
        <record id="type_feature" model="om.helpdesk.ticket.type">
            <field name="name">Feature Request</field>
            <field name="sequence">4</field>
        </record>

        <record id="tag_hardware" model="om.helpdesk.tag">
            <field name="name">Hardware</field>
            <field name="color">2</field>
        </record>
        <record id="tag_software" model="om.helpdesk.tag">
            <field name="name">Software</field>
            <field name="color">4</field>
        </record>
        <record id="tag_invoice" model="om.helpdesk.tag">
            <field name="name">Invoicing</field>
            <field name="color">10</field>
        </record>
        <record id="tag_account" model="om.helpdesk.tag">
            <field name="name">Account</field>
            <field name="color">7</field>
        </record>

        <record id="team_support" model="om.helpdesk.team">
            <field name="member_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_demo'))]"/>
            <field name="assign_method">balanced</field>
            <field name="use_rating" eval="True"/>
            <field name="description" type="html"><p>Questions about your account, orders and deliveries.</p></field>
        </record>
        <record id="team_tech" model="om.helpdesk.team">
            <field name="name">Technical Support</field>
            <field name="sequence">2</field>
            <field name="alias_name">tech-support</field>
            <field name="user_id" ref="base.user_demo"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin')), (4, ref('base.user_demo'))]"/>
            <field name="assign_method">randomly</field>
            <field name="use_rating" eval="True"/>
            <field name="color">2</field>
            <field name="stage_ids" eval="[(6, 0, [ref('stage_new'), ref('stage_in_progress'), ref('stage_waiting'), ref('stage_solved'), ref('stage_cancelled')])]"/>
            <field name="description" type="html"><p>Hardware, installation and software problems.</p></field>
        </record>
        <record id="team_billing" model="om.helpdesk.team">
            <field name="name">Billing</field>
            <field name="sequence">3</field>
            <field name="alias_name">billing</field>
            <field name="user_id" ref="base.user_admin"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="privacy_visibility">internal</field>
            <field name="color">10</field>
            <field name="stage_ids" eval="[(6, 0, [ref('stage_new'), ref('stage_waiting'), ref('stage_solved')])]"/>
            <field name="description" type="html"><p>Invoices, payments and refunds.</p></field>
        </record>

        <record id="sla_support_answer" model="om.helpdesk.sla">
            <field name="name">Answer within 4 working hours</field>
            <field name="team_id" ref="team_support"/>
            <field name="priority">0</field>
            <field name="stage_id" ref="stage_in_progress"/>
            <field name="time">4</field>
        </record>
        <record id="sla_support_solve" model="om.helpdesk.sla">
            <field name="name">Solve within 3 days</field>
            <field name="team_id" ref="team_support"/>
            <field name="priority">0</field>
            <field name="stage_id" ref="stage_solved"/>
            <field name="time">72</field>
            <field name="time_mode">calendar</field>
        </record>
        <record id="sla_tech_urgent" model="om.helpdesk.sla">
            <field name="name">Urgent issues solved within 8 working hours</field>
            <field name="team_id" ref="team_tech"/>
            <field name="priority">3</field>
            <field name="ticket_type_ids" eval="[(4, ref('type_issue'))]"/>
            <field name="stage_id" ref="stage_solved"/>
            <field name="time">8</field>
        </record>
        <record id="sla_tech_answer" model="om.helpdesk.sla">
            <field name="name">Answer within 8 working hours</field>
            <field name="team_id" ref="team_tech"/>
            <field name="priority">0</field>
            <field name="stage_id" ref="stage_in_progress"/>
            <field name="time">8</field>
        </record>
        <record id="sla_billing_invoice" model="om.helpdesk.sla">
            <field name="name">Invoice issues solved within 2 days</field>
            <field name="team_id" ref="team_billing"/>
            <field name="priority">1</field>
            <field name="tag_ids" eval="[(4, ref('tag_invoice'))]"/>
            <field name="stage_id" ref="stage_solved"/>
            <field name="time">16</field>
        </record>

        <record id="ticket_1" model="om.helpdesk.ticket">
            <field name="name">Cannot log in to the customer portal</field>
            <field name="team_id" ref="team_support"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="partner_id" ref="base.partner_demo_portal"/>
            <field name="stage_id" ref="stage_in_progress"/>
            <field name="priority">2</field>
            <field name="ticket_type_id" ref="type_issue"/>
            <field name="tag_ids" eval="[(4, ref('tag_account'))]"/>
            <field name="kanban_state">normal</field>
            <field name="date_open" eval="(DateTime.now() - relativedelta(days=2, hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="description" type="html"><p>Cannot log in to the customer portal.</p></field>
        </record>
        <record id="ticket_2" model="om.helpdesk.ticket">
            <field name="name">How do I change my delivery address?</field>
            <field name="team_id" ref="team_support"/>
            <field name="user_id" eval="False"/>
            <field name="partner_id" ref="base.partner_demo_portal"/>
            <field name="stage_id" ref="stage_new"/>
            <field name="priority">0</field>
            <field name="ticket_type_id" ref="type_question"/>
            <field name="kanban_state">normal</field>
            <field name="date_open" eval="(DateTime.now() - relativedelta(days=0, hours=3)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="description" type="html"><p>How do I change my delivery address?.</p></field>
