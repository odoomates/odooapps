        <function model="om.helpdesk.ticket" name="_demo_set_dates">
            <value eval="[ref('ticket_%s' % i) for i in range(1, 16)]"/>
            <value eval="{ref('ticket_9'): 5, ref('ticket_10'): 3, ref('ticket_14'): 5}"/>
        </function>
    </data>
</odoo>
