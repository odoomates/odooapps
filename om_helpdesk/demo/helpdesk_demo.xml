        <record id="message_1" model="mail.message">
            <field name="model">om.helpdesk.ticket</field>
            <field name="res_id" ref="ticket_1"/>
            <field name="author_id" ref="base.partner_demo_portal"/>
            <field name="message_type">comment</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field name="body" type="html"><p>Hello, since yesterday I cannot log in. The page says my password is wrong but I did not change it.</p></field>
        </record>
        <record id="message_2" model="mail.message">
            <field name="model">om.helpdesk.ticket</field>
            <field name="res_id" ref="ticket_1"/>
            <field name="author_id" ref="base.partner_admin"/>
            <field name="message_type">comment</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field name="body" type="html"><p>Hello Joel, thank you for your message. I have sent you a link to reset your password. Can you try it and tell us if it works?</p></field>
