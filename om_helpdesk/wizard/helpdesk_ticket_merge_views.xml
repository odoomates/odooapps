<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_merge_form" model="ir.ui.view">
        <field name="name">om.helpdesk.ticket.merge.form</field>
        <field name="model">om.helpdesk.ticket.merge</field>
        <field name="arch" type="xml">
            <form string="Merge Tickets">
                <p class="text-muted">
                    Messages, attachments and followers of the selected tickets are moved to the ticket below.
                    The other tickets are archived.
                </p>
                <group>
                    <group>
                        <field name="target_ticket_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="team_id" options="{'no_create': True}"/>
                        <field name="user_id" widget="many2one_avatar_user"/>
                    </group>
                </group>
                <field name="ticket_ids">
                    <list create="0">
                        <field name="number"/>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="team_id"/>
                        <field name="user_id"/>
                        <field name="stage_id"/>
                        <field name="date_open"/>
                    </list>
                </field>
                <footer>
                    <button name="action_merge" type="object" string="Merge" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
