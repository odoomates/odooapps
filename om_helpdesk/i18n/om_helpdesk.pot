#. module: om_helpdesk
#: model:mail.template,body_html:om_helpdesk.mail_template_ticket_rating
msgid ""
"<div>\n"
"    <t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"/>\n"
"    <t t-set=\"partner\" t-value=\"object._rating_get_partner()\"/>\n"
"    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"width:100%; margin:0px auto;\">\n"
"    <tbody>\n"
"        <tr><td valign=\"top\" style=\"font-size: 13px;\">\n"
"            Hello <t t-out=\"partner.name or ''\">Brandon Freeman</t>,<br/><br/>\n"
"            Your ticket <strong t-out=\"object.number or ''\">TK00001</strong>: <t t-out=\"object.name or ''\">Printer not working</t> is closed.\n"
"            Please take a moment to tell us how we did<t t-if=\"object._rating_get_operator().name\">, handled by <strong t-out=\"object._rating_get_operator().name or ''\">Mitchell Admin</strong></t>.\n"
"        </td></tr>\n"
"        <tr><td style=\"text-align: center;\">\n"
"            <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"width:100%; margin: 32px 0px 32px 0px; display: inline-table;\">\n"
"                <tr><td style=\"font-size: 13px; text-align: center;\">\n"
"                    <strong>How do you feel about our support?</strong><br/>\n"
"                    <span style=\"font-size: 12px; opacity: 0.5; color: #454748;\">(click on one of these smileys)</span>\n"
"                </td></tr>\n"
"                <tr><td style=\"font-size: 13px;\">\n"
"                    <table style=\"width:100%; text-align:center; margin-top:2rem;\">\n"
"                        <tr>\n"
"                            <td><a t-attf-href=\"/rate/{{ access_token }}/5\"><img alt=\"Happy\" src=\"/rating/static/src/img/rating_5.png\" title=\"Happy\"/></a></td>\n"
"                            <td><a t-attf-href=\"/rate/{{ access_token }}/3\"><img alt=\"Neutral\" src=\"/rating/static/src/img/rating_3.png\" title=\"Neutral\"/></a></td>\n"
"                            <td><a t-attf-href=\"/rate/{{ access_token }}/1\"><img alt=\"Unhappy\" src=\"/rating/static/src/img/rating_1.png\" title=\"Unhappy\"/></a></td>\n"
"                        </tr>\n"
"                    </table>\n"
"                </td></tr>\n"
"            </table>\n"
"        </td></tr>\n"
"        <tr><td valign=\"top\" style=\"font-size: 13px;\">\n"
"            Your feedback helps us improve our service.<br/><br/>\n"
"            Best regards,<br/>\n"
"            <t t-out=\"object.team_id.name or object.company_id.name or ''\">Customer Support</t>\n"
"        </td></tr>\n"
"    </tbody>\n"
"    </table>\n"
"</div>\n"
"            "
msgstr ""

#. module: om_helpdesk
#: model:mail.template,body_html:om_helpdesk.mail_template_ticket_received
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.partner_id.name or object.partner_name or 'customer'\">Brandon Freeman</t>,<br/><br/>\n"
"    Thank you for contacting us. Your request has been received and registered under the reference\n"
"    <strong t-out=\"object.number or ''\">TK00001</strong>: <t t-out=\"object.name or ''\">Printer not working</t>.<br/>\n"
"    Our team will get back to you as soon as possible.<br/><br/>\n"
"    <t t-if=\"object.team_id.privacy_visibility == 'portal'\">\n"
"        You can follow your ticket and reply to us from your account.<br/>\n"
"        <div style=\"margin: 16px 0px 16px 0px;\">\n"
"            <a t-att-href=\"object.get_portal_url()\" style=\"background-color: #714B67; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                View the ticket\n"
"            </a>\n"
"        </div>\n"
"    </t>\n"
"    Simply reply to this email to add information to your request.<br/><br/>\n"
"    Best regards,<br/>\n"
"    <t t-out=\"object.team_id.name or object.company_id.name or ''\">Customer Support</t>\n"
"</div>\n"
"            "
msgstr ""

#. module: om_helpdesk
#: model:mail.template,body_html:om_helpdesk.mail_template_ticket_solved
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.partner_id.name or object.partner_name or 'customer'\">Brandon Freeman</t>,<br/><br/>\n"
"    Your request <strong t-out=\"object.number or ''\">TK00001</strong>: <t t-out=\"object.name or ''\">Printer not working</t>\n"
"    has been solved.<br/>\n"
"    If the problem is still there, just reply to this email and we will look at it again.<br/><br/>\n"
"    Best regards,<br/>\n"
"    <t t-out=\"object.user_id.name or object.team_id.name or ''\">Mitchell Admin</t>\n"
"</div>\n"
"            "
msgstr ""

