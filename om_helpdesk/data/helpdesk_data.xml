<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="stage_new" model="om.helpdesk.stage">
            <field name="name">New</field>
            <field name="sequence">1</field>
            <field name="template_id" ref="mail_template_ticket_received"/>
        </record>
        <record id="stage_in_progress" model="om.helpdesk.stage">
            <field name="name">In Progress</field>
            <field name="sequence">10</field>
        </record>
        <record id="stage_waiting" model="om.helpdesk.stage">
            <field name="name">Waiting for Customer</field>
            <field name="sequence">20</field>
        </record>
        <record id="stage_solved" model="om.helpdesk.stage">
            <field name="name">Solved</field>
            <field name="sequence">30</field>
            <field name="is_close" eval="True"/>
            <field name="fold" eval="True"/>
            <field name="template_id" ref="mail_template_ticket_solved"/>
        </record>
        <record id="stage_cancelled" model="om.helpdesk.stage">
            <field name="name">Cancelled</field>
            <field name="sequence">40</field>
            <field name="is_close" eval="True"/>
            <field name="fold" eval="True"/>
        </record>

        <record id="close_reason_solved" model="om.helpdesk.close.reason">
            <field name="name">Solved</field>
            <field name="sequence">1</field>
        </record>
        <record id="close_reason_duplicate" model="om.helpdesk.close.reason">
            <field name="name">Duplicate</field>
            <field name="sequence">2</field>
        </record>
        <record id="close_reason_no_reply" model="om.helpdesk.close.reason">
            <field name="name">No reply from the customer</field>
            <field name="sequence">3</field>
        </record>
        <record id="close_reason_not_issue" model="om.helpdesk.close.reason">
            <field name="name">Not an issue</field>
            <field name="sequence">4</field>
        </record>

        <record id="team_support" model="om.helpdesk.team">
            <field name="name">Customer Support</field>
            <field name="sequence">1</field>
            <field name="alias_name">support</field>
            <field name="stage_ids" eval="[(6, 0, [ref('stage_new'), ref('stage_in_progress'), ref('stage_waiting'), ref('stage_solved'), ref('stage_cancelled')])]"/>
            <field name="member_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="user_id" ref="base.user_admin"/>
            <field name="color">5</field>
        </record>
    </data>

    <record id="ir_cron_sla_deadlines" model="ir.cron">
        <field name="name">Helpdesk: flag failed SLAs</field>
        <field name="model_id" ref="model_om_helpdesk_sla_status"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_deadlines()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
