<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="privilege_payroll" model="res.groups.privilege">
            <field name="name">Payroll</field>
            </record>

        <record id="group_hr_payroll_user" model="res.groups">
            <field name="name">Officer</field>
            <field name="privilege_id" ref="privilege_payroll"/>
            <field name="implied_ids"
                   eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_hr_payroll_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_payroll"/>
            <field name="implied_ids" eval="[(4, ref('om_hr_payroll.group_hr_payroll_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
