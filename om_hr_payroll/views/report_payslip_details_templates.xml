<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_payslip_details">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="layout_document_title">
                    <span t-if="o.credit_note">Payslip Refund Details</span>
                    <span t-else="">Payslip Details</span>
                </t>
                <t t-call="web.external_layout">
                    <t t-set="currency" t-value="o.company_id.currency_id"/>
                    <div class="page">
                        <h4 t-field="o.name" class="mb-3"/>
                        <t t-call="om_hr_payroll.report_payslip_employee"/>

                        <h5>Details by Salary Rule Category</h5>
                        <table class="table table-sm o_main_table mb-4">
                            <thead>
                                <tr>
                                    <th class="text-start">Code</th>
                                    <th class="text-start">Salary Rule Category</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_details_by_rule_category.get(o.id, [])" t-as="h"
                                    t-att-class="'fw-bold' if not h['level'] else None">
                                    <td><span t-out="h['code']"/></td>
                                    <td t-attf-style="padding-left: #{0.25 + h['level']}rem;">
                                        <span t-out="h['rule_category']"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="h['total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h5>Payslip Lines by Contribution Register</h5>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th class="text-start">Code</th>
                                    <th class="text-start">Name</th>
                                    <th class="text-end">Quantity/Rate</th>
                                    <th class="text-end">Amount</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="get_lines_by_contribution_register.get(o.id, [])" t-as="p">
                                    <td><span t-out="p.get('code', '')"/></td>
                                    <td><span t-out="p.get('name', '')"/></td>
                                    <td class="text-end"><span t-out="p.get('quantity', '')"/></td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="p.get('amount', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="p.get('total', 0)" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                                <tr t-if="not get_lines_by_contribution_register.get(o.id)">
                                    <td colspan="5" class="text-muted">No line is linked to a contribution register.</td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-call="om_hr_payroll.report_payslip_signature"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
