<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Payslip Line -->
        <record id="view_hr_payslip_line_tree" model="ir.ui.view">
            <field name="name">hr.payslip.line.list</field>
            <field name="model">hr.payslip.line</field>
            <field name="arch" type="xml">
                <list string="Salary Structure" editable="bottom" decoration-info="total == 0">
                    <field name="category_id"/>
                    <field name="employee_id" column_invisible="1"/>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="quantity"/>
                    <field name="rate"/>
                    <field name="amount"/>
                    <field name="total"/>
                    <field name="amount_select" column_invisible="1"/>
                    <field name="register_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_hr_payslip_line_form" model="ir.ui.view">
            <field name="name">hr.payslip.line.form</field>
            <field name="model">hr.payslip.line</field>
            <field name="arch" type="xml">
                <form string="Payslip Line">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="slip_id"/>
                                <field name="employee_id"/>
                                <field name="sequence"/>
                            </group>
                            <group string="Calculation">
                                <field name="category_id"/>
                                <field name="amount_select"/>
                                <field name="amount_fix" readonly="amount_select != 'fix'"/>
                                <field name="amount_percentage" readonly="amount_select != 'percentage'"/>
                            </group>
                        </group>
                        <field name="note" placeholder="Notes"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_payslip_line_filter" model="ir.ui.view">
            <field name="name">hr.payslip.line.select</field>
            <field name="model">hr.payslip.line</field>
            <field name="arch" type="xml">
                <search string="Search Payslip Lines">
                    <field name="name" string="Payslip Lines"
                           filter_domain="['|',('name','ilike',self),('code','ilike',self)]"/>
                    <field name="amount_select"/>
                    <field name="slip_id"/>
                    <group>
                        <filter string="Salary Rule Category" name="category_id" context="{'group_by':'category_id'}"/>
                        <filter string="Contribution Register" name="register_id" context="{'group_by':'register_id'}"/>
                        <filter string="Amount Type" name="amount_select" context="{'group_by':'amount_select'}"/>
                        <filter string="Employees" name="employee_id" context="{'group_by':'employee_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- payslip -->

        <record id="view_hr_payslip_tree" model="ir.ui.view">
            <field name="name">hr.payslip.list</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <list decoration-info="state in ('done')"
                      decoration-muted="state == 'cancel'" string="Payslips">
                    <field name="number"/>
                    <field name="employee_id"/>
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="state"/>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="payslip_run_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="hr_payslip_view_kanban" model="ir.ui.view">
            <field name="name">hr.payslip.kanban</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div class="row">
                                    <div class="col-6">
                                        <strong>
                                            <field name="employee_id"/>
                                        </strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="float-right badge badge-secondary">
                                            <field name="state"/>
                                        </span>
                                    </div>
                                    <div class="col-12">
                                        <span>
                                            <field name="date_from"/>
                                            -
                                            <field name="date_to"/>
                                        </span>
                                    </div>
                                    <div class="col-12">
                                        <span>
                                            <field name="name"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="act_payslip_lines" model="ir.actions.act_window">
            <field name="name">Payslip Computation Details</field>
            <field name="res_model">hr.payslip.line</field>
            <field name="context">{'default_slip_id': active_id,'search_default_slip_id': active_id}</field>
        </record>

        <record id="view_hr_payslip_form" model="ir.ui.view">
            <field name="name">hr.payslip.form</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <form string="Payslip">
                    <header>
                        <!-- compute first, then confirm what was computed -->
                        <button string="Compute Sheet" name="compute_sheet" type="object" class="btn-primary"
                                invisible="state != 'draft' or line_ids"/>
                        <button string="Confirm" name="action_payslip_done" type="object" class="btn-primary"
                                invisible="state != 'draft' or not line_ids"/>
                        <button string="Recompute" name="compute_sheet" type="object"
                                invisible="state != 'draft' or not line_ids"/>
                        <button string="Confirm" name="action_payslip_done" type="object"
                                invisible="state != 'draft' or line_ids"/>
                        <button string="Send by Email" name="action_send_email" type="object" class="btn-primary"
                                invisible="state not in ('verify', 'done')"/>
                        <button string="Refund" name="refund_sheet"
                                invisible="state != 'done' or credit_note" type="object"/>
                        <button string="Set to Draft" name="action_payslip_draft" type="object"
                                invisible="state != 'cancel'"/>
                        <button string="Cancel" name="action_payslip_cancel" type="object"
                                invisible="state not in ('draft', 'verify', 'done')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(act_payslip_lines)d"
                                    class="oe_stat_button"
                                    icon="list_alt"
                                    type="action">
                                <field name="payslip_count" widget="statinfo" string="Payslip"
                                       help="Payslip Computation Details"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Refund" bg_color="text-bg-warning" invisible="not credit_note"/>
                        <div class="oe_title">
                            <label for="employee_id"/>
                            <h1>
                                <field name="employee_id" placeholder="Employee" readonly="state != 'draft'"/>
                            </h1>
                            <field name="name" placeholder="Payslip name" readonly="state != 'draft'"/>
                        </div>
                        <group>
                            <group>
                                <label for="date_from" string="Period"/>
                                <div class="o_row">
                                    <field name="date_from" class="oe_inline" readonly="state != 'draft'"/>
                                    <span class="mx-2">to</span>
                                    <field name="date_to" class="oe_inline" readonly="state != 'draft'"/>
                                </div>
                                <field name="number" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="version_id"
                                       readonly="state != 'draft'"
                                       domain="[('employee_id','=',employee_id),('contract_date_start','&lt;=',date_to),'|',('contract_date_end','&gt;=',date_from),('contract_date_end','=',False)]"
                                       context="{'default_employee_id': employee_id}"/>
                                <field name="struct_id" required="version_id != False" readonly="state != 'draft'"/>
                                <field name="credit_note" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Worked Days &amp; Inputs" name="worked_days">
                                <separator string="Worked Days"/>
                                <field name="worked_days_line_ids" readonly="state != 'draft'">
                                    <list string="Worked Days" editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="number_of_days" sum="Total Working Days"/>
                                        <field name="number_of_hours"/>
                                        <field name="work_entry_type_id" optional="show"/>
                                        <field name="paid_rate" widget="percentage" optional="show"/>
                                        <field name="version_id"/>
                                        <field name="sequence" column_invisible="1"/>
                                    </list>
                                    <form string="Worked Day">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="code"/>
                                                    <field name="work_entry_type_id"/>
                                                    <field name="sequence"/>
                                                </group>
                                                <group>
                                                    <field name="number_of_days"/>
                                                    <field name="number_of_hours"/>
                                                    <field name="paid_rate" widget="percentage"/>
                                                    <field name="version_id"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                                <separator string="Other Inputs"/>
                                <field name="input_line_ids" nolabel="1" readonly="state != 'draft'">
                                    <list string="Input Data" editable="bottom">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="amount"/>
                                        <field name="version_id"/>
                                        <field name="sequence" column_invisible="1"/>
                                    </list>
                                    <form string="Other Input">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="code"/>
                                                    <field name="sequence"/>
                                                </group>
                                                <group>
                                                    <field name="amount"/>
                                                    <field name="version_id"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Salary Computation" name="computation">
                                <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                                    <list string="Salary Structure" editable="bottom" decoration-info="total == 0">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="category_id"/>
                                        <field name="sequence" column_invisible="1"/>
                                        <field name="quantity"/>
                                        <field name="rate"/>
                                        <field name="salary_rule_id"/>
                                        <field name="amount"/>
                                        <field name="total"/>
                                    </list>
                                    <form string="Payslip Line">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="name"/>
                                                    <field name="code"/>
                                                    <field name="category_id"/>
                                                    <field name="salary_rule_id"/>
                                                    <field name="sequence"/>
                                                </group>
                                                <group>
                                                    <field name="quantity"/>
                                                    <field name="rate"/>
                                                    <field name="amount"/>
                                                    <field name="total"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Details by Category" name="details">
                                <field name="details_by_salary_rule_category"
                                       context="{'search_default_category_id':1}"
                                       domain="[('appears_on_payslip', '=', True)]">
                                    <list string="Payslip Lines" decoration-info="total == 0">
                                        <field name="category_id"/>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="total"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Other Information" name="other_info">
                                <group>
                                    <group string="Miscellaneous">
                                        <field name="company_id" readonly="state != 'draft'"
                                               groups="base.group_multi_company"/>
                                        <field name="payslip_run_id" domain="[('state','=','draft')]"
                                               readonly="state != 'draft'"/>
                                    </group>
                                    <group name="accounting" string="Accounting">
                                        <field name="paid" readonly="1"/>
                                    </group>
                                </group>
                                <field name="note" placeholder="Add an internal note..."
                                       readonly="state != 'draft'"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_hr_payslip_filter" model="ir.ui.view">
            <field name="name">hr.payslip.select</field>
            <field name="model">hr.payslip</field>
            <field name="arch" type="xml">
                <search string="Search Payslips">
                    <field name="name" string="Payslips"
                           filter_domain="['|',('name','ilike',self),('number','ilike',self)]"/>
                    <field name="date_from"/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]" help="Draft Slip"/>
                    <filter string="Done" name="done" domain="[('state','=','done')]" help="Done Slip"/>
                    <field name="employee_id"/>
                    <field name="payslip_run_id"/>
                    <group>
                        <filter string="Employees" name="employee_id" context="{'group_by':'employee_id'}"/>
                        <filter string="PaySlip Batch" name="payslip_run_id" context="{'group_by':'payslip_run_id'}"/>
                        <filter string="Companies" name="company_id" groups="base.group_multi_company"
                                context="{'group_by':'company_id'}"/>
                        <filter string="States" name="state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_view_hr_payslip_form" model="ir.actions.act_window">
            <field name="name">Employee Payslips</field>
            <field name="res_model">hr.payslip</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_hr_payslip_filter"/>
        </record>

        <menuitem id="menu_department_tree"
                  action="action_view_hr_payslip_form"
                  parent="menu_hr_payroll_root"
                  groups="om_hr_payroll.group_hr_payroll_user"/>

        <record id="act_hr_employee_payslip_list" model="ir.actions.act_window">
            <field name="res_model">hr.payslip</field>
            <field name="name">Payslips</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_employee_id': [active_id], 'default_employee_id': active_id}</field>
        </record>

        <!-- payslip runs -->

        <record id="hr_payslip_run_filter" model="ir.ui.view">
            <field name="name">hr.payslip.run.search</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <search string="Search Payslip Batches">
                    <field name="name" string="Payslip Batches"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]" help="Draft Payslip Batches"/>
                    <filter name="done_filter" string="Done" domain="[('state','=','close')]"
                            help="Done Payslip Batches"/>
                </search>
            </field>
        </record>

        <record id="hr_payslip_run_tree" model="ir.ui.view">
            <field name="name">hr.payslip.run.list</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <list string="Payslips Batches">
                    <field name="name"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="credit_note"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
            <field name="name">hr.payslip.run.kanban</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <templates>
                        <t t-name="card">
                            <div class="d-flex">
                                <field name="name" class="fw-bold"/>
                                <field name="state" widget="badge" class="ms-auto"
                                       decoration-success="state == 'close'" decoration-info="state == 'draft'"/>
                            </div>
                            <div class="text-muted">
                                <field name="date_start"/> - <field name="date_end"/>
                            </div>
                            <span t-if="record.credit_note.raw_value" class="badge text-bg-warning">Refund</span>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="hr_payslip_run_form" model="ir.ui.view">
            <field name="name">hr.payslip.run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="arch" type="xml">
                <form string="Payslips Batches">
                    <header>
                        <button name="%(action_hr_payslip_by_employees)d" type="action" invisible="state != 'draft'"
                                string="Generate Payslips" class="btn-primary"/>
                        <button string="Mark as Done" name="done_payslip_run" type="object"
                                invisible="state != 'draft'"/>
                        <button name="close_payslip_run" type="object" string="Close" invisible="state != 'draft'"/>
                        <button name="action_send_payslips" type="object" string="Send Payslips by Email"
                                class="btn-primary" invisible="state == 'draft'"
                                confirm="The confirmed payslips of the batch are emailed to the employees. Continue?"/>
                        <button string="Set to Draft" name="draft_payslip_run" type="object"
                                invisible="state != 'close'"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" readonly="state != 'draft'" placeholder="e.g. Salaries of January"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <label for="date_start" string="Period"/>
                                <div class="o_row">
                                    <field name="date_start" class="oe_inline" readonly="state != 'draft'"/>
                                    <span class="mx-2">to</span>
                                    <field name="date_end" class="oe_inline" readonly="state != 'draft'"/>
                                </div>
                            </group>
                            <group>
                                <field name="credit_note" readonly="state != 'draft'"/>
                                <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"
                                       options="{'no_create': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Payslips" name="payslips">
                                <field name="slip_ids" readonly="state != 'draft'"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_payslip_run_tree" model="ir.actions.act_window">
            <field name="name">Payslips Batches</field>
            <field name="res_model">hr.payslip.run</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="hr_payslip_run_filter"/>
        </record>

        <menuitem id="menu_hr_payslip_run"
                  action="action_hr_payslip_run_tree"
                  parent="menu_hr_payroll_root"
                  groups="om_hr_payroll.group_hr_payroll_manager"/>

        <!--  Shortcuts -->

        <record id="act_contribution_reg_payslip_lines" model="ir.actions.act_window">
            <field name="name">Payslip Lines</field>
            <field name="res_model">hr.payslip.line</field>
            <field name="domain">[('register_id', '=', active_id)]</field>
            <field name="context">{'default_register_id': active_id, 'search_default_register_id': 1}</field>
        </record>

    </data>

</odoo>