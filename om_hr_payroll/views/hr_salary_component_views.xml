<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_salary_component_view_list" model="ir.ui.view">
        <field name="name">hr.salary.component.list</field>
        <field name="model">hr.salary.component</field>
        <field name="arch" type="xml">
            <list string="Salary Components" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="default_amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="hr_salary_component_view_form" model="ir.ui.view">
        <field name="name">hr.salary.component.form</field>
        <field name="model">hr.salary.component</field>
        <field name="arch" type="xml">
            <form string="Salary Component">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Housing"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. HOUSING"/>
                            <field name="category_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="default_amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="note" nolabel="1"
                               placeholder="What the component pays for, and how the salary rules use it."/>
                    </group>
                    <div class="text-muted">
                        The salary rules read the amount of this component with
                        <strong>components.&lt;CODE&gt;</strong>, e.g. <code>result = components.HOUSING</code>.
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_salary_component_view_search" model="ir.ui.view">
        <field name="name">hr.salary.component.search</field>
        <field name="model">hr.salary.component</field>
        <field name="arch" type="xml">
            <search string="Salary Components">
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" domain="[]"
                            context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_salary_component" model="ir.actions.act_window">
        <field name="name">Salary Components</field>
        <field name="res_model">hr.salary.component</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Describe what the employees are paid besides their wage
            </p>
            <p>
                A salary component, e.g. a housing or a transport component, holds an amount on the contract of
                the employee. The salary rules read it with components.&lt;CODE&gt;, so the same rules serve
                every company whatever it pays.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_salary_component"
              name="Salary Components"
              parent="menu_hr_payroll_configuration"
              action="action_hr_salary_component"
              sequence="6"/>

</odoo>
