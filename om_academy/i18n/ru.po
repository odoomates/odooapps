#. odoo-python
#: code:addons/om_academy/courses/report.py:0
msgid "A record of <code>report.paperformat</code>, set on the report."
msgstr "Запись <code>report.paperformat</code>, указанная в отчёте."

#. module: om_academy
#. odoo-python
#: code:addons/om_academy/courses/security.py:0
msgid ""
"A record of <code>res.groups.privilege</code> and two of "
"<code>res.groups</code>, the administrator in the managers."
msgstr ""
"Одна запись <code>res.groups.privilege</code> и две <code>res.groups</code>,"
" администратор среди менеджеров."

