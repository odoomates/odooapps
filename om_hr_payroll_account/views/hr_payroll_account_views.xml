<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_hr_payslip_inherit_form">
        <field name="name">hr.payslip.inherit.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <field name="paid" position="after">
                <field name="date" readonly="state != 'draft'"/>
                <field name="journal_id" required="1" readonly="state != 'draft'" options="{'no_create': True, 'no_open': True}"/>
                <field name="move_id" readonly="1" groups="account.group_account_readonly,account.group_account_invoice"/>
                <field name="state" invisible="1"/>
            </field>
            <button name="action_payslip_cancel" position="attributes">
                <attribute name="confirm">The accounting entry of the payslip is deleted. Continue?</attribute>
            </button>
            <button name="action_send_email" position="before">
                <button string="Register Payment" name="action_register_payment" type="object" class="btn-primary"
                        groups="account.group_account_invoice"
                        invisible="state != 'done' or credit_note or payment_state not in ('not_paid', 'partial')"/>
            </button>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_payments" type="object" class="oe_stat_button" icon="payments"
                        invisible="not payment_count"
                        groups="account.group_account_invoice,account.group_account_readonly">
                    <field name="payment_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon']" position="before">
                <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_state != 'paid'"/>
                <widget name="web_ribbon" title="In Payment" bg_color="text-bg-info"
                        invisible="payment_state != 'in_payment'"/>
                <widget name="web_ribbon" title="Partially Paid" bg_color="text-bg-info"
                        invisible="payment_state != 'partial'"/>
                <widget name="web_ribbon" title="Reversed" bg_color="text-bg-secondary"
                        invisible="payment_state != 'reversed' or credit_note"/>
            </xpath>
            <field name="paid" position="before">
                <field name="payment_state" invisible="state != 'done' or credit_note"/>
            </field>
        </field>
    </record>

    <record id="view_hr_payslip_tree_inherit_payment" model="ir.ui.view">
        <field name="name">hr.payslip.list.inherit.payment</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="credit_note" column_invisible="1"/>
                <field name="payment_state" widget="badge" optional="show"
                       invisible="state != 'done' or credit_note"
                       decoration-info="payment_state in ('not_paid', 'in_payment')"
                       decoration-warning="payment_state == 'partial'"
                       decoration-success="payment_state == 'paid'"
                       decoration-muted="payment_state == 'reversed'"/>
            </field>
        </field>
    </record>

    <record id="view_hr_payslip_filter_inherit_payment" model="ir.ui.view">
        <field name="name">hr.payslip.select.inherit.payment</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_filter"/>
        <field name="arch" type="xml">
            <filter name="done" position="after">
                <separator/>
                <filter string="To Pay" name="to_pay"
                        domain="[('state', '=', 'done'), ('credit_note', '=', False), ('payment_state', 'in', ('not_paid', 'partial'))]"/>
                <filter string="Paid" name="paid_filter" domain="[('payment_state', 'in', ('in_payment', 'paid'))]"/>
            </filter>
            <filter name="state" position="after">
                <filter string="Payment Status" name="group_payment_state" context="{'group_by': 'payment_state'}"/>
            </filter>
        </field>
    </record>

    <!-- Adding Account fields to the Salary Rules -->

    <record id="hr_salary_rule_form_inherit" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.inherit</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='rules']" position="after">
                <page string="Accounting" name="accounting">
                    <group>
                        <field name="account_debit"/>
                        <field name="account_credit"/>
                        <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>
                        <field name="account_tax_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Contract View -->

    <record id="hr_version_form_inherit_journal" model="ir.ui.view">
        <field name="name">hr.version.view.form.inherit.journal</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='top_info']" position="after">
                <group string="Accounting">
                    <field name="analytic_account_id" groups="analytic.group_analytic_accounting"/>
                    <field name="journal_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Payslip Run View -->

    <record id="hr_payslip_run_search_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.search.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_filter"/>
        <field name="arch" type="xml">
            <filter name='done_filter' position="after">
                <field name="journal_id" readonly="state != 'draft'"/>
                <field name="state" invisible="1"/>
            </filter>
        </field>
    </record>

    <record id="hr_payslip_run_tree_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.list.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_tree"/>
        <field name="arch" type="xml">
            <field name="date_end" position="after">
                <field name="journal_id"/>
            </field>
        </field>
    </record>

    <record id="hr_payslip_run_form_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.inherit</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <field name="credit_note" position="before">
                <field name="journal_id"/>
            </field>
            <button name="action_send_payslips" position="before">
                <button name="action_register_payment" type="object" string="Register Payments" class="btn-primary"
                        groups="account.group_account_invoice" invisible="not has_payslips_to_pay"/>
            </button>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_payments" type="object" class="oe_stat_button" icon="payments"
                        invisible="not payment_count"
                        groups="account.group_account_invoice,account.group_account_readonly">
                    <field name="payment_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
