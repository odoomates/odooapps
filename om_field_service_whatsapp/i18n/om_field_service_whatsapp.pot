#. module: om_field_service_whatsapp
#: model:om.whatsapp.template,body:om_field_service_whatsapp.om_whatsapp_template_fs_report
msgid ""
"Hello {{ object.partner_id.name }}, the job *{{ object.job_number or "
"object.name }}* ({{ object.name }}) is done. Thank you! Your job report: {{ "
"object.get_base_url() }}/my/field_service/{{ object.id }}"
msgstr ""

#. module: om_field_service_whatsapp
#: model:om.whatsapp.template,body:om_field_service_whatsapp.om_whatsapp_template_fs_planned
msgid ""
"Hello {{ object.partner_id.name }}, your service visit *{{ object.job_number"
" or object.name }}* ({{ object.name }}) is planned on *{{ "
"format_datetime(object.planned_start, tz=object.partner_id.tz or user.tz, "
"dt_format='EEEE d MMMM, HH:mm') }}* at {{ object.site_address or '' }}. "
"Technician: {{ ', '.join(object.technician_ids.mapped('name')) or '-' }}. "
"Reply here if the time does not suit you."
msgstr ""

#. module: om_field_service_whatsapp
#: model:om.whatsapp.template,body:om_field_service_whatsapp.om_whatsapp_template_fs_on_the_way
msgid ""
"Hello {{ object.partner_id.name }}, {{ user.employee_id.name or user.name }}"
" is on the way to {{ object.site_address or 'your site' }} for {{ "
"object.job_number or object.name }}. See you soon!{{ object.fs_tracking_url "
"and ' Follow the technician live: ' + object.fs_tracking_url or '' }}"
msgstr ""

