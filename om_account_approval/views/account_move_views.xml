<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_invoice_filter_inherit_om_approval" model="ir.ui.view">
        <field name="name">account.invoice.select.om.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <filter name="om_approval_waiting" string="Waiting for Approval"
                        domain="[('om_approval_waiting', '=', True)]"/>
            </filter>
        </field>
    </record>

    <record id="view_account_move_filter_inherit_om_approval" model="ir.ui.view">
        <field name="name">account.move.select.om.approval</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <filter name="unposted" position="after">
                <filter name="om_approval_waiting" string="Waiting for Approval"
                        domain="[('om_approval_waiting', '=', True)]"/>
            </filter>
        </field>
    </record>
</odoo>
