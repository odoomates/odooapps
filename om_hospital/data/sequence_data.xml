<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_hospital_patient" model="ir.sequence">
        <field name="name">Patient</field>
        <field name="code">hospital.patient</field>
        <field name="prefix">PT</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_hospital_appointment" model="ir.sequence">
        <field name="name">Appointment</field>
        <field name="code">hospital.appointment</field>
        <field name="prefix">AP</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="patient_tag_vip" model="patient.tag">
        <field name="name">VIP</field>
        <field name="color">3</field>
    </record>

    <record id="patient_tag_child" model="patient.tag">
        <field name="name">Child</field>
        <field name="color">10</field>
    </record>

</odoo>
