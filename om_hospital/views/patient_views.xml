<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_patient_kanban" model="ir.ui.view">
        <field name="name">hospital.patient.kanban</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image" widget="image" class="o_kanban_image_fill w-100" options="{'zoom': true}"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="reference" class="text-muted"/>
                            <div>Age: <field name="age"/> · <field name="gender"/></div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="reference"/>
                <field name="name"/>
                <field name="responsible_id" optional="show"/>
                <field name="gender" optional="show"/>
                <field name="age" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="appointment_count" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(om_hospital.action_create_appointment)d" type="action" string="Create Appointment"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h4><field name="reference"/></h4>
                        <h1><field name="name" placeholder="Patient name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="gender" invisible="context.get('hide_gender')"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appointments" name="appointments">
                            <field name="appointment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="doctor_id"/>
                                    <field name="date_appointment"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search string="Patients">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('reference', 'ilike', self)]"/>
                <field name="responsible_id"/>
                <field name="tag_ids"/>
                <filter string="Male" name="male" domain="[('gender', '=', 'male')]"/>
                <filter string="Female" name="female" domain="[('gender', '=', 'female')]"/>
                <filter string="Other" name="other" domain="[('gender', '=', 'other')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Gender" name="group_gender" context="{'group_by': 'gender'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
                <searchpanel>
                    <field name="gender" icon="fa-users" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first patient!</p>
        </field>
    </record>

    <record id="action_hospital_kids" model="ir.actions.act_window">
        <field name="name">Kids</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('age', '&lt;', 18)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No patient under 18 yet.</p>
        </field>
    </record>

    <record id="action_hospital_female" model="ir.actions.act_window">
        <field name="name">Female Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('gender', '=', 'female')]</field>
        <field name="context">{'default_gender': 'female', 'hide_gender': True}</field>
    </record>

    <record id="action_patient_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">patient.tag</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_patient_tag_list" model="ir.ui.view">
        <field name="name">patient.tag.list</field>
        <field name="model">patient.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

</odoo>
