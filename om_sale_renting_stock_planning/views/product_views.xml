<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_rental_stock_planning" model="ir.ui.view">
        <field name="name">product.template.form.om.rental.stock.planning</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="om_sale_renting.product_template_form_view_rental"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rental_qty']" position="attributes">
                <attribute name="invisible">is_storable or rental_availability == 'unit'</attribute>
            </xpath>
            <xpath expr="//field[@name='rental_unit_ids']" position="before">
                <field name="rental_units_from_serials" invisible="tracking != 'serial' or not is_storable"/>
            </xpath>
            <xpath expr="//field[@name='rental_unit_ids']" position="attributes">
                <attribute name="readonly">rental_units_from_serials</attribute>
            </xpath>
        </field>
    </record>

</odoo>
