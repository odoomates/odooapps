"%(planned)s)."
msgstr ""
"%(line)s dosáhl %(percent)s%% své plánované částky (%(practical)s z "
"%(planned)s)."

#. module: om_account_budget
#. odoo-python
#: code:addons/om_account_budget/models/account_move.py:0
msgid ""
"%(move)s cannot be posted, it goes over budget:\n"
"%(lines)s\n"
"Ask an accounting manager to post it or to raise the budget."
msgstr ""
"%(move)s nelze zaúčtovat, překračuje rozpočet:\n"
"%(lines)s\n"
"Požádejte účetního manažera, aby jej zaúčtoval nebo navýšil rozpočet."

