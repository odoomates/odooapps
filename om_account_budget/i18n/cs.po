msgid ""
"%(line)s (%(budget)s): planned %(planned)s, actual %(actual)s, committed "
"%(committed)s, this document %(new)s, %(over)s over budget"
msgstr ""
"%(line)s (%(budget)s): plánováno %(planned)s, skutečnost %(actual)s, závazně"
" %(committed)s, tento doklad %(new)s, %(over)s nad rozpočet"

