#. module: om_account_budget
#: model:mail.template,body_html:om_account_budget.mail_template_budget_exceeded
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object._get_budget_alert_user().name or ''\">Marc Demo</t>,\n"
"        <br/><br/>\n"
"        These lines of the budget <strong t-out=\"object.name or ''\">Budget 2026</strong> spent more than planned:\n"
"    </p>\n"
"    <t t-out=\"object._get_budget_exceeded_table()\"/>\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        <br/>\n"
"        Review the spending, or revise the planned amounts of the budget.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        您好 <t t-out=\"object._get_budget_alert_user().name or ''\">Marc Demo</t>，\n"
"        <br/><br/>\n"
"        預算 <strong t-out=\"object.name or ''\">Budget 2026</strong> 中以下明細的支出超出計劃：\n"
"    </p>\n"
"    <t t-out=\"object._get_budget_exceeded_table()\"/>\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        <br/>\n"
"        請檢查支出，或修訂預算的計劃金額。\n"
"    </p>\n"
"</div>\n"
"            "

