#: model_terms:ir.ui.view,arch_db:om_account_budget.view_account_budget_search
msgid "Start Date"
msgstr "Start dato"

#. module: om_account_budget
#: model:ir.model.fields,field_description:om_account_budget.field_account_budget__state
#: model_terms:ir.ui.view,arch_db:om_account_budget.view_account_budget_search
msgid "Status"
msgstr "Status"

#. module: om_account_budget
#: model:ir.model.fields,help:om_account_budget.field_account_budget__activity_state
msgid ""
"Status based on activities\n"
"Overdue: Due date is already passed\n"
"Today: Activity date is today\n"
"Planned: Future activities."
msgstr ""
"Status baseret på aktiviteter\n"
"Forfaldne: Aktivitetens forfaldsdato er overskredet\n"
"I dag: Aktiviteten er planlagt til i dag\n"
"Planlagt: Kommende aktiviteter."

#. module: om_account_budget
#: model:ir.model.fields,help:om_account_budget.field_account_budget_line__warning_level
msgid "Technical field: last warning sent to the responsible of the budget."
msgstr "Teknisk felt: seneste advarsel sendt til budgettets ansvarlige."

#. module: om_account_budget
#. odoo-python
#: code:addons/om_account_budget/models/account_budget.py:0
msgid "The budget \"%s\" must start before it ends."
msgstr "Budgettet \"%s\" skal starte, før det slutter."

#. module: om_account_budget
#. odoo-python
#: code:addons/om_account_budget/models/account_budget_position.py:0
msgid "The budgetary position \"%s\" must have at least one account."
msgstr "Budgetpositionen \"%s\" skal have mindst én konto."

#. module: om_account_budget
#. odoo-python
#: code:addons/om_account_budget/models/account_budget_line.py:0
msgid "The line \"%s\" must start before it ends."
msgstr "Linjen \"%s\" skal starte, før den slutter."

#. module: om_account_budget
#. odoo-python
#: code:addons/om_account_budget/models/account_budget_line.py:0
msgid ""
"The lines \"%(line)s\" and \"%(other)s\" overlap: the same entries would be "
"counted twice."
msgstr ""
"Linjerne \"%(line)s\" og \"%(other)s\" overlapper: de samme posteringer "
"ville blive talt med to gange."

#. module: om_account_budget
#. odoo-python
#: code:addons/om_account_budget/wizard/account_budget_copy.py:0
msgid "The new budget must start before it ends."
msgstr "Det nye budget skal starte, før det slutter."

#. module: om_account_budget
#. odoo-python
#: code:addons/om_account_budget/models/account_budget_line.py:0
msgid ""
"The period of the line \"%s\" must be included in the period of the budget."
msgstr "Perioden for linjen \"%s\" skal ligge inden for budgettets periode."

#. module: om_account_budget
#. odoo-python
#: code:addons/om_account_budget/models/account_budget_line.py:0
msgid ""
"The planned amount of \"%s\" must be positive: choose whether the line is an"
" expense or a revenue."
msgstr ""
"Det planlagte beløb for \"%s\" skal være positivt: vælg, om linjen er en "
"omkostning eller en indtægt."

#. module: om_account_budget
#: model:ir.model.fields,help:om_account_budget.field_res_company__budget_warning_threshold
#: model:ir.model.fields,help:om_account_budget.field_res_config_settings__budget_warning_threshold
msgid ""
"The responsible of a budget is warned when an expense line reaches this "
"percentage of its planned amount, and again when it goes over it."
msgstr ""
"Budgettets ansvarlige advares, når en omkostningslinje når denne procentdel "
"af sit planlagte beløb, og igen, når den overskrider det."

