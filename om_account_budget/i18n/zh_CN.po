#: model_terms:ir.actions.act_window,help:om_account_budget.action_account_budget
msgid "Use budgets to compare actual with expected revenues and costs"
msgstr "使用预算对比实际和预期收入、成本"

#. module: om_account_budget
#: model:ir.model.fields.selection,name:om_account_budget.selection__account_budget__state__validate
#: model_terms:ir.ui.view,arch_db:om_account_budget.view_account_budget_search
