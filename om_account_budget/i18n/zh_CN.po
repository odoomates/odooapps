#: model_terms:ir.ui.view,arch_db:om_account_budget.view_account_budget_form
msgid "Split by Period"
msgstr "按期间拆分"

#. module: om_account_budget
#: model:ir.model.fields.selection,name:om_account_budget.selection__account_budget_line__distribution__spread
msgid "Spread Evenly"
msgstr "均匀分摊"

#. module: om_account_budget
#: model:ir.model.fields,help:om_account_budget.field_account_budget_line__distribution
msgid ""
"Spread Evenly: the amount is expected little by little over the period.\n"
"At a Date: the whole amount is expected on the planned date, e.g. a yearly fee."
msgstr ""
"均匀分摊：金额预计在期间内逐步实现。\n"
"于某日期：全部金额预计在计划日期实现，例如年费。"

#. module: om_account_budget
#: model:ir.model.fields,field_description:om_account_budget.field_account_budget__date_from
#: model:ir.model.fields,field_description:om_account_budget.field_account_budget_copy__date_from
