<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Budgetary positions -->

    <record id="view_account_budget_position_search" model="ir.ui.view">
        <field name="name">account.budget.position.search</field>
        <field name="model">account.budget.position</field>
        <field name="arch" type="xml">
            <search string="Budgetary Position">
                <field name="name" string="Budgetary Position"/>
                <field name="account_ids"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Expenses" name="expense" domain="[('budget_type', '=', 'expense')]"/>
                <filter string="Revenues" name="revenue" domain="[('budget_type', '=', 'revenue')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_account_budget_position_list" model="ir.ui.view">
        <field name="name">account.budget.position.list</field>
        <field name="model">account.budget.position</field>
        <field name="arch" type="xml">
            <list string="Budgetary Position">
                <field name="name"/>
                <field name="budget_type"/>
                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_account_budget_position_form" model="ir.ui.view">
        <field name="name">account.budget.position.form</field>
        <field name="model">account.budget.position</field>
        <field name="arch" type="xml">
            <form string="Budgetary Position">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="budget_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounts" name="accounts">
                            <field name="account_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="account_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_budget_position" model="ir.actions.act_window">
        <field name="name">Budgetary Positions</field>
        <field name="res_model">account.budget.position</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_account_budget_position_list"/>
        <field name="search_view_id" ref="view_account_budget_position_search"/>
    </record>

    <menuitem id="menu_account_budget_position"
              action="action_account_budget_position"
              parent="account.account_account_menu"
              sequence="120"/>

    <!-- Budgets -->

    <record id="view_account_budget_form" model="ir.ui.view">
        <field name="name">account.budget.form</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button string="Confirm" name="action_budget_confirm" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button string="Approve" name="action_budget_validate" type="object"
                            invisible="state != 'confirm'" groups="account.group_account_manager"
                            class="btn-primary"/>
                    <button string="Done" name="action_budget_done" type="object"
                            invisible="state != 'validate'" groups="account.group_account_manager"
                            class="btn-primary"/>
                    <button string="Reset to Draft" name="action_budget_draft" type="object"
                            invisible="state not in ('confirm', 'cancel')"/>
                    <button string="Split by Period" name="action_open_split_wizard" type="object"
                            invisible="state != 'draft' or not line_ids"/>
                    <button string="Copy to Next Period" name="action_open_copy_wizard" type="object"
                            invisible="state == 'draft'"/>
                    <button string="Cancel Budget" name="action_budget_cancel" type="object"
                            invisible="state not in ('confirm', 'validate')" groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,validate,done"/>
                </header>
                <sheet string="Budget">
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_open_budget_report" type="object" icon="bar_chart"
                                string="Budget Report" invisible="not line_ids"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Over Budget" bg_color="text-bg-warning" invisible="not is_over_budget or not active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="is_over_budget" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="Budget Name"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'" placeholder="e.g. Budget 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_from" string="Period" widget="daterange" readonly="state != 'draft'"
                                   options="{'end_date_field': 'date_to', 'always_range': True}"/>
                            <field name="date_to" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Lines" name="lines">
                            <field name="line_ids"
                                   context="{'default_date_from': date_from, 'default_date_to': date_to}"
                                   readonly="state != 'draft'">
                                <list string="Budget Lines" editable="bottom"
                                      decoration-danger="is_over_budget"
                                      decoration-success="budget_type == 'revenue' and is_above_budget">
                                    <field name="sequence" widget="handle"/>
                                    <field name="position_id"/>
                                    <field name="analytic_account_id"/>
                                    <field name="budget_type"/>
                                    <field name="date_from" optional="show"/>
                                    <field name="date_to" optional="show"/>
                                    <field name="distribution" optional="hide"/>
                                    <field name="planned_date" optional="hide"
                                           required="distribution == 'at_date'" readonly="distribution != 'at_date'"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="planned_amount" string="Budget" sum="Budget"/>
                                    <field name="theoretical_amount" string="Theoretical" sum="Theoretical" optional="hide"
                                           column_invisible="parent.state == 'draft'"/>
                                    <field name="practical_amount" string="Achieved" sum="Achieved"
                                           column_invisible="parent.state == 'draft'"/>
                                    <field name="achievement" string="%" widget="percentage" optional="show"
                                           column_invisible="parent.state == 'draft'"/>
                                    <button type="object" name="action_open_budget_entries" string="Audit"
                                            class="btn-link" column_invisible="parent.state == 'draft'"/>
                                    <field name="is_above_budget" column_invisible="1"/>
                                    <field name="is_over_budget" column_invisible="1"/>
                                </list>
                                <form string="Budget Line">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="currency_id" invisible="1"/>
                                                <field name="position_id"/>
                                                <field name="analytic_account_id"/>
                                                <field name="budget_type" widget="radio" options="{'horizontal': true}"/>
                                                <field name="planned_amount"/>
                                            </group>
                                            <group>
                                                <field name="date_from" string="Period" widget="daterange"
                                                       options="{'end_date_field': 'date_to', 'always_range': True}"/>
                                                <field name="date_to" invisible="1"/>
                                                <field name="distribution" widget="radio"/>
                                                <field name="planned_date" invisible="distribution != 'at_date'"
                                                       required="distribution == 'at_date'"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <group invisible="state == 'draft'">
                                <group/>
                                <group class="oe_subtotal_footer border-top-0" name="budget_total">
                                    <label for="expense_practical_amount" string="Expenses"/>
                                    <div class="text-end text-nowrap">
                                        <field name="expense_practical_amount" class="oe_inline"/>
                                        <span class="text-muted"> of </span>
                                        <field name="expense_planned_amount" class="oe_inline"/>
                                    </div>
                                    <label for="revenue_practical_amount" string="Revenues"/>
                                    <div class="text-end text-nowrap">
                                        <field name="revenue_practical_amount" class="oe_inline"/>
                                        <span class="text-muted"> of </span>
                                        <field name="revenue_planned_amount" class="oe_inline"/>
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_budget_list" model="ir.ui.view">
        <field name="name">account.budget.list</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <list string="Budget" decoration-muted="state in ('done', 'cancel')">
                <field name="name"/>
                <field name="date_from" string="Start Date"/>
                <field name="date_to" string="End Date" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="expense_planned_amount" optional="hide"/>
                <field name="expense_practical_amount" optional="hide"/>
                <field name="revenue_planned_amount" optional="hide"/>
                <field name="revenue_practical_amount" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="is_over_budget" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'confirm')" decoration-success="state == 'validate'"
                       decoration-warning="is_over_budget and state == 'validate'" decoration-muted="state in ('done', 'cancel')"/>
            </list>
        </field>
    </record>

    <record id="view_account_budget_kanban" model="ir.ui.view">
        <field name="name">account.budget.kanban</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="user_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex mb4">
                            <field name="name" class="fw-bold"/>
                            <field name="state" widget="label_selection" class="ms-auto"
                                   options="{'classes': {'draft': 'default', 'confirm': 'info', 'validate': 'success', 'done': 'default', 'cancel': 'danger'}}"/>
                        </div>
                        <footer>
                            <div>
                                <i class="oi me-1" data-icon="schedule" role="img" aria-label="Period" title="Period"/>
                                <field name="date_from"/> - <field name="date_to"/>
                            </div>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_account_budget_search" model="ir.ui.view">
        <field name="name">account.budget.search</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <search string="Budget">
                <field name="name" string="Budget"/>
                <field name="user_id"/>
                <field name="line_ids" string="Budgetary Position" filter_domain="[('line_ids.position_id', 'ilike', self)]"/>
                <field name="line_ids" string="Analytic Account" filter_domain="[('line_ids.analytic_account_id', 'ilike', self)]"
                       groups="analytic.group_analytic_accounting"/>
                <filter string="My Budgets" name="my_budgets" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="To Approve" name="toapprove" domain="[('state', '=', 'confirm')]"/>
                <filter string="Validated" name="validated" domain="[('state', '=', 'validate')]"/>
                <separator/>
                <filter string="Over Budget" name="over_budget" domain="[('is_over_budget', '=', True)]"/>
                <separator/>
                <filter string="Period" name="period" date="date_from"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_date_from" context="{'group_by': 'date_from:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">account.budget</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="view_account_budget_list"/>
        <field name="search_view_id" ref="view_account_budget_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to create a new budget.
            </p>
            <p>
                Use budgets to compare actual with expected revenues and costs
            </p>
        </field>
    </record>

    <menuitem id="menu_account_budget"
              parent="account.menu_finance_entries"
              name="Budgets"
              action="action_account_budget"
              sequence="35"
              groups="account.group_account_readonly,account.group_account_user,account.group_account_manager"/>

    <!-- Budget lines -->

    <record id="view_account_budget_line_search" model="ir.ui.view">
        <field name="name">account.budget.line.search</field>
        <field name="model">account.budget.line</field>
        <field name="arch" type="xml">
            <search string="Budget Lines">
                <field name="budget_id"/>
                <field name="position_id"/>
                <field name="analytic_account_id"/>
                <filter name="filter_not_cancelled" string="Not Cancelled"
                        domain="[('budget_state', '!=', 'cancel')]"/>
                <separator/>
                <filter name="expense" string="Expenses" domain="[('budget_type', '=', 'expense')]"/>
                <filter name="revenue" string="Revenues" domain="[('budget_type', '=', 'revenue')]"/>
                <separator/>
                <filter name="over_budget" string="Over Budget" domain="[('is_over_budget', '=', True)]"/>
                <separator/>
                <filter name="period" string="Period" date="date_from"/>
                <group>
                    <filter name="group_budget_id" string="Budget" context="{'group_by': 'budget_id'}"/>
                    <filter name="group_position_id" string="Budgetary Position" context="{'group_by': 'position_id'}"/>
                    <filter name="group_analytic_account_id" string="Analytic Account"
                            context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="group_budget_type" string="Type" context="{'group_by': 'budget_type'}"/>
                    <filter name="group_date_from" string="Start Date" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_account_budget_line_list" model="ir.ui.view">
        <field name="name">account.budget.line.list</field>
        <field name="model">account.budget.line</field>
        <field name="arch" type="xml">
            <list string="Budget Lines" create="0"
                  decoration-danger="is_over_budget"
                  decoration-success="budget_type == 'revenue' and is_above_budget">
                <field name="currency_id" column_invisible="1"/>
                <field name="budget_id"/>
                <field name="position_id"/>
                <field name="analytic_account_id"/>
                <field name="budget_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="planned_amount" sum="Planned Amount"/>
                <field name="theoretical_amount" sum="Theoretical Amount"/>
                <field name="practical_amount" sum="Actual Amount"/>
                <field name="achievement" widget="percentage"/>
                <field name="is_above_budget" column_invisible="1"/>
                <field name="is_over_budget" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_account_budget_line_form" model="ir.ui.view">
        <field name="name">account.budget.line.form</field>
        <field name="model">account.budget.line</field>
        <field name="arch" type="xml">
            <form string="Budget Line">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="budget_state" invisible="1"/>
                    <group>
                        <group>
                            <field name="budget_id" readonly="budget_state != 'draft'"/>
                            <field name="position_id" readonly="budget_state != 'draft'"/>
                            <field name="analytic_account_id" readonly="budget_state != 'draft'"/>
                            <field name="budget_type" readonly="budget_state != 'draft'"/>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <label for="date_from" string="Period"/>
                            <div>
                                <field name="date_from" class="oe_inline" readonly="budget_state != 'draft'"/>
                                -
                                <field name="date_to" class="oe_inline" readonly="budget_state != 'draft'"/>
                            </div>
                            <field name="distribution" readonly="budget_state != 'draft'"/>
                            <field name="planned_date" readonly="budget_state != 'draft'"
                                   invisible="distribution != 'at_date'" required="distribution == 'at_date'"/>
                        </group>
                        <group>
                            <field name="planned_amount" readonly="budget_state != 'draft'"/>
                            <field name="theoretical_amount"/>
                            <field name="practical_amount"/>
                            <field name="achievement" widget="percentage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_account_budget_line_pivot" model="ir.ui.view">
        <field name="name">account.budget.line.pivot</field>
        <field name="model">account.budget.line</field>
        <field name="arch" type="xml">
            <pivot string="Budget Lines">
                <field name="budget_type" type="row"/>
                <field name="budget_id" type="row"/>
                <field name="planned_amount" type="measure"/>
                <field name="practical_amount" string="Achieved" type="measure"/>
                <field name="achievement" type="measure" widget="percentage"/>
            </pivot>
        </field>
    </record>

    <record id="view_account_budget_line_graph" model="ir.ui.view">
        <field name="name">account.budget.line.graph</field>
        <field name="model">account.budget.line</field>
        <field name="arch" type="xml">
            <graph string="Budget Lines">
                <field name="budget_id" type="row"/>
                <field name="planned_amount" type="measure"/>
                <field name="theoretical_amount" type="measure"/>
                <field name="practical_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_account_budget_line_analysis" model="ir.actions.act_window">
        <field name="name">Budget Report</field>
        <field name="res_model">account.budget.line</field>
        <field name="view_mode">pivot,list,graph,form</field>
        <field name="view_id" ref="view_account_budget_line_pivot"/>
        <field name="search_view_id" ref="view_account_budget_line_search"/>
        <field name="context">{'search_default_filter_not_cancelled': True}</field>
    </record>

    <menuitem id="menu_account_budget_line_analysis"
              name="Budget Analysis"
              parent="account.account_reports_management_menu"
              action="action_account_budget_line_analysis"
              sequence="20"
              groups="account.group_account_readonly,account.group_account_manager"/>

    <record id="action_analytic_account_budget_lines" model="ir.actions.act_window">
        <field name="name">Budget Items</field>
        <field name="res_model">account.budget.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_analytic_account_id': [active_id], 'default_analytic_account_id': active_id}</field>
    </record>

</odoo>
