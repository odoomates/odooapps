<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_analytic_account_form_inherit_budget" model="ir.ui.view">
        <field name="name">account.analytic.account.form.inherit.budget</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Budget Items" groups="account.group_account_user,account.group_account_manager">
                    <field name="budget_line_ids" widget="one2many_list" colspan="4" nolabel="1"
                           mode="list">
                        <list string="Budget Items" editable="top">
                            <field name="budget_id"/>
                            <field name="position_id"/>
                            <field name="budget_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="distribution" optional="hide"/>
                            <field name="planned_date" optional="hide"/>
                            <field name="planned_amount" widget="monetary"/>
                            <field name="practical_amount" sum="Actual Amount" widget="monetary"/>
                            <field name="theoretical_amount" sum="Theoretical Amount" widget="monetary"/>
                            <field name="achievement" widget="percentage"/>
                        </list>
                        <form string="Budget Items">
                            <group>
                                <field name="budget_id"/>
                                <field name="position_id"/>
                                <field name="budget_type"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="distribution"/>
                                <field name="planned_date" invisible="distribution != 'at_date'"/>
                                <field name="planned_amount" widget="monetary"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>