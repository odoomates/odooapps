<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_budget_warning" model="ir.ui.view">
        <field name="name">account.move.form.budget.warning</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not budget_warning">
                    <field name="budget_warning" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
