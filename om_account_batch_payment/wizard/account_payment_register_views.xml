<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_register_form_batch" model="ir.ui.view">
        <field name="name">account.payment.register.form.batch</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <field name="group_payment" position="after">
                <field name="om_journal_type" invisible="1"/>
                <field name="om_create_batch" invisible="om_journal_type != 'bank'"/>
            </field>
        </field>
    </record>

</odoo>
