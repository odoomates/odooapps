<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="account_batch_payment_company_rule" model="ir.rule">
            <field name="name">Batch payments: multi-company</field>
            <field name="model_id" ref="model_account_batch_payment"/>
            <field eval="True" name="global"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="account_batch_payment_layout_company_rule" model="ir.rule">
            <field name="name">Bank file layouts: multi-company</field>
            <field name="model_id" ref="model_account_batch_payment_layout"/>
            <field eval="True" name="global"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
