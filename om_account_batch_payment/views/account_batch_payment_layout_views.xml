<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_batch_layout_list" model="ir.ui.view">
        <field name="name">account.batch.payment.layout.list</field>
        <field name="model">account.batch.payment.layout</field>
        <field name="arch" type="xml">
            <list string="Bank File Layouts">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="file_type"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_batch_layout_form" model="ir.ui.view">
        <field name="name">account.batch.payment.layout.form</field>
        <field name="model">account.batch.payment.layout</field>
        <field name="arch" type="xml">
            <form string="Bank File Layout">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Bulk upload of the main bank"/></h1>
                    </div>
                    <group>
                        <group string="File">
                            <field name="file_type"/>
                            <field name="delimiter" invisible="file_type != 'csv'"/>
                            <field name="quoting" invisible="file_type != 'csv'"/>
                            <field name="encoding" invisible="file_type != 'csv'"/>
                            <field name="include_header"/>
                        </group>
                        <group string="Values">
                            <field name="date_format"/>
                            <field name="amount_in_cents"/>
                            <field name="decimal_separator" invisible="amount_in_cents or file_type != 'csv'"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Columns" name="columns">
                            <p class="text-muted">
                                One line per column of the file, in the order of the template of your bank.
                            </p>
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="value"/>
                                    <field name="text" invisible="value != 'text'" required="value == 'text'"/>
                                    <field name="max_length" optional="show"/>
                                    <field name="uppercase" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Preview" name="preview">
                            <p class="text-muted">The file with one sample payment.</p>
                            <field name="preview" nolabel="1" class="font-monospace" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_batch_layout" model="ir.actions.act_window">
        <field name="name">Bank File Layouts</field>
        <field name="res_model">account.batch.payment.layout</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Describe the bulk upload file of your bank</p>
            <p>Set the columns in the order of the template of the bank, then choose the layout on the bank journal.</p>
        </field>
    </record>

    <menuitem id="menu_batch_layout" action="action_batch_layout"
              parent="account.account_invoicing_menu" sequence="26" groups="account.group_account_manager"/>

</odoo>
