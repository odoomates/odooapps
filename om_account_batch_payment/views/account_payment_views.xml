<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_list_batch" model="ir.ui.view">
        <field name="name">account.payment.list.batch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="batch_payment_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_payment_search_batch" model="ir.ui.view">
        <field name="name">account.payment.search.batch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="batch_payment_id"/>
            </field>
            <filter name="unmatched" position="after">
                <filter string="Not in a Batch" name="not_batched" domain="[('batch_payment_id', '=', False)]"/>
            </filter>
            <filter name="journal" position="after">
                <filter string="Batch" name="group_batch" domain="[]" context="{'group_by': 'batch_payment_id'}"/>
            </filter>
        </field>
    </record>

    <record id="view_account_payment_form_batch" model="ir.ui.view">
        <field name="name">account.payment.form.batch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="batch_payment_id" invisible="not batch_payment_id"/>
            </field>
        </field>
    </record>

</odoo>
