<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_batch_payment_out" model="ir.sequence">
            <field name="name">Batch Payments</field>
            <field name="code">account.batch.payment.out</field>
            <field name="prefix">BATCH/OUT/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_batch_payment_in" model="ir.sequence">
            <field name="name">Batch Deposits</field>
            <field name="code">account.batch.payment.in</field>
            <field name="prefix">BATCH/IN/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
