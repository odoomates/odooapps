#. module: om_sale_commission_subscription
#: model:ir.model.fields,help:om_sale_commission_subscription.field_om_commission_plan__subscription_base
msgid ""
"Invoiced Amount: the recurring lines of subscriptions count like any other "
"invoice or order line. Monthly Recurring Revenue: the MRR of the running "
"subscriptions, for each month of the period. New MRR: the MRR added in the "
"period by new subscriptions and upsells."
msgstr ""

#. module: om_sale_commission_subscription
#: model:ir.model.fields.selection,name:om_sale_commission_subscription.selection__om_commission_plan__subscription_base__mrr
msgid "Monthly Recurring Revenue"
msgstr ""

#. module: om_sale_commission_subscription
#: model_terms:ir.ui.view,arch_db:om_sale_commission_subscription.om_commission_plan_view_form_subscription
msgid ""
"Monthly Recurring Revenue pays on the MRR of the running subscriptions, for each month\n"
"                            of the period. New MRR pays on the MRR added by new subscriptions and upsells in the\n"
"                            period. These commissions have no product: use a rule on all products."
msgstr ""

#. module: om_sale_commission_subscription
#: model:ir.model.fields.selection,name:om_sale_commission_subscription.selection__om_commission_plan__subscription_base__new_mrr
