<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The accounting dashboards, next to the Invoicing dashboard of the Finance section. The files are built by
         tools/build_dashboards.py. -->

    <record id="dashboard_accounting_overview" model="spreadsheet.dashboard">
        <field name="name">Accounting Overview</field>
        <field name="data" type="base64" file="om_spreadsheet_account/data/files/accounting_overview_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.set([ref('account.group_account_readonly'), ref('account.group_account_manager')])]"/>
        <field name="sequence">30</field>
    </record>

    <record id="dashboard_profit_and_loss" model="spreadsheet.dashboard">
        <field name="name">Profit and Loss</field>
        <field name="data" type="base64" file="om_spreadsheet_account/data/files/profit_and_loss_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.set([ref('account.group_account_readonly'), ref('account.group_account_manager')])]"/>
        <field name="sequence">31</field>
    </record>

    <record id="dashboard_balance_sheet" model="spreadsheet.dashboard">
        <field name="name">Balance Sheet</field>
        <field name="data" type="base64" file="om_spreadsheet_account/data/files/balance_sheet_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.set([ref('account.group_account_readonly'), ref('account.group_account_manager')])]"/>
        <field name="sequence">32</field>
    </record>

    <record id="dashboard_receivables_payables" model="spreadsheet.dashboard">
        <field name="name">Receivables and Payables</field>
        <field name="data" type="base64" file="om_spreadsheet_account/data/files/receivables_payables_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.set([ref('account.group_account_readonly'), ref('account.group_account_invoice')])]"/>
        <field name="sequence">33</field>
    </record>

    <record id="dashboard_bank_cash" model="spreadsheet.dashboard">
        <field name="name">Bank and Cash</field>
        <field name="data" type="base64" file="om_spreadsheet_account/data/files/bank_cash_dashboard.json"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_finance"/>
        <field name="group_ids" eval="[Command.set([ref('account.group_account_readonly'), ref('account.group_account_manager')])]"/>
        <field name="sequence">34</field>
    </record>

</odoo>
