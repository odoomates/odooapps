#. module: om_whatsapp_website_sale
#: model:om.whatsapp.template,body:om_whatsapp_website_sale.om_whatsapp_template_online_order
msgid ""
"Hello {{ object.partner_id.name }}, thank you for shopping at {{ object.website_id.name }}! Your order *{{ object.name }}* of *{{ format_amount(object.amount_total, object.currency_id) }}* is confirmed. Follow it online: {{ object.om_whatsapp_portal_link() }}\n"
"We will let you know when it ships."
msgstr ""

#. module: om_whatsapp_website_sale
#: model:om.whatsapp.template,body:om_whatsapp_website_sale.om_whatsapp_template_abandoned_cart
msgid ""
"Hello {{ object.partner_id.name }}, you left some items in your cart at {{ object.website_id.name }}: {{ object.om_whatsapp_cart_products() }}. Your cart is waiting for you: {{ object.om_whatsapp_cart_link() }}\n"
"Reply here if you need any help."
msgstr ""

