<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_whatsapp_website_sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='order_confirmation_setting']/div[hasclass('content-group')]" position="inside">
                <div class="row mt8">
                    <label string="WhatsApp" for="om_whatsapp_website_order_template_id" class="o_light_label col-lg-3"/>
                    <field name="om_whatsapp_website_order_template_id" options="{'no_create': True}"
                           placeholder="The order confirmation of Sales"/>
                </div>
            </xpath>
            <xpath expr="//div[@id='abandoned_cart_templates']/div[hasclass('content-group')]" position="inside">
                <div class="row mt8">
                    <label string="WhatsApp" for="om_whatsapp_cart_template_id" class="o_light_label col-lg-3"/>
                    <field name="om_whatsapp_cart_template_id" options="{'no_create': True}"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
