<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.om.ai.whatsapp</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='tracking']" position="after">
                <field name="om_ai_whatsapp_shipping_sent" invisible="not om_ai_whatsapp_shipping_sent"/>
            </xpath>
        </field>
    </record>
</odoo>
