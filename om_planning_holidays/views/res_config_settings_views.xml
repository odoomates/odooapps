<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_planning_holidays</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="om_planning.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="planning_rules" position="after">
                <block title="Time Off" name="planning_time_off">
                    <setting id="planning_time_off_policy" string="Approved Time Off"
                        help="What happens to the planned slots of an employee when their time off is approved">
                        <field name="planning_time_off_policy" widget="radio"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
