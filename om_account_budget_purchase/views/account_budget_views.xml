<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_budget_form_committed" model="ir.ui.view">
        <field name="name">account.budget.form.committed</field>
        <field name="model">account.budget</field>
        <field name="inherit_id" ref="om_account_budget.view_account_budget_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='practical_amount']" position="after">
                <field name="committed_amount" string="Committed" optional="show"
                       column_invisible="parent.state == 'draft'"/>
            </xpath>
        </field>
    </record>

</odoo>
