<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.credit.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_use_credit_limit']" position="after">
                <div class="content-group mt-2" name="credit_limit_block" invisible="not account_use_credit_limit">
                    <field name="credit_limit_block"/>
                    <label for="credit_limit_block" class="o_light_label"
                           string="Refuse to post an invoice going over the limit"/>
                    <div class="text-muted">
                        The accounting managers can still post it: the override is logged on the invoice.
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
