<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_helpdesk_team_form_inherit_fs" model="ir.ui.view">
        <field name="name">om.helpdesk.team.form.inherit.field.service</field>
        <field name="model">om.helpdesk.team</field>
        <field name="inherit_id" ref="om_helpdesk.view_helpdesk_team_form"/>
        <field name="arch" type="xml">
            <group name="settings_main" position="after">
                <group name="field_service">
                    <group string="Field Service" name="fs_jobs">
                        <field name="use_field_service"/>
                        <field name="fs_project_id" invisible="not use_field_service" options="{'no_create': True}"/>
                        <field name="fs_job_type_id" invisible="not use_field_service" options="{'no_create': True}"/>
                        <field name="fs_auto_create" invisible="not use_field_service"/>
                    </group>
                    <group string="When the Job Is Done" name="fs_done" invisible="not use_field_service">
                        <field name="fs_done_message" widget="radio" string="Ticket"/>
                        <field name="fs_close_ticket"/>
                    </group>
                </group>
            </group>
        </field>
    </record>

</odoo>
