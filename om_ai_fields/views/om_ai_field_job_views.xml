<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_ai_field_job_view_list" model="ir.ui.view">
        <field name="name">om.ai.field.job.list</field>
        <field name="model">om.ai.field.job</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'failed'" decoration-muted="state == 'done'">
                <field name="create_date" string="Queued On"/>
                <field name="action_id"/>
                <field name="res_model"/>
                <field name="record_name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-info="state == 'pending'"
                       decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="error" optional="show"/>
                <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="om_ai_field_job_view_form" model="ir.ui.view">
        <field name="name">om.ai.field.job.form</field>
        <field name="model">om.ai.field.job</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
                    <button name="action_open_record" type="object" string="Open Record"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="action_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="create_date" string="Queued On"/>
                            <field name="date_done"/>
                        </group>
                    </group>
                    <field name="error" invisible="not error"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="om_ai_field_job_view_search" model="ir.ui.view">
        <field name="name">om.ai.field.job.search</field>
        <field name="model">om.ai.field.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="action_id"/>
                <field name="res_model"/>
                <field name="user_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <record id="om_ai_field_job_action" model="ir.actions.act_window">
        <field name="name">AI Field Queue</field>
        <field name="res_model">om.ai.field.job</field>
        <field name="path">ai-field-queue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
