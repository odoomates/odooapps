<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_om_ai_field_jobs" model="ir.cron">
        <field name="name">AI Fields: fill queued records</field>
        <field name="model_id" ref="model_om_ai_field_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_om_ai_field_empty" model="ir.cron">
        <field name="name">AI Fields: fill empty values</field>
        <field name="model_id" ref="model_om_ai_field"/>
        <field name="state">code</field>
        <field name="code">model._cron_fill_empty()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
