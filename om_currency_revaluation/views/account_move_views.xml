<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_filter" model="ir.ui.view">
        <field name="name">account.move.select.inherit.currency.revaluation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Currency Revaluation" name="currency_revaluation"
                        domain="[('currency_reval_date', '!=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.currency.revaluation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab_entry']//field[@name='auto_post_until']" position="after">
                <field name="currency_reval_date" invisible="not currency_reval_date"/>
            </xpath>
        </field>
    </record>

</odoo>
