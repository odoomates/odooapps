<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cash_forecast_report_form" model="ir.ui.view">
        <field name="name">account.cash.forecast.report.form</field>
        <field name="model">account.cash.forecast.report</field>
        <field name="arch" type="xml">
            <form string="Cash Forecast">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="period_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="period_count"/>
                    </group>
                    <group>
                        <field name="overdue" widget="radio"/>
                        <field name="include_drafts"/>
                        <field name="display_partners"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print" type="object" class="btn-primary" data-hotkey="q"/>
                    <field name="excel_report_available" invisible="1"/>
                    <button name="action_print_excel" string="Print Excel" type="object" class="btn-primary"
                            invisible="not excel_report_available"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cash_forecast_report" model="ir.actions.act_window">
        <field name="name">Cash Forecast</field>
        <field name="res_model">account.cash.forecast.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cash_forecast_report"
              name="Cash Forecast"
              sequence="30"
              parent="account.account_reports_management_menu"
              action="action_cash_forecast_report"
              groups="account.group_account_readonly,account.group_account_invoice"/>

</odoo>
