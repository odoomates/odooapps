<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_meta_send_queue" model="ir.cron">
        <field name="name">WhatsApp: send the queue of Meta</field>
        <field name="model_id" ref="om_whatsapp_base.model_om_whatsapp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_meta_send_queue()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_meta_sync_templates" model="ir.cron">
        <field name="name">WhatsApp: sync the templates of Meta</field>
        <field name="model_id" ref="om_whatsapp_base.model_om_whatsapp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_meta_sync_templates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
