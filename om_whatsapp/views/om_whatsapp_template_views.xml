<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_whatsapp_template_view_form_inherit_meta" model="ir.ui.view">
        <field name="name">om.whatsapp.template.form.inherit.meta</field>
        <field name="model">om.whatsapp.template</field>
        <field name="inherit_id" ref="om_whatsapp_base.om_whatsapp_template_view_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="is_meta" invisible="1"/>
                <button name="action_meta_submit" type="object" string="Submit to Meta" class="btn-primary"
                        invisible="not is_meta or meta_status not in ('draft', 'REJECTED')"
                        groups="om_whatsapp_base.group_om_whatsapp_manager"/>
                <button name="action_meta_sync" type="object" string="Check Status"
                        invisible="not is_meta or meta_status == 'draft'"/>
                <field name="meta_status" widget="statusbar" statusbar_visible="draft,PENDING,APPROVED" invisible="not is_meta"/>
            </header>
            
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="alert alert-warning" role="alert" invisible="not is_meta or not meta_reason">
                    <field name="meta_reason"/>
                </div>
            </xpath>
            <page name="body" position="after">
                <page string="Meta" name="meta" invisible="not is_meta">
                    <group>
                        <group>
                            <field name="meta_name"/>
                            <field name="meta_category"/>
                            <field name="meta_language"/>
                            <field name="meta_footer"/>
                        </group>
                        <group>
                            <field name="meta_template_id"/>
                            <field name="meta_waba_id"/>
                        </group>
                    </group>
                    <label for="meta_body"/>
                    <field name="meta_body" readonly="1"/>
                    <div class="text-muted mb-3">The fields of the text become {{1}}, {{2}}... for Meta, which reviews the
                        text with the samples below, also shown in the preview of the Message tab. The report, when set,
                        is the PDF at the top of the message. Changing the field behind a number keeps the approval.</div>
                    <field name="variable_ids">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="sequence" readonly="1"/>
                            <field name="expression" readonly="1"/>
                            <field name="sample"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <record id="om_whatsapp_template_view_list_inherit_meta" model="ir.ui.view">
        <field name="name">om.whatsapp.template.list.inherit.meta</field>
        <field name="model">om.whatsapp.template</field>
        <field name="inherit_id" ref="om_whatsapp_base.om_whatsapp_template_view_list"/>
        <field name="arch" type="xml">
            <field name="account_id" position="after">
                <field name="meta_status" optional="show" widget="badge" decoration-success="meta_status == 'APPROVED'"
                       decoration-warning="meta_status == 'PENDING'" decoration-danger="meta_status in ('REJECTED', 'DISABLED')"/>
            </field>
        </field>
    </record>
</odoo>
