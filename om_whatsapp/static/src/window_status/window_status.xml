<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="om_whatsapp.WindowStatus" owl="1">
        <t t-set="windowStatus" t-value="status"/>
        <span class="o-om-whatsapp-WindowStatus d-inline-flex align-items-center gap-1 text-nowrap small ms-2 flex-shrink-0"
              t-att-class="{ 'text-success': windowStatus.level === 'open', 'text-warning': windowStatus.level === 'ending', 'text-danger': windowStatus.level === 'closed' }"
              t-att-title="windowStatus.title">
            <i class="fa" t-att-class="windowStatus.level === 'closed' ? 'fa-ban' : 'fa-clock-o'"/>
            <t t-esc="windowStatus.text"/>
        </span>
    </t>

    <t t-inherit="mail.ThreadViewTopbar" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='!threadViewTopbar.isEditingThreadName']" position="after">
            <t t-set="omWhatsappMeta" t-value="threadViewTopbar.thread.channel and threadViewTopbar.thread.channel.channel_type === 'om_whatsapp' and threadViewTopbar.thread.channel.om_whatsapp_provider === 'meta' and threadViewTopbar.thread.channel"/>
            <OmWhatsappWindowStatus t-if="omWhatsappMeta" channel="omWhatsappMeta"/>
        </xpath>
    </t>

    <t t-inherit="mail.ChatWindowHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_ChatWindowHeader_name')]" position="after">
            <t t-set="omWhatsappMeta" t-value="chatWindow.thread and chatWindow.thread.channel and chatWindow.thread.channel.channel_type === 'om_whatsapp' and chatWindow.thread.channel.om_whatsapp_provider === 'meta' and chatWindow.thread.channel"/>
            <OmWhatsappWindowStatus t-if="omWhatsappMeta" channel="omWhatsappMeta" compact="true"/>
        </xpath>
    </t>
</templates>
