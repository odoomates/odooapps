<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_subscription" model="ir.ui.view">
        <field name="name">account.move.form.subscription</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/div[@name='due_date']" position="after">
                <field name="subscription_id" invisible="not subscription_id"/>
                <label for="subscription_period_start" string="Subscription Period" invisible="not subscription_period_start"/>
                <div class="d-flex gap-2" invisible="not subscription_period_start">
                    <field name="subscription_period_start" class="oe_inline"/>
                    <span>to</span>
                    <field name="subscription_period_end" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
