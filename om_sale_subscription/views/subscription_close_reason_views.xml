<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="subscription_close_reason_view_list" model="ir.ui.view">
        <field name="name">om.subscription.close.reason.list</field>
        <field name="model">om.subscription.close.reason</field>
        <field name="arch" type="xml">
            <list string="Close Reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="visible_in_portal"/>
            </list>
        </field>
    </record>

    <record id="action_subscription_close_reason" model="ir.actions.act_window">
        <field name="name">Close Reasons</field>
        <field name="res_model">om.subscription.close.reason</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
