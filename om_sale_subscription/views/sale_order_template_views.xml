<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_template_view_form_subscription" model="ir.ui.view">
        <field name="name">sale.order.template.form.subscription</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='template_type']" position="after">
                <field name="subscription_plan_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_template_view_list_subscription" model="ir.ui.view">
        <field name="name">sale.order.template.list.subscription</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="subscription_plan_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="action_subscription_templates" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">sale.order.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('subscription_plan_id', '!=', False)]</field>
        <field name="context">{'subscription_default_plan': True}</field>
    </record>

</odoo>
