<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="close_reason_price" model="om.subscription.close.reason">
            <field name="name">Too expensive</field>
            <field name="sequence">10</field>
        </record>
        <record id="close_reason_features" model="om.subscription.close.reason">
            <field name="name">Missing features</field>
            <field name="sequence">20</field>
        </record>
        <record id="close_reason_competitor" model="om.subscription.close.reason">
            <field name="name">Moved to another provider</field>
            <field name="sequence">30</field>
        </record>
        <record id="close_reason_not_needed" model="om.subscription.close.reason">
            <field name="name">No longer needed</field>
            <field name="sequence">40</field>
        </record>
        <record id="close_reason_quality" model="om.subscription.close.reason">
            <field name="name">Not satisfied with the service</field>
            <field name="sequence">50</field>
        </record>
        <record id="close_reason_unpaid" model="om.subscription.close.reason">
            <field name="name">Unpaid invoices</field>
            <field name="sequence">80</field>
            <field name="visible_in_portal" eval="False"/>
        </record>
        <record id="close_reason_end_of_term" model="om.subscription.close.reason">
            <field name="name">End of term</field>
            <field name="sequence">90</field>
            <field name="visible_in_portal" eval="False"/>
        </record>

        <record id="plan_monthly" model="om.subscription.plan">
            <field name="name">Monthly</field>
            <field name="sequence">10</field>
            <field name="billing_period_value">1</field>
            <field name="billing_period_unit">month</field>
            <field name="user_closable" eval="True"/>
        </record>
        <record id="plan_yearly" model="om.subscription.plan">
            <field name="name">Yearly</field>
            <field name="sequence">30</field>
            <field name="billing_period_value">1</field>
            <field name="billing_period_unit">year</field>
            <field name="duration_value">1</field>
            <field name="duration_unit">year</field>
            <field name="end_behaviour">quotation</field>
            <field name="renewal_notice_days">30</field>
        </record>

    </data>
</odoo>
