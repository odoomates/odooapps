<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="subscription_close_wizard_view_form" model="ir.ui.view">
        <field name="name">om.subscription.close.wizard.form</field>
        <field name="model">om.subscription.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Subscription">
                <field name="order_ids" invisible="1"/>
                <group>
                    <field name="close_reason_id" options="{'no_create': True}"/>
                    <field name="note" placeholder="Details for the history of the subscription"/>
                    <field name="send_mail"/>
                </group>
                <footer>
                    <button string="Close Subscription" name="action_close" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
