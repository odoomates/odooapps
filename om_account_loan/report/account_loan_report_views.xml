<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_loan_report_form" model="ir.ui.view">
        <field name="name">account.loan.report.form</field>
        <field name="model">account.loan.report</field>
        <field name="arch" type="xml">
            <form string="Loan Report">
                <group>
                    <group>
                        <field name="date"/>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="loan_ids" widget="many2many_tags" options="{'no_create': True}"
                               placeholder="Every loan"/>
                    </group>
                </group>
                <div class="text-muted">
                    Per loan at the date: the outstanding principal, the interest accrued since the last due date,
                    the next instalment, and the principal due within 12 months and after.
                </div>
                <footer>
                    <button name="action_view" type="object" string="View" class="btn-primary"/>
                    <button name="action_print" type="object" string="Print PDF" class="btn-secondary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_loan_report" model="ir.actions.act_window">
        <field name="name">Loan Report</field>
        <field name="res_model">account.loan.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_account_loan_report_line_list" model="ir.ui.view">
        <field name="name">account.loan.report.line.list</field>
        <field name="model">account.loan.report.line</field>
        <field name="arch" type="xml">
            <list string="Loan Report" create="0" edit="0" delete="0">
                <field name="currency_id" column_invisible="True"/>
                <field name="company_currency_id" column_invisible="True"/>
                <field name="loan_id"/>
                <field name="partner_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="rate" optional="show"/>
                <field name="principal" optional="hide"/>
                <field name="outstanding"/>
                <field name="accrued_interest"/>
                <field name="next_date"/>
                <field name="next_amount"/>
                <field name="due_within"/>
                <field name="due_after"/>
                <field name="outstanding_company" sum="Total" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_account_loan_report_line_pivot" model="ir.ui.view">
        <field name="name">account.loan.report.line.pivot</field>
        <field name="model">account.loan.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Loan Report" sample="1">
                <field name="partner_id" type="row"/>
                <field name="currency_id" type="col"/>
                <field name="outstanding" type="measure"/>
                <field name="accrued_interest" type="measure"/>
                <field name="due_within" type="measure"/>
                <field name="due_after" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_account_loan_report_line_search" model="ir.ui.view">
        <field name="name">account.loan.report.line.search</field>
        <field name="model">account.loan.report.line</field>
        <field name="arch" type="xml">
            <search string="Loan Report">
                <field name="loan_id"/>
                <field name="partner_id"/>
                <group>
                    <filter name="group_partner" string="Lender" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
