<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_loan_pay_form" model="ir.ui.view">
        <field name="name">account.loan.pay.form</field>
        <field name="model">account.loan.pay</field>
        <field name="arch" type="xml">
            <form string="Pay Instalment">
                <group>
                    <group>
                        <field name="line_id" readonly="1" invisible="1"/>
                        <field name="loan_id"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="date"/>
                        <field name="journal_id"/>
                    </group>
                    <group>
                        <field name="principal"/>
                        <field name="interest"/>
                        <field name="amount"/>
                        <field name="withholding_tax_id" invisible="1"/>
                        <field name="withholding" invisible="not withholding_tax_id"/>
                        <field name="net_amount" invisible="not withholding_tax_id"/>
                    </group>
                </group>
                <div class="text-muted">
                    A principal changed here moves the difference to the last instalment.
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Pay" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
