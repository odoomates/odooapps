<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_loan_import_form" model="ir.ui.view">
        <field name="name">account.loan.import.form</field>
        <field name="model">account.loan.import</field>
        <field name="arch" type="xml">
            <form string="Import Schedule">
                <group>
                    <group>
                        <field name="loan_id" readonly="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="principal_to_import"/>
                    </group>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="columns" widget="radio"/>
                    </group>
                </group>
                <div class="text-muted">
                    A CSV or XLSX file with one row per instalment: the due date (2025-02-01 or 01/02/2025), then
                    the principal and the interest, or the instalment and the interest. A first row of titles is
                    skipped. The due dates must increase and the principal add up to the principal to schedule;
                    the unpaid lines of the loan are replaced.
                </div>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
