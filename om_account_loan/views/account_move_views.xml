<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.om_account_loan</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="tax_cash_basis_origin_move_id" position="before">
                <field name="loan_id" invisible="not loan_id"
                       groups="account.group_account_readonly,account.group_account_manager"/>
                <field name="loan_entry_type" invisible="not loan_id"
                       groups="account.group_account_readonly,account.group_account_manager"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_filter" model="ir.ui.view">
        <field name="name">account.move.search.inherit.om_account_loan</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <filter name="misc_filter" position="after">
                <filter string="Loans" name="loan_filter" domain="[('loan_id', '!=', False)]"
                        groups="account.group_account_readonly,account.group_account_manager"/>
            </filter>
        </field>
    </record>

</odoo>
