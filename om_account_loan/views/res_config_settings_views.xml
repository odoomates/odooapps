<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_account_loan</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="account_digitalization" position="after">
                <block title="Loans" id="loan_settings">
                    <setting id="loan_accounts" string="Loan accounts" company_dependent="1"
                             help="The accounts proposed on the new loans.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="loan_long_term_account_id" string="Long-term" class="col-lg-4 o_light_label"/>
                                <field name="loan_long_term_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="loan_short_term_account_id" string="Short-term" class="col-lg-4 o_light_label"/>
                                <field name="loan_short_term_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="loan_interest_account_id" string="Interest" class="col-lg-4 o_light_label"/>
                                <field name="loan_interest_account_id"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="loan_journals" string="Loan journals" company_dependent="1"
                             help="The journals proposed on the new loans: the reclassifications and the initial recognition of the leases go to the loan journal, the drawdowns and payments to the bank journal.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="loan_journal_id" string="Loans / Leases" class="col-lg-4 o_light_label"/>
                                <field name="loan_journal_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="loan_bank_journal_id" string="Bank" class="col-lg-4 o_light_label"/>
                                <field name="loan_bank_journal_id"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="loan_auto_reclassify" company_dependent="1"
                             help="At the beginning of each month, the running loans and leases are reclassified at the end of the month before: the principal due within 12 months goes to the short-term accounts. A loan that cannot be reclassified (a locked period, a lease bill in draft) says why in its chatter.">
                        <field name="loan_auto_reclassify"/>
                    </setting>
                    <setting id="lease_accounts" string="Lease accounts" company_dependent="1"
                             help="The accounts and the journal proposed on the new leases; the lease liability accounts default to the loan accounts.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="lease_long_term_account_id" string="Long-term" class="col-lg-4 o_light_label"/>
                                <field name="lease_long_term_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="lease_short_term_account_id" string="Short-term" class="col-lg-4 o_light_label"/>
                                <field name="lease_short_term_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="lease_rou_account_id" string="Right of use" class="col-lg-4 o_light_label"/>
                                <field name="lease_rou_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="lease_bill_journal_id" string="Bills" class="col-lg-4 o_light_label"/>
                                <field name="lease_bill_journal_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
