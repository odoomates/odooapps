<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_loan_form" model="ir.ui.view">
        <field name="name">account.loan.form</field>
        <field name="model">account.loan</field>
        <field name="arch" type="xml">
            <form string="Loan">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'" groups="account.group_account_manager"/>
                    <button name="action_drawdown" type="object" string="Draw Down" class="btn-primary"
                            invisible="state != 'running' or undrawn_amount &lt;= 0"
                            groups="account.group_account_manager"/>
                    <button name="action_repay" type="object" string="Early Repayment"
                            invisible="state != 'running' or outstanding_amount &lt;= 0"
                            groups="account.group_account_manager"/>
                    <button name="action_compute_schedule" type="object" string="Compute Schedule"
                            invisible="state not in ('draft', 'running')" groups="account.group_account_manager"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'running') or move_count"
                            groups="account.group_account_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'" groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_moves" type="object" class="oe_stat_button" icon="menu"
                                invisible="not move_count">
                            <field name="move_count" widget="statinfo" string="Entries"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-success" invisible="state != 'closed'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group name="loan">
                            <field name="partner_id" readonly="state not in ('draft', 'running')"/>
                            <field name="lender_ref" readonly="state not in ('draft', 'running')"/>
                            <field name="principal" readonly="state != 'draft'"/>
                            <field name="currency_id" groups="base.group_multi_currency" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="schedule_method" readonly="state != 'draft'"/>
                            <field name="interest_method" readonly="state != 'draft'"/>
                        </group>
                        <group name="terms">
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="payment_frequency" readonly="state != 'draft'"/>
                            <field name="date_first_payment" readonly="state != 'draft'"/>
                            <field name="payment_count" readonly="state not in ('draft', 'running')"/>
                            <field name="rate_type" readonly="state not in ('draft', 'running')"/>
                            <field name="rate" readonly="state not in ('draft', 'running')"
                                   string="Annual Rate (%)" invisible="rate_type == 'floating'"/>
                            <field name="rate" readonly="state not in ('draft', 'running')"
                                   string="Initial Rate (%)" invisible="rate_type != 'floating'"/>
                            <field name="current_rate" invisible="rate_type != 'floating'"/>
                        </group>
                        <group name="position" invisible="state == 'draft'">
                            <field name="drawn_amount"/>
                            <field name="undrawn_amount"/>
                            <field name="outstanding_amount"/>
                        </group>
                        <group name="next" invisible="state == 'draft'">
                            <field name="next_date" invisible="not next_date or state != 'running'"/>
                            <field name="next_amount" invisible="not next_date or state != 'running'"/>
                            <field name="date_end" invisible="not date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule" name="schedule">
                            <field name="line_ids" readonly="state not in ('draft', 'running')">
                                <list editable="bottom" create="0" delete="0" decoration-muted="state == 'posted'">
                                    <field name="loan_state" column_invisible="True"/>
                                    <field name="is_last_paid" column_invisible="True"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="sequence" readonly="1"/>
                                    <field name="date" readonly="state == 'posted'"/>
                                    <field name="opening_balance" readonly="1"/>
                                    <field name="principal" sum="Total" readonly="state == 'posted'"/>
                                    <field name="interest" sum="Total" readonly="state == 'posted'"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="closing_balance"/>
                                    <field name="rate" optional="hide" readonly="1"/>
                                    <field name="payment_date" optional="show"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'"
                                           decoration-info="state == 'draft'"/>
                                    <button name="action_pay" type="object" string="Pay" class="btn-link"
                                            icon="payments" invisible="state == 'posted' or loan_state != 'running'"
                                            groups="account.group_account_manager"/>
                                    <button name="action_open_move" type="object" title="Journal Entry"
                                            icon="open_in_new" invisible="not move_id"/>
                                    <button name="action_cancel_payment" type="object" title="Cancel the payment"
                                            icon="undo" invisible="not is_last_paid"
                                            groups="account.group_account_manager"
                                            confirm="The payment entry is reversed and the instalment is to pay again."/>
                                    <field name="move_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Drawdowns &amp; Repayments" name="operations" invisible="state == 'draft'">
                            <field name="operation_ids" readonly="1">
                                <list create="0" delete="0" decoration-muted="state == 'cancel'">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="date"/>
                                    <field name="operation_type"/>
                                    <field name="journal_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="interest" sum="Total" optional="show"/>
                                    <field name="after_repayment" optional="show"/>
                                    <field name="move_id"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                                    <button name="action_cancel" type="object" title="Cancel" icon="undo"
                                            invisible="state != 'posted'" groups="account.group_account_manager"
                                            confirm="The entry is reversed and the schedule computed again."/>
                                </list>
                            </field>
                        </page>
                        <page string="Rate Changes" name="rates" invisible="rate_type != 'floating'">
                            <field name="rate_line_ids" readonly="state not in ('draft', 'running')">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                The unpaid instalments due from the date of a change are computed again.
                            </div>
                        </page>
                        <page string="Accounting" name="accounting">
                            <group>
                                <group string="Accounts">
                                    <field name="account_long_term_id" readonly="state not in ('draft', 'running')"/>
                                    <field name="account_short_term_id" readonly="state not in ('draft', 'running')"/>
                                    <field name="account_interest_id" readonly="state not in ('draft', 'running')"/>
                                </group>
                                <group string="Journals">
                                    <field name="journal_id" readonly="state not in ('draft', 'running')"/>
                                    <field name="bank_journal_id" readonly="state not in ('draft', 'running')"/>
                                    <field name="bank_posting" readonly="state not in ('draft', 'running')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Covenants, guarantees, contacts at the lender..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_loan_list" model="ir.ui.view">
        <field name="name">account.loan.list</field>
        <field name="model">account.loan</field>
        <field name="arch" type="xml">
            <list string="Loans" decoration-muted="state in ('closed', 'cancel')" decoration-info="state == 'draft'">
                <field name="currency_id" column_invisible="True"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lender_ref" optional="show"/>
                <field name="date_start"/>
                <field name="date_end" optional="show"/>
                <field name="rate" optional="show"/>
                <field name="principal" sum="Total"/>
                <field name="outstanding_amount" sum="Total"/>
                <field name="next_date" optional="show"/>
                <field name="next_amount" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'running'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_account_loan_search" model="ir.ui.view">
        <field name="name">account.loan.search</field>
        <field name="model">account.loan</field>
        <field name="arch" type="xml">
            <search string="Loans">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="lender_ref"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="floating" string="Floating Rate" domain="[('rate_type', '=', 'floating')]"/>
                <group>
                    <filter name="group_partner" string="Lender" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_loan" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">account.loan</field>
        <field name="path">loans</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_account_loan_search"/>
        <field name="context">{'search_default_running': 1, 'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a loan</p>
            <p>Enter the lender, the principal, the rate and the instalments: the schedule is computed when the loan
                is confirmed. Then draw it down, pay the instalments from the schedule and reclassify the current
                part at each period end.</p>
        </field>
    </record>

    <record id="view_account_loan_line_list" model="ir.ui.view">
        <field name="name">account.loan.line.list</field>
        <field name="model">account.loan.line</field>
        <field name="arch" type="xml">
            <list string="Instalments" create="0" edit="0" delete="0">
                <field name="currency_id" column_invisible="True"/>
                <field name="loan_id"/>
                <field name="partner_id"/>
                <field name="sequence"/>
                <field name="date"/>
                <field name="principal" sum="Total"/>
                <field name="interest" sum="Total"/>
                <field name="amount" sum="Total"/>
                <field name="closing_balance"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'"
                       decoration-info="state == 'draft'"/>
                <field name="loan_state" column_invisible="True"/>
                <button name="action_pay" type="object" string="Pay" class="btn-link" icon="payments"
                        invisible="state == 'posted' or loan_state != 'running'"
                        groups="account.group_account_manager"/>
            </list>
        </field>
    </record>

    <record id="view_account_loan_line_search" model="ir.ui.view">
        <field name="name">account.loan.line.search</field>
        <field name="model">account.loan.line</field>
        <field name="arch" type="xml">
            <search string="Instalments">
                <field name="loan_id"/>
                <field name="partner_id"/>
                <filter name="to_pay" string="To Pay" domain="[('state', '=', 'draft'), ('loan_state', '=', 'running')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'posted')]"/>
                <separator/>
                <filter name="filter_date" string="Due Date" date="date"/>
                <group>
                    <filter name="group_loan" string="Loan" context="{'group_by': 'loan_id'}"/>
                    <filter name="group_date" string="Due Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_loan_line" model="ir.actions.act_window">
        <field name="name">Instalments</field>
        <field name="res_model">account.loan.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_account_loan_line_search"/>
        <field name="context">{'search_default_to_pay': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No instalment to pay</p>
            <p>The instalments of the running loans show here, to pay them in their order.</p>
        </field>
    </record>

</odoo>
