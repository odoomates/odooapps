<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- the XML id of the 15.0 module: the views inheriting it keep working -->
    <record id="journal_dashboard_view_inherit" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.inherit.statement.import</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <!-- the card of the bank journals of Odoo 15: the button under the graph and the New menu -->
            <xpath expr="//span[@name='button_import_placeholder']" position="inside">
                <span> or <a type="object" name="action_import_statement">Import</a></span>
            </xpath>
            <xpath expr="//div[@name='bank_cash_commands']" position="inside">
                <a t-if="journal_type == 'bank' || journal_type == 'cash'" role="menuitem" type="object"
                   name="action_import_statement">Import Statement</a>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.statement.import</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="statement_import_map_id"
                       options="{'no_create_edit': True}" attrs="{'invisible': [('type', 'not in', ['bank', 'cash'])]}"/>
            </field>
        </field>
    </record>

</odoo>
