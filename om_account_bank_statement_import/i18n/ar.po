#. odoo-python
#: code:addons/om_account_bank_statement_import/wizard/account_statement_import.py:0
msgid "A statement is imported in a bank or cash journal, not in %s."
msgstr "يتم استيراد كشف الحساب في دفتر يومية بنكي أو نقدي، وليس في %s."

