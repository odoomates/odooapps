<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_om_bill_ocr_profile_list" model="ir.ui.view">
        <field name="name">om.bill.ocr.profile.list</field>
        <field name="model">om.bill.ocr.profile</field>
        <field name="arch" type="xml">
            <list string="Vendor Bill Recognition">
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="tax_ids" widget="many2many_tags"/>
                <field name="line_mode"/>
                <field name="bill_count"/>
                <field name="last_learned"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_om_bill_ocr_profile_form" model="ir.ui.view">
        <field name="name">om.bill.ocr.profile.form</field>
        <field name="model">om.bill.ocr.profile</field>
        <field name="arch" type="xml">
            <form string="Vendor Bill Recognition">
                <sheet>
                    <div class="oe_title">
                        <label for="partner_id"/>
                        <h1><field name="partner_id"/></h1>
                    </div>
                    <group>
                        <group string="Booking">
                            <field name="account_id"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="product_id"/>
                            <field name="line_mode"/>
                        </group>
                        <group string="Reading">
                            <field name="date_order" placeholder="The date format of the language"/>
                            <field name="anchor_ref"/>
                            <field name="anchor_invoice_date"/>
                            <field name="anchor_invoice_date_due"/>
                            <field name="anchor_amount_total"/>
                        </group>
                        <group>
                            <field name="bill_count"/>
                            <field name="last_learned"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Recognized By"/>
                    <field name="match_keys" nolabel="1" placeholder="Tax numbers, bank accounts, email domains, letterhead lines: one per line"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_om_bill_ocr_profile_search" model="ir.ui.view">
        <field name="name">om.bill.ocr.profile.search</field>
        <field name="model">om.bill.ocr.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="account_id"/>
            </search>
        </field>
    </record>

    <record id="action_om_bill_ocr_profile" model="ir.actions.act_window">
        <field name="name">Vendor Bill Recognition</field>
        <field name="res_model">om.bill.ocr.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing learned yet</p>
            <p>Upload a vendor bill and post it: what it taught about its vendor shows here, and is used to read
                the vendor's next bills.</p>
        </field>
    </record>

    <menuitem id="menu_om_bill_ocr_profile"
              action="action_om_bill_ocr_profile"
              parent="account.account_invoicing_menu"
              groups="account.group_account_manager"
              sequence="90"/>

</odoo>
