#. module: om_access_manager_pos_hr
#: model:ir.model,name:om_access_manager_pos_hr.model_om_access_profile
msgid "Access Profile"
msgstr "访问配置文件"

#. module: om_access_manager_pos_hr
#: model:ir.module.module,description:base.module_om_access_manager_pos_hr
msgid ""
"Completely free. Lists POS employees on an access profile: when one of them "
"logs in to the shop, the Point of Sale restrictions of the profile apply to "
"them."
msgstr "完全免费。在访问配置文件中列出 POS 员工：当其中一人登录店铺时，配置文件的销售点限制即对其适用。"

#. module: om_access_manager_pos_hr
#: model:ir.model.fields,field_description:om_access_manager_pos_hr.field_om_access_profile__display_name
#: model:ir.model.fields,field_description:om_access_manager_pos_hr.field_om_pos_access__display_name
msgid "Display Name"
msgstr "显示名称"

#. module: om_access_manager_pos_hr
#: model:ir.module.module,summary:base.module_om_access_manager_pos_hr
msgid ""
"The Point of Sale restrictions of an access profile, for the employees who "
"log in to the shop"
msgstr "访问配置文件的销售点限制，适用于登录店铺的员工"

#. module: om_access_manager_pos_hr
#: model:ir.model.fields,field_description:om_access_manager_pos_hr.field_om_access_profile__id
#: model:ir.model.fields,field_description:om_access_manager_pos_hr.field_om_pos_access__id
msgid "ID"
msgstr "ID"

#. module: om_access_manager_pos_hr
#: model:ir.model.fields,field_description:om_access_manager_pos_hr.field_om_access_profile__pos_employee_ids
msgid "POS Employees"
msgstr "POS 员工"

#. module: om_access_manager_pos_hr
#: model:ir.model,name:om_access_manager_pos_hr.model_om_pos_access
msgid "Point of Sale Access Control"
msgstr "销售点访问控制"

#. module: om_access_manager_pos_hr
#: model:ir.model.fields,help:om_access_manager_pos_hr.field_om_access_profile__pos_employee_ids
msgid ""
"The employees who log in to the Point of Sale with their badge or PIN. When "
"one of them is the cashier, the Point of Sale restrictions of this profile "
"apply. An employee listed in no profile, with no rules of their own, follows"
" their Odoo user, or else the Odoo user who opened the shop."
msgstr ""
"使用工牌或 PIN 登录销售点的员工。当其中一人担任收银员时，此配置文件的销售点限制适用。未列入任何配置文件且没有自有规则的员工遵循其 Odoo "
"用户，否则遵循打开店铺的 Odoo 用户。"

#. module: om_access_manager_pos_hr
#: model_terms:ir.ui.view,arch_db:om_access_manager_pos_hr.om_access_profile_view_form_pos_hr
msgid "The employees who log in to the shop..."
msgstr "登录店铺的员工..."

#. module: om_access_manager_pos_hr
#: model:ir.module.module,shortdesc:base.module_om_access_manager_pos_hr
msgid "User Access Manager for Point of Sale Employees"
msgstr "销售点员工 User Access Manager"
