<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_access_profile_view_form_pos_hr" model="ir.ui.view">
        <field name="name">om.access.profile.form.pos.hr</field>
        <field name="model">om.access.profile</field>
        <field name="inherit_id" ref="om_access_manager_pos.om_access_profile_view_form_pos"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='pos_restrictions']" position="before">
                <group>
                    <field name="pos_employee_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="The employees who log in to the shop..."/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
