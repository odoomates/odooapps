<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_workflow_template_import_view_form" model="ir.ui.view">
        <field name="name">om.workflow.template.import.form</field>
        <field name="model">om.workflow.template.import</field>
        <field name="arch" type="xml">
            <form>
                <p>Choose a file exported with Export on a template. Users, activity types and email templates
                    are found again by their external id or their name; those missing are left for you to
                    choose in the designer.</p>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Odoo 16 shows the buttons of a list header only with records selected: a menu instead -->
    <record id="om_workflow_template_import_action" model="ir.actions.act_window">
        <field name="name">Import a Workflow Template</field>
        <field name="res_model">om.workflow.template.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
