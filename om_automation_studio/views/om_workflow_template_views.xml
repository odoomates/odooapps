<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_workflow_template_view_list" model="ir.ui.view">
        <field name="name">om.workflow.template.list</field>
        <field name="model">om.workflow.template</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_import" type="object" string="Import" display="always" icon="upload"/>
                </header>
                <field name="name"/>
                <field name="model_id"/>
                <field name="description" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="create_uid" string="Saved By" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="om_workflow_template_view_form" model="ir.ui.view">
        <field name="name">om.workflow.template.form</field>
        <field name="model">om.workflow.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_workflow" type="object" string="New Workflow" class="btn-primary"
                            help="A draft workflow from this template, opened in the designer."/>
                    <button name="action_export" type="object" string="Export" icon="download"
                            help="A file to import this template into another database."/>
                </header>
                <sheet>
                    <div class="alert alert-warning mb-3" role="status" invisible="not import_note">
                        <field name="import_note" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Approval of Big Orders"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}" readonly="id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="description" placeholder="What workflows made from it do."
                                   nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- the dialog of Save as Template -->
    <record id="om_workflow_template_view_form_save" model="ir.ui.view">
        <field name="name">om.workflow.template.form.save</field>
        <field name="model">om.workflow.template</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="model_id" readonly="1" options="{'no_open': True}"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="description" placeholder="What workflows made from it do."/>
                </group>
                <div class="text-muted small">The template appears when creating a new workflow.</div>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="om_workflow_template_view_search" model="ir.ui.view">
        <field name="name">om.workflow.template.search</field>
        <field name="model">om.workflow.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <group>
                    <filter name="group_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="om_workflow_template_action" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">om.workflow.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Keep your workflows as templates</p>
            <p>Use Save as Template on a workflow, or import a template exported from another database.
                Templates appear when creating a new workflow.</p>
        </field>
    </record>
</odoo>
