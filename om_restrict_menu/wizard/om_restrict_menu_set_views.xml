<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_om_restrict_menu_set_form" model="ir.ui.view">
        <field name="name">om.restrict.menu.set.form</field>
        <field name="model">om.restrict.menu.set</field>
        <field name="arch" type="xml">
            <form string="Set Hidden Menus">
                <group>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="source_user_id"/>
                    <field name="mode" widget="radio" options="{'horizontal': true}"/>
                </group>
                <group string="Visible Apps">
                    <p class="text-muted" colspan="2">
                        When set, the users see these apps only, in every company. Leave it empty to keep every app.
                    </p>
                    <field name="visible_menu_ids" nolabel="1" colspan="2" widget="many2many_tags"
                           context="{'search_view_ref': 'om_restrict_menu.view_om_menu_search'}"/>
                </group>
                <group string="Hidden Menus">
                    <field name="hidden_menu_ids" nolabel="1" colspan="2"
                           context="{'search_view_ref': 'om_restrict_menu.view_om_menu_search'}">
                        <tree>
                            <field name="complete_name" string="Menu"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window id="action_om_restrict_menu_set" name="Set Hidden Menus" res_model="om.restrict.menu.set"
                src_model="res.users" view_mode="form" target="new" key2="client_action_multi"
                groups="base.group_system"/>

</odoo>
