<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_menu_access_om_restrict_menu" model="ir.ui.view">
        <field name="name">ir.ui.menu.form.om.hide.menu</field>
        <field name="model">ir.ui.menu</field>
        <field name="inherit_id" ref="base.edit_menu_access"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="om_hidden_for" string="Hidden For" groups="base.group_system">
                    <group>
                        <field name="om_hidden_user_ids" widget="many2many_tags"/>
                        <field name="om_hidden_company_ids" widget="many2many_tags"
                               groups="base.group_multi_company"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_om_hidden_menu_list" model="ir.ui.view">
        <field name="name">ir.ui.menu.list.om.hide.menu</field>
        <field name="model">ir.ui.menu</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Hidden Menus" create="0" delete="0">
                <field name="complete_name" string="Menu"/>
                <field name="om_hidden_user_ids" widget="many2many_tags"/>
                <field name="om_hidden_company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_om_hidden_menus" model="ir.actions.act_window">
        <field name="name">Hidden Menus</field>
        <field name="res_model">ir.ui.menu</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('view_om_hidden_menu_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('base.edit_menu_access')})]"/>
        <field name="domain">['|', ('om_hidden_user_ids', '!=', False), ('om_hidden_company_ids', '!=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No menu is hidden</p>
            <p>
                Hide a menu for a user from the Hidden Menus tab of the user, or for everyone working in a
                company from the Hidden Menus tab of the company. Hiding a menu hides its sub-menus too.
            </p>
        </field>
    </record>

</odoo>
