<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_rental_stock" model="ir.ui.view">
        <field name="name">product.template.form.om.rental.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="om_sale_renting.product_template_form_view_rental"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='rental_qty']" position="attributes">
                <attribute name="invisible">is_storable</attribute>
            </xpath>
        </field>
    </record>

</odoo>
