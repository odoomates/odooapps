#. module: om_whatsapp_sale
#: model:om.whatsapp.template,body:om_whatsapp_sale.om_whatsapp_template_quotation
msgid ""
"Hello {{ object.partner_id.name }}, here is your quotation *{{ object.name }}* of *{{ format_amount(object.amount_total, object.currency_id) }}*. View, accept and pay it online: {{ object.om_whatsapp_portal_link() }}\n"
"Reply here if you have any question."
msgstr ""

#. module: om_whatsapp_sale
#: model:om.whatsapp.template,body:om_whatsapp_sale.om_whatsapp_template_order_confirmed
msgid ""
"Hello {{ object.partner_id.name }}, thank you for your order! Your order *{{ object.name }}* of *{{ format_amount(object.amount_total, object.currency_id) }}* is confirmed. Follow it online: {{ object.om_whatsapp_portal_link() }}\n"
"We will keep you posted."
msgstr ""

