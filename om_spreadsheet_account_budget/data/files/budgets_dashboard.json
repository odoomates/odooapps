                "A5": "=_t(\"Revenues expected to date\")",
                "B5": "=PIVOT.VALUE(1,\"theoretical_amount:sum\",\"budget_type\",\"revenue\")",
                "A6": "=_t(\"Actual revenues\")",
                "B6": "=PIVOT.VALUE(1,\"practical_amount:sum\",\"budget_type\",\"revenue\")",
                "A7": "=_t(\"Expenses spent of the plan\")",
                "B7": "=IFERROR(B3/B1,0)",
                "A8": "=_t(\"Revenues earned of the plan\")",
                "B8": "=IFERROR(B6/B4,0)",
                "A9": "=_t(\"Expenses spent of the plan (%)\")",
                "B9": "=ROUND(B7*100)",
                "A10": "=_t(\"Revenues earned of the plan (%)\")",
