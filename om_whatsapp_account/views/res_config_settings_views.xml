<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_whatsapp_account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pay_invoice_online_setting_container" position="after">
                <block title="WhatsApp" id="om_whatsapp_account_settings">
                    <setting id="om_whatsapp_invoice_auto" company_dependent="1"
                             help="Send each customer invoice and credit note by WhatsApp once, when it is posted">
                        <field name="om_whatsapp_invoice_auto"/>
                        <div class="content-group mt16">
                            <div class="row">
                                <label for="om_whatsapp_invoice_template_id" string="Invoice" class="col-lg-4 o_light_label"/>
                                <field name="om_whatsapp_invoice_template_id" options="{'no_create': True}"/>
                            </div>
                            <div class="row">
                                <label for="om_whatsapp_refund_template_id" string="Credit Note" class="col-lg-4 o_light_label"/>
                                <field name="om_whatsapp_refund_template_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="om_whatsapp_payment_auto" company_dependent="1"
                             help="Send the receipt of each customer payment by WhatsApp once, when it is confirmed">
                        <field name="om_whatsapp_payment_auto"/>
                        <div class="content-group mt16">
                            <div class="row">
                                <label for="om_whatsapp_payment_template_id" string="Template" class="col-lg-4 o_light_label"/>
                                <field name="om_whatsapp_payment_template_id" options="{'no_create': True}"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="om_whatsapp_invoice_account" string="Send From" company_dependent="1"
                             help="WhatsApp account of the automatic messages: empty for the account of the template or of the user">
                        <field name="om_whatsapp_invoice_account_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
