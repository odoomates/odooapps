<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.om_whatsapp_account</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_om_whatsapp_send" type="object" string="Send by WhatsApp"
                        groups="om_whatsapp_base.group_om_whatsapp_user"
                        invisible="state in ('draft', 'canceled', 'rejected') or payment_type != 'inbound'"/>
            </xpath>
        </field>
    </record>

</odoo>
