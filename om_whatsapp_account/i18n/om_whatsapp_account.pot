#. module: om_whatsapp_account
#: model:om.whatsapp.template,body:om_whatsapp_account.om_whatsapp_template_credit_note
msgid ""
"Hello {{ object.partner_id.name }}, here is your credit note *{{ object.name }}* of *{{ format_amount(object.amount_total, object.currency_id) }}*. View it online: {{ object.om_whatsapp_portal_link() }}\n"
"Thank you!"
msgstr ""

#. module: om_whatsapp_account
#: model:om.whatsapp.template,body:om_whatsapp_account.om_whatsapp_template_invoice
msgid ""
"Hello {{ object.partner_id.name }}, here is your invoice *{{ object.name }}* of *{{ format_amount(object.amount_total, object.currency_id) }}*, due on {{ format_date(object.invoice_date_due) }}. View and pay it online: {{ object.om_whatsapp_portal_link() }}\n"
"Thank you for your business!"
msgstr ""

#. module: om_whatsapp_account
#: model:om.whatsapp.template,body:om_whatsapp_account.om_whatsapp_template_payment_receipt
msgid ""
"Hello {{ object.partner_id.name }}, we received your payment *{{ object.name"
" }}* of *{{ format_amount(object.amount, object.currency_id) }}* on {{ "
"format_date(object.date) }}. Thank you!"
msgstr ""

