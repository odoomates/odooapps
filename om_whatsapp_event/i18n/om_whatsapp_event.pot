#. module: om_whatsapp_event
#: model:om.whatsapp.template,body:om_whatsapp_event.om_whatsapp_template_event_reminder
msgid ""
"Hello {{ object.name or object.partner_id.name }}, a reminder: *{{ "
"object.event_id.name }}* starts {{ object.event_date_range }}. {{ "
"object.om_whatsapp_event_place() }} We look forward to seeing you!"
msgstr ""

#. module: om_whatsapp_event
#: model:om.whatsapp.template,body:om_whatsapp_event.om_whatsapp_template_event_registration
msgid ""
"Hello {{ object.name or object.partner_id.name }}, your registration to *{{ "
"object.event_id.name }}* is confirmed. It starts on {{ "
"format_datetime(object.event_begin_date, tz=object.event_id.date_tz, "
"dt_format='medium') }}. {{ object.om_whatsapp_event_place() }} See you "
"there!"
msgstr ""

