<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_whatsapp_event</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="event.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="registration_setting_container" position="after">
                <block title="WhatsApp" name="om_whatsapp_event_settings">
                    <setting id="om_whatsapp_event_account" string="Send From" company_dependent="1"
                             help="WhatsApp account of the registration confirmations and reminders: pick a WhatsApp template in the communication of an event">
                        <field name="om_whatsapp_event_account_id" options="{'no_create': True}"
                               placeholder="The account of the template or of the user"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
