<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_om_barcode" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.om.barcode</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="inside">
                <setting id="om_barcode_sound" company_dependent="1"
                         help="Play a sound and vibrate on each scan in the Barcode app">
                    <field name="om_barcode_sound"/>
                </setting>
                <setting id="om_barcode_camera" company_dependent="1"
                         help="Scan with the camera of a phone or tablet in the Barcode app">
                    <field name="om_barcode_camera"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
