<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_adaptive_views.FadedToggle">
        <div class="o_om_faded_toggle mt-3">
            <button type="button" class="btn btn-link p-0" t-att-title="this.props.labels"
                    t-on-click="(ev) => this.toggle(ev)" t-out="this.label"/>
        </div>
    </t>

</templates>
