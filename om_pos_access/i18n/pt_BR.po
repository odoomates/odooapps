#. module: om_pos_access
#: model:ir.model.fields,help:om_pos_access.field_om_pos_access_rules__om_pos_refund_receipt_only
#: model:ir.model.fields,help:om_pos_access.field_res_users__om_pos_refund_receipt_only
msgid ""
"A refund goes through Orders, from the receipt of the sale: a line made "
"negative with the +/- key is refused."
msgstr ""
"Um reembolso passa por Pedidos, a partir do recibo da venda: uma linha "
"tornada negativa com a tecla +/- é recusada."

#. module: om_pos_access
#: model:ir.model.fields,help:om_pos_access.field_om_pos_access_rules__om_pos_no_cancel
#: model:ir.model.fields,help:om_pos_access.field_res_users__om_pos_no_cancel
msgid ""
"Cancel Order is hidden, an order with products cannot be deleted from the "
"list of orders, and cancelling an order sent anyway is refused."
msgstr ""
"Cancelar pedido fica oculto, um pedido com produtos não pode ser excluído da"
" lista de pedidos, e o cancelamento de um pedido enviado mesmo assim é "
"recusado."

#. module: om_pos_access
#: model_terms:ir.ui.view,arch_db:om_pos_access.res_users_view_form_pos_access
msgid "Every pricelist of the shop"
msgstr "Todas as listas de preços da loja"

#. module: om_pos_access
#: model:ir.model.fields,help:om_pos_access.field_om_pos_access_rules__om_pos_pricelist_ids
#: model:ir.model.fields,help:om_pos_access.field_res_users__om_pos_pricelist_ids
msgid ""
"Leave empty to allow every pricelist of the shop. Set, only these can be "
"chosen, and orders with another pricelist are refused: the price and "
"discount limits are measured against them."
msgstr ""
"Deixe vazio para permitir todas as listas de preços da loja. Definido, "
"somente estas podem ser escolhidas, e pedidos com outra lista de preços são "
"recusados: os limites de preço e desconto são medidos em relação a elas."

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_max_refund
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_max_refund
msgid "Maximum Refund"
msgstr "Reembolso máximo"

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_no_cancel
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_no_cancel
msgid "No Cancelling Orders"
msgstr "Sem cancelar pedidos"

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_pricelist_ids
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_pricelist_ids
msgid "Only These Pricelists"
msgstr "Somente estas listas de preços"

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_refund_receipt_only
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_refund_receipt_only
msgid "Refunds Only From a Receipt"
msgstr "Reembolsos somente a partir de um recibo"

#. module: om_pos_access
#. odoo-javascript
#. odoo-python
#: code:addons/om_pos_access/models/pos_access.py:0
#: code:addons/om_pos_access/static/src/order_summary.js:0
#: code:addons/om_pos_access/static/src/pos_store.js:0
msgid "Refunds are only allowed from the receipt of the sale, in Orders."
msgstr "Reembolsos só são permitidos a partir do recibo da venda, em Pedidos."

#. module: om_pos_access
#: model:ir.model.fields,help:om_pos_access.field_om_pos_access_rules__om_pos_max_refund
#: model:ir.model.fields,help:om_pos_access.field_res_users__om_pos_max_refund
msgid ""
