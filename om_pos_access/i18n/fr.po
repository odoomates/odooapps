#. module: om_pos_access
#: model:ir.model.fields,help:om_pos_access.field_om_pos_access_rules__om_pos_payment_method_ids
#: model:ir.model.fields,help:om_pos_access.field_res_users__om_pos_payment_method_ids
msgid ""
"Leave empty to allow every payment method of the shop. Set, only these are "
"shown and may be used, and orders paid otherwise are refused."
msgstr ""
"Laissez vide pour autoriser tous les modes de paiement de la boutique. "
"Renseigné, seuls ceux-ci sont affichés et utilisables, et les commandes "
"payées autrement sont refusées."

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_max_discount
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_max_discount
