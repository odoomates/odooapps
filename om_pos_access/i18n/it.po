msgstr "Nessuna chiusura della cassa"

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_no_partner_edit
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_no_partner_edit
msgid "No Creating or Editing Customers"
msgstr "Nessuna creazione o modifica di clienti"

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_no_discount
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_no_discount
msgid "No Discounts"
msgstr "Nessuno sconto"

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_no_price_change
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_no_price_change
msgid "No Price Changes"
msgstr "Nessuna modifica di prezzo"

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_no_refund
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_no_refund
msgid "No Refunds"
msgstr "Nessun rimborso"

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_no_decrease
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_no_decrease
msgid "No Removing Lines or Lowering Quantities"
msgstr "Nessuna rimozione di righe o riduzione delle quantità"

#. module: om_pos_access
#: model:ir.model.fields,help:om_pos_access.field_om_pos_access_rules__om_pos_no_decrease
#: model:ir.model.fields,help:om_pos_access.field_res_users__om_pos_no_decrease
msgid ""
"Once a product is on the order, it cannot be removed nor its quantity "
"lowered: a manager has to. Checked on the screen of the Point of Sale only: "
"the server only sees the final order."
msgstr ""
"Una volta che un prodotto è nell'ordine, non può essere rimosso né la sua "
"quantità ridotta: deve farlo un responsabile. Controllato solo sullo schermo"
" del Punto vendita: il server vede solo l'ordine finale."

#. module: om_pos_access
#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_payment_method_ids
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_payment_method_ids
msgid "Only These Payment Methods"
msgstr "Solo questi metodi di pagamento"

