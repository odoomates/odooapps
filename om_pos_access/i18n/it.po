#: model:ir.model.fields,field_description:om_pos_access.field_om_pos_access_rules__om_pos_no_below_cost
#: model:ir.model.fields,field_description:om_pos_access.field_res_users__om_pos_no_below_cost
msgid "Never Below Cost"
msgstr "Mai sotto costo"

