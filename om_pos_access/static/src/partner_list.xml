<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="om_pos_access.PartnerList" t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension">
        <!-- Create, on a large screen and on a small one -->
        <xpath expr="(//button[@t-on-click='() => this.editPartner()'])[1]" position="attributes">
            <attribute name="t-if">!ui.isSmall and this.pos.cashier._role !== 'minimal' and !this.pos.omIsRestricted('partner')</attribute>
        </xpath>
        <xpath expr="(//button[@t-on-click='() => this.editPartner()'])[2]" position="attributes">
            <attribute name="t-if">ui.isSmall and this.pos.cashier._role !== 'minimal' and !this.pos.omIsRestricted('partner')</attribute>
        </xpath>
    </t>
    <t t-name="om_pos_access.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <!-- Edit Details, in the menu of a customer on a large screen and on a small one -->
        <xpath expr="(//DropdownItem[@onSelected='() => props.onClickEdit(props.partner)'])[1]" position="attributes">
            <attribute name="t-if">!this.pos.omIsRestricted('partner')</attribute>
        </xpath>
        <xpath expr="(//DropdownItem[@onSelected='() => props.onClickEdit(props.partner)'])[2]" position="attributes">
            <attribute name="t-if">!this.pos.omIsRestricted('partner')</attribute>
        </xpath>
    </t>
</templates>
