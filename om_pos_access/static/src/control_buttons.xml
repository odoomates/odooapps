<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="om_pos_access.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <!-- the pricelist, when the cashier may choose among several -->
        <xpath expr="//button[hasclass('o_pricelist_button')]" position="attributes">
            <attribute name="t-if">this.pos.cashier._role != 'minimal' and (!this.pos.omPricelists or this.pos.omPricelists.length > 1)</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='() => this.clickRefund()']" position="attributes">
            <attribute name="t-if">this.pos.cashier._role != 'minimal' and !this.pos.omIsRestricted('refund')</attribute>
        </xpath>
        <!-- Cancel Order -->
        <xpath expr="//button[@t-on-click='this.onCancelOrder']" position="attributes">
            <attribute name="t-if">this.pos.cashier._role != 'minimal' and !this.pos.omIsRestricted('cancel')</attribute>
        </xpath>
    </t>
</templates>
