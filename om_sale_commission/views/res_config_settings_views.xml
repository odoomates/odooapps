<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_commission" model="ir.ui.view">
        <field name="name">res.config.settings.form.commission</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="setting_commission" position="attributes">
                <attribute name="invisible">1</attribute>
            </setting>
            <xpath expr="//app[@name='sale_management']" position="inside">
                <block title="Commissions" name="om_commission_setting_container">
                    <setting id="om_commission_bill" string="Commission Vendor Bills"
                             help="Product, journal and expense account of the vendor bills that pay the commissions">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="om_commission_product_id" string="Product" class="col-lg-4 o_light_label"/>
                                <field name="om_commission_product_id" context="{'default_type': 'service', 'default_sale_ok': False}"/>
                            </div>
                            <div class="row">
                                <label for="om_commission_journal_id" string="Journal" class="col-lg-4 o_light_label"/>
                                <field name="om_commission_journal_id"/>
                            </div>
                            <div class="row">
                                <label for="om_commission_account_id" string="Expense Account" class="col-lg-4 o_light_label"/>
                                <field name="om_commission_account_id"/>
                            </div>
                        </div>
                        <div class="mt8">
                            <button name="%(om_sale_commission.action_commission_plan)d" icon="east" type="action"
                                    string="Commission Plans" class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
