<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_commission_root"
        name="Commissions"
        web_icon="om_sale_commission,static/description/icon.png"
        groups="sales_team.group_sale_salesman,account.group_account_invoice"
        sequence="32">

        <menuitem id="menu_commission_main" name="Commissions" sequence="10">
            <menuitem id="menu_commission_my" action="action_commission_line_my" sequence="10"
                      groups="sales_team.group_sale_salesman"/>
            <menuitem id="menu_commission_lines" action="action_commission_line" sequence="20"
                      groups="sales_team.group_sale_manager,account.group_account_invoice"/>
            <menuitem id="menu_commission_achievement" action="action_commission_achievement" sequence="30"
                      groups="sales_team.group_sale_salesman"/>
        </menuitem>

        <menuitem id="menu_commission_statements" name="Statements" sequence="20">
            <menuitem id="menu_commission_statement_my" action="action_commission_statement_my" sequence="10"
                      groups="sales_team.group_sale_salesman"/>
            <menuitem id="menu_commission_statement_all" action="action_commission_statement" sequence="20"
                      groups="sales_team.group_sale_manager,account.group_account_invoice"/>
            <menuitem id="menu_commission_statement_to_bill" action="action_commission_statement_to_bill"
                      sequence="30" groups="account.group_account_invoice"/>
            <menuitem id="menu_commission_statement_create" action="action_commission_statement_wizard"
                      sequence="40" groups="sales_team.group_sale_manager"/>
        </menuitem>

        <menuitem id="menu_commission_reporting" name="Reporting" sequence="30"
                  groups="sales_team.group_sale_manager,account.group_account_invoice">
            <menuitem id="menu_commission_report_lines" action="action_commission_line_report" sequence="10"/>
            <menuitem id="menu_commission_report_achievement" action="action_commission_achievement"
                      sequence="20"/>
        </menuitem>

        <menuitem id="menu_commission_config" name="Configuration" sequence="90"
                  groups="sales_team.group_sale_manager">
            <menuitem id="menu_commission_settings" name="Settings" action="sale.action_sale_config_settings"
                      sequence="5" groups="base.group_system"/>
            <menuitem id="menu_commission_plan" action="action_commission_plan" sequence="10"/>
            <menuitem id="menu_commission_grade" action="action_commission_grade" sequence="20"/>
            <menuitem id="menu_commission_resellers" action="action_commission_resellers" sequence="30"/>
            <menuitem id="menu_commission_compute" action="action_commission_compute_wizard" sequence="40"/>
        </menuitem>
