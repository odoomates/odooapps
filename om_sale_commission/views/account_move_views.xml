<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_commission" model="ir.ui.view">
        <field name="name">account.move.form.commission</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_user_id']" position="after">
                <field name="om_referrer_id" readonly="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_commission" model="ir.ui.view">
        <field name="name">account.move.search.commission</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="om_referrer_id"/>
            </xpath>
        </field>
    </record>

</odoo>
