<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_commission_statement" model="ir.sequence">
            <field name="name">Commission Statement</field>
            <field name="code">om.commission.statement</field>
            <field name="prefix">COM/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="product_commission" model="product.product">
            <field name="name">Sales Commission</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="True"/>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="taxes_id" eval="[Command.clear()]"/>
            <field name="supplier_taxes_id" eval="[Command.clear()]"/>
        </record>

        <function model="res.company" name="write">
            <value model="res.company" eval="obj().search([]).ids"/>
            <value eval="{'om_commission_product_id': ref('om_sale_commission.product_commission')}"/>
        </function>

    </data>
</odoo>
