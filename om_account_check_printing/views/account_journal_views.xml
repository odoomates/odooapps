<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_check_format" model="ir.ui.view">
        <field name="name">account.journal.form.check.format</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account_check_printing.view_account_journal_form_inherited"/>
        <field name="arch" type="xml">
            <!-- Odoo 16 chooses the cheque layout per company, in the settings -->
            <field name="check_next_number" position="after">
                <field name="check_format_id"/>
            </field>
        </field>
    </record>

</odoo>
