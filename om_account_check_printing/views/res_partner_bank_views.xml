<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- the clearing number is in the bank account form of Odoo 19 -->
    <record id="view_partner_bank_form_clearing_number" model="ir.ui.view">
        <field name="name">res.partner.bank.form.clearing.number</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <field name="acc_number" position="after">
                <field name="clearing_number"/>
            </field>
        </field>
    </record>

</odoo>
