<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="calendar_alarm_view_form" model="ir.ui.view">
        <field name="name">calendar.alarm.form.inherit.om_whatsapp_calendar</field>
        <field name="model">calendar.alarm</field>
        <field name="inherit_id" ref="calendar.calendar_alarm_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mail_template_id']" position="after">
                <field name="om_whatsapp_template_id" invisible="alarm_type != 'om_whatsapp'"
                       required="alarm_type == 'om_whatsapp'" options="{'no_create': True}"/>
                <field name="om_whatsapp_account_id" invisible="alarm_type != 'om_whatsapp'"
                       options="{'no_create': True}" placeholder="An account of the organizer"/>
            </xpath>
        </field>
    </record>

    <record id="calendar_alarm_view_kanban" model="ir.ui.view">
        <field name="name">calendar.alarm.kanban.inherit.om_whatsapp_calendar</field>
        <field name="model">calendar.alarm</field>
        <field name="inherit_id" ref="calendar.calendar_alarm_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mail_template_id']" position="after">
                <field name="om_whatsapp_template_id" invisible="not om_whatsapp_template_id"/>
            </xpath>
        </field>
    </record>

</odoo>
