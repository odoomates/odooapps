<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_planning_fleet</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="om_planning.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="planning_rules" position="after">
                <block title="Fleet" name="planning_fleet">
                    <setting id="planning_fleet_follow_driver"
                        help="New vehicles with a driver go with the driver on the planning slots (can be changed per vehicle)">
                        <field name="planning_fleet_follow_driver"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
