<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_pen.CustomizerSystray">
        <div class="o_om_pen_systray d-flex align-items-center">
            <button type="button"
                    class="btn o_om_pen_toggle"
                    t-att-class="state.active ? 'o_om_pen_on' : ''"
                    title="Customize this view"
                    t-on-click="() => this.customizer.toggle()">
                <i class="fa fa-magic" role="img" aria-label="Customize this view"/>
            </button>
        </div>
    </t>

</templates>
