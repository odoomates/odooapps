<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_pen.Section">
        <div class="om-pen-section" t-att-class="open ? 'open' : ''">
            <button class="om-pen-section-head" t-on-click="() => this.toggleSection(key)">
                <i class="fa fa-fw" t-att-class="open ? 'fa-caret-down' : 'fa-caret-right'"/>
                <span t-esc="title"/>
            </button>
            <div class="om-pen-section-body" t-if="open">
                <!-- a t-call body renders at t-out="0"; t-slot only works for components -->
                <t t-out="0"/>
            </div>
        </div>
    </t>

    <t t-name="om_pen.CustomizerOverlay">
        <t t-if="state.active">
            <div class="o_om_pen_ui o_om_pen_banner">
                <i class="fa fa-magic me-2"/>
                <span class="om-pen-crumb">
                    <strong t-esc="state.config.resModel"/>
                    <span class="om-pen-sep">/</span>
                    <span t-esc="state.config.viewType"/>
                </span>
                <span t-if="state.adding" class="om-pen-hint">
                    Drop <strong t-esc="state.adding"/> where it should go
                </span>
                <span t-elif="state.broken" class="badge text-bg-danger ms-3">
                    No longer matches the standard view
                </span>
                <span t-else="" class="om-pen-hint om-pen-hint-quiet">
                    Click a field to edit it · drag to move it · Esc to leave
                </span>
                <span class="flex-grow-1"/>
                <span t-if="state.saving" class="om-pen-saving"><i class="fa fa-circle-o-notch fa-spin me-1"/>Saving</span>
                <t t-if="state.hasDraft">
                    <span class="om-pen-draft-count" t-att-class="state.draftInvalid ? 'invalid' : ''">
                        <t t-esc="state.draftCount"/> unpublished
                    </span>
                    <button class="btn btn-sm btn-light me-2"
                            t-on-click="() => this.customizer.discardDraft()">Discard</button>
                    <button class="btn btn-sm me-2"
                            t-att-class="state.draftInvalid ? 'btn-outline-light' : 'btn-warning'"
                            t-att-disabled="state.draftInvalid or state.saving"
                            t-att-title="state.draftInvalid ? 'These changes no longer fit the standard view. Discard them and make them again.' : 'Make these changes live for everyone'"
                            t-on-click="() => this.customizer.publish()">Publish</button>
                </t>
                <button t-if="state.adding" class="btn btn-sm btn-light me-2"
                        t-on-click="() => this.customizer.cancelAdding()">Cancel</button>
                <button class="btn btn-sm btn-light om-pen-exit"
                        t-on-click="() => this.customizer.toggle()">Exit</button>
            </div>

            <div t-if="state.adding" class="o_om_pen_ui o_om_pen_chip">
                <i class="fa fa-arrows me-2"/>
                <span t-esc="state.adding"/>
                <small class="d-block">drag onto the form, or click a field</small>
            </div>

            <div class="o_om_pen_ui o_om_pen_panel">
                <div class="om-pen-tabs">
                    <button t-att-class="ui.tab === 'add' ? 'active' : ''"
                            t-on-click="() => this.ui.tab = 'add'">
                        <i class="fa fa-plus me-1"/>Add
                    </button>
                    <button t-att-class="ui.tab === 'field' ? 'active' : ''"
                            t-on-click="() => this.ui.tab = 'field'">
                        <i class="fa fa-pencil me-1"/>Field
                    </button>
                    <button t-att-class="ui.tab === 'view' ? 'active' : ''"
                            t-on-click="() => this.ui.tab = 'view'">
                        <i class="fa fa-sliders me-1"/>View
                    </button>
                    <button t-att-class="ui.tab === 'changes' ? 'active' : ''"
                            t-on-click="() => this.ui.tab = 'changes'">
                        <i class="fa fa-list me-1"/>Changes
                        <span t-if="changes.length" class="om-pen-count" t-esc="changes.length"/>
                    </button>
                </div>

                <!-- add tab: drag a type or a field onto the view -->
                <t t-if="ui.tab === 'add'">
                    <div class="om-pen-palette-wrap">
                        <div class="om-pen-palette-hint">
                            <i class="fa fa-hand-pointer-o me-1"/>Drag onto the form. You see where it lands before you let go.
                        </div>
                        <div class="om-pen-subhead">New field</div>
                        <div class="om-pen-palette">
                            <div t-foreach="paletteTypes" t-as="type" t-key="type.key"
                                 class="om-pen-tile o_om_pen_source" t-att-data-ttype="type.key">
                                <i t-attf-class="fa fa-fw {{type.icon}}"/>
                                <span t-esc="type.label"/>
                            </div>
                        </div>
                        <div class="om-pen-subhead">Existing fields</div>
                        <input type="search" class="form-control form-control-sm mb-2"
                               placeholder="Search fields not on this view"
                               t-model="palette.search"/>
                        <div class="om-pen-palette-list">
                            <div t-foreach="paletteFields" t-as="field" t-key="field.name"
                                 class="om-pen-palette-row o_om_pen_source" t-att-data-field="field.name"
                                 t-att-title="field.name">
                                <i t-attf-class="fa fa-fw {{field.icon}} me-2"/>
                                <span class="flex-grow-1" t-esc="field.string"/>
                                <i class="fa fa-ellipsis-v om-pen-grip"/>
                            </div>
                            <div t-if="!paletteFields.length" class="om-pen-empty">Every field is on the view already.</div>
                        </div>
                        <button class="btn btn-link btn-sm px-0 mt-2" t-on-click="() => this.openAddDialog()">
                            <i class="fa fa-share-alt me-1"/>A related field, or more options…
                        </button>
                    </div>
                </t>

                <!-- field tab -->
                <t t-if="ui.tab === 'field'">
                    <button class="om-pen-add-field" t-on-click="() => this.ui.tab = 'add'">
                        <i class="fa fa-plus me-2"/>Add a field to this view
                    </button>
                    <t t-if="state.selected">
                        <div class="om-pen-head">
                            <div class="om-pen-head-title" t-esc="currentLabel"/>
                            <div class="om-pen-head-meta">
                                <code t-esc="state.selected"/>
                                <span class="om-pen-chip" t-esc="selectedField.type"/>
                                <span t-if="isAddedField" class="om-pen-chip om-pen-chip-info">added</span>
                            </div>
                        </div>

                        <div class="om-pen-body">
                            <t t-call="om_pen.Section">
                                <t t-set="key" t-value="'appearance'"/>
                                <t t-set="title" t-value="'Appearance'"/>
                                <t t-set="open" t-value="ui.openSections.appearance"/>
                                <div class="om-pen-row">
                                    <label class="om-pen-label">Label</label>
                                    <div class="om-pen-control">
                                        <input type="text" class="form-control form-control-sm om-pen-field-label"
                                               t-model="draft.label"/>
                                        <button t-if="draft.label !== baseLabel"
                                                class="om-pen-reset" title="Back to the standard label"
                                                t-on-click="() => draft.label = baseLabel">reset</button>
                                    </div>
                                </div>
                                <div class="om-pen-row">
                                    <label class="om-pen-label">Tooltip</label>
                                    <div class="om-pen-control">
                                        <input type="text" class="form-control form-control-sm"
                                               placeholder="shown on hover" t-model="draft.help_text"/>
                                    </div>
                                </div>
                                <div class="om-pen-row">
                                    <label class="om-pen-label">Placeholder</label>
                                    <div class="om-pen-control">
                                        <input type="text" class="form-control form-control-sm"
                                               placeholder="shown when empty" t-model="draft.placeholder"/>
                                    </div>
                                </div>
                                <div class="om-pen-row">
                                    <label class="om-pen-label">Widget</label>
                                    <div class="om-pen-control">
                                        <select class="form-select form-select-sm" t-model="draft.widget">
                                            <option value="">Default</option>
                                            <option t-foreach="widgetChoices" t-as="choice"
                                                    t-key="choice.name" t-att-value="choice.name">
                                                <t t-esc="choice.label"/> (<t t-esc="choice.name"/>)
                                            </option>
                                        </select>
                                    </div>
                                </div>
                            </t>

                            <t t-call="om_pen.Section">
                                <t t-set="key" t-value="'behaviour'"/>
                                <t t-set="title" t-value="'Behaviour'"/>
                                <t t-set="open" t-value="ui.openSections.behaviour"/>
                                <ModifierControl label.translate="Hidden" entry="draft.invisible"
                                      fields="state.fields"
                                      fieldNames="conditionFieldNames"/>
                                <ModifierControl label.translate="Readonly" entry="draft.readonly"
                                      fields="state.fields"
                                      fieldNames="conditionFieldNames"/>
                                <ModifierControl label.translate="Required" entry="draft.required"
                                      fields="state.fields"
                                      fieldNames="conditionFieldNames"/>
                                <t t-if="isList">
                                    <ModifierControl label.translate="Hide column" entry="draft.column_invisible"
                                      fields="state.fields"
                                      fieldNames="conditionFieldNames"/>
                                    <div class="om-pen-row">
                                        <label class="om-pen-label">Optional</label>
                                        <div class="om-pen-control">
                                            <select class="form-select form-select-sm" t-model="draft.optional">
                                                <option value="">Always shown</option>
                                                <option value="show">Optional, shown by default</option>
                                                <option value="hide">Optional, hidden by default</option>
                                            </select>
                                            <small class="om-pen-help">Users switch optional columns on from the column picker.</small>
                                        </div>
                                    </div>
                                </t>
                            </t>

                            <t t-call="om_pen.Section">
                                <t t-set="key" t-value="'visibility'"/>
                                <t t-set="title" t-value="'Who can see it'"/>
                                <t t-set="open" t-value="ui.openSections.visibility"/>
                                <div t-if="selectedGroupNames.length" class="om-pen-tags">
                                    <span t-foreach="selectedGroupNames" t-as="name" t-key="name"
                                          class="om-pen-chip om-pen-chip-primary" t-esc="name"/>
                                </div>
                                <p t-else="" class="om-pen-help mb-2">Everyone who can see this view.</p>
                                <input type="text" class="form-control form-control-sm mb-1"
                                       placeholder="Search groups…" t-model="ui.groupSearch"/>
                                <div class="om-pen-scroll">
                                    <label t-foreach="visibleGroups" t-as="group" t-key="group.id"
                                           class="om-pen-check">
                                        <input type="checkbox"
                                               t-att-checked="draft.group_ids.includes(group.id)"
                                               t-on-change="() => this.toggleGroup(group.id)"/>
                                        <span t-esc="group.display_name"/>
                                    </label>
                                </div>
                            </t>

                            <t t-if="isRelational" t-call="om_pen.Section">
                                <t t-set="key" t-value="'relational'"/>
                                <t t-set="title" t-value="'Linked record'"/>
                                <t t-set="open" t-value="ui.openSections.relational"/>
                                <label class="om-pen-check">
                                    <input type="checkbox" t-model="draft.opt_no_open"/>
                                    <span>Cannot open the linked record</span>
                                </label>
                                <label class="om-pen-check">
                                    <input type="checkbox" t-model="draft.opt_no_create"/>
                                    <span>Cannot create from here</span>
                                </label>
                                <label class="om-pen-check">
                                    <input type="checkbox" t-model="draft.opt_no_quick_create"/>
                                    <span>No quick create</span>
                                </label>
                                <label class="om-pen-check">
                                    <input type="checkbox" t-model="draft.opt_no_create_edit"/>
                                    <span>No "Create and edit"</span>
                                </label>
                            </t>
                        </div>

                        <div class="om-pen-foot" t-att-class="dirty ? 'dirty' : ''">
                            <button class="btn btn-sm btn-link text-danger px-0"
                                    t-on-click="() => this.clearField()">
                                <t t-if="isAddedField">Remove from view</t>
                                <t t-else="">Reset field</t>
                            </button>
                            <span class="flex-grow-1"/>
                            <span t-if="dirty" class="om-pen-pending">Unsaved</span>
                            <button class="btn btn-sm btn-primary"
                                    t-att-disabled="state.saving or !dirty"
                                    t-att-title="dirty ? 'Apply (Ctrl+Enter)' : 'Nothing to apply yet'"
                                    t-on-click="() => this.applyField()">Apply</button>
                        </div>
                    </t>
                    <div t-else="" class="om-pen-empty">
                        <i class="fa fa-hand-pointer-o"/>
                        <p>Click any field to edit it.</p>
                        <p class="om-pen-help">
                            <t t-esc="availableToAdd"/> more fields of this model are not
                            on this view yet.
                        </p>
                    </div>
                </t>

                <!-- view tab -->
                <t t-if="ui.tab === 'view'">
                    <div class="om-pen-body">
                        <t t-call="om_pen.Section">
                            <t t-set="key" t-value="'appearance'"/>
                            <t t-set="title" t-value="'What users may do'"/>
                            <t t-set="open" t-value="true"/>
                            <label class="om-pen-check">
                                <input type="checkbox" t-model="actionsDraft.create_ok"/>
                                <span>Create records</span>
                            </label>
                            <label class="om-pen-check">
                                <input type="checkbox" t-model="actionsDraft.edit_ok"/>
                                <span>Edit records</span>
                            </label>
                            <label class="om-pen-check">
                                <input type="checkbox" t-model="actionsDraft.delete_ok"/>
                                <span>Delete records</span>
                            </label>
                            <label class="om-pen-check" t-att-class="!actionsDraft.create_ok ? 'disabled' : ''">
                                <input type="checkbox" t-att-disabled="!actionsDraft.create_ok"
                                       t-model="actionsDraft.duplicate_ok"/>
                                <span>Duplicate records</span>
                            </label>
                            <p t-if="!actionsDraft.create_ok" class="om-pen-help">
                                Duplicating is off because creating is off.
                            </p>
                            <t t-if="isList">
                                <label class="om-pen-check">
                                    <input type="checkbox" t-model="actionsDraft.export_ok"/>
                                    <span>Export</span>
                                </label>
                                <label class="om-pen-check">
                                    <input type="checkbox" t-model="actionsDraft.import_ok"/>
                                    <span>Import</span>
                                </label>
                            </t>
                        </t>

                        <t t-if="state.subviews.length">
                            <div class="om-pen-subhead">Embedded views</div>
                            <div t-foreach="state.subviews" t-as="subview" t-key="subview.name"
                                 class="om-pen-card">
                                <div>
                                    <strong t-esc="subview.string"/>
                                    <code class="ms-1" t-esc="subview.comodel"/>
                                </div>
                                <div class="mt-1">
                                    <button t-foreach="subview.views" t-as="kind" t-key="kind"
                                            class="btn btn-sm btn-outline-primary me-1"
                                            t-on-click="() => this.openSubviewDialog(subview, kind)">
                                        <i class="fa fa-plus me-1"/>Add to <t t-esc="kind"/>
                                    </button>
                                </div>
                            </div>
                        </t>

                        <t t-if="hasNotebook">
                            <div class="om-pen-subhead">Pages</div>
                            <div t-foreach="state.pages" t-as="page" t-key="page.id" class="om-pen-card om-pen-row-flex">
                                <span class="flex-grow-1" t-esc="page.string"/>
                                <button t-if="state.adding" class="btn btn-sm btn-outline-success me-1"
                                        t-on-click="() => this.placeInPage(page.id)">Put it here</button>
                                <button class="btn btn-sm btn-link text-danger p-0"
                                        t-on-click="() => this.removePage(page.id)">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                            <div class="input-group input-group-sm mt-2">
                                <input type="text" class="form-control" placeholder="New page title"
                                       t-model="ui.pageTitle"/>
                                <button class="btn btn-outline-primary"
                                        t-on-click="() => this.addPage()">Add</button>
                            </div>
                        </t>
                    </div>
                    <div class="om-pen-foot">
                        <span class="flex-grow-1"/>
                        <button class="btn btn-sm btn-primary" t-att-disabled="state.saving"
                                t-on-click="() => this.applyActions()">Apply</button>
                    </div>
                </t>

                <!-- changes tab -->
                <t t-if="ui.tab === 'changes'">
                    <div class="om-pen-body">
                        <input t-if="changes.length or ui.changeSearch" type="text"
                               class="form-control form-control-sm mb-2"
                               placeholder="Search changes…" t-model="ui.changeSearch"/>
                        <div t-if="!changes.length" class="om-pen-empty">
                            <i class="fa fa-check-circle-o"/>
                            <p>Nothing customized on this view yet.</p>
                        </div>
                        <div t-foreach="changes" t-as="change" t-key="change.name"
                             class="om-pen-card om-pen-change" t-on-click="() => this.selectChange(change.name)">
                            <div class="flex-grow-1">
                                <div>
                                    <strong t-esc="change.label"/>
                                    <span t-if="change.kind === 'add'" class="om-pen-chip om-pen-chip-info ms-1">added</span>
                                    <span t-if="change.kind === 'move'" class="om-pen-chip ms-1">moved</span>
                                    <span t-if="change.draft and change.to_remove"
                                          class="om-pen-chip om-pen-chip-warn ms-1">removal pending</span>
                                    <span t-elif="change.draft"
                                          class="om-pen-chip om-pen-chip-warn ms-1">unpublished</span>
                                    <span t-else="" class="om-pen-chip om-pen-chip-live ms-1">live</span>
                                </div>
                                <small class="om-pen-help" t-esc="change.summary"/>
                            </div>
                            <button class="btn btn-sm btn-link text-danger p-0 ms-2"
                                    t-on-click.stop="() => this.removeRule(change.name)"
                                    title="Undo this change">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>
                    <div class="om-pen-foot">
                        <button class="btn btn-sm btn-link text-danger px-0"
                                t-on-click="() => this.customizer.reset()">Reset everything</button>
                    </div>
                </t>
            </div>
        </t>
    </t>

</templates>
