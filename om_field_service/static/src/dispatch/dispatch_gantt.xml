<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_field_service.DispatchGanttButtons">
        <button type="button" class="btn btn-primary o_fs_button_jobs"
            t-on-click="() => this.togglePanel()">
            Jobs to Plan
            <span class="badge rounded-pill text-bg-light ms-1" t-out="this.dispatch.jobs.length"/>
        </button>
        <button type="button" class="btn btn-secondary o_fs_button_map" t-on-click="() => this.openMap()">
            <i class="oi me-1" data-icon="map"/>Map
        </button>
    </t>

    <t t-name="om_field_service.DispatchGanttController" t-inherit="om_web_gantt.GanttController" t-inherit-mode="primary">
        <xpath expr="//t[@t-component='this.props.Renderer']" position="replace">
            <div class="d-flex flex-grow-1 overflow-hidden o_fs_dispatch_body">
                <t t-component="this.props.Renderer" t-props="this.rendererProps"/>
                <aside t-if="this.dispatch.showPanel" class="o_fs_dispatch_panel border-start bg-view d-flex flex-column">
                    <div class="d-flex align-items-center px-3 py-2 border-bottom">
                        <h5 class="mb-0 me-auto">Jobs to Plan</h5>
                        <button type="button" class="btn btn-link p-0" title="Close" aria-label="Close"
                            t-on-click="() => this.togglePanel()">
                            <i class="oi" data-icon="close"/>
                        </button>
                    </div>
                    <div class="overflow-auto flex-grow-1 p-2">
                        <p t-if="!this.dispatch.jobs.length" class="text-muted small p-2">Every job is planned.</p>
                        <t t-foreach="this.dispatch.jobs" t-as="job" t-key="job.id">
                            <div class="card mb-2 o_fs_dispatch_job">
                                <div class="card-body p-2">
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="small text-muted" t-out="job.number"/>
                                        <span class="ms-auto text-warning small" t-if="this.priorityStars(job)">
                                            <t t-foreach="[...Array(this.priorityStars(job)).keys()]" t-as="star" t-key="star">
                                                <i class="oi oi-filled" data-icon="star"/>
                                            </t>
                                        </span>
                                    </div>
                                    <a href="#" class="fw-bold d-block text-truncate" t-on-click.prevent="() => this.openJob(job.id)" t-out="job.name"/>
                                    <div class="small text-muted text-truncate" t-out="job.customer"/>
                                    <div class="small text-muted d-flex gap-2">
                                        <span t-if="job.city"><i class="oi" data-icon="location_on"/> <t t-out="job.city"/></span>
                                        <span><i class="oi" data-icon="schedule"/> <t t-out="this.formatDuration(job.duration)"/></span>
                                    </div>
                                    <div t-if="job.deadline" class="small text-danger">Deadline <t t-out="this.formatDeadline(job)"/></div>
                                    <div class="d-flex align-items-center mt-1">
                                        <span class="badge text-bg-light border small" t-if="job.job_type" t-out="job.job_type"/>
                                        <button type="button" class="btn btn-sm btn-primary ms-auto o_fs_plan_job"
                                            t-on-click="() => this.planJob(job)">Plan</button>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <p class="small text-muted p-2 mb-0">
                            Or click the search button of a cell to plan jobs on that technician at that time.
                        </p>
                    </div>
                </aside>
            </div>
        </xpath>
    </t>

</templates>
