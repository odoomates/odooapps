<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_fs_route_wizard_view_form" model="ir.ui.view">
        <field name="name">om.fs.route.wizard.form</field>
        <field name="model">om.fs.route.wizard</field>
        <field name="arch" type="xml">
            <form string="Optimise the Route">
                <field name="can_apply" invisible="1"/>
                <group>
                    <group>
                        <field name="employee_id" widget="many2one_avatar_employee" options="{'no_create': True}"/>
                        <field name="date"/>
                        <field name="start_partner_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="distance_before"/>
                        <field name="distance_after"/>
                        <field name="maps_url" widget="url" text="Open the route in Maps" invisible="not maps_url"/>
                    </group>
                </group>
                <p class="text-muted small">
                    Shortest order of the visits from the start address (straight-line distance), planned one after
                    the other with the travel time at the average speed of the settings.
                </p>
                <field name="line_ids" readonly="1" nolabel="1">
                    <list create="0" delete="0" decoration-info="moved">
                        <field name="sequence"/>
                        <field name="task_id"/>
                        <field name="partner_id"/>
                        <field name="site_address" optional="show"/>
                        <field name="distance_km" sum="Total"/>
                        <field name="old_start"/>
                        <field name="new_start"/>
                        <field name="new_end" optional="hide"/>
                        <field name="moved" column_invisible="1"/>
                    </list>
                </field>
                <div class="text-muted small" invisible="not note">
                    <field name="note" class="d-block" style="white-space: pre-line;"/>
                </div>
                <footer>
                    <button name="action_apply" type="object" string="Apply the Order" class="btn-primary"
                        invisible="not can_apply" data-hotkey="q"/>
                    <button name="action_refresh" type="object" string="Compute Again" class="btn-secondary"/>
                    <button special="cancel" string="Close" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_om_fs_route_wizard" model="ir.actions.act_window">
        <field name="name">Optimise Routes</field>
        <field name="res_model">om.fs.route.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
