<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_fs_job_type_view_list" model="ir.ui.view">
        <field name="name">om.fs.job.type.list</field>
        <field name="model">om.fs.job.type</field>
        <field name="arch" type="xml">
            <list string="Job Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_duration" widget="float_time"/>
                <field name="role_id" optional="show"/>
                <field name="signature_required" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="om_fs_job_type_view_form" model="ir.ui.view">
        <field name="name">om.fs.job.type.form</field>
        <field name="model">om.fs.job.type</field>
        <field name="arch" type="xml">
            <form string="Job Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object" class="oe_stat_button" icon="assignment">
                            <field name="job_count" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Boiler Maintenance"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="default_duration" widget="float_time"/>
                            <field name="role_id" options="{'no_quick_create': True}"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="signature_required"/>
                            <field name="checklist_required"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="checklist" string="Checklist">
                            <field name="checklist_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="check_type"/>
                                    <field name="uom_label" invisible="check_type != 'number'"/>
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                        <page name="instructions" string="Instructions">
                            <field name="description" placeholder="Shown to the technician on the job: tools to take, safety rules..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_om_fs_job_type" model="ir.actions.act_window">
        <field name="name">Job Types</field>
        <field name="res_model">om.fs.job.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a job type</p>
            <p>A job type gives its duration, checklist and instructions to the jobs: installation, repair, yearly maintenance...</p>
        </field>
    </record>

</odoo>
