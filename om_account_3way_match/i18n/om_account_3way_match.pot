#. module: om_account_3way_match
#: model:ir.module.module,description:base.module_om_account_3way_match
msgid ""
"Match every vendor bill line with its purchase order line and its receipts: "
"ordered, received and billed quantities, PO price against bill price. The "
"bill gets a Release to Pay status (Yes, No, Exception) used to block or warn"
" when a payment is registered."
msgstr ""

#. module: om_account_3way_match
#: model:ir.model.fields.selection,name:om_account_3way_match.selection__res_company__om_3way_ordered_policy__two_way
msgid "Match the purchase order only (2-way)"
msgstr ""

#. module: om_account_3way_match
#: model_terms:ir.ui.view,arch_db:om_account_3way_match.res_config_settings_view_form_om_3way
msgid ""
"Match vendor bills with purchase orders and receipts: a bill is released to "
"pay when what is billed is received at the ordered price."
msgstr ""

