#: model:ir.model.fields.selection,name:om_account_3way_match.selection__account_move_line__om_match_state__matched
msgid "Matched"
msgstr ""

#. module: om_account_3way_match
#: model:ir.model.fields,help:om_account_3way_match.field_account_move_line__om_match_state
msgid ""
"Matched: the billed quantity is received (or ordered, for a 2-way match) and the price is within the tolerance.\n"
"Waiting for Receipt: more is billed than received so far.\n"
"Quantity Exception: more is billed than ordered.\n"
"Price Exception: the bill price is above the purchase order price beyond the tolerance.\n"
"Not Linked: the line is not linked to a purchase order line."
msgstr ""

