<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_om_3way" model="ir.ui.view">
        <field name="name">account.payment.register.form.om.3way</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group" position="before">
                <field name="om_release_blocked" invisible="1"/>
                <div role="alert" class="alert alert-warning" invisible="not om_release_warning or om_release_blocked">
                    <div class="fw-bold">These bills are not released to pay yet:</div>
                    <field name="om_release_warning"/>
                </div>
                <div role="alert" class="alert alert-danger" invisible="not om_release_blocked">
                    <div class="fw-bold">Payment refused, these bills are not released to pay:</div>
                    <field name="om_release_warning"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
