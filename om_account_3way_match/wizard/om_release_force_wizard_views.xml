<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_release_force_wizard_form" model="ir.ui.view">
        <field name="name">om.release.force.wizard.form</field>
        <field name="model">om.release.force.wizard</field>
        <field name="arch" type="xml">
            <form string="Release to Pay">
                <group>
                    <field name="move_ids" widget="many2many_tags" readonly="1"/>
                    <field name="decision" widget="radio"/>
                    <field name="reason" placeholder="e.g. price agreed with the vendor by phone"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
