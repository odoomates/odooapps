#. module: om_sale_renting
#: model:mail.template,body_html:om_sale_renting.mail_template_rental_return_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        This is a reminder that the products of your rental <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">S00052</span>\n"
"        are to be returned on <span style=\"font-weight: bold;\" t-out=\"format_datetime(object.rental_return_date, tz=object.user_id.tz or 'UTC', dt_format='short') or ''\">04/12/2026 09:00</span>.\n"
"        <br/><br/>\n"
"        Late returns are charged extra. Contact us if you need to keep them longer.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: om_sale_renting
#: model:mail.template,body_html:om_sale_renting.mail_template_rental_pickup_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        This is a reminder that your rental <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">S00052</span>\n"
"        starts on <span style=\"font-weight: bold;\" t-out=\"format_datetime(object.rental_start_date, tz=object.user_id.tz or 'UTC', dt_format='short') or ''\">01/12/2026 09:00</span>.\n"
"        <br/><br/>\n"
"        <t t-foreach=\"object.order_line.filtered(lambda l: l.is_rental)\" t-as=\"line\">\n"
"            <t t-out=\"line.product_uom_qty\">1</t> x <t t-out=\"line.product_id.display_name or ''\">Projector</t><br/>\n"
"        </t>\n"
"        <br/>\n"
"        See you soon.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: om_sale_renting
#: model:mail.template,body_html:om_sale_renting.mail_template_rental_confirmation
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Brandon Freeman</t>,\n"
"        <br/><br/>\n"
"        Your rental <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">S00052</span>\n"
"        amounting in <span style=\"font-weight: bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 10.00</span>\n"
"        is confirmed.\n"
"        <br/><br/>\n"
"        Pickup: <span style=\"font-weight: bold;\" t-out=\"format_datetime(object.rental_start_date, tz=object.user_id.tz or 'UTC', dt_format='short') or ''\">01/12/2026 09:00</span><br/>\n"
"        Return: <span style=\"font-weight: bold;\" t-out=\"format_datetime(object.rental_return_date, tz=object.user_id.tz or 'UTC', dt_format='short') or ''\">04/12/2026 09:00</span>\n"
"        <br/><br/>\n"
"        You will find the rental agreement attached.\n"
"        <br/><br/>\n"
"        Do not hesitate to contact us if you have any questions.\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

