<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rental_order_wizard_view_form" model="ir.ui.view">
        <field name="name">om.rental.order.wizard.form</field>
        <field name="model">om.rental.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Rental Pickup and Return">
                <field name="order_id" invisible="1"/>
                <field name="mode" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="1" name="wizard_lines">
                        <field name="sale_line_id" column_invisible="True"/>
                        <field name="product_id"/>
                        <field name="qty_reserved"/>
                        <field name="qty_max"/>
                        <field name="qty"/>
                        <field name="uom_id" groups="uom.group_uom"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="late_label" column_invisible="parent.mode != 'return'"/>
                        <field name="late_fee" column_invisible="parent.mode != 'return'"/>
                        <field name="note" placeholder="Condition, remarks..."/>
                    </list>
                </field>
                <group invisible="mode != 'return'" name="return_charges">
                    <group string="Late Fees">
                        <field name="late_fee_amount"/>
                        <field name="add_late_fee" invisible="not late_fee_amount"/>
                    </group>
                    <group string="Damages">
                        <field name="damage_description" placeholder="e.g. Broken lens"/>
                        <field name="damage_amount"/>
                    </group>
                </group>
                <field name="note" placeholder="Notes posted on the order..."/>
                <footer>
                    <button string="Validate" name="action_validate" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
