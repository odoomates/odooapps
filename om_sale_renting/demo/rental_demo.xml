    <record id="rental_order_quotation" model="sale.order">
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="is_rental_order" eval="True"/>
        <field name="rental_start_date" eval="(DateTime.today().replace(hour=9, minute=0, second=0, microsecond=0) + relativedelta(days=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="rental_return_date" eval="(DateTime.today().replace(hour=9, minute=0, second=0, microsecond=0) + relativedelta(days=8)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="order_line" eval="[
                Command.create({'product_id': ref('product_rental_projector'), 'product_uom_qty': 2}),
                Command.create({'product_id': ref('product_rental_speaker'), 'product_uom_qty': 1})]"/>
    </record>

    <record id="rental_order_reserved" model="sale.order">
        <field name="partner_id" ref="base.res_partner_12"/>
        <field name="user_id" ref="base.user_admin"/>
