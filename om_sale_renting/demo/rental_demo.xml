        <field name="rental_qty">3</field>
        <field name="rental_padding_hours">2</field>
        <field name="rental_extra_hour_price">10.0</field>
        <field name="rental_extra_day_price">50.0</field>
        <field name="rental_min_duration">0</field>
        <field name="rental_min_duration_unit">day</field>
    </record>
    <record id="pricing_projector_0" model="om.rental.pricing">
        <field name="product_template_id" ref="product_rental_projector_product_template"/>
