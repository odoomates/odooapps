<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_rental_confirmation" model="mail.template">
            <field name="name">Rental: Order Confirmation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} Rental {{ object.name or 'n/a' }} confirmed</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent to customers when a rental order is confirmed</field>
            <field name="email_layout_xmlid">mail.mail_notification_layout_with_responsible_signature</field>
            <field name="report_template_ids" eval="[(4, ref('om_sale_renting.action_report_rental_agreement'))]"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        <br/><br/>
        Your rental <span style="font-weight: bold;" t-out="object.name or ''">S00052</span>
        amounting in <span style="font-weight: bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</span>
        is confirmed.
        <br/><br/>
        Pickup: <span style="font-weight: bold;" t-out="format_datetime(object.rental_start_date, tz=object.user_id.tz or 'UTC', dt_format='short') or ''">01/12/2026 09:00</span><br/>
        Return: <span style="font-weight: bold;" t-out="format_datetime(object.rental_return_date, tz=object.user_id.tz or 'UTC', dt_format='short') or ''">04/12/2026 09:00</span>
        <br/><br/>
        You will find the rental agreement attached.
        <br/><br/>
        Do not hesitate to contact us if you have any questions.
    </p>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_rental_pickup_reminder" model="mail.template">
            <field name="name">Rental: Pickup Reminder</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} Pickup reminder for your rental {{ object.name or 'n/a' }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent to customers before the pickup date of their rental</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        <br/><br/>
        This is a reminder that your rental <span style="font-weight: bold;" t-out="object.name or ''">S00052</span>
        starts on <span style="font-weight: bold;" t-out="format_datetime(object.rental_start_date, tz=object.user_id.tz or 'UTC', dt_format='short') or ''">01/12/2026 09:00</span>.
        <br/><br/>
        <t t-foreach="object.order_line.filtered(lambda l: l.is_rental)" t-as="line">
            <t t-out="line.product_uom_qty">1</t> x <t t-out="line.product_id.display_name or ''">Projector</t><br/>
        </t>
        <br/>
        See you soon.
    </p>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_rental_return_reminder" model="mail.template">
            <field name="name">Rental: Return Reminder</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} Return reminder for your rental {{ object.name or 'n/a' }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent to customers before the return date of their rental</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        <br/><br/>
        This is a reminder that the products of your rental <span style="font-weight: bold;" t-out="object.name or ''">S00052</span>
        are to be returned on <span style="font-weight: bold;" t-out="format_datetime(object.rental_return_date, tz=object.user_id.tz or 'UTC', dt_format='short') or ''">04/12/2026 09:00</span>.
        <br/><br/>
        Late returns are charged extra. Contact us if you need to keep them longer.
    </p>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
