msgstr ""

#. module: om_access_manager_pos
#: model:ir.model.fields,help:om_access_manager_pos.field_om_access_profile__om_pos_no_refund
msgid ""
"The Refund button of the Point of Sale is hidden, and refunds sent anyway "
"are refused."
msgstr ""

#. module: om_access_manager_pos
#: model:ir.model.fields,help:om_access_manager_pos.field_om_access_profile__om_pos_no_discount
msgid ""
"The discount key (%) of the Point of Sale is disabled, and orders sent with "
"a discounted line, or with the global discount, are refused. Refunding a "
"discounted sale stays possible."
msgstr ""

#. module: om_access_manager_pos
#: model:ir.model.fields,help:om_access_manager_pos.field_om_access_profile__om_pos_max_discount
msgid "The highest discount that may be given on a line. 0 for no limit."
msgstr ""

#. module: om_access_manager_pos
#: model:ir.model.fields,help:om_access_manager_pos.field_om_access_profile__om_pos_no_price_change
msgid ""
"The price key of the Point of Sale is disabled, and a price below the one of"
" the pricelist is refused."
msgstr ""

