<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_field_service.job_type_repair" model="om.fs.job.type">
        <field name="service_product_id" ref="product_fs_hour"/>
    </record>
    <record id="om_field_service.job_type_installation" model="om.fs.job.type">
        <field name="service_product_id" ref="product_fs_hour"/>
        <field name="bill_travel" eval="False"/>
    </record>

    <record id="om_field_service.job_hills" model="project.task">
        <field name="is_covered" eval="True"/>
        <field name="coverage">contract</field>
    </record>

</odoo>
