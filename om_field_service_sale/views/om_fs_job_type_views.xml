<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_fs_job_type_view_form_inherit_sale" model="ir.ui.view">
        <field name="name">om.fs.job.type.form.inherit.sale</field>
        <field name="model">om.fs.job.type</field>
        <field name="inherit_id" ref="om_field_service.om_fs_job_type_view_form"/>
        <field name="arch" type="xml">
            <field name="checklist_required" position="after">
                <field name="service_product_id" options="{'no_quick_create': True}"/>
                <field name="bill_travel"/>
            </field>
        </field>
    </record>

    <record id="om_fs_job_type_view_list_inherit_sale" model="ir.ui.view">
        <field name="name">om.fs.job.type.list.inherit.sale</field>
        <field name="model">om.fs.job.type</field>
        <field name="inherit_id" ref="om_field_service.om_fs_job_type_view_list"/>
        <field name="arch" type="xml">
            <field name="signature_required" position="after">
                <field name="service_product_id" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
