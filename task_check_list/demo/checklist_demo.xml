<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Global checklists (no project): shown as fallback for projects without own checklists -->
    <record id="task_check_list_global_1" model="task.checklist">
        <field name="name">Requirements Analysis</field>
        <field name="description">Review and document all project requirements</field>
        <field name="sequence">10</field>
    </record>

    <record id="task_check_list_global_2" model="task.checklist">
        <field name="name">Planning</field>
        <field name="description">Define scope, timeline and resources</field>
        <field name="sequence">20</field>
    </record>

    <record id="task_check_list_global_3" model="task.checklist">
        <field name="name">Implementation</field>
        <field name="description">Execute the planned work</field>
        <field name="sequence">30</field>
    </record>

    <record id="task_check_list_global_4" model="task.checklist">
        <field name="name">Testing</field>
        <field name="description">Verify the deliverable meets requirements</field>
        <field name="sequence">40</field>
    </record>

    <record id="task_check_list_global_5" model="task.checklist">
        <field name="name">Documentation</field>
        <field name="description">Update relevant documentation</field>
        <field name="sequence">50</field>
    </record>

    <record id="task_check_list_global_6" model="task.checklist">
        <field name="name">Delivery</field>
        <field name="description">Hand off to stakeholders and close the task</field>
        <field name="sequence">60</field>
    </record>
</odoo>
