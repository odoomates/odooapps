<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_planning_maintenance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="om_planning.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="planning_rules" position="after">
                <block title="Maintenance" name="planning_maintenance">
                    <setting id="planning_mnt_plan_technicians"
                        help="Scheduled maintenance requests book their technicians as well as their equipment">
                        <field name="planning_mnt_plan_technicians"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
