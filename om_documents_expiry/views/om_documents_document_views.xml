<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- the expiring documents -->

    <record id="om_documents_document_view_form_expiry" model="ir.ui.view">
        <field name="name">om.documents.document.form.expiry</field>
        <field name="model">om.documents.document</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_renew" string="Renew" type="object" class="btn-primary"
                            invisible="not id or not active or next_id or expiry_state not in ('expiring', 'expired')"/>
                    <button name="action_renew" string="Renew" type="object"
                            invisible="not id or not active or next_id or expiry_state in ('expiring', 'expired')"/>
                    <button name="action_download" type="object" string="Download" invisible="not attachment_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object" class="oe_stat_button" icon="open_in_new"
                                invisible="not res_name">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Holder</span>
                                <span class="o_stat_value text-truncate" style="max-width: 120px;">
                                    <field name="res_name" readonly="1"/>
                                </span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Renewed" bg_color="text-bg-info" invisible="active or not next_id"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active or next_id"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                            invisible="not active or expiry_state != 'expired'"/>
                    <widget name="web_ribbon" title="Expiring" bg_color="text-bg-warning"
                            invisible="not active or expiry_state != 'expiring'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Passport A1234567"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="record_ref" string="Holder" options="{'no_create': True}"
                                   required="type_res_model"/>
                            <field name="type_id" options="{'no_create': True}" required="1"/>
                            <field name="number" invisible="not has_number"/>
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="partner_id" string="Contact"/>
                        </group>
                        <group>
                            <field name="date_issue" invisible="not has_issue_date"/>
                            <field name="date_expiry" invisible="not has_expiry_date"
                                   decoration-danger="expiry_state == 'expired'"
                                   decoration-warning="expiry_state == 'expiring'"/>
                            <field name="expiry_state" widget="badge" invisible="not has_expiry_date"
                                   decoration-success="expiry_state == 'valid'"
                                   decoration-warning="expiry_state == 'expiring'"
                                   decoration-danger="expiry_state == 'expired'"/>
                            <field name="previous_id" invisible="not previous_id"/>
                            <field name="next_id" invisible="not next_id"/>
                            <field name="folder_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="res_model" invisible="1" force_save="1"/>
                            <field name="res_id" invisible="1" force_save="1"/>
                            <field name="type_res_model" invisible="1"/>
                            <field name="has_number" invisible="1"/>
                            <field name="has_issue_date" invisible="1"/>
                            <field name="has_expiry_date" invisible="1"/>
                            <field name="attachment_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Files" name="files">
                            <group>
                                <field name="datas" filename="file_name" string="File"
                                       help="Upload another file to make a new version: the current one is kept in the versions."/>
                                <field name="file_name" invisible="1"/>
                                <field name="extra_attachment_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                        <page string="Note" name="note">
                            <field name="description" placeholder="Anything worth knowing about this document"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="om_documents_document_view_kanban_expiry" model="ir.ui.view">
        <field name="name">om.documents.document.kanban.expiry</field>
        <field name="model">om.documents.document</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <kanban string="Documents" class="o_om_documents_expiry_kanban" sample="1" quick_create="false"
                    default_order="date_expiry, id desc">
                <field name="expiry_state"/>
                <field name="expiry_preview_url"/>
                <field name="file_count"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <div class="o_om_documents_expiry_kanban_preview">
                            <img t-if="record.expiry_preview_url.raw_value" t-att-src="record.expiry_preview_url.raw_value"
                                 alt="Preview" loading="lazy"/>
                            <i t-elif="record.file_count.raw_value" class="oi text-muted" data-icon="description" title="File"/>
                            <i t-else="" class="oi text-muted" data-icon="upload_file" title="No file yet"/>
                        </div>
                        <div class="p-2">
                            <field name="type_id" class="fw-bold text-truncate d-block"/>
                            <field name="res_name" class="text-truncate d-block"/>
                            <field name="number" class="small text-muted text-truncate d-block"/>
                            <div class="d-flex align-items-center mt-1 gap-1">
                                <field name="expiry_state" widget="badge" decoration-success="expiry_state == 'valid'"
                                       decoration-warning="expiry_state == 'expiring'"
                                       decoration-danger="expiry_state == 'expired'"/>
                                <field name="date_expiry" class="small text-muted"/>
                                <span class="flex-grow-1"/>
                                <span t-if="record.file_count.raw_value" class="small text-muted">
                                    <i class="oi" data-icon="attach_file" title="Files"/><field name="file_count"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="om_documents_document_view_list_expiry" model="ir.ui.view">
        <field name="name">om.documents.document.list.expiry</field>
        <field name="model">om.documents.document</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list string="Documents" default_order="date_expiry, id desc" decoration-danger="expiry_state == 'expired'"
                  decoration-warning="expiry_state == 'expiring'">
                <field name="res_name" string="Holder"/>
                <field name="type_id"/>
                <field name="name" optional="hide"/>
                <field name="number" optional="show"/>
                <field name="date_issue" optional="hide"/>
                <field name="date_expiry"/>
                <field name="days_left" optional="show" invisible="expiry_state == 'none'"/>
                <field name="country_id" optional="hide"/>
                <field name="folder_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="expiry_state" widget="badge" decoration-success="expiry_state == 'valid'"
                       decoration-warning="expiry_state == 'expiring'" decoration-danger="expiry_state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="om_documents_document_view_search_expiry" model="ir.ui.view">
        <field name="name">om.documents.document.search.expiry</field>
        <field name="model">om.documents.document</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="number"/>
                <field name="type_id"/>
                <field name="partner_id"/>
                <field name="folder_id"/>
                <filter name="expiring" string="Expiring" domain="[('expiry_state', 'in', ['expiring'])]"/>
                <filter name="expired" string="Expired" domain="[('expiry_state', 'in', ['expired'])]"/>
                <filter name="valid" string="Valid" domain="[('expiry_state', 'in', ['valid', 'none'])]"/>
                <separator/>
                <filter name="date_expiry" string="Expiry Date" date="date_expiry"/>
                <separator/>
                <filter name="activities_my" string="My Activities" domain="[('activity_user_id', '=', uid)]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <searchpanel>
                    <field name="type_id" string="Type" icon="folder" enable_counters="1"/>
                </searchpanel>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_model" string="Kind of Record" context="{'group_by': 'res_model'}"/>
                    <filter name="group_expiry" string="Expiry Month" context="{'group_by': 'date_expiry:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_expiry_documents" model="ir.actions.act_window">
        <field name="name">Tracked Documents</field>
        <field name="res_model">om.documents.document</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('type_id', '!=', False)]</field>
        <field name="search_view_id" ref="om_documents_document_view_search_expiry"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('om_documents_document_view_kanban_expiry')}),
            Command.create({'view_mode': 'list', 'view_id': ref('om_documents_document_view_list_expiry')}),
            Command.create({'view_mode': 'form', 'view_id': ref('om_documents_document_view_form_expiry')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Keep a document with its expiry date</p>
            <p>A passport, a license or a permit: you are reminded before it expires.</p>
        </field>
    </record>

    <record id="action_expiry_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Documents</field>
        <field name="res_model">om.documents.document</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('type_id', '!=', False), ('expiry_state', 'in', ['expiring'])]</field>
        <field name="search_view_id" ref="om_documents_document_view_search_expiry"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('om_documents_document_view_kanban_expiry')}),
            Command.create({'view_mode': 'list', 'view_id': ref('om_documents_document_view_list_expiry')}),
            Command.create({'view_mode': 'form', 'view_id': ref('om_documents_document_view_form_expiry')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is about to expire</p>
        </field>
    </record>

    <record id="action_expiry_expired" model="ir.actions.act_window">
        <field name="name">Expired Documents</field>
        <field name="res_model">om.documents.document</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="domain">[('type_id', '!=', False), ('expiry_state', 'in', ['expired'])]</field>
        <field name="search_view_id" ref="om_documents_document_view_search_expiry"/>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'kanban', 'view_id': ref('om_documents_document_view_kanban_expiry')}),
            Command.create({'view_mode': 'list', 'view_id': ref('om_documents_document_view_list_expiry')}),
            Command.create({'view_mode': 'form', 'view_id': ref('om_documents_document_view_form_expiry')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has expired</p>
        </field>
    </record>

    <!-- the expiry on the documents of Documents -->

    <record id="om_documents_document_view_form" model="ir.ui.view">
        <field name="name">om.documents.document.form.expiry.inherit</field>
        <field name="model">om.documents.document</field>
        <field name="inherit_id" ref="om_documents.om_documents_document_view_form"/>
        <field name="arch" type="xml">
            <button name="action_move" position="after">
                <button name="action_renew" type="object" string="Renew"
                        invisible="not id or not type_id or not active or next_id"/>
            </button>
            <widget name="web_ribbon" position="before">
                <widget name="web_ribbon" title="Renewed" bg_color="text-bg-info" invisible="active or not next_id"/>
                <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger"
                        invisible="not active or expiry_state != 'expired'"/>
                <widget name="web_ribbon" title="Expiring" bg_color="text-bg-warning"
                        invisible="not active or expiry_state != 'expiring'"/>
            </widget>
            <field name="record_ref" position="after">
                <field name="type_id" options="{'no_create': True}" placeholder="Track an expiry"/>
                <field name="number" invisible="not type_id or not has_number"/>
                <field name="date_issue" invisible="not type_id or not has_issue_date"/>
                <field name="date_expiry" invisible="not type_id or not has_expiry_date"
                       decoration-danger="expiry_state == 'expired'" decoration-warning="expiry_state == 'expiring'"/>
                <field name="expiry_state" widget="badge" invisible="not type_id or not has_expiry_date"
                       decoration-success="expiry_state == 'valid'" decoration-warning="expiry_state == 'expiring'"
                       decoration-danger="expiry_state == 'expired'"/>
                <field name="country_id" options="{'no_create': True}" invisible="not type_id"/>
                <field name="previous_id" invisible="not previous_id"/>
                <field name="next_id" invisible="not next_id"/>
                <field name="has_number" invisible="1"/>
                <field name="has_issue_date" invisible="1"/>
                <field name="has_expiry_date" invisible="1"/>
                <field name="res_model" invisible="1"/>
            </field>
            <page name="versions" position="before">
                <page string="Extra Files" name="extra_files" invisible="not type_id and not extra_attachment_ids">
                    <field name="extra_attachment_ids" widget="many2many_binary"/>
                </page>
            </page>
        </field>
    </record>

    <record id="om_documents_document_view_search" model="ir.ui.view">
        <field name="name">om.documents.document.search.expiry.inherit</field>
        <field name="model">om.documents.document</field>
        <field name="inherit_id" ref="om_documents.om_documents_document_view_search"/>
        <field name="arch" type="xml">
            <field name="res_model" position="after">
                <field name="type_id"/>
                <field name="number"/>
            </field>
            <filter name="linked" position="after">
                <separator/>
                <filter name="expiry_tracked" string="Expiry Tracked" domain="[('type_id', '!=', False)]"/>
                <filter name="expiring" string="Expiring" domain="[('expiry_state', 'in', ['expiring'])]"/>
                <filter name="expired" string="Expired" domain="[('expiry_state', 'in', ['expired'])]"/>
            </filter>
        </field>
    </record>

</odoo>
