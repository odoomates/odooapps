<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_documents_type_view_list" model="ir.ui.view">
        <field name="name">om.documents.type.list</field>
        <field name="model">om.documents.type</field>
        <field name="arch" type="xml">
            <list string="Document Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="model_id"/>
                <field name="has_expiry_date"/>
                <field name="reminder_days" invisible="not has_expiry_date"/>
                <field name="notify_holder" optional="show"/>
                <field name="folder_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="om_documents_type_view_form" model="ir.ui.view">
        <field name="name">om.documents.type.form</field>
        <field name="model">om.documents.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object" class="oe_stat_button" icon="description"
                                invisible="not id">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Passport"/></h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Any document"/>
                            <field name="code"/>
                            <field name="has_number"/>
                            <field name="has_issue_date"/>
                            <field name="has_expiry_date"/>
                            <field name="folder_id" options="{'no_create': True}" placeholder="Folder of the record"/>
                        </group>
                        <group string="Reminders" invisible="not has_expiry_date">
                            <field name="reminder_days" placeholder="30,7,0"/>
                            <field name="notify_holder"/>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Explain the document to the people filling it in"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="om_documents_type_view_search" model="ir.ui.view">
        <field name="name">om.documents.type.search</field>
        <field name="model">om.documents.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="model_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_model" string="Applies To" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_document_types" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">om.documents.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a document type</p>
            <p>A passport, a work permit, a trade license: the kind of record it belongs to, its fields and when to
                remind before it expires.</p>
        </field>
    </record>

</odoo>
