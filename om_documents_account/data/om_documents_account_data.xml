<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="folder_accounting" model="om.documents.folder">
            <field name="name">Accounting</field>
            <field name="sequence">5</field>
            <field name="owner_id" ref="base.user_admin"/>
            <field name="access_internal">none</field>
            <field name="read_group_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
            <field name="write_group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="tag_category_accounting" model="om.documents.tag.category">
            <field name="name">Invoice</field>
            <field name="folder_id" ref="folder_accounting"/>
        </record>
        <record id="tag_in_invoice" model="om.documents.tag">
            <field name="name">Vendor Bill</field>
            <field name="category_id" ref="tag_category_accounting"/>
            <field name="sequence">1</field>
            <field name="color">4</field>
        </record>
        <record id="tag_in_refund" model="om.documents.tag">
            <field name="name">Vendor Credit Note</field>
            <field name="category_id" ref="tag_category_accounting"/>
            <field name="sequence">2</field>
            <field name="color">2</field>
        </record>
        <record id="tag_out_invoice" model="om.documents.tag">
            <field name="name">Customer Invoice</field>
            <field name="category_id" ref="tag_category_accounting"/>
            <field name="sequence">3</field>
            <field name="color">10</field>
        </record>
        <record id="tag_out_refund" model="om.documents.tag">
            <field name="name">Customer Credit Note</field>
            <field name="category_id" ref="tag_category_accounting"/>
            <field name="sequence">4</field>
            <field name="color">1</field>
        </record>
    </data>

    <function model="res.company" name="_om_documents_account_init_folder"/>

    <record id="server_action_create_vendor_bill" model="ir.actions.server">
        <field name="name">Create Vendor Bill</field>
        <field name="model_id" ref="om_documents.model_om_documents_document"/>
        <field name="binding_model_id" ref="om_documents.model_om_documents_document"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_create_vendor_bill()</field>
    </record>

    <record id="server_action_create_customer_invoice" model="ir.actions.server">
        <field name="name">Create Customer Invoice</field>
        <field name="model_id" ref="om_documents.model_om_documents_document"/>
        <field name="binding_model_id" ref="om_documents.model_om_documents_document"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_create_customer_invoice()</field>
    </record>

    <record id="server_action_create_vendor_refund" model="ir.actions.server">
        <field name="name">Create Vendor Credit Note</field>
        <field name="model_id" ref="om_documents.model_om_documents_document"/>
        <field name="binding_model_id" ref="om_documents.model_om_documents_document"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_create_vendor_refund()</field>
    </record>

</odoo>
