<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_om_ai_read_receipts" model="ir.actions.server">
        <field name="name">Read Receipts with AI</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="binding_model_id" ref="hr_expense.model_hr_expense"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.filtered(lambda e: e.state == 'draft' and e.nb_attachment).action_om_ai_read_receipt()</field>
    </record>
</odoo>
