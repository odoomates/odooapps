<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_om_ai_expense" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.om_ai_expense</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_expense.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="expense_extract_settings" position="after">
                <setting id="om_ai_expense_settings" string="Read Receipts with AI"
                         help="Fill the expenses created from uploaded receipts with your AI model. The Read Receipt with AI button is always on draft expenses.">
                    <field name="om_ai_expense_read_on_upload"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
