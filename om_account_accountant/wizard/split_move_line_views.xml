<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_om_split_move_line_form" model="ir.ui.view">
        <field name="name">om.split.move.line.form</field>
        <field name="model">om.split.move.line</field>
        <field name="arch" type="xml">
            <form string="Split a Journal Item">
                <field name="currency_id" invisible="1"/>
                <field name="move_state" invisible="1"/>
                <div class="alert alert-info" role="status" invisible="move_state == 'draft'">
                    The entry is posted: it stays as it is, and a reclassification entry moves the parts from its
                    account to the accounts below.
                </div>
                <group>
                    <group>
                        <field name="line_id"/>
                        <field name="amount"/>
                        <field name="mode" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group>
                        <field name="date" invisible="move_state == 'draft'"/>
                        <field name="split_total"/>
                        <field name="left_amount"/>
                    </group>
                </group>
                <field name="split_ids">
                    <list editable="bottom">
                        <field name="account_id"/>
                        <field name="partner_id" optional="show"/>
                        <field name="analytic_distribution" widget="analytic_distribution" optional="show"
                               groups="analytic.group_analytic_accounting"/>
                        <field name="label" optional="show"/>
                        <field name="value"/>
                    </list>
                </field>
                <footer>
                    <button name="action_split" type="object" string="Split" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_om_split_move_line" model="ir.actions.act_window">
        <field name="name">Split</field>
        <field name="res_model">om.split.move.line</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

</odoo>
