<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_account_accountant.AttachmentPreviewField">
        <button t-if="this.attachmentId" type="button" class="btn btn-link p-0 o_om_attachment_preview"
                title="Preview the document" aria-label="Preview the document"
                t-on-click.stop="() => this.preview()">
            <i class="oi" data-icon="visibility"/>
        </button>
    </t>

</templates>
