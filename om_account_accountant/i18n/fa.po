"برچسب‌ها حساب‌ها یا سطرهای مالیاتی را در گزارش‌ها گروه‌بندی می‌کنند، مانند "
"صورت جریان وجوه نقد یا شبکه‌های مالیاتی."

#. module: om_account_accountant
#: model_terms:ir.ui.view,arch_db:om_account_accountant.res_config_settings_view_form
