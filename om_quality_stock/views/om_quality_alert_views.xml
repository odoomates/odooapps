<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_om_quality_alert_form_stock" model="ir.ui.view">
        <field name="name">om.quality.alert.form.stock</field>
        <field name="model">om.quality.alert</field>
        <field name="inherit_id" ref="om_quality.view_om_quality_alert_form"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="lot_id" invisible="not product_id"/>
                <field name="picking_id" invisible="not picking_id"/>
            </field>
        </field>
    </record>

    <record id="view_om_quality_alert_list_stock" model="ir.ui.view">
        <field name="name">om.quality.alert.list.stock</field>
        <field name="model">om.quality.alert</field>
        <field name="inherit_id" ref="om_quality.view_om_quality_alert_list"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="lot_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_om_quality_alert_search_stock" model="ir.ui.view">
        <field name="name">om.quality.alert.search.stock</field>
        <field name="model">om.quality.alert</field>
        <field name="inherit_id" ref="om_quality.view_om_quality_alert_search"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="lot_id"/>
                <field name="picking_id"/>
            </field>
        </field>
    </record>
</odoo>
