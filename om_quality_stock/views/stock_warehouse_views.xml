<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_om_quality" model="ir.ui.view">
        <field name="name">stock.warehouse.form.om.quality</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="om_quality_quarantine_location_id" groups="om_quality.group_om_quality_manager"
                    options="{'no_create': True}" placeholder="Created at the first quarantine"/>
            </field>
        </field>
    </record>
</odoo>
