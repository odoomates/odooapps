<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.om.documents</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_om_documents" type="object" class="oe_stat_button" icon="folder"
                        groups="om_documents.group_documents_user">
                    <field name="om_documents_count" widget="statinfo" string="Files"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
