<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_ai_tool_view_list" model="ir.ui.view">
        <field name="name">om.ai.tool.list.mcp</field>
        <field name="model">om.ai.tool</field>
        <field name="inherit_id" ref="om_ai.om_ai_tool_view_list"/>
        <field name="arch" type="xml">
            <field name="read_only" position="after">
                <field name="mcp_enabled" string="MCP" optional="show"/>
            </field>
        </field>
    </record>

    <record id="om_ai_tool_view_form" model="ir.ui.view">
        <field name="name">om.ai.tool.form.mcp</field>
        <field name="model">om.ai.tool</field>
        <field name="inherit_id" ref="om_ai.om_ai_tool_view_form"/>
        <field name="arch" type="xml">
            <field name="read_only" position="after">
                <field name="mcp_enabled"/>
            </field>
        </field>
    </record>
</odoo>
