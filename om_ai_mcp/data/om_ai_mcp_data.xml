<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="config_mcp_enabled" model="ir.config_parameter">
            <field name="key">om_ai_mcp.enabled</field>
            <field name="value">True</field>
        </record>
        <record id="config_mcp_oauth_enabled" model="ir.config_parameter">
            <field name="key">om_ai_mcp.oauth_enabled</field>
            <field name="value">True</field>
        </record>
        <record id="config_mcp_oauth_registration" model="ir.config_parameter">
            <field name="key">om_ai_mcp.oauth_registration</field>
            <field name="value">True</field>
        </record>
    </data>

    <record id="ir_cron_om_mcp_log_cleanup" model="ir.cron">
        <field name="name">MCP: remove old logs and sessions</field>
        <field name="model_id" ref="model_om_mcp_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_om_mcp_oauth_cleanup" model="ir.cron">
        <field name="name">MCP: remove expired OAuth tokens and connections</field>
        <field name="model_id" ref="model_om_mcp_oauth_grant"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
