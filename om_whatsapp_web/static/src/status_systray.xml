<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_whatsapp_web.StatusSystray" owl="1">
        <div t-attf-class="o_om_whatsapp_systray_item {{ status.ready and status.hasAccount ? '' : 'd-none' }}">
            <Dropdown position="'bottom-end'" togglerClass="'o_nav_entry o_om_whatsapp_systray position-relative'" title="title">
                <t t-set-slot="toggler">
                    <i class="fa fa-whatsapp fa-lg" role="img" t-att-aria-label="title"/>
                    <span t-attf-class="o_om_whatsapp_dot o_om_whatsapp_dot_{{ status.level }}"/>
                </t>
                <t t-set-slot="default">
                    <div class="o_om_whatsapp_systray_content px-3 py-2" style="min-width: 290px; max-width: 360px;">
                        <div class="d-flex align-items-center font-weight-bold mb-1">
                            <span t-attf-class="o_om_whatsapp_dot o_om_whatsapp_dot_{{ status.level }} mr-2"/>
                            <t t-esc="title"/>
                        </div>
                        <div class="small mb-3" t-esc="status.reason"/>
                        <div class="d-flex flex-wrap">
                            <button t-if="status.action === 'open'" type="button" class="btn btn-sm btn-primary mr-2"
                                    t-on-click="openWhatsapp">Open WhatsApp Web</button>
                            <button type="button" class="btn btn-sm btn-secondary mr-2" t-att-disabled="status.checking"
                                    t-on-click="refresh">Check again</button>
                            <button type="button" class="btn btn-sm btn-link ml-auto px-0" t-on-click="openAccounts">Accounts</button>
                        </div>
                    </div>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
