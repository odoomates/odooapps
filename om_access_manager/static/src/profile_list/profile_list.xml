<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_access_manager.ProfileListView.Buttons" t-inherit="web.ListView.Buttons"
       t-inherit-mode="primary" owl="1">
        <xpath expr="//t[contains(@t-if, 'isExportEnable')]" position="before">
            <button type="button" class="btn btn-secondary o_om_access_template"
                    t-on-click="() => this.openWizard('om_access_manager.om_access_template_wizard_action')">
                New from Template
            </button>
            <button type="button" class="btn btn-secondary o_om_access_import"
                    t-on-click="() => this.openWizard('om_access_manager.om_access_import_action')">
                Import
            </button>
        </xpath>
    </t>

</templates>
