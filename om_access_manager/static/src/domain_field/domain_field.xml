<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_access_manager.AccessDomainField" owl="1">
        <div t-if="hasExpressions" class="o_om_domain_text w-100">
            <textarea t-if="!props.readonly" class="o_input font-monospace w-100" rows="2"
                      t-att-value="props.value" t-on-change="onTextChange"/>
            <code t-else="" t-esc="props.value"/>
            <div class="text-muted small">It reads the user or the date: edited as text.</div>
        </div>
        <t t-else="" t-call="web.DomainField"/>
    </t>

</templates>
