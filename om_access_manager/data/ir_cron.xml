<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_refresh_assignments" model="ir.cron">
        <field name="name">Access Profiles: Start and End Temporary Users</field>
        <field name="model_id" ref="model_om_access_profile_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="ir_cron_health_check" model="ir.cron">
        <field name="name">Access Profiles: Health Check</field>
        <field name="model_id" ref="model_om_access_profile"/>
        <field name="state">code</field>
        <field name="code">model._cron_health_check()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
    </record>

</odoo>
