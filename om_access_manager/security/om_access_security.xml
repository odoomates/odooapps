<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_access_management">
        <field name="name">Access Management</field>
        <field name="sequence">30</field>
        <field name="parent_id" ref="base.module_category_administration"/>
    </record>

    <!-- who manages the access profiles: the Access Manager app is theirs -->
    <record id="group_access_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_access_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Creates and changes the access profiles, and gives them to users.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
