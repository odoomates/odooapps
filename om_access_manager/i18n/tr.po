", except what\n"
"                            the cards below limit."
msgstr ""
", aşağıdaki kartların\n"
"                            sınırladıkları dışında."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
