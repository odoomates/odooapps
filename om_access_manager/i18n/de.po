msgstr "Ihr eigener Filter:"

#. module: om_access_manager
#: model:ir.model.fields.selection,name:om_access_manager.selection__om_access_app_wizard_model__scope__own
#: model:ir.model.fields.selection,name:om_access_manager.selection__om_access_profile_menu__records__own
msgid "Their own records"
msgstr "Ihre eigenen Datensätze"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_guided.py:0
msgid ""
"Their own records, and those of the employees under them in the org chart, "
"three levels down."
msgstr ""
"Ihre eigenen Datensätze und die der Mitarbeiter unter ihnen im Organigramm, "
"drei Ebenen tief."

#. module: om_access_manager
#: model:ir.model.fields.selection,name:om_access_manager.selection__om_access_profile_menu__records__team
msgid "Their sales team"
msgstr "Ihr Verkaufsteam"

#. module: om_access_manager
#: model:ir.model.fields.selection,name:om_access_manager.selection__om_access_profile_menu__records__warehouse
msgid "Their warehouse"
msgstr "Ihr Lagerhaus"

#. module: om_access_manager
#: model:ir.model.fields.selection,name:om_access_manager.selection__om_access_profile_menu__records__hierarchy
msgid "Theirs and their team's (org chart)"
msgstr "Ihre und die ihres Teams (Organigramm)"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
"They open what the menus show, but create, change and delete\n"
"                                nothing."
msgstr ""
"Sie öffnen, was die Menüs zeigen, erstellen, ändern und löschen aber\n"
"                                nichts."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "They see all records in"
msgstr "Sie sehen alle Datensätze in"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.js:0
msgid "They see the button and can use it."
msgstr "Sie sehen die Schaltfläche und können sie verwenden."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.js:0
msgid "They will see %(kept)s of %(total)s."
msgstr "Sie werden %(kept)s von %(total)s sehen."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_guided.py:0
msgid "This app no longer exists."
msgstr "Diese App existiert nicht mehr."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/conditions.py:0
msgid "This comparison is not supported in a condition."
msgstr "Dieser Vergleich wird in einer Bedingung nicht unterstützt."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_panel.xml:0
msgid "This data has its own filter: change it with Advanced... on its menu."
msgstr ""
"Diese Daten haben einen eigenen Filter: Ändern Sie ihn mit Erweitert ... in "
"ihrem Menü."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "This data has no form: its fields are below."
msgstr "Diese Daten haben kein Formular: Ihre Felder stehen unten."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_menu_panel.py:0
msgid "This data is not linked to %s."
msgstr "Diese Daten sind nicht mit %s verknüpft."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_menu_panel.py:0
msgid "This field does not exist."
msgstr "Dieses Feld existiert nicht."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_transfer.py:0
msgid "This file comes from a newer version of the module: upgrade it first."
msgstr ""
"Diese Datei stammt aus einer neueren Version des Moduls: Aktualisieren Sie "
"es zuerst."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_transfer.py:0
msgid "This file is not an export of access profiles."
msgstr "Diese Datei ist kein Export von Zugriffsprofilen."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_menu_panel.py:0
msgid "This group does not open this app."
msgstr "Diese Gruppe öffnet diese App nicht."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_preview.py:0
msgid "This is a preview: nothing is saved."
msgstr "Dies ist eine Vorschau: Es wird nichts gespeichert."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_panel.xml:0
msgid "This menu is hidden."
msgstr "Dieses Menü ist ausgeblendet."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_guided.py:0
#: code:addons/om_access_manager/models/om_access_menu_panel.py:0
msgid "This menu no longer exists."
msgstr "Dieses Menü existiert nicht mehr."

