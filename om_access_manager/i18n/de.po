msgstr "Ihr Lagerhaus"

#. module: om_access_manager
#: model:ir.model.fields.selection,name:om_access_manager.selection__om_access_profile_menu__records__company
msgid "Their companies"
msgstr "Ihre Unternehmen"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_panel.xml:0
msgid "Their own Odoo groups"
msgstr "Ihre eigenen Odoo-Gruppen"

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_profile_model_view_form
