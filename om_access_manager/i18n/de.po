msgstr "%s ist nicht installiert: Der zugehörige Teil wurde übersprungen."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_preview.py:0
msgid "%s may use this. It is not run in a preview."
msgstr "%s kann dies verwenden. Es wird in einer Vorschau nicht ausgeführt."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.js:0
