"%s has more settings (a condition or required): change it in More settings."
msgstr ""
"%s hat weitere Einstellungen (eine Bedingung oder Pflichtfeld): Ändern Sie "
"es unter Weitere Einstellungen."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_preview.py:0
msgid "%s has rights you do not have: only a Settings user can preview them."
msgstr ""
"%s hat Rechte, die Sie nicht haben: Nur ein Benutzer mit Einstellungsrechten"
" kann sie in der Vorschau ansehen."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_tree_field.js:0
