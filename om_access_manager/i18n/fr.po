msgstr "'%(name)s' n'est pas un type de vue. Utilisez l'un de : %(types)s"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_allowed.py:0
msgid "'Each user's own' is set on a profile, not on a user."
msgstr ""
"'Ceux de chaque utilisateur' se définit sur un profil, pas sur un "
"utilisateur."

#. module: om_access_manager
#: model:ir.model.fields,help:om_access_manager.field_om_access_profile_field__mode
msgid ""
"'Keep as is' leaves the field alone and applies only the options below."
msgstr ""
"'Laisser tel quel' ne touche pas au champ et applique seulement les options "
"ci-dessous."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
"(dimmed): the button is not on the screen. They could still run\n"
"                                    the same action another way: from another screen, the Action menu or by calling Odoo\n"
"                                    directly. Use it to keep screens simple, not to forbid something."
msgstr ""
"(atténué) : le bouton n'est pas à l'écran. Ils pourraient encore lancer\n"
"                                    la même action autrement : depuis un autre écran, le menu Action ou en appelant Odoo\n"
"                                    directement. Utilisez-le pour garder des écrans simples, pas pour interdire quelque chose."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_version.py:0
msgid "(empty)"
msgstr "(vide)"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/preview/preview_banner.xml:0
msgid "(no access profile)"
msgstr "(aucun profil d'accès)"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
"(red, with the lock): hidden too, and Odoo refuses it however\n"
"                                    they try, with an error; each try is written to the audit log. Use it for what they\n"
"                                    must not do. Odoo's own automatic work (scheduled jobs, automations) still runs it."
msgstr ""
"(rouge, avec le cadenas) : masqué aussi, et Odoo le refuse quelle que soit\n"
"                                    la manière, avec une erreur ; chaque tentative est inscrite au journal d'audit. Utilisez-le pour ce qu'ils\n"
"                                    ne doivent pas faire. Le travail automatique d'Odoo (actions planifiées, automatisations) l'exécute toujours."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_panel.xml:0
msgid "+ Add a condition"
msgstr "+ Ajouter une condition"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
", except what\n"
"                            the cards below limit."
msgstr ""
", sauf ce que\n"
"                            limitent les cartes ci-dessous."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
". Limit some only if\n"
"                            needed: pick the data below."
msgstr ""
". N'en limitez que si\n"
"                            nécessaire : choisissez les données ci-dessous."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ". Tick more apps or untick them."
msgstr ". Cochez d'autres apps ou décochez-les."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_tree_field.js:0
msgid "1 hidden"
msgstr "1 masqué"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/wizard/om_access_explain.py:0
msgid "1. Odoo's own access"
msgstr "1. Accès propres à Odoo"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "1st click"
msgstr "1er clic"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/wizard/om_access_explain.py:0
msgid "2. Access profiles"
msgstr "2. Profils d'accès"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "2nd click"
msgstr "2e clic"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/wizard/om_access_explain.py:0
msgid "3. Also restricted on this data"
msgstr "3. Également restreint sur ces données"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "3rd click"
msgstr "3e clic"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ": as Odoo shows it."
msgstr " : tel qu'Odoo l'affiche."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
": not shown on the form, in lists or on cards, and blank in exports and "
"scripts."
msgstr ""
" : non affiché sur le formulaire, dans les listes ou sur les cartes, et vide"
" dans les exports et les scripts."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
#: code:addons/om_access_manager/static/src/menu_tree/menu_panel.xml:0
msgid ": own filter"
msgstr " : filtre personnalisé"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ": shown only in some states"
msgstr " : affichés seulement dans certains états"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
": they see it but cannot change it, on the screens, by import or by a "
"script."
msgstr ""
" : ils le voient mais ne peuvent pas le modifier, ni à l'écran, ni par "
"import, ni par un script."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ": they see the button and can use it."
msgstr " : ils voient le bouton et peuvent l'utiliser."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid ""
": they will see almost no records. Set it on\n"
"                                each user (Preferences or the user form), or use Only some... with the Warehouse."
msgstr ""
" : ils ne verront presque aucun enregistrement. Définissez-le sur\n"
"                                chaque utilisateur (Préférences ou formulaire de l'utilisateur), ou utilisez Seulement certains... avec l'Entrepôt."

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_profile_view_form
msgid ""
"<span class=\"text-muted\">\n"
"                                    The menus of the database. Untick a menu to hide it with\n"
"                                    everything below it; click a menu to decide what its users may\n"
"                                    do there. In developer mode, more tabs list the same rules in full.\n"
"                                </span>"
msgstr ""
"<span class=\"text-muted\">\n"
"                                    Les menus de la base de données. Décochez un menu pour le masquer avec\n"
"                                    tout ce qui se trouve en dessous ; cliquez sur un menu pour décider de ce que ses utilisateurs\n"
"                                    peuvent y faire. En mode développeur, d'autres onglets listent les mêmes règles en détail.\n"
"                                </span>"

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_profile_view_form
msgid ""
"<span>The Health Check found rules of this profile that need a look.</span>"
msgstr ""
"<span>Le Contrôle de santé a trouvé des règles de ce profil à "
"vérifier.</span>"

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_profile_element.py:0
msgid "A '%s' rule needs a name."
msgstr "Une règle '%s' doit avoir un nom."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_profile_element.py:0
msgid "A Settings App rule belongs to the Settings."
msgstr "Une règle d'app des Paramètres appartient aux Paramètres."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid ""
"A field marked 'may be slow on large data' has no database index: ask your "
"developer to add one if lists get slow."
msgstr ""
"Un champ marqué 'peut être lent sur de gros volumes' n'a pas d'index en base"
" de données : demandez à votre développeur d'en ajouter un si les listes "
"deviennent lentes."

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_import_view_form
msgid ""
"A file made with <strong>Export Profiles</strong> on another database. What\n"
"                    this database lacks (an app, a menu, a journal) is skipped and listed in the\n"
"                    chatter of the profile."
msgstr ""
"Un fichier créé avec <strong>Exporter les profils</strong> sur une autre base de données. Ce\n"
"                    qui manque à cette base de données (une app, un menu, un journal) est ignoré et listé dans le\n"
"                    chatter du profil."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.js:0
msgid "A filter of its own"
msgstr "Un filtre personnalisé"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "A filter of its own is set (by operation or on a menu)."
msgstr "Un filtre personnalisé est défini (par opération ou sur un menu)."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid "A filter on records also hides the new ones that do not match it."
msgstr ""
"Un filtre sur les enregistrements masque aussi les nouveaux qui n'y "
"correspondent pas."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/menu_tree/menu_panel.xml:0
msgid ""
"A hidden app leaves the Settings, and what only it holds cannot be saved."
msgstr ""
"Une app masquée quitte les Paramètres, et ce qu'elle seule contient ne peut "
"pas être enregistré."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid ""
"A hidden field is blank for these users in lists, exports and the external "
"API too."
msgstr ""
"Un champ masqué est aussi vide pour ces utilisateurs dans les listes, les "
"exports et l'API externe."

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_profile_view_form
msgid ""
"A hidden field is removed from the screen and is not fetched with\n"
"                                the record, but this is not a guarantee that its value cannot be\n"
"                                read: use a record filter for data that must not leak.\n"
"                                With a condition (<code>state == 'done'</code>,\n"
"                                <code>amount_total &gt; 1000</code>), the rule applies only to\n"
"                                the records that match it."
msgstr ""
"Un champ masqué est retiré de l'écran et n'est pas lu avec\n"
"                                l'enregistrement, mais cela ne garantit pas que sa valeur ne puisse pas être\n"
"                                lue : utilisez un filtre d'enregistrements pour les données qui ne doivent pas fuiter.\n"
"                                Avec une condition (<code>state == 'done'</code>,\n"
"                                <code>amount_total &gt; 1000</code>), la règle ne s'applique qu'aux\n"
"                                enregistrements qui la remplissent."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid "A menu with children passes its rights down to them."
msgstr "Un menu avec des sous-menus leur transmet ses droits."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid ""
"A new profile applies only from Finish. On a profile in use, each answer "
"applies at once."
msgstr ""
"Un nouveau profil ne s'applique qu'à partir de Terminer. Sur un profil déjà "
"utilisé, chaque réponse s'applique aussitôt."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_preview.py:0
msgid "A preview needs a browser session."
msgstr "Un aperçu nécessite une session de navigateur."

#. module: om_access_manager
#: model:ir.model.constraint,message:om_access_manager.constraint_om_access_profile_button_unique_button
msgid "A profile can only carry one rule per button."
msgstr "Un profil ne peut porter qu'une règle par bouton."

#. module: om_access_manager
#: model:ir.model.constraint,message:om_access_manager.constraint_om_access_profile_field_unique_field
msgid "A profile can only carry one rule per field."
msgstr "Un profil ne peut porter qu'une règle par champ."

#. module: om_access_manager
#: model:ir.model.constraint,message:om_access_manager.constraint_om_access_profile_menu_unique_menu
msgid "A profile can only carry one rule per menu."
msgstr "Un profil ne peut porter qu'une règle par menu."

#. module: om_access_manager
#: model:ir.model.constraint,message:om_access_manager.constraint_om_access_profile_model_unique_model
msgid "A profile can only carry one rule per model."
msgstr "Un profil ne peut porter qu'une règle par modèle."

#. module: om_access_manager
#: model:ir.model.constraint,message:om_access_manager.constraint_om_access_profile_element_unique_element
msgid "A profile can only carry one rule per view element."
msgstr "Un profil ne peut porter qu'une règle par élément de vue."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_profile.py:0
msgid ""
"A profile cannot grant %s: it would make its users administrators, or access"
" managers. Give it on the user form instead."
msgstr ""
"Un profil ne peut pas accorder %s : cela ferait de ses utilisateurs des "
"administrateurs ou des gestionnaires d'accès. Accordez-le plutôt sur la "
"fiche de l'utilisateur."

#. module: om_access_manager
#. odoo-python
#: code:addons/om_access_manager/models/om_access_profile.py:0
msgid "A profile cannot grant its own group."
msgstr "Un profil ne peut pas accorder son propre groupe."

#. module: om_access_manager
#: model:ir.model.constraint,message:om_access_manager.constraint_om_access_profile_version_number_unique
msgid "A profile has each version once."
msgstr "Un profil a chaque version une seule fois."

#. module: om_access_manager
#: model:ir.model.fields,help:om_access_manager.field_om_access_import__replace
msgid ""
"A profile of this database with the same name is overwritten. Unticked, the "
"imported one is created beside it, as '<name> (imported)'."
msgstr ""
"Un profil de cette base de données portant le même nom est écrasé. Si "
"décoché, le profil importé est créé à côté, sous le nom '<name> (importé)'."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid ""
"A profile set up one question at a time, on screens that look like Odoo "
"itself."
msgstr ""
"Un profil configuré une question à la fois, sur des écrans qui ressemblent à"
" Odoo lui-même."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid "A template only fills a new profile: change it freely afterwards."
msgstr ""
"Un modèle ne fait que remplir un nouveau profil : modifiez-le librement "
"ensuite."

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/help/help_dialog.js:0
msgid "A user covering for a colleague, for the length of the holiday."
msgstr "Un utilisateur qui remplace un collègue, le temps des congés."

#. module: om_access_manager
#: model:ir.model.fields,help:om_access_manager.field_res_users__access_profile_ids
msgid ""
"A user may carry several profiles. Additive profiles combine permissively, "
"override profiles always subtract."
msgstr ""
"Un utilisateur peut avoir plusieurs profils. Les profils additifs se "
"combinent de manière permissive, les profils prioritaires retirent toujours "
"des droits."

#. module: om_access_manager
#: model_terms:ir.ui.view,arch_db:om_access_manager.om_access_health_issue_view_list
msgid "Accept"
msgstr "Accepter"

#. module: om_access_manager
#. odoo-javascript
#: code:addons/om_access_manager/static/src/guided/guided_setup.xml:0
msgid "Access"
msgstr "Accès"

#. module: om_access_manager
#: model:ir.model,name:om_access_manager.model_res_groups
msgid "Access Groups"
