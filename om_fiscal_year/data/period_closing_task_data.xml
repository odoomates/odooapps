<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A basic month-end closing, shared by the companies. Edit, archive or add tasks from the Closing Tasks menu of
         the accounting configuration: the updates of the module leave them as they are. -->
    <data noupdate="1">

        <record id="closing_task_customer_invoices" model="account.period.closing.task">
            <field name="sequence">10</field>
            <field name="name">Invoice the goods delivered and the services provided in the period</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_vendor_bills" model="account.period.closing.task">
            <field name="sequence">20</field>
            <field name="name">Record the vendor bills received for the period</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_bank" model="account.period.closing.task">
            <field name="sequence">30</field>
            <field name="name">Reconcile the bank and cash accounts with their statements</field>
            <field name="note">The balance of each bank account in the books matches its statement at the end of the period.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_receivables_payables" model="account.period.closing.task">
            <field name="sequence">40</field>
            <field name="name">Match the payments with their invoices and review the aged receivables and payables</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_accruals" model="account.period.closing.task">
            <field name="sequence">50</field>
            <field name="name">Record the accruals of the expenses not billed yet</field>
            <field name="note">e.g. the electricity, rent and services of the period not billed at its end.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_prepayments" model="account.period.closing.task">
            <field name="sequence">60</field>
            <field name="name">Adjust the prepaid expenses and the revenue received in advance</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_depreciation" model="account.period.closing.task">
            <field name="sequence">70</field>
            <field name="name">Post the depreciation of the fixed assets</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_payroll" model="account.period.closing.task">
            <field name="sequence">80</field>
            <field name="name">Record the payroll with the salaries, social charges and taxes payable</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_currencies" model="account.period.closing.task">
            <field name="sequence">90</field>
            <field name="name">Check the exchange rates and the balances in foreign currencies</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_taxes" model="account.period.closing.task">
            <field name="sequence">100</field>
            <field name="name">Review the tax accounts and prepare the tax return</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="closing_task_review" model="account.period.closing.task">
            <field name="sequence">110</field>
            <field name="name">Review the Profit and Loss and the Balance Sheet against the previous period and the budget</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
