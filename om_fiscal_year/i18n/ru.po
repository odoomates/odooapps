#: model:ir.model.fields.selection,name:om_fiscal_year.selection__account_period_closing_check__status__warning
msgid "Warning"
msgstr "Предупреждение"

#. module: om_fiscal_year
#: model:ir.model.fields,field_description:om_fiscal_year.field_account_period_closing__warning_count
