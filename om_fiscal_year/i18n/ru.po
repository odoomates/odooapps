msgstr "Несверенные банковские транзакции"

#. module: om_fiscal_year
#: model:ir.model.fields,field_description:om_fiscal_year.field_account_fiscal_year_closing__unreconciled_statement_line_count
msgid "Unreconciled Statement Line Count"
msgstr "Количество несверенных строк выписки"

#. module: om_fiscal_year
#: model_terms:ir.ui.view,arch_db:om_fiscal_year.view_account_fiscal_year_closing_form
msgid "Unreconciled bank transactions"
msgstr "Несверенные банковские транзакции"

#. module: om_fiscal_year
#: model_terms:ir.ui.view,arch_db:om_fiscal_year.view_account_fiscal_year_closing_form
msgid "View"
msgstr "Просмотр"

