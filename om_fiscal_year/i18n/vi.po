msgstr ""
"Tài khoản lợi nhuận chưa phân phối %s phải là tài khoản vốn chủ sở hữu."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_period_closing.py:0
msgid "The start date of the closing must be before its end date."
msgstr "Ngày bắt đầu của lần khóa sổ phải trước ngày kết thúc."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_period_closing.py:0
