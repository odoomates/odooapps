#: code:addons/om_fiscal_year/models/account_fiscal_year.py:0
msgid ""
"The dates and the company of a closed fiscal year cannot be changed. Reopen "
"it first."
msgstr ""
"Nie można zmienić dat ani firmy zamkniętego roku obrotowego. Najpierw otwórz"
" go ponownie."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_fiscal_year.py:0
msgid ""
"The earnings are transferred from an account of type Current Year Earnings."
msgstr "Wynik jest przenoszony z konta typu Zarobki bieżącego roku."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_fiscal_year.py:0
msgid "The ending date must not be prior to the starting date."
msgstr "Data końcowa nie może być wcześniejsza niż data początkowa."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_fiscal_year.py:0
msgid "The fiscal year %s is already closed."
msgstr "Rok obrotowy %s jest już zamknięty."

#. module: om_fiscal_year
#: model:ir.model.fields,help:om_fiscal_year.field_account_period_closing__lock_type
msgid ""
"The lock date set on the company when the period is closed. The permanent "
"lock is set from the lock dates of the company."
msgstr ""
"Data blokady ustawiana w firmie po zamknięciu okresu. Blokada trwała jest "
"ustawiana na podstawie dat blokady firmy."

#. module: om_fiscal_year
#: model_terms:ir.ui.view,arch_db:om_fiscal_year.view_account_period_closing_form
msgid ""
"The lock dates set by this closing go back to their previous value. Reopen "
"the period?"
msgstr ""
"Daty blokady ustawione przez to zamknięcie wracają do poprzednich wartości. "
"Otworzyć ponownie okres?"

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_period_closing.py:0
msgid "The period %s is closed."
msgstr "Okres %s jest zamknięty."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_period_closing.py:0
msgid "The period %s overlaps another closing."
msgstr "Okres %s nakłada się na inne zamknięcie."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_period_closing.py:0
msgid "The period stays locked: it is before the permanent lock date."
msgstr "Okres pozostaje zablokowany: jest przed trwałą datą blokady."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_fiscal_year.py:0
msgid "The retained earnings account %s must be an Equity account."
msgstr "Konto zysków zatrzymanych %s musi być kontem kapitału własnego."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_period_closing.py:0
msgid "The start date of the closing must be before its end date."
msgstr ""
"Data początkowa zamknięcia musi być wcześniejsza niż jego data końcowa."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_period_closing.py:0
msgid "This check no longer exists, refresh the checklist."
msgstr "Ta kontrola już nie istnieje, odśwież listę kontrolną."

#. module: om_fiscal_year
#. odoo-python
#: code:addons/om_fiscal_year/models/account_move.py:0
msgid ""
"This entry closes the fiscal year %s. Reopen the fiscal year instead of "
"changing it."
msgstr ""
"Ten zapis zamyka rok obrotowy %s. Zamiast go zmieniać, otwórz ponownie rok "
"obrotowy."

#. module: om_fiscal_year
