<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_schedule_view_form" model="ir.ui.view">
        <field name="name">om.inventory.report.schedule.form</field>
        <field name="model">om.inventory.report.schedule</field>
        <field name="arch" type="xml">
            <form string="Scheduled Report">
                <header>
                    <button name="action_send_now" type="object" string="Send Now" class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Weekly stock for the warehouse team"/></h1>
                    </div>
                    <group>
                        <group string="Report">
                            <field name="view_id" options="{'no_create': True}"/>
                            <field name="file_format" widget="radio" options="{'horizontal': true}"/>
                            <field name="expand_all"/>
                        </group>
                        <group string="Sending">
                            <field name="interval"/>
                            <field name="next_date"/>
                            <field name="last_sent" invisible="not last_sent"/>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Recipients">
                        <field name="partner_ids" widget="many2many_tags_email" nolabel="1" colspan="2"
                               placeholder="Who receives the report..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="report_schedule_view_list" model="ir.ui.view">
        <field name="name">om.inventory.report.schedule.list</field>
        <field name="model">om.inventory.report.schedule</field>
        <field name="arch" type="xml">
            <list string="Scheduled Reports">
                <field name="name"/>
                <field name="view_id"/>
                <field name="file_format"/>
                <field name="interval"/>
                <field name="next_date"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="last_sent" optional="show"/>
            </list>
        </field>
    </record>

    <record id="report_schedule_view_search" model="ir.ui.view">
        <field name="name">om.inventory.report.schedule.search</field>
        <field name="model">om.inventory.report.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="view_id"/>
                <field name="partner_ids"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_report_schedule" model="ir.actions.act_window">
        <field name="name">Scheduled Reports</field>
        <field name="res_model">om.inventory.report.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Send an inventory report by email, regularly</p>
            <p>Save a view of a report (its filters, grouping and columns), then choose who receives it,
               how often, and as PDF or Excel.</p>
        </field>
    </record>

</odoo>
