<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_batch_payment_form" model="ir.ui.view">
        <field name="name">account.batch.payment.form.reconcile</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="om_account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_statement_lines" type="object" class="oe_stat_button"
                        icon="fa-university" invisible="state == 'draft'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Bank</span>
                        <span class="o_stat_text">Transactions</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
