<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om.theme.lite</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <div id="om_theme_lite">
                    <h2>Theme</h2>
                    <div class="row mt16 o_settings_container" name="om_theme_lite_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="om_home_background">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Home screen background</span>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                      aria-label="Values set here are company-specific." role="img"/>
                                <div class="text-muted">A picture behind the app launcher and on the login page</div>
                                <div class="content-group mt8">
                                    <field name="om_home_background" widget="image" class="w-50"
                                           options="{'size': [0, 90]}"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="om_favicon">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Favicon</span>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific."
                                      aria-label="Values set here are company-specific." role="img"/>
                                <div class="text-muted">The small icon in the browser tab</div>
                                <div class="content-group mt8">
                                    <field name="om_favicon" widget="image" class="w-25"
                                           options="{'size': [0, 48]}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
