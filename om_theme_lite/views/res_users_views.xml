<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The theme choices, under the language and time zone of My Preferences. -->
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.om.theme.lite</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <!-- after om_chatter_position, whose field it moves into the Theme group -->
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="after">
                <group name="om_theme_preferences" string="Theme">
                    <field name="om_color_scheme" readonly="0"/>
                    <field name="om_sidebar_type" readonly="0"/>
                    <field name="om_dialog_size" readonly="0"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='om_sidebar_type']" position="after">
                <xpath expr="//field[@name='om_chatter_position']" position="move"/>
            </xpath>
        </field>
    </record>

</odoo>
