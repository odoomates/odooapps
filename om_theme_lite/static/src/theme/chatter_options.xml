<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- show or hide field changes, at the start of the chatter's right-hand tools -->
    <t t-inherit="mail.ChatterTopbar" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_ChatterTopbar_rightSection')]" position="inside">
            <button type="button" class="btn btn-link px-1 o_om_tracking_toggle order-first"
                    t-att-class="{ 'text-muted': !this.omState.hideTracking, 'o_om_active': this.omState.hideTracking }"
                    t-att-title="this.omState.hideTracking ? 'Show field changes' : 'Hide field changes'"
                    aria-label="Hide field changes" t-on-click="() => this.omToggleTracking()">
                <i class="fa fa-filter fa-fw" role="img"/>
            </button>
        </xpath>
    </t>

    <!-- the edge to drag; it only shows when the chatter sits beside the form -->
    <t t-inherit="mail.Chatter" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_Chatter')]" position="inside">
            <div class="o_om_chatter_resize"
                 title="Drag to resize, double-click to reset"
                 t-on-pointerdown="(ev) => this.omStartResize(ev)"
                 t-on-dblclick="() => this.omResetWidth()"/>
        </xpath>
    </t>

</templates>
