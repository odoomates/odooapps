#: code:addons/om_account_pdc/models/account_pdc.py:0
msgid ""
"Set the PDC accounts in the accounting settings, or a PDC account on the "
"cheque."
msgstr "Legen Sie die PDC-Konten in den Buchhaltungseinstellungen fest oder ein PDC-Konto auf dem Scheck."

#. module: om_account_pdc
#. odoo-python
#: code:addons/om_account_pdc/models/account_pdc.py:0
msgid "Set the PDC journal in the accounting settings first."
msgstr "Legen Sie zuerst das PDC-Journal in den Buchhaltungseinstellungen fest."

#. module: om_account_pdc
#: model:ir.model.fields,field_description:om_account_pdc.field_account_pdc__state
msgid "State"
msgstr "Status"

#. module: om_account_pdc
#: model_terms:ir.ui.view,arch_db:om_account_pdc.account_pdc_view_search
msgid "Status"
msgstr "Status"

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_account_pdc__activity_state
msgid ""
"Status based on activities\n"
"Overdue: Due date is already passed\n"
"Today: Activity date is today\n"
"Planned: Future activities."
msgstr "Status basierend auf Aktivitäten\nÜberfällig: Fälligkeitsdatum bereits überschritten\nHeute: Aktivitätsdatum ist heute\nGeplant: Zukünftige Aktivitäten."

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_account_pdc__pdc_account_id
msgid ""
"The account holding the cheques until they are cleared: an asset for the "
"cheques received, a liability for the cheques issued."
msgstr "Das Konto, auf dem die Schecks bis zur Einlösung stehen: ein Aktivkonto für erhaltene Schecks, ein Passivkonto für ausgestellte Schecks."

#. module: om_account_pdc
#: model_terms:ir.ui.view,arch_db:om_account_pdc.res_config_settings_view_form_pdc
msgid ""
"The accounts holding the cheques until they are cleared, and the journal of "
"their registration."
msgstr "Die Konten, auf denen die Schecks bis zur Einlösung stehen, und das Journal ihrer Erfassung."

#. module: om_account_pdc
#: model:ir.model.constraint,message:om_account_pdc.constraint_account_pdc_positive_amount
msgid "The amount of a cheque must be positive."
msgstr "Der Betrag eines Schecks muss positiv sein."

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_account_pdc__journal_id
msgid "The bank account the cheque is cleared into, or paid from."
msgstr "Das Bankkonto, auf das der Scheck eingelöst oder von dem er bezahlt wird."

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_account_pdc__bank_name
msgid "The bank the cheque is drawn on."
msgstr "Die Bank, auf die der Scheck gezogen ist."

#. module: om_account_pdc
#. odoo-python
#: code:addons/om_account_pdc/models/account_pdc.py:0
msgid "The cheque %(cheque)s cannot be cleared before its date, %(date)s."
msgstr "Der Scheck %(cheque)s kann nicht vor seinem Datum, %(date)s, eingelöst werden."

#. module: om_account_pdc
#. odoo-python
#: code:addons/om_account_pdc/models/account_pdc.py:0
msgid "The cheque bounced: its invoices are open again."
msgstr "Der Scheck ist geplatzt: Seine Rechnungen sind wieder offen."

#. module: om_account_pdc
#: model_terms:ir.ui.view,arch_db:om_account_pdc.account_pdc_view_form
msgid ""
"The cheque bounced: its registration is reversed and its invoices are open "
"again. Go on?"
msgstr "Der Scheck ist geplatzt: Seine Erfassung wird storniert und seine Rechnungen sind wieder offen. Fortfahren?"

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_account_pdc__cheque_date
msgid "The date written on the cheque: it cannot be cashed before it."
msgstr "Das auf dem Scheck angegebene Datum: Vorher kann er nicht eingelöst werden."

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_account_pdc__date
msgid ""
"The day the cheque is received or issued: the date of its registration."
msgstr "Der Tag, an dem der Scheck erhalten oder ausgestellt wird: das Datum seiner Erfassung."

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_account_pdc__invoice_ids
msgid ""
"The invoices or bills the cheque pays: they are matched when it is "
"registered."
msgstr "Die Kunden- oder Lieferantenrechnungen, die der Scheck bezahlt: Sie werden bei seiner Erfassung abgeglichen."

#. module: om_account_pdc
#. odoo-python
#: code:addons/om_account_pdc/models/account_pdc.py:0
msgid "The journal %(journal)s has no bank account."
msgstr "Das Journal %(journal)s hat kein Bankkonto."

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_res_company__pdc_journal_id
#: model:ir.model.fields,help:om_account_pdc.field_res_config_settings__pdc_journal_id
msgid ""
"The journal of the registration of the cheques; the clearing goes to their "
"bank journal."
msgstr "Das Journal für die Erfassung der Schecks; die Einlösung erfolgt in ihrem Bankjournal."

#. module: om_account_pdc
#: model_terms:ir.ui.view,arch_db:om_account_pdc.account_pdc_view_search
msgid "To Clear"
msgstr "Einzulösen"

#. module: om_account_pdc
#: model_terms:ir.ui.view,arch_db:om_account_pdc.account_pdc_view_form
#: model_terms:ir.ui.view,arch_db:om_account_pdc.account_pdc_view_list
msgid "Total"
msgstr "Gesamt"

#. module: om_account_pdc
#: model:ir.model.fields,field_description:om_account_pdc.field_account_pdc__pdc_type
msgid "Type"
msgstr "Typ"

#. module: om_account_pdc
#: model:ir.model.fields,help:om_account_pdc.field_account_pdc__activity_exception_decoration
msgid "Type of the exception activity on record."
msgstr "Typ der Ausnahmeaktivität im Datensatz."

