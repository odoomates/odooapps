<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_pdc_receive" model="ir.sequence">
            <field name="name">Post-dated Cheques Received</field>
            <field name="code">account.pdc.receive</field>
            <field name="prefix">PDC/IN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_pdc_issue" model="ir.sequence">
            <field name="name">Post-dated Cheques Issued</field>
            <field name="code">account.pdc.issue</field>
            <field name="prefix">PDC/OUT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="cron_pdc_maturity" model="ir.cron">
            <field name="name">Post-dated Cheques: remind the cheques reaching their date</field>
            <field name="model_id" ref="model_account_pdc"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_maturity()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
