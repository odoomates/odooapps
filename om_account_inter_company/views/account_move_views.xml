<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_om_ic" model="ir.ui.view">
        <field name="name">account.move.form.om.ic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning mb-0 d-flex align-items-center gap-2" role="alert" invisible="not om_ic_warning">
                    <i class="oi" data-icon="warning"/>
                    <span class="fw-bold text-nowrap">Inter-Company:</span>
                    <field name="om_ic_warning" class="flex-grow-1 mb-0"/>
                    <button name="action_om_ic_retry" type="object" string="Try Again" class="btn btn-sm btn-secondary"
                            invisible="om_ic_source_move_id or om_ic_mirror_ids or state != 'posted'"/>
                    <button name="action_om_ic_dismiss" type="object" string="Dismiss" class="btn btn-sm btn-link"/>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="om_ic_source_move_id" invisible="1"/>
                <field name="om_ic_mirror_ids" invisible="1"/>
                <button name="action_om_ic_open" type="object" class="oe_stat_button" icon="swap_horiz"
                        invisible="not om_ic_link_name">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text"><field name="om_ic_link_company" readonly="1"/></span>
                        <span class="o_stat_value"><field name="om_ic_link_name" readonly="1"/></span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//page[@name='other_info']//group[@name='accounting_info_group']" position="inside">
                <field name="om_ic_rule_id" invisible="not om_ic_rule_id" readonly="1" groups="account.group_account_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_om_ic" model="ir.ui.view">
        <field name="name">account.move.list.om.ic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="om_ic_link_name" string="Inter-Company" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_filter_om_ic" model="ir.ui.view">
        <field name="name">account.move.search.om.ic</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="to_check" position="after">
                <filter name="om_inter_company" string="Inter-Company" domain="[('partner_id.om_inter_company', '=', True)]"
                        groups="base.group_multi_company"/>
                <filter name="om_ic_warning" string="Inter-Company Warnings" domain="[('om_ic_warning', '!=', False)]"
                        groups="base.group_multi_company"/>
            </filter>
        </field>
    </record>
</odoo>
