<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form_om_ic" model="ir.ui.view">
        <field name="name">account.account.form.om.ic</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="om_inter_company"/>
            </field>
        </field>
    </record>

    <record id="view_account_list_om_ic" model="ir.ui.view">
        <field name="name">account.account.list.om.ic</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <field name="reconcile" position="after">
                <field name="om_inter_company" widget="boolean_toggle" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
