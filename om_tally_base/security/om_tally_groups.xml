<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_tally" model="res.groups.privilege">
        <field name="name">Tally Import</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_om_tally_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_tally"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sees the imports from Tally and the data read from Tally.</field>
    </record>

    <record id="group_om_tally_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_tally"/>
        <field name="implied_ids" eval="[Command.link(ref('group_om_tally_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Connects to Tally, maps the data and imports it.</field>
    </record>
</odoo>
