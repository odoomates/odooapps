<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_om_tally_sync" model="ir.cron">
        <field name="name">Tally: read the changes</field>
        <field name="model_id" ref="model_om_tally_import"/>
        <field name="state">code</field>
        <field name="code">model._cron_om_tally_sync()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_om_tally_read" model="ir.cron">
        <field name="name">Tally: read in the background</field>
        <field name="model_id" ref="model_om_tally_import"/>
        <field name="state">code</field>
        <field name="code">model._cron_om_tally_read()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
