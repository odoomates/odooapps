<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_currency_form_om_aed" model="ir.ui.view">
        <field name="name">res.currency.form.om.aed.symbol</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header invisible="name != 'AED' or symbol == '&#x20C3;'">
                    <button name="action_om_use_dirham_sign" type="object" string="Use UAE Dirham Sign" class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
