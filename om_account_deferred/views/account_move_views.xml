<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_om_deferred" model="ir.ui.view">
        <field name="name">account.move.form.inherit.om.deferred</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="before">
                <field name="om_deferred_start_date" optional="hide"/>
                <field name="om_deferred_end_date" optional="hide"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_om_open_deferrals"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="om_deferral_count == 0">
                    <field name="om_deferral_count" widget="statinfo" string="Deferrals"/>
                </button>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_om_generate_deferrals" type="object"
                        string="Generate Deferrals" class="btn-secondary"
                        invisible="state != 'posted' or not om_has_deferrals or om_deferral_count &gt; 0 or om_deferred_generation == 'manual'"/>
                <field name="om_has_deferrals" invisible="1"/>
                <field name="om_deferral_count" invisible="1"/>
                <field name="om_deferred_origin_id" invisible="1"/>
                <field name="om_deferred_generation" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
