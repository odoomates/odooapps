<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_verification_code" model="mail.template">
            <field name="name">WhatsApp Assistant: verification code</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Your verification code: {{ ctx.get('om_ai_whatsapp_code') }}</field>
            <field name="email_from">{{ (object.env.company.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.email_formatted }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="description">Mailed when a customer asks the WhatsApp assistant for their invoices, balance or addresses</field>
            <field name="body_html" type="html">
<div>
    Hello <t t-out="object.name or ''">Steve Miller</t>,<br/><br/>
    Type this code in your WhatsApp chat with <t t-out="object.env.company.name or ''">YourCompany</t>:<br/><br/>
    <span style="font-size: 24px; font-weight: bold; letter-spacing: 4px;" t-out="ctx.get('om_ai_whatsapp_code') or ''">123456</span><br/><br/>
    It is valid for 15 minutes. If you did not ask for it, ignore this email: nobody can use it without your phone.
</div>
            </field>
            <field name="lang">{{ object.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
