<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.om.ai.whatsapp</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_reporting']" position="inside">
                <field name="om_ai_whatsapp_conversation_id" invisible="not om_ai_whatsapp_conversation_id"/>
                <field name="om_ai_whatsapp_link_date" invisible="not om_ai_whatsapp_link_date"/>
                <field name="om_ai_whatsapp_reminded" invisible="not om_ai_whatsapp_reminded"/>
            </xpath>
        </field>
    </record>
</odoo>
