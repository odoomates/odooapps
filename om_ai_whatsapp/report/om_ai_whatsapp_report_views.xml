<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_ai_whatsapp_report_view_pivot" model="ir.ui.view">
        <field name="name">om.ai.whatsapp.report.pivot</field>
        <field name="model">om.ai.whatsapp.report</field>
        <field name="arch" type="xml">
            <pivot string="WhatsApp Assistant" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="conversation_count" type="measure"/>
                <field name="reply_count" type="measure"/>
                <field name="handover_count" type="measure"/>
                <field name="quotation_count" type="measure"/>
                <field name="order_count" type="measure"/>
                <field name="revenue" type="measure"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="om_ai_whatsapp_report_view_graph" model="ir.ui.view">
        <field name="name">om.ai.whatsapp.report.graph</field>
        <field name="model">om.ai.whatsapp.report</field>
        <field name="arch" type="xml">
            <graph string="WhatsApp Assistant" type="bar" sample="1">
                <field name="date" interval="week"/>
                <field name="conversation_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="om_ai_whatsapp_report_view_list" model="ir.ui.view">
        <field name="name">om.ai.whatsapp.report.list</field>
        <field name="model">om.ai.whatsapp.report</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="conversation_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
                <field name="reply_count" sum="Total"/>
                <field name="handover_count" sum="Total"/>
                <field name="quotation_count" sum="Total"/>
                <field name="order_count" sum="Total"/>
                <field name="revenue" sum="Total"/>
                <field name="cost" sum="Total"/>
                <field name="tokens" sum="Total" optional="hide"/>
                <field name="account_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="om_ai_whatsapp_report_view_search" model="ir.ui.view">
        <field name="name">om.ai.whatsapp.report.search</field>
        <field name="model">om.ai.whatsapp.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="account_id"/>
                <filter name="filter_date" string="Date" date="date"/>
                <separator/>
                <filter name="filter_handover" string="Handed Over" domain="[('handover_count', '>', 0)]"/>
                <filter name="filter_orders" string="With Orders" domain="[('order_count', '>', 0)]"/>
                <group>
                    <filter name="group_account" string="WhatsApp Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="om_ai_whatsapp_report_action" model="ir.actions.act_window">
        <field name="name">AI Assistant Analysis</field>
        <field name="res_model">om.ai.whatsapp.report</field>
        <field name="path">whatsapp-ai-analysis</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No data yet</p>
            <p>Conversations answered by the assistant, hand-overs, quotations and orders made, revenue and the AI
                cost of each conversation.</p>
        </field>
    </record>
</odoo>
