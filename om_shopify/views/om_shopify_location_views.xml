<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_shopify_location_view_list" model="ir.ui.view">
        <field name="name">om.shopify.location.list</field>
        <field name="model">om.shopify.location</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0">
                <field name="sequence" widget="handle"/>
                <field name="store_id" readonly="1"/>
                <field name="name"/>
                <field name="warehouse_id"/>
                <field name="shopify_active"/>
            </list>
        </field>
    </record>

    <record id="om_shopify_location_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">om.shopify.location</field>
        <field name="view_mode">list</field>
    </record>

    <record id="om_shopify_gateway_view_list" model="ir.ui.view">
        <field name="name">om.shopify.gateway.list</field>
        <field name="model">om.shopify.gateway</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0">
                <field name="store_id" readonly="1"/>
                <field name="name"/>
                <field name="workflow_id"/>
            </list>
        </field>
    </record>

    <record id="om_shopify_gateway_action" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">om.shopify.gateway</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No payment method yet</p>
            <p>The payment methods are listed here when Odoo imports the first orders paid with them.</p>
        </field>
    </record>
</odoo>
