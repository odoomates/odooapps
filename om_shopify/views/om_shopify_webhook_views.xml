<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_shopify_webhook_view_list" model="ir.ui.view">
        <field name="name">om.shopify.webhook.list</field>
        <field name="model">om.shopify.webhook</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="store_id"/>
                <field name="topic"/>
                <field name="uri"/>
                <field name="shopify_gid" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="om_shopify_webhook_action" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">om.shopify.webhook</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No webhooks yet</p>
            <p>Connect a store with a public https address: Odoo subscribes to the webhooks it needs.</p>
        </field>
    </record>
</odoo>
