<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_om_shopify" model="ir.ui.view">
        <field name="name">sale.order.form.om.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_shopify_release" type="object" string="Release" class="btn-primary"
                        invisible="not shopify_on_hold" groups="om_shopify.group_om_shopify_user"/>
                <button name="action_shopify_cancel" type="object" string="Cancel in Shopify"
                        invisible="not shopify_store_id or shopify_cancelled or state == 'cancel'"
                        groups="om_shopify.group_om_shopify_user"/>
            </header>
            <sheet position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not shopify_on_hold">
                    Shopify finds this order risky (<field name="shopify_risk" readonly="1"/>): its workflow waits.
                    Check it, then click Release, or cancel it in Shopify.
                </div>
            </sheet>
            <notebook position="inside">
                <page string="Shopify" name="shopify" invisible="not shopify_store_id">
                    <group>
                        <group>
                            <field name="shopify_store_id"/>
                            <field name="shopify_order_name"/>
                            <field name="shopify_gateway_id"/>
                            <field name="shopify_workflow_id"/>
                            <field name="shopify_source"/>
                        </group>
                        <group>
                            <field name="shopify_financial_status"/>
                            <field name="shopify_fulfillment_status"/>
                            <field name="shopify_risk"/>
                            <field name="shopify_risk_message" invisible="not shopify_risk_message"/>
                            <field name="shopify_on_hold" invisible="1"/>
                            <field name="shopify_cancelled"/>
                            <button name="action_open_in_shopify" type="object" string="Open in Shopify"
                                    class="btn-link p-0" icon="open_in_new"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_order_tree_inherit_om_shopify" model="ir.ui.view">
        <field name="name">sale.order.list.om.shopify</field>
        <field name="model">sale.order</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="shopify_order_name"/>
                <field name="shopify_store_id" optional="hide"/>
            </field>
            <field name="partner_id" position="after">
                <field name="shopify_financial_status" optional="show"/>
                <field name="shopify_fulfillment_status" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_om_shopify" model="ir.ui.view">
        <field name="name">sale.order.search.om.shopify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="shopify_order_name"/>
            </field>
            <filter name="my_sale_orders_filter" position="after">
                <filter name="filter_shopify" string="Shopify" domain="[('shopify_store_id', '!=', False)]"/>
                <filter name="filter_shopify_hold" string="Risky (On Hold)" domain="[('shopify_on_hold', '=', True)]"/>
            </filter>
        </field>
    </record>

    <record id="om_shopify_sale_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="view_id" ref="view_order_tree_inherit_om_shopify"/>
        <field name="domain">[('shopify_store_id', '!=', False)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Shopify order yet</p>
            <p>The orders of the connected stores are imported every 15 minutes, and at once with webhooks.</p>
        </field>
    </record>
</odoo>
