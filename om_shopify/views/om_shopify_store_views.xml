<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_shopify_store_view_form" model="ir.ui.view">
        <field name="name">om.shopify.store.form</field>
        <field name="model">om.shopify.store</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_shopify_oauth_start" type="object" string="Connect with Shopify" class="btn-primary"
                            invisible="auth_type != 'oauth' or state == 'connected'" groups="om_shopify.group_om_shopify_manager"/>
                    <button name="action_shopify_connect" type="object" string="Connect" class="btn-primary"
                            invisible="state == 'connected' or auth_type == 'oauth'" groups="om_shopify.group_om_shopify_manager"/>
                    <button name="action_shopify_connect" type="object" string="Test Connection"
                            invisible="state != 'connected'" groups="om_shopify.group_om_shopify_manager"/>
                    <button name="action_shopify_import_products" type="object" string="Import Products"
                            invisible="state != 'connected'"/>
                    <button name="action_shopify_import_orders" type="object" string="Import Orders"
                            invisible="state != 'connected'"/>
                    <button name="action_shopify_export_stock" type="object" string="Send Stock"
                            invisible="state != 'connected'"/>
                    <button name="action_shopify_import_stock" type="object" string="Import Stock"
                            invisible="state != 'connected'"/>
                    <button name="action_shopify_import_customers" type="object" string="Import Customers"
                            invisible="state != 'connected'"/>
                    <button name="action_shopify_export_prices" type="object" string="Send Prices"
                            invisible="state != 'connected'"/>
                    <button name="action_shopify_import_payouts" type="object" string="Import Payouts"
                            invisible="state != 'connected' or not payout_journal_id"/>
                    <button name="action_shopify_sync_webhooks" type="object" string="Sync Webhooks"
                            invisible="state != 'connected'" groups="om_shopify.group_om_shopify_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-info mb-0" role="alert" groups="base.group_system"
                     invisible="secret_key_source != 'database'">
                    The Shopify secrets are encrypted with the secret of the database. For a stronger key, add
                    <code>om_connector_key = a-long-random-text</code> to the Odoo configuration file, restart, and enter
                    the credentials again.
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="state != 'error' or not last_error">
                    <field name="last_error"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_products" type="object" class="oe_stat_button" icon="inventory_2">
                            <field name="product_count" widget="statinfo"/>
                        </button>
                        <button name="action_open_orders" type="object" class="oe_stat_button" icon="shopping_cart">
                            <field name="order_count" widget="statinfo"/>
                        </button>
                        <button name="action_open_connector_jobs" type="object" class="oe_stat_button" icon="task_alt">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="connector_job_todo_count"/></span>
                                <span class="o_stat_text">To Do</span>
                            </div>
                        </button>
                        <button name="action_open_connector_jobs" type="object" class="oe_stat_button text-danger"
                                icon="warning" invisible="not connector_job_failed_count">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="connector_job_failed_count"/></span>
                                <span class="o_stat_text">Failed</span>
                            </div>
                        </button>
                        <button name="action_open_webhooks" type="object" class="oe_stat_button" icon="bolt">
                            <field name="webhook_count" string="Webhooks" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. My Store"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="shop_domain" placeholder="my-store.myshopify.com"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group invisible="not shop_gid">
                            <field name="shop_name"/>
                            <field name="shop_email"/>
                            <field name="shop_currency_id"/>
                            <field name="shop_timezone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Orders" name="orders">
                            <group>
                                <group string="Import">
                                    <field name="order_auto_import"/>
                                    <field name="order_import_from"/>
                                    <field name="order_last_sync"/>
                                    <field name="order_import_test"/>
                                    <field name="order_import_pos"/>
                                    <field name="pos_partner_id" invisible="not order_import_pos"/>
                                    <field name="order_use_shopify_name"/>
                                    <field name="order_prefix" invisible="not order_use_shopify_name"/>
                                    <field name="order_currency"/>
                                </group>
                                <group string="Sale Orders">
                                    <field name="warehouse_id"/>
                                    <field name="team_id"/>
                                    <field name="user_id"/>
                                    <field name="order_warehouse_from_location"/>
                                    <field name="workflow_id"/>
                                    <field name="tax_mode"/>
                                    <field name="tax_account_id" invisible="tax_mode != 'shopify'"/>
                                    <field name="order_deliver_fulfilled"/>
                                    <field name="order_sync_edits"/>
                                    <field name="responsible_id"/>
                                </group>
                                <group string="Refunds">
                                    <field name="refund_import"/>
                                    <field name="refund_create_return" invisible="not refund_import"/>
                                    <field name="refund_validate_return" invisible="not refund_create_return"/>
                                    <field name="refund_restock_type"/>
                                    <field name="refund_notify"/>
                                </group>
                                <group string="Products of the Order Lines">
                                    <field name="shipping_product_id"/>
                                    <field name="tip_product_id"/>
                                    <field name="gift_card_product_id"/>
                                    <field name="custom_product_id"/>
                                    <field name="duties_product_id"/>
                                    <field name="refund_adjustment_product_id"/>
                                </group>
                            </group>
                            <separator string="Order Rules"/>
                            <div class="text-muted mb-2">The first rule an order matches gives its workflow and its
                                warehouse; else the payment method gives the workflow, and the store the warehouse.</div>
                            <field name="order_rule_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="gateway_id"/>
                                    <field name="financial_status"/>
                                    <field name="fulfillment_status"/>
                                    <field name="tag"/>
                                    <field name="source"/>
                                    <field name="workflow_id"/>
                                    <field name="warehouse_id"/>
                                </list>
                            </field>
                            <separator string="Payment Methods"/>
                            <div class="text-muted mb-2">The workflow of the orders paid with each payment method. A new
                                payment method gets the default workflow.</div>
                            <field name="gateway_ids">
                                <list editable="bottom" create="0">
                                    <field name="name"/>
                                    <field name="workflow_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Products" name="products">
                            <group>
                                <group>
                                    <field name="product_match"/>
                                    <field name="product_auto_create"/>
                                    <field name="product_import_images"/>
                                </group>
                                <group>
                                    <field name="product_auto_import"/>
                                    <field name="product_bulk_import"/>
                                    <field name="product_last_sync"/>
                                </group>
                                <group string="Export to Shopify">
                                    <field name="product_export_status"/>
                                    <field name="product_publish"/>
                                </group>
                                <group string="Prices">
                                    <field name="price_pricelist_id"/>
                                    <field name="compare_pricelist_id"/>
                                    <field name="price_auto_export"/>
                                </group>
                            </group>
                        </page>
                        <page string="Stock &amp; Delivery" name="stock">
                            <group>
                                <group string="Stock">
                                    <field name="stock_export"/>
                                    <field name="stock_field" invisible="not stock_export"/>
                                    <field name="stock_last_sync" invisible="not stock_export"/>
                                    <field name="stock_import_apply"/>
                                </group>
                                <group string="Fulfillment">
                                    <field name="fulfillment_push"/>
                                    <field name="fulfillment_notify" invisible="not fulfillment_push"/>
                                </group>
                            </group>
                            <separator string="Locations"/>
                            <div class="text-muted mb-2">The stock of the warehouse of a location is sent to it.
                                <button name="action_shopify_import_locations" type="object" string="Import Locations"
                                        class="btn-link p-0" invisible="state != 'connected'"/>
                            </div>
                            <field name="location_ids">
                                <list editable="bottom" create="0">
                                    <field name="name"/>
                                    <field name="warehouse_id"/>
                                    <field name="shopify_active"/>
                                </list>
                            </field>
                        </page>
                        <page string="B2B &amp; Metafields" name="b2b">
                            <group>
                                <group string="B2B (Shopify Plus)">
                                    <field name="b2b_import"/>
                                    <field name="b2b_tax_exempt_fiscal_position_id" invisible="not b2b_import"/>
                                </group>
                                <group>
                                    <div colspan="2">
                                        <button name="action_shopify_import_companies" type="object" string="Import Companies"
                                                class="btn-secondary me-2" invisible="state != 'connected' or not b2b_import"/>
                                        <button name="action_shopify_import_price_lists" type="object" string="Import Price Lists"
                                                class="btn-secondary" invisible="state != 'connected'"/>
                                    </div>
                                </group>
                            </group>
                            <separator string="Price Lists"/>
                            <div class="text-muted mb-2">The prices of the Odoo pricelist of a Shopify price list (market
                                or B2B catalog) are sent as its fixed prices, with Send Prices.</div>
                            <field name="price_list_ids">
                                <list editable="bottom" create="0">
                                    <field name="name"/>
                                    <field name="currency_code"/>
                                    <field name="pricelist_id"/>
                                </list>
                            </field>
                            <separator string="B2B Companies" invisible="not b2b_import"/>
                            <field name="company_binding_ids" invisible="not b2b_import" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="sync_date"/>
                                </list>
                            </field>
                            <separator string="Metafields"/>
                            <div class="text-muted mb-2">Shopify metafields copied to Odoo fields on import, or sent with
                                the product export.</div>
                            <field name="metafield_ids">
                                <list editable="bottom">
                                    <field name="resource"/>
                                    <field name="namespace"/>
                                    <field name="key"/>
                                    <field name="metafield_type"/>
                                    <field name="model_name" column_invisible="1"/>
                                    <field name="field_id" options="{'no_create': True}"/>
                                    <field name="direction"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payouts" name="payouts">
                            <group>
                                <group>
                                    <field name="payout_import"/>
                                    <field name="payout_mode" invisible="not payout_import"/>
                                    <field name="payout_journal_id" required="payout_import" invisible="not payout_import"
                                           string="Bank Journal"/>
                                    <field name="payout_last_sync" invisible="not payout_import"/>
                                    <button name="action_shopify_setup_payouts" type="object"
                                            string="Use a Transit Account (Set Up)" class="btn-link p-0" colspan="2"
                                            invisible="not payout_import or payout_mode == 'entry'"
                                            groups="account.group_account_manager"/>
                                </group>
                                <group invisible="not payout_import or payout_mode != 'entry'" string="Accounting">
                                    <field name="payout_transit_account_id"/>
                                    <field name="payout_fee_account_id"/>
                                    <field name="payout_adjustment_account_id"/>
                                    <field name="payout_clearing_account_id"/>
                                    <field name="payout_entry_journal_id"/>
                                    <button name="action_shopify_setup_payouts" type="object" string="Set Up Payouts"
                                            class="btn-secondary" colspan="2" groups="account.group_account_manager"/>
                                </group>
                                <group>
                                    <field name="customer_last_sync"/>
                                </group>
                            </group>
                        </page>
                        <page string="Connection" name="connection" groups="om_shopify.group_om_shopify_manager">
                            <group>
                                <group string="Credentials">
                                    <field name="auth_type" widget="radio"/>
                                    <field name="client_id" invisible="auth_type == 'token'"
                                           required="auth_type != 'token'"/>
                                    <field name="client_secret" password="True"
                                           required="auth_type != 'token'"/>
                                    <field name="access_token" password="True" invisible="auth_type != 'token'"
                                           required="auth_type == 'token'" placeholder="shpat_…"/>
                                    <field name="oauth_scopes" invisible="auth_type != 'oauth'"/>
                                    <field name="oauth_granted_scopes" invisible="auth_type != 'oauth' or not oauth_granted_scopes"/>
                                    <field name="oauth_redirect_url" widget="CopyClipboardChar" invisible="auth_type != 'oauth'"/>
                                    <field name="oauth_app_url" widget="CopyClipboardChar" invisible="auth_type != 'oauth'"/>
                                    <field name="token_expires_at" invisible="auth_type == 'token' or not token_expires_at"/>
                                    <field name="refresh_token_expires_at" invisible="auth_type != 'oauth' or not refresh_token_expires_at"/>
                                    <field name="api_version"/>
                                    <field name="secret_key_source"/>
                                </group>
                                <group string="Webhooks">
                                    <field name="webhook_base_url" placeholder="https://odoo.example.com"/>
                                    <field name="webhook_url" widget="CopyClipboardChar"/>
                                    <div colspan="2" class="text-muted small">Also the address of the compliance (GDPR)
                                        webhooks: copy it in the settings of your app in the Shopify Dev Dashboard.</div>
                                    <field name="gdpr_anonymize"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                <p class="mb-1"><strong>Client ID and Secret:</strong> in the Shopify Dev Dashboard, create an app,
                                    give it the Admin API scopes of the modules you use, install it on this store, and copy its
                                    client ID and secret here.</p>
                                <p class="mb-1"><strong>Install by Link (OAuth):</strong> in the Dev Dashboard, set the App URL
                                    and the Redirection URL below in your app, copy its client ID and secret here, then click
                                    Connect with Shopify: the merchant approves the scopes on Shopify, and comes back here.</p>
                                <p class="mb-0"><strong>Admin API Access Token:</strong> for a custom app made in the admin of the
                                    store; also copy its API secret key in Client Secret, to receive webhooks.</p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="om_shopify_store_view_list" model="ir.ui.view">
        <field name="name">om.shopify.store.list</field>
        <field name="model">om.shopify.store</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="shop_domain"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="connector_job_failed_count" string="Failed Jobs" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="om_shopify_store_view_kanban" model="ir.ui.view">
        <field name="name">om.shopify.store.kanban</field>
        <field name="model">om.shopify.store</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" highlight_color="color">
                <field name="color"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Settings</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <div class="d-flex align-items-start gap-2">
                            <div class="flex-grow-1 text-truncate">
                                <field name="name" class="fw-bold fs-4"/>
                                <div class="text-muted text-truncate"><field name="shop_domain"/></div>
                            </div>
                            <field name="state" widget="badge" class="flex-shrink-0 me-4"
                                   decoration-success="state == 'connected'" decoration-danger="state == 'error'"/>
                        </div>
                        <div class="d-flex gap-4 mt-3 fs-5" name="store_stats">
                            <a name="action_open_orders" type="object"><field name="order_count" class="fw-bold"/> orders</a>
                            <a name="action_open_products" type="object"><field name="product_count" class="fw-bold"/> products</a>
                        </div>
                        <div class="d-flex gap-3 mt-2 small">
                            <a name="action_open_connector_jobs" type="object" class="text-muted">
                                <field name="connector_job_todo_count"/> jobs to do
                            </a>
                            <a name="action_open_connector_jobs" type="object" class="text-danger"
                               invisible="not connector_job_failed_count">
                                <field name="connector_job_failed_count"/> failed
                            </a>
                        </div>
                        <div class="text-muted small mt-1" invisible="not order_last_sync">
                            Orders imported on <field name="order_last_sync"/>
                        </div>
                        <div class="mt-3 d-flex gap-2 flex-wrap" name="store_actions">
                            <button name="action_shopify_connect" type="object" class="btn btn-primary btn-sm"
                                    invisible="state == 'connected' or auth_type == 'oauth'" groups="om_shopify.group_om_shopify_manager">Connect</button>
                            <button name="action_shopify_oauth_start" type="object" class="btn btn-primary btn-sm"
                                    invisible="state == 'connected' or auth_type != 'oauth'" groups="om_shopify.group_om_shopify_manager">Connect with Shopify</button>
                            <button name="action_shopify_import_orders" type="object" class="btn btn-secondary btn-sm"
                                    invisible="state != 'connected'">Import Orders</button>
                            <button name="action_shopify_import_products" type="object" class="btn btn-secondary btn-sm"
                                    invisible="state != 'connected'">Import Products</button>
                            <button name="action_shopify_export_stock" type="object" class="btn btn-secondary btn-sm"
                                    invisible="state != 'connected'">Send Stock</button>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="om_shopify_store_view_search" model="ir.ui.view">
        <field name="name">om.shopify.store.search</field>
        <field name="model">om.shopify.store</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="shop_domain"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="om_shopify_store_action_dashboard" model="ir.actions.act_window">
        <field name="name">Shopify Stores</field>
        <field name="res_model">om.shopify.store</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect your first Shopify store</p>
            <p>Use Configuration &gt; Connect a Store: the address of the store and the credentials of your Shopify
               app, then the first imports.</p>
        </field>
    </record>

    <record id="om_shopify_store_action" model="ir.actions.act_window">
        <field name="name">Stores</field>
        <field name="res_model">om.shopify.store</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="om_shopify_job_action" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">om.connector.job</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('backend_model', '=', 'om.shopify.store')]</field>
        <field name="context">{'search_default_filter_todo_failed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to do</p>
            <p>The imports, exports and webhooks of your Shopify stores are queued here, and tried again when they fail.</p>
        </field>
    </record>
</odoo>
