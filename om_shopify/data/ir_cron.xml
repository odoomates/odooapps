<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_om_shopify_import_orders" model="ir.cron">
        <field name="name">Shopify: import the new orders</field>
        <field name="model_id" ref="model_om_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_import_orders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_om_shopify_export_stock" model="ir.cron">
        <field name="name">Shopify: send the stock</field>
        <field name="model_id" ref="model_om_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_export_stock()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>
    <record id="ir_cron_om_shopify_import_products" model="ir.cron">
        <field name="name">Shopify: import the changed products</field>
        <field name="model_id" ref="model_om_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_import_products()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="ir_cron_om_shopify_daily" model="ir.cron">
        <field name="name">Shopify: send the prices and import the payouts</field>
        <field name="model_id" ref="model_om_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_shopify_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
