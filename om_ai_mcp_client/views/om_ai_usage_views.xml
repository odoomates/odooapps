<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_ai_usage_view_list" model="ir.ui.view">
        <field name="name">om.ai.usage.list.mcp.client</field>
        <field name="model">om.ai.usage</field>
        <field name="inherit_id" ref="om_ai.om_ai_usage_view_list"/>
        <field name="arch" type="xml">
            <field name="model_name" position="after">
                <field name="mcp_remote_id" optional="hide"/>
                <field name="mcp_tool" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="om_ai_usage_view_form" model="ir.ui.view">
        <field name="name">om.ai.usage.form.mcp.client</field>
        <field name="model">om.ai.usage</field>
        <field name="inherit_id" ref="om_ai.om_ai_usage_view_form"/>
        <field name="arch" type="xml">
            <field name="model_name" position="after">
                <field name="mcp_remote_id" invisible="not mcp_remote_id"/>
                <field name="mcp_tool" invisible="not mcp_tool"/>
            </field>
        </field>
    </record>

    <record id="om_ai_usage_view_search" model="ir.ui.view">
        <field name="name">om.ai.usage.search.mcp.client</field>
        <field name="model">om.ai.usage</field>
        <field name="inherit_id" ref="om_ai.om_ai_usage_view_search"/>
        <field name="arch" type="xml">
            <field name="provider_id" position="after">
                <field name="mcp_remote_id"/>
                <field name="mcp_tool"/>
            </field>
            <filter name="blocked" position="after">
                <separator/>
                <filter name="filter_mcp_client" string="Outside MCP Tools" domain="[('mcp_remote_id', '!=', False)]"/>
            </filter>
            <filter name="group_status" position="after">
                <filter name="group_mcp_remote" string="Outside MCP Server" context="{'group_by': 'mcp_remote_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
