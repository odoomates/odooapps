<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="folder_expiry" model="om.documents.folder">
            <field name="name">Expiring Documents</field>
            <field name="sequence">8</field>
            <field name="owner_id" ref="base.user_admin"/>
            <field name="access_internal">none</field>
            <field name="read_group_ids" eval="[(4, ref('om_document.group_documents_manager'))]"/>
            <field name="write_group_ids" eval="[(4, ref('om_document.group_documents_manager'))]"/>
        </record>
    </data>

    <record id="ir_cron_expiry_reminders" model="ir.cron">
        <field name="name">Documents: remind of the documents about to expire</field>
        <field name="model_id" ref="om_document.model_om_documents_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_expiry_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

</odoo>
