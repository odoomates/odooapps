<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_document.DocumentsPreview">
        <t t-set="file" t-value="this.file"/>
        <div class="o_om_documents_preview border rounded p-2 text-center bg-100">
            <t t-if="!file">
                <div class="text-muted py-5">
                    <i class="oi oi-3x d-block mb-2" data-icon="upload"/>
                    <t t-if="this.props.record.data.request_state === 'missing'">Waiting for the requested file.</t>
                    <t t-else="">No file yet: upload one.</t>
                </div>
            </t>
            <t t-elif="file.isImage">
                <img t-att-src="file.defaultSource" t-att-alt="file.name" class="img-fluid"/>
            </t>
            <t t-elif="file.isPdf or file.isText or file.isUrlYoutube">
                <iframe t-att-src="file.defaultSource" t-att-title="file.name"/>
            </t>
            <t t-elif="file.isVideo">
                <video t-att-src="file.defaultSource" controls="controls"/>
            </t>
            <t t-else="">
                <div class="py-5">
                    <div class="o_image d-inline-block" style="width: 80px; height: 80px;" t-att-data-mimetype="file.mimetype"/>
                    <div class="mt-2 text-muted">No preview for this type of file.</div>
                </div>
            </t>
            <div t-if="file" class="mt-2">
                <button t-if="file.isViewable" type="button" class="btn btn-link btn-sm" t-on-click="this.openViewer">
                    <i class="oi me-1" data-icon="open_in_new"/>Full Screen
                </button>
                <a t-if="file.type === 'binary'" class="btn btn-link btn-sm" t-att-href="file.downloadUrl">
                    <i class="oi me-1" data-icon="download"/>Download
                </a>
                <a t-if="file.type === 'url'" class="btn btn-link btn-sm" t-att-href="file.url" target="_blank">
                    <i class="oi me-1" data-icon="open_in_new"/>Open the Link
                </a>
            </div>
        </div>
    </t>

</templates>
