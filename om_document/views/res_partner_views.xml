<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.om.documents</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_om_documents" type="object" class="oe_stat_button" icon="description"
                        groups="om_document.group_documents_user" invisible="not om_documents_count">
                    <field name="om_documents_count" widget="statinfo" string="Documents"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
