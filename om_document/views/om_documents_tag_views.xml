<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_documents_tag_category_view_list" model="ir.ui.view">
        <field name="name">om.documents.tag.category.list</field>
        <field name="model">om.documents.tag.category</field>
        <field name="arch" type="xml">
            <list string="Tag Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="folder_id"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </list>
        </field>
    </record>

    <record id="om_documents_tag_category_view_form" model="ir.ui.view">
        <field name="name">om.documents.tag.category.form</field>
        <field name="model">om.documents.tag.category</field>
        <field name="arch" type="xml">
            <form string="Tag Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Status"/>
                            <field name="folder_id" placeholder="All the folders"/>
                        </group>
                        <group>
                            <field name="tooltip"/>
                        </group>
                    </group>
                    <field name="tag_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tag_categories" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">om.documents.tag.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a tag category</p>
            <p>Tags sort the documents, e.g. a Status category with To Validate, Validated and Rejected.</p>
        </field>
    </record>

</odoo>
