<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_documents_request_wizard_view_form" model="ir.ui.view">
        <field name="name">om.documents.request.wizard.form</field>
        <field name="model">om.documents.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Request a Document">
                <group>
                    <group>
                        <field name="name" placeholder="e.g. Signed contract"/>
                        <field name="partner_id"/>
                        <field name="deadline"/>
                    </group>
                    <group>
                        <field name="folder_id" options="{'no_create': True}"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                        <field name="user_id" widget="many2one_avatar_user"/>
                    </group>
                </group>
                <field name="message" placeholder="A message for the contact..."/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <footer>
                    <button name="action_request" type="object" string="Request" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_request_wizard" model="ir.actions.act_window">
        <field name="name">Request a Document</field>
        <field name="res_model">om.documents.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="om_documents_move_wizard_view_form" model="ir.ui.view">
        <field name="name">om.documents.move.wizard.form</field>
        <field name="model">om.documents.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Move or Tag">
                <field name="document_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="folder_id" options="{'no_create': True}"/>
                        <field name="owner_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="add_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                        <field name="remove_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="om_documents_action_wizard_view_form" model="ir.ui.view">
        <field name="name">om.documents.action.wizard.form</field>
        <field name="model">om.documents.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Run an Action">
                <field name="document_ids" invisible="1"/>
                <field name="available_action_ids" invisible="1"/>
                <div class="text-muted mb-2" invisible="available_action_ids">
                    No action applies to these documents. An administrator adds actions to the folders.
                </div>
                <group invisible="not available_action_ids">
                    <field name="action_id" widget="radio"/>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Run" class="btn-primary"
                            invisible="not available_action_ids"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
