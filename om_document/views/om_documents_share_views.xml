<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_documents_share_view_search" model="ir.ui.view">
        <field name="name">om.documents.share.search</field>
        <field name="model">om.documents.share</field>
        <field name="arch" type="xml">
            <search string="Shares">
                <field name="name"/>
                <field name="partner_ids"/>
                <field name="folder_id"/>
                <filter name="live" string="Live" domain="[('state', '=', 'live')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="upload" string="Upload Links" domain="[('allow_upload', '=', True)]"/>
                <filter name="mine" string="Shared by Me" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="om_documents_share_view_list" model="ir.ui.view">
        <field name="name">om.documents.share.list</field>
        <field name="model">om.documents.share</field>
        <field name="arch" type="xml">
            <list string="Shares" create="0">
                <field name="name"/>
                <field name="share_type"/>
                <field name="folder_id"/>
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="allow_download"/>
                <field name="allow_upload"/>
                <field name="date_expiry"/>
                <field name="state" widget="badge" decoration-success="state == 'live'" decoration-muted="state == 'expired'"/>
                <field name="create_uid" string="Shared By" widget="many2one_avatar_user"/>
                <field name="log_count"/>
            </list>
        </field>
    </record>

    <record id="om_documents_share_view_form" model="ir.ui.view">
        <field name="name">om.documents.share.form</field>
        <field name="model">om.documents.share</field>
        <field name="arch" type="xml">
            <form string="Share">
                <header>
                    <button name="action_send" type="object" string="Send by Email" class="btn-primary"
                            invisible="not partner_ids or state != 'live'"/>
                    <button name="action_open_share" type="object" string="Open the Page" invisible="state != 'live'"/>
                    <button name="action_regenerate_token" type="object" string="New Link"
                            confirm="The current link stops working. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_logs" type="object" class="oe_stat_button" icon="visibility">
                            <field name="log_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="full_url" widget="CopyClipboardChar" readonly="1"/>
                            <field name="share_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="folder_id" required="share_type == 'folder' or allow_upload"/>
                            <field name="include_subfolders" invisible="share_type != 'folder'"/>
                            <field name="document_ids" widget="many2many_tags" invisible="share_type != 'documents'"/>
                            <field name="request_document_id" invisible="not request_document_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="date_expiry"/>
                            <field name="allow_download"/>
                            <field name="allow_upload"/>
                            <field name="upload_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                                   invisible="not allow_upload"/>
                            <field name="upload_owner_id" invisible="not allow_upload"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="om_documents_share_view_form_dialog" model="ir.ui.view">
        <field name="name">om.documents.share.form.dialog</field>
        <field name="model">om.documents.share</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Share">
                <field name="state" invisible="1"/>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="full_url" widget="CopyClipboardChar" readonly="1"/>
                        <field name="share_type" readonly="1"/>
                        <field name="folder_id" readonly="share_type == 'folder'"
                               required="share_type == 'folder' or allow_upload"/>
                        <field name="include_subfolders" invisible="share_type != 'folder'"/>
                        <field name="document_ids" widget="many2many_tags" invisible="share_type != 'documents'"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="date_expiry"/>
                        <field name="allow_download"/>
                        <field name="allow_upload"/>
                        <field name="upload_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                               invisible="not allow_upload"/>
                    </group>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send by Email" class="btn-primary"
                            invisible="not partner_ids"/>
                    <button string="Done" special="save" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="om_documents_share_log_view_list" model="ir.ui.view">
        <field name="name">om.documents.share.log.list</field>
        <field name="model">om.documents.share.log</field>
        <field name="arch" type="xml">
            <list string="Access Log" create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="share_id"/>
                <field name="event" widget="badge" decoration-danger="event == 'expired'"
                       decoration-success="event == 'upload'"/>
                <field name="document_id"/>
                <field name="partner_id"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="action_shares" model="ir.actions.act_window">
        <field name="name">Shares</field>
        <field name="res_model">om.documents.share</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="om_documents_share_view_search"/>
        <field name="context">{'search_default_live': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No share yet</p>
            <p>Share a folder or chosen documents from the documents: a link, valid until a date, to download them
                or to upload files.</p>
        </field>
    </record>

    <record id="action_share_logs" model="ir.actions.act_window">
        <field name="name">Access Log</field>
        <field name="res_model">om.documents.share.log</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
