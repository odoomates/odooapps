<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_followup_send_form" model="ir.ui.view">
        <field name="name">followup.send.form.inherit.om_whatsapp_followup</field>
        <field name="model">followup.send</field>
        <field name="inherit_id" ref="om_account_followup.view_followup_send_form"/>
        <field name="arch" type="xml">
            <field name="print_letter" position="after">
                <field name="send_whatsapp"/>
            </field>
            <xpath expr="//div[hasclass('alert-warning')]" position="after">
                <div class="alert alert-warning" role="alert" invisible="not whatsapp_warning">
                    <field name="whatsapp_warning"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
