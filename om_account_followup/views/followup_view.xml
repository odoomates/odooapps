<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_om_account_followup_followup_line_tree" model="ir.ui.view">
            <field name="name">followup.line.list</field>
            <field name="model">followup.line</field>
            <field name="arch" type="xml">
                <list string="Follow-up Levels">
                    <field name="delay"/>
                    <field name="name"/>
                    <field name="email_template_id" optional="show"/>
                    <field name="send_email"/>
                    <field name="send_letter"/>
                    <field name="manual_action"/>
                </list>
            </field>
        </record>

        <record id="view_om_account_followup_followup_line_form" model="ir.ui.view">
            <field name="name">followup.line.form</field>
            <field name="model">followup.line</field>
            <field name="arch" type="xml">
                <form string="Follow-up Level">
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Second reminder"/></h1>
                        </div>
                        <group>
                            <group>
                                <label for="delay" string="Send After"/>
                                <div class="o_row">
                                    <field name="delay" class="oe_inline"/>
                                    <span class="ms-2">days overdue</span>
                                </div>
                            </group>
                            <group string="Actions">
                                <field name="send_email" widget="boolean_toggle"/>
                                <field name="send_letter" widget="boolean_toggle"/>
                                <field name="manual_action" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Email" name="email" invisible="not send_email">
                                <group>
                                    <field name="email_template_id" options="{'no_create': True}"/>
                                </group>
                            </page>
                            <page string="Letter" name="letter" invisible="not send_letter and not send_email">
                                <div class="alert alert-info" role="alert">
                                    The message printed at the top of the customer statement. It can use
                                    <code>%%(partner_name)s</code> (the customer),
                                    <code>%%(date)s</code> (the date of the statement),
                                    <code>%%(company_name)s</code> (your company) and
                                    <code>%%(user_signature)s</code> (the user printing it).
                                    Write <code>%%%%</code> for a percent sign.
                                </div>
                                <field name="description" nolabel="1"/>
                            </page>
                            <page string="Manual Action" name="manual_action" invisible="not manual_action">
                                <group>
                                    <field name="manual_action_responsible_id" widget="many2one_avatar_user"
                                           placeholder="The follow-up responsible of the customer"/>
                                    <field name="manual_action_note" placeholder="e.g. Call the customer"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_om_account_followup_followup_form" model="ir.ui.view">
            <field name="name">followup.followup.form</field>
            <field name="model">followup.followup</field>
            <field name="arch" type="xml">
                <form string="Follow-up Plan">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_partners" type="object" class="oe_stat_button" icon="group"
                                    invisible="not id">
                                <field name="partner_count" widget="statinfo" string="Customers"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name" placeholder="e.g. Key accounts"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="is_default"/>
                                <field name="company_id" options="{'no_create': True}"
                                       groups="base.group_multi_company"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="auto_send"/>
                                <field name="auto_user_id" invisible="not auto_send" required="auto_send"/>
                                <field name="last_auto_send" invisible="not last_auto_send"/>
                            </group>
                        </group>
                        <p class="text-muted">
                            The reminders are sent when an invoice is overdue by the number of days of a level.
                            When a customer has several overdue invoices, the reminder of the most overdue one is
                            sent. The customers without a plan of their own follow the default plan.
                        </p>
                        <field name="followup_line"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_om_account_followup_followup_tree" model="ir.ui.view">
            <field name="name">followup.followup.list</field>
            <field name="model">followup.followup</field>
            <field name="arch" type="xml">
                <list string="Follow-up Plans">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="is_default"/>
                    <field name="auto_send"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_om_account_followup_filter" model="ir.ui.view">
            <field name="name">account.followup.select</field>
            <field name="model">followup.followup</field>
            <field name="arch" type="xml">
                <search string="Search Follow-up Plans">
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </search>
            </field>
        </record>

        <record id="action_om_account_followup_definition_form" model="ir.actions.act_window">
            <field name="name">Follow-up Plans</field>
            <field name="res_model">followup.followup</field>
            <field name="search_view_id" ref="view_om_account_followup_filter"/>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create a follow-up plan</p>
                <p>
                    A plan lists the reminders sent to the customers who do not pay on time: after how many days,
                    by email, by letter, or as an action for the person in charge.
                </p>
            </field>
        </record>

        <menuitem id="om_account_followup_menu"
                  name="Follow-up Plans"
                  action="action_om_account_followup_definition_form"
                  parent="account.account_invoicing_menu"
                  sequence="40"/>

    </data>
</odoo>
