<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_followup_send_form" model="ir.ui.view">
        <field name="name">followup.send.form</field>
        <field name="model">followup.send</field>
        <field name="arch" type="xml">
            <form string="Send Reminder">
                <field name="partner_count" invisible="1"/>
                <div class="alert alert-warning" role="alert" attrs="{'invisible': [('warning', '=', False)]}">
                    <field name="warning" class="text-break" style="white-space: pre-line;"/>
                </div>
                <group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}" attrs="{'invisible': [('partner_count', '=', 1)]}"/>
                        <field name="partner_ids" widget="many2many_tags" readonly="1" string="Customer" attrs="{'invisible': [('partner_count', '!=', 1)]}"/>
                        <field name="level_id" options="{'no_create': True}" attrs="{'invisible': [('partner_count', '!=', 1)]}"/>
                    </group>
                    <group>
                        <field name="send_email"/>
                        <field name="print_letter"/>
                        <field name="attach_invoices" attrs="{'invisible': [('send_email', '=', False)]}"/>
                    </group>
                </group>
                <group attrs="{'invisible': [('send_email', '=', False)]}">
                    <field name="template_id" options="{'no_create': True}"/>
                    <field name="recipient_ids" widget="many2many_tags_email"
                           options="{'no_create': True}" attrs="{'invisible': [('partner_count', '!=', 1)]}"/>
                    <field name="subject" placeholder="Subject" attrs="{'invisible': [('partner_count', '!=', 1)]}"/>
                </group>
                <field name="body" class="oe-bordered-editor"
                       options="{'style-inline': true}" attrs="{'invisible': ['|', ('send_email', '=', False), ('partner_count', '!=', 1)]}"/>
                <p class="text-muted" attrs="{'invisible': ['|', ('partner_count', '=', 1), ('send_email', '=', False)]}">
                    Each customer receives the email of the template, with its own overdue invoices.
                </p>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_followup_send" model="ir.actions.act_window">
        <field name="name">Send Reminder</field>
        <field name="res_model">followup.send</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user')), (4, ref('account.group_account_manager'))]"/>
    </record>

</odoo>
