"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Olá, <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Segue em anexo o extrato da sua conta com <t t-out=\"env.company.name or ''\"/>, com as faturas e os pagamentos ainda em aberto.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Se algo não corresponder aos seus registros, informe-nos.</p>\n"
