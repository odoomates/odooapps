"    <p style=\"margin: 0 0 12px 0;\">If anything does not match your records, please let us know.</p>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Sayın <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\"><t t-out=\"env.company.name or ''\"/> nezdindeki hesabınızın, hâlâ açık olan faturalar ve ödemelerle birlikte hesap ekstresini ekte bulabilirsiniz.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Kayıtlarınızla uyuşmayan bir şey varsa lütfen bize bildirin.</p>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Saygılarımızla,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_om_account_followup_level0
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">This is a friendly reminder that the invoices below are past their due date.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">If you have already paid them, please ignore this message. Otherwise, you can pay them from the links below or by bank transfer. Do not hesitate to contact us if you have any question.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Sayın <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Bu, aşağıdaki faturaların vade tarihinin geçtiğine dair dostça bir hatırlatmadır.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Ödemelerini zaten yaptıysanız lütfen bu mesajı dikkate almayın. Aksi takdirde aşağıdaki bağlantılardan veya banka havalesiyle ödeyebilirsiniz. Herhangi bir sorunuz olursa bizimle iletişime geçmekten çekinmeyin.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Saygılarımızla,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

