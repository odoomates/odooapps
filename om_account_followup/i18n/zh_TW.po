msgid "<div style=\\\"margin: 0; padding: 0; font-size: 14px;\\\">\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Dear <t t-out=\\\"object.name or ''\\\"/>,</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">According to our records, the invoices below are past their due date.</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">If you have already paid them, please ignore this message. Otherwise, please settle them at your earliest convenience, and do not hesitate to contact us if you have any question.</p>\\n    <t t-out=\\\"object.get_followup_table_html()\\\"/>\\n    <p style=\\\"margin: 12px 0 0 0;\\\">\\n        Best regards,<br/>\\n        <t t-out=\\\"user.name or ''\\\"/><br/>\\n        <t t-out=\\\"env.company.name or ''\\\"/>\\n    </p>\\n</div>\\n            "
msgstr ""

msgid "<div style=\\\"margin: 0; padding: 0; font-size: 14px;\\\">\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Dear <t t-out=\\\"object.name or ''\\\"/>,</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Despite our previous reminder, the invoices below are still unpaid.</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Please settle them within the next 8 days, or let us know if there is an issue we should be aware of, so that we can solve it quickly.</p>\\n    <t t-out=\\\"object.get_followup_table_html()\\\"/>\\n    <p style=\\\"margin: 12px 0 0 0;\\\">\\n        Best regards,<br/>\\n        <t t-out=\\\"user.name or ''\\\"/><br/>\\n        <t t-out=\\\"env.company.name or ''\\\"/>\\n    </p>\\n</div>\\n            "
msgstr ""

msgid "<div style=\\\"margin: 0; padding: 0; font-size: 14px;\\\">\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Dear <t t-out=\\\"object.name or ''\\\"/>,</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Despite several reminders, the invoices below are still unpaid.</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Unless the full amount is paid within the next 8 days, we will have to put your account on hold and take further action to recover the debt. We trust this will not be necessary: please contact our accounting department if you have any question.</p>\\n    <t t-out=\\\"object.get_followup_table_html()\\\"/>\\n    <p style=\\\"margin: 12px 0 0 0;\\\">\\n        Best regards,<br/>\\n        <t t-out=\\\"user.name or ''\\\"/><br/>\\n        <t t-out=\\\"env.company.name or ''\\\"/>\\n    </p>\\n</div>\\n            "
msgstr ""

msgid "<div style=\\\"margin: 0; padding: 0; font-size: 14px;\\\">\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Dear <t t-out=\\\"object.name or ''\\\"/>,</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Please find attached the bills and payments still open in our records for your account.</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Could you check them against your own statement and let us know of any difference?</p>\\n    <p style=\\\"margin: 12px 0 0 0;\\\">\\n        Best regards,<br/>\\n        <t t-out=\\\"user.name or ''\\\"/><br/>\\n        <t t-out=\\\"env.company.name or ''\\\"/>\\n    </p>\\n</div>\\n            "
msgstr ""

msgid "<div style=\\\"margin: 0; padding: 0; font-size: 14px;\\\">\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Dear <t t-out=\\\"object.name or ''\\\"/>,</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Please find attached the statement of your account with <t t-out=\\\"env.company.name or ''\\\"/>, with the invoices and payments still open.</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">If anything does not match your records, please let us know.</p>\\n    <p style=\\\"margin: 12px 0 0 0;\\\">\\n        Best regards,<br/>\\n        <t t-out=\\\"user.name or ''\\\"/><br/>\\n        <t t-out=\\\"env.company.name or ''\\\"/>\\n    </p>\\n</div>\\n            "
msgstr ""

msgid "<div style=\\\"margin: 0; padding: 0; font-size: 14px;\\\">\\n    <p style=\\\"margin: 0 0 12px 0;\\\">Dear <t t-out=\\\"object.name or ''\\\"/>,</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">This is a friendly reminder that the invoices below are past their due date.</p>\\n    <p style=\\\"margin: 0 0 12px 0;\\\">If you have already paid them, please ignore this message. Otherwise, you can pay them from the links below or by bank transfer. Do not hesitate to contact us if you have any question.</p>\\n    <t t-out=\\\"object.get_followup_table_html()\\\"/>\\n    <p style=\\\"margin: 12px 0 0 0;\\\">\\n        Best regards,<br/>\\n        <t t-out=\\\"user.name or ''\\\"/><br/>\\n        <t t-out=\\\"env.company.name or ''\\\"/>\\n    </p>\\n</div>\\n            "
msgstr ""

