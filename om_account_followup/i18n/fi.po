#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_om_account_followup_default
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">According to our records, the invoices below are past their due date.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">If you have already paid them, please ignore this message. Otherwise, please settle them at your earliest convenience, and do not hesitate to contact us if you have any question.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Hyvä <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Kirjanpitomme mukaan alla olevat laskut ovat ylittäneet eräpäivänsä.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Jos olet jo maksanut ne, voit jättää tämän viestin huomiotta. Muussa tapauksessa maksathan ne mahdollisimman pian. Otathan rohkeasti yhteyttä, jos sinulla on kysyttävää.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Ystävällisin terveisin,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_om_account_followup_level1
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Despite our previous reminder, the invoices below are still unpaid.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Please settle them within the next 8 days, or let us know if there is an issue we should be aware of, so that we can solve it quickly.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Hyvä <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Aiemmasta muistutuksestamme huolimatta alla olevat laskut ovat edelleen maksamatta.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Maksathan ne seuraavan 8 päivän kuluessa tai kerro meille, jos on jokin ongelma, josta meidän pitäisi tietää, jotta voimme ratkaista sen nopeasti.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Ystävällisin terveisin,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_om_account_followup_level2
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Despite several reminders, the invoices below are still unpaid.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Unless the full amount is paid within the next 8 days, we will have to put your account on hold and take further action to recover the debt. We trust this will not be necessary: please contact our accounting department if you have any question.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Hyvä <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Useista muistutuksista huolimatta alla olevat laskut ovat edelleen maksamatta.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Ellei koko summaa makseta seuraavan 8 päivän kuluessa, joudumme asettamaan asiakkuutesi pitoon ja ryhtymään jatkotoimiin saatavan perimiseksi. Toivomme, ettei tämä ole tarpeen: otathan yhteyttä kirjanpito-osastoomme, jos sinulla on kysyttävää.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Ystävällisin terveisin,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_vendor_statement
