#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_om_account_followup_default
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">According to our records, the invoices below are past their due date.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">If you have already paid them, please ignore this message. Otherwise, please settle them at your earliest convenience, and do not hesitate to contact us if you have any question.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Kære <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Ifølge vores optegnelser har nedenstående fakturaer overskredet deres forfaldsdato.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Hvis du allerede har betalt dem, kan du se bort fra denne besked. Ellers beder vi dig betale dem hurtigst muligt, og du er velkommen til at kontakte os, hvis du har spørgsmål.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Med venlig hilsen<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_om_account_followup_level1
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Despite our previous reminder, the invoices below are still unpaid.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Please settle them within the next 8 days, or let us know if there is an issue we should be aware of, so that we can solve it quickly.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Kære <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Trods vores tidligere påmindelse er nedenstående fakturaer stadig ubetalte.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Vi beder dig betale dem inden for de næste 8 dage eller give os besked, hvis der er et problem, vi bør kende til, så vi hurtigt kan løse det.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Med venlig hilsen<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_om_account_followup_level2
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Despite several reminders, the invoices below are still unpaid.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Unless the full amount is paid within the next 8 days, we will have to put your account on hold and take further action to recover the debt. We trust this will not be necessary: please contact our accounting department if you have any question.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Kære <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Trods flere påmindelser er nedenstående fakturaer stadig ubetalte.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Medmindre det fulde beløb betales inden for de næste 8 dage, bliver vi nødt til at spærre din konto og tage yderligere skridt til at inddrive gælden. Vi håber, at det ikke bliver nødvendigt: kontakt venligst vores bogholderi, hvis du har spørgsmål.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Med venlig hilsen<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_vendor_statement
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Please find attached the bills and payments still open in our records for your account.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Could you check them against your own statement and let us know of any difference?</p>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Kære <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Vedhæftet finder du de fakturaer og betalinger, der stadig står åbne i vores optegnelser for din konto.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Vil du sammenholde dem med dit eget kontoudtog og give os besked om eventuelle forskelle?</p>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Med venlig hilsen<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_customer_statement
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Please find attached the statement of your account with <t t-out=\"env.company.name or ''\"/>, with the invoices and payments still open.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">If anything does not match your records, please let us know.</p>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Kære <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Vedhæftet finder du kontoudtoget for din konto hos <t t-out=\"env.company.name or ''\"/> med de fakturaer og betalinger, der stadig står åbne.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Hvis noget ikke stemmer med dine optegnelser, bedes du give os besked.</p>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Med venlig hilsen<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

#. module: om_account_followup
#: model:mail.template,body_html:om_account_followup.email_template_om_account_followup_level0
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Dear <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">This is a friendly reminder that the invoices below are past their due date.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">If you have already paid them, please ignore this message. Otherwise, you can pay them from the links below or by bank transfer. Do not hesitate to contact us if you have any question.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p style=\"margin: 0 0 12px 0;\">Kære <t t-out=\"object.name or ''\"/>,</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Dette er en venlig påmindelse om, at nedenstående fakturaer har overskredet deres forfaldsdato.</p>\n"
"    <p style=\"margin: 0 0 12px 0;\">Hvis du allerede har betalt dem, kan du se bort fra denne besked. Ellers kan du betale dem via linkene nedenfor eller via bankoverførsel. Du er velkommen til at kontakte os, hvis du har spørgsmål.</p>\n"
"    <t t-out=\"object.get_followup_table_html()\"/>\n"
"    <p style=\"margin: 12px 0 0 0;\">\n"
"        Med venlig hilsen<br/>\n"
"        <t t-out=\"user.name or ''\"/><br/>\n"
"        <t t-out=\"env.company.name or ''\"/>\n"
"    </p>\n"
"</div>\n"
"            "

