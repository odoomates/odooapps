<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_fs_gasket_kit" model="product.product">
        <field name="name">Boiler Gasket Kit</field>
        <field name="default_code">FS-GK10</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="list_price">24.0</field>
        <field name="standard_price">9.5</field>
    </record>
    <record id="product_fs_valve" model="product.product">
        <field name="name">Thermostatic Radiator Valve</field>
        <field name="default_code">FS-TRV2</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="list_price">39.0</field>
        <field name="standard_price">16.0</field>
    </record>
    <record id="product_fs_thermostat" model="product.product">
        <field name="name">Smart Thermostat</field>
        <field name="default_code">FS-ST100</field>
        <field name="type">consu</field>
        <field name="is_storable" eval="True"/>
        <field name="tracking">serial</field>
        <field name="list_price">189.0</field>
        <field name="standard_price">95.0</field>
    </record>

    <record id="lot_fs_thermostat_1" model="stock.lot">
        <field name="name">ST100-24-0187</field>
        <field name="product_id" ref="product_fs_thermostat"/>
    </record>
    <record id="lot_fs_thermostat_2" model="stock.lot">
        <field name="name">ST100-24-0188</field>
        <field name="product_id" ref="product_fs_thermostat"/>
    </record>
    <record id="lot_fs_thermostat_3" model="stock.lot">
        <field name="name">ST100-24-0189</field>
        <field name="product_id" ref="product_fs_thermostat"/>
    </record>

    <function model="project.task" name="_fs_stock_demo"/>

</odoo>
