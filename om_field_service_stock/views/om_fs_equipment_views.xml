<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_fs_equipment_view_list" model="ir.ui.view">
        <field name="name">om.fs.equipment.list</field>
        <field name="model">om.fs.equipment</field>
        <field name="arch" type="xml">
            <list string="Equipment at Customer Sites">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id" optional="hide"/>
                <field name="lot_id" optional="show"/>
                <field name="installed_on"/>
                <field name="install_task_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="om_fs_equipment_view_form" model="ir.ui.view">
        <field name="name">om.fs.equipment.form</field>
        <field name="model">om.fs.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object" class="oe_stat_button" icon="build">
                            <field name="job_count" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Heat pump, roof"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="lot_id" context="{'default_product_id': product_id}"/>
                        </group>
                        <group>
                            <field name="installed_on"/>
                            <field name="install_task_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Where it is on site, warranty, access..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="om_fs_equipment_view_search" model="ir.ui.view">
        <field name="name">om.fs.equipment.search</field>
        <field name="model">om.fs.equipment</field>
        <field name="arch" type="xml">
            <search string="Equipment">
                <field name="name"/>
                <field name="partner_id" operator="child_of"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'commercial_partner_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_om_fs_equipment" model="ir.actions.act_window">
        <field name="name">Equipment at Sites</field>
        <field name="res_model">om.fs.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No equipment recorded yet</p>
            <p>The serial numbers installed on a job are recorded here, on the customer site, for the next visits.</p>
        </field>
    </record>

    <record id="action_om_fs_van_stock" model="ir.actions.act_window">
        <field name="name">Van Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="domain">[('location_id.fs_van_employee_ids', '!=', False)]</field>
        <field name="context">{'search_default_locationgroup': 1, 'inventory_mode': False}</field>
    </record>

</odoo>
