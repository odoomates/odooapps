<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_whatsapp_template_view_list" model="ir.ui.view">
        <field name="name">om.whatsapp.template.list</field>
        <field name="model">om.whatsapp.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="account_id" optional="show"/>
                <field name="report_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="om_whatsapp_template_view_form" model="ir.ui.view">
        <field name="name">om.whatsapp.template.form</field>
        <field name="model">om.whatsapp.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_sidebar_action" type="object" string="Add Action Menu"
                            invisible="sidebar_action_id" help="Show the template in the Action menu of its documents."/>
                    <button name="action_unlink_sidebar_action" type="object" string="Remove Action Menu"
                            invisible="not sidebar_action_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Invoice Reminder"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model" invisible="1"/>
                            <field name="report_id" invisible="not model" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="lang" placeholder="{{ object.partner_id.lang }}"/>
                            <field name="sidebar_action_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Message" name="body">
                            <field name="body" placeholder="Hello {{ object.partner_id.name }}, ..."/>
                            <div class="text-muted">Use {{ object.field }} to insert a value of the document.</div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="om_whatsapp_template_view_search" model="ir.ui.view">
        <field name="name">om.whatsapp.template.search</field>
        <field name="model">om.whatsapp.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_model" string="Applies to" context="{'group_by': 'model_id'}"/>
            </search>
        </field>
    </record>

    <record id="om_whatsapp_template_action" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">om.whatsapp.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a WhatsApp template</p>
            <p>A template is the text sent for one kind of document, filled with its values.</p>
        </field>
    </record>
</odoo>
