<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
            <button t-if="canWhatsapp" class="o-mail-Chatter-whatsapp btn btn-secondary text-nowrap me-1"
                    t-att-class="{ 'my-2': !props.compactHeight }"
                    t-att-disabled="!state.thread.canPostMessage and props.threadId"
                    title="Send a WhatsApp message" t-on-click="onClickWhatsapp">
                <i class="fa fa-whatsapp me-1"/>WhatsApp
            </button>
        </xpath>
    </t>
</templates>
