<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.ChatterTopbar" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonLogNote')]" position="after">
            <button t-if="canWhatsapp" class="o_ChatterTopbar_button o_ChatterTopbar_buttonWhatsapp btn btn-light text-nowrap"
                    type="button" title="Send a WhatsApp message"
                    t-att-disabled="!chatterTopbar.chatter.canPostMessage" t-on-click="onClickWhatsapp">
                <i class="fa fa-whatsapp me-1"/>WhatsApp
            </button>
        </xpath>
    </t>
</templates>
