<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="om_whatsapp_base.PhoneFieldWhatsapp">
        <a t-if="showWhatsapp" href="#" class="o_om_whatsapp_phone ms-3 d-inline-flex align-items-center"
           title="Send a WhatsApp message" t-on-click.prevent.stop="onClickWhatsapp">
            <i class="fa fa-whatsapp"/><small class="fw-bold ms-1">WhatsApp</small>
        </a>
    </t>

    <t t-inherit="web.PhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]//a" position="after">
            <t t-call="om_whatsapp_base.PhoneFieldWhatsapp"/>
        </xpath>
    </t>

    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <t t-call="om_whatsapp_base.PhoneFieldWhatsapp"/>
        </xpath>
    </t>
</templates>
