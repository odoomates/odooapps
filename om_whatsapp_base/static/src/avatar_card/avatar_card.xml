<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AvatarCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_avatar_card_buttons')]" position="inside">
            <button t-if="this.showWhatsappButton" class="o_avatar_card_whatsapp btn btn-secondary btn-sm" t-on-click.stop="this.onClickWhatsapp">
                <i class="oi me-1" data-icon="oi_whatsapp"/>WhatsApp
            </button>
        </xpath>
    </t>
</templates>
