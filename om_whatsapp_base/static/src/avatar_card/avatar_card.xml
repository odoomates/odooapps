<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AvatarCardPopover" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_avatar_card_buttons')]" position="inside">
            <button t-if="showWhatsappButton" class="o_avatar_card_whatsapp btn btn-secondary btn-sm" t-on-click.stop="onClickWhatsapp">
                <i class="fa fa-whatsapp me-1"/>WhatsApp
            </button>
        </xpath>
    </t>
</templates>
