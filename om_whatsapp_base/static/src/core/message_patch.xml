<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Message.notification" t-inherit-mode="extension">
        <xpath expr="//div[@t-if]/span[hasclass('o-mail-Message-notification')]" position="after">
            <span t-if="this.whatsappTicks" class="o-om-whatsapp-ticks ms-1" role="img"
                  t-att-class="this.whatsappTicks.read ? 'text-info' : 'opacity-50'" t-att-title="this.whatsappTicks.title">
                <i class="oi" data-icon="check"/><i t-if="this.whatsappTicks.double" class="oi o-om-whatsapp-second" data-icon="check"/>
            </span>
        </xpath>
    </t>
</templates>
