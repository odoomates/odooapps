<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Message.notification" t-inherit-mode="extension">
        <xpath expr="//div[@t-if]/span[hasclass('o-mail-Message-notification')]" position="after">
            <span t-if="whatsappTicks" class="o-om-whatsapp-ticks ms-1" role="img"
                  t-att-class="whatsappTicks.read ? 'text-info' : 'opacity-50'" t-att-title="whatsappTicks.title">
                <i class="fa fa-check"/><i t-if="whatsappTicks.double" class="fa fa-check o-om-whatsapp-second"/>
            </span>
        </xpath>
    </t>
</templates>
