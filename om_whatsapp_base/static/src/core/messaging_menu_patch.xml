<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.MessagingMenu.content" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-MessagingMenu-headerFilter')][3]" position="after">
            <button t-if="showOmWhatsappTab" class="o-mail-MessagingMenu-headerFilter o-om-whatsapp-headerFilter btn btn-link o-px-1_5 py-1 m-1 lh-1"
                    t-att-class="store.discuss.activeTab === 'om_whatsapp' ? 'fw-bold o-active shadow-sm' : 'text-muted'"
                    type="button" role="tab" t-on-click="() => store.discuss.activeTab = 'om_whatsapp'">WhatsApp</button>
        </xpath>
    </t>
</templates>
