<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.MessagingMenu.content" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-MessagingMenu-header')]/t[@t-if='!ui.isSmall']/button[3]" position="after">
            <button t-if="showOmWhatsappTab" class="btn btn-link py-2 rounded-0 o-om-whatsapp-headerFilter"
                    t-att-class="store.discuss.activeTab === 'om_whatsapp' ? 'fw-bold' : 'text-muted'"
                    type="button" role="tab" t-on-click="() => store.discuss.activeTab = 'om_whatsapp'">WhatsApp</button>
        </xpath>
    </t>
</templates>
