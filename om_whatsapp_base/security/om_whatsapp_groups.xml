<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_om_whatsapp_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sends WhatsApp messages from the accounts allowed to them, and sees the WhatsApp messages of the documents they can read.</field>
    </record>

    <record id="group_om_whatsapp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_whatsapp"/>
        <field name="implied_ids" eval="[Command.link(ref('group_om_whatsapp_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Manages the WhatsApp accounts and templates, and sees every message.</field>
    </record>
</odoo>
