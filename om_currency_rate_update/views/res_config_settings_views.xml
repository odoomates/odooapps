<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_rate_update" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.rate.update</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- the automatic rates are given by this module: the box of the account module (Enterprise) is hidden -->
            <div id="update_exchange_rates" position="attributes">
                <attribute name="invisible">1</attribute>
            </div>
            <div id="update_exchange_rates" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="om_update_exchange_rates"
                     attrs="{'invisible': [('group_multi_currency', '=', False)]}">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Automatic Currency Rates</span>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">Update the exchange rates from the source of your choice</div>
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="rate_interval" string="Update" class="col-lg-4 o_light_label"/>
                                <field name="rate_interval" required="1"/>
                            </div>
                            <div class="row">
                                <label for="rate_provider" string="Source" class="col-lg-4 o_light_label"/>
                                <field name="rate_provider" required="1"/>
                            </div>
                            <div class="row">
                                <label for="rate_fallback_provider" string="Backup Source" class="col-lg-4 o_light_label"/>
                                <field name="rate_fallback_provider" placeholder="None"/>
                            </div>
                            <div class="row" groups="base.group_system"
                                 attrs="{'invisible': [('rate_provider', '!=', 'openexchangerates'), ('rate_fallback_provider', '!=', 'openexchangerates')]}">
                                <label for="rate_openexchangerates_key" string="App ID" class="col-lg-4 o_light_label"/>
                                <field name="rate_openexchangerates_key" password="True"/>
                            </div>
                            <div class="row" groups="base.group_system"
                                 attrs="{'invisible': [('rate_provider', '!=', 'exchangerate_api'), ('rate_fallback_provider', '!=', 'exchangerate_api')]}">
                                <label for="rate_exchangerate_api_key" string="API Key" class="col-lg-4 o_light_label"/>
                                <field name="rate_exchangerate_api_key" password="True" placeholder="Optional"/>
                            </div>
                            <div class="row">
                                <label for="rate_currency_ids" string="Currencies" class="col-lg-4 o_light_label"/>
                                <field name="rate_currency_ids" widget="many2many_tags" placeholder="All active currencies"
                                       options="{'no_create': True}" context="{'active_test': False}"/>
                            </div>
                            <div class="row">
                                <label for="rate_date_policy" string="Rate Date" class="col-lg-4 o_light_label"/>
                                <field name="rate_date_policy" required="1"/>
                            </div>
                            <div class="row">
                                <label for="rate_max_change" string="Maximum Change (%)" class="col-lg-4 o_light_label"/>
                                <field name="rate_max_change"/>
                            </div>
                            <div class="row" attrs="{'invisible': [('rate_interval', '=', 'manual')]}">
                                <label for="rate_next_date" string="Next Update" class="col-lg-4 o_light_label"/>
                                <field name="rate_next_date"/>
                            </div>
                            <div class="text-muted small mt8" attrs="{'invisible': [('rate_provider', 'not in', ['frankfurter', 'ecb'])]}">
                                This source quotes about 30 major currencies, without key. For every currency, choose Open
                                Exchange Rates (App ID from openexchangerates.org) or ExchangeRate-API as source or backup.
                            </div>
                            <div class="mt8" attrs="{'invisible': [('rate_last_update', '=', False)]}">
                                <span class="o_light_label">Last update: </span><field name="rate_last_update" class="oe_inline"/>
                                <div class="text-muted small"><field name="rate_last_message"/></div>
                            </div>
                            <div class="mt8">
                                <button name="action_test_currency_rates" type="object" string="Test Connection" class="btn-link" icon="fa-wifi"/>
                                <button name="action_update_currency_rates" type="object" string="Update Now" class="btn-link" icon="fa-refresh"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
