<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_form_cash_flow" model="ir.ui.view">
        <field name="name">account.account.form.cash.flow</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="tag_ids" position="after">
                <field name="cash_flow_activity" invisible="account_type in ('asset_cash', 'off_balance')"
                       placeholder="By account type"/>
            </field>
        </field>
    </record>

</odoo>
