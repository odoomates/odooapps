<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_financial_report_menu_form" model="ir.ui.view">
        <field name="name">account.financial.report.menu.form</field>
        <field name="model">account.financial.report.menu</field>
        <field name="arch" type="xml">
            <form string="Add to Menu">
                <group>
                    <field name="report_id" invisible="1"/>
                    <field name="name"/>
                    <field name="parent_id" options="{'no_create': True}"/>
                    <field name="sequence"/>
                </group>
                <footer>
                    <button name="action_create_menu" string="Add to Menu" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
