<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_tax_closing_wizard_view" model="ir.ui.view">
        <field name="name">account.tax.closing.wizard.form</field>
        <field name="model">account.tax.closing.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Tax Period">
                <p class="text-muted">
                    The tax due on the period leaves the tax accounts for the account of the tax owed, or of the tax
                    to be refunded, in a draft entry to check and post. The cash basis taxes count on their payment;
                    the withholding taxes are left out, they are owed apart.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="journal_id"/>
                        <field name="payable_account_id"/>
                        <field name="receivable_account_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_close" string="Create the Closing Entry" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
