<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_annual">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page o_annual o_om_report">
                    <t t-call="accounting_pdf_reports.report_style"/>
                    <style>
                        /* Scoped to this report: it travels with the template instead of
                           adding a stylesheet to a bundle every report would pay for. */
                        .o_annual h2 { border-bottom: 2px solid #333; padding-bottom: 6px; margin-bottom: 14px; }
                        .o_annual .o_annual_amount { font-variant-numeric: tabular-nums; }
                        .o_annual_cover { text-align: center; padding-top: 150px; }
                        .o_annual_cover .o_annual_rule { width: 90px; border-top: 2px solid #333; margin: 34px auto; }
                        .o_annual_cover .o_annual_title { font-size: 30px; letter-spacing: 3px;
                            text-transform: uppercase; margin: 0; }
                        .o_annual_cover .o_annual_period { font-size: 17px; color: #6b7280; margin-top: 10px; }
                        .o_annual_foot { margin-top: 190px; text-align: center;
                            font-size: 11px; color: #6b7280; }
                        .o_annual_toc { width: 100%; border-collapse: collapse; }
                        .o_annual_toc td { border: 0 !important; padding: 7px 0 3px 0; vertical-align: bottom; }
                        .o_annual_toc .o_annual_leader { border-bottom: 1px dotted #9a9a9a !important; }
                        .o_annual_kpi { border: 1px solid #dee2e6; border-radius: 4px; padding: 16px 18px; width: 50%; }
                        .o_annual_kpi .o_annual_kpi_label { font-size: 10px; letter-spacing: .09em;
                            text-transform: uppercase; color: #6b7280; }
                        .o_annual_kpi .o_annual_kpi_value { font-size: 21px; font-weight: 600; margin-top: 4px; }
                        .o_annual_kpi .o_annual_kpi_prior { font-size: 11px; color: #6b7280; margin-top: 3px; }
                    </style>
                    <t t-set="comparing" t-value="bool(data.get('enable_filter')) and data.get('date_to_cmp')"/>
                    <t t-set="variance" t-value="comparing and bool(data.get('show_variance'))"/>

                    <!-- ============================ page 1: the cover -->
                    <div class="o_annual_cover">
                        <img t-if="res_company.logo" t-att-src="image_data_uri(res_company.logo)"
                             alt="Logo" style="max-height: 80px; max-width: 300px;"/>

                        <h1 style="font-size: 26px; font-weight: 600; margin: 26px 0 2px 0;"
                            t-out="res_company.name"/>
                        <div style="color: #6b7280; font-size: 13px;">
                            <t t-out="', '.join([part for part in [
                                res_company.partner_id.city,
                                res_company.partner_id.country_id.name] if part])"/>
                        </div>

                        <div class="o_annual_rule"/>

                        <h2 class="o_annual_title" style="border: 0;">Annual Report</h2>
                        <div class="o_annual_period">
                            <span t-out="data['date_from']" t-options="{'widget': 'date'}"/>
                            <span> &#8212; </span>
                            <span t-out="data['date_to']" t-options="{'widget': 'date'}"/>
                        </div>

                        <div class="o_annual_foot">
                        <div t-if="comparing">
                            With comparatives for
                            <span t-out="data['date_from_cmp']" t-options="{'widget': 'date'}"/>
                            <span> &#8212; </span>
                            <span t-out="data['date_to_cmp']" t-options="{'widget': 'date'}"/>
                        </div>
                        <div>
                            Expressed in <span t-out="res_company.currency_id.name"/><t t-if="res_company.vat">
                            &#183; Tax ID <span t-out="res_company.vat"/></t>
                            &#183; Prepared on <span t-out="time.strftime('%Y-%m-%d')"/>
                            </div>
                        </div>
                    </div>

                    <!-- ============================ page 2: the contents -->
                    <div style="page-break-before: always;">
                        <h2>Contents</h2>

                        <table class="o_annual_toc" style="max-width: 560px;">
                            <tbody>
                                <tr t-foreach="contents" t-as="entry">
                                    <td style="width: 26px; color: #6b7280;"><span t-out="entry_index + 1"/>.</td>
                                    <td style="white-space: nowrap; padding-right: 8px;"><span t-out="entry['name']"/></td>
                                    <td class="o_annual_leader"/>
                                    <td class="text-end o_annual_amount" style="width: 40px; padding-left: 8px;">
                                        <span t-out="entry['page']"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div id="informations" class="row mt-5">
                            <div class="col" t-if="data['date_from'] or data['date_to']">
                                <strong>Period:</strong>
                                <div>
                                    <t t-if="data['date_from'] and data['date_to']"><span t-out="data['date_from']" t-options="{'widget': 'date'}"/> - <span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                                    <t t-elif="data['date_from']">From <span t-out="data['date_from']" t-options="{'widget': 'date'}"/></t>
                                    <t t-else="">Until <span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                                </div>
                            </div>
                            <div class="col">
                                <strong>Target Moves:</strong>
                                <div t-if="data['target_move'] == 'all'">All Entries</div>
                                <div t-if="data['target_move'] == 'posted'">All Posted Entries</div>
                            </div>
                            <div class="col">
                                <strong>Journals:</strong>
                                <div t-out="', '.join([journal or '' for journal in print_journal])"/>
                            </div>
                        </div>
                    </div>

                    <!-- ============================ key figures -->
                    <t t-if="key_figures">
                        <div style="page-break-before: always;">
                            <h2>Key Figures</h2>
                            <table style="width: 100%; border-collapse: separate; border-spacing: 10px 10px;">
                                <tbody>
                                    <tr t-foreach="key_figure_rows" t-as="row">
                                        <td t-foreach="row" t-as="figure" class="o_annual_kpi">
                                            <div class="o_annual_kpi_label" t-out="figure['label']"/>
                                            <div class="o_annual_kpi_value o_annual_amount"
                                                 t-out="figure['amount']"
                                                 t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                            <div class="o_annual_kpi_prior" t-if="comparing">
                                                <span t-out="figure.get('amount_cmp')"
                                                      t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                a year earlier
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>

                    <!-- ============================ the statements, one page at a time -->
                    <t t-foreach="statements" t-as="statement">
                        <t t-foreach="statement['pages']" t-as="rows">
                            <div style="page-break-before: always;">
                                <h2>
                                    <span t-out="statement['name']"/>
                                    <small class="text-muted" t-if="rows_index &gt; 0"> (continued)</small>
                                </h2>

                                <table class="table table-sm table-reports">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th class="text-end">
                                                <t t-if="comparing"><span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                                                <t t-else="">Balance</t>
                                            </th>
                                            <th class="text-end" t-if="comparing">
                                                <span t-out="data['date_to_cmp']" t-options="{'widget': 'date'}"/>
                                            </th>
                                            <th class="text-end" t-if="variance">Variance</th>
                                            <th class="text-end" t-if="variance">%</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="rows" t-as="a">
                                            <t t-set="style" t-value="'font-weight: normal;' if int(a.get('level')) &gt; 3 else 'font-weight: bold;'"/>
                                            <td>
                                                <span style="color: white;" t-out="'..' * int(a.get('level', 0))"/>
                                                <span t-att-style="style" t-out="a.get('name')"/>
                                            </td>
                                            <td class="text-end text-nowrap o_annual_amount">
                                                <span t-att-style="style" t-out="a.get('balance')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                            </td>
                                            <td class="text-end text-nowrap o_annual_amount" t-if="comparing">
                                                <span t-att-style="style" t-out="a.get('balance_cmp')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                            </td>
                                            <td class="text-end text-nowrap o_annual_amount" t-if="variance">
                                                <span t-att-style="style" t-out="a.get('variance')" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                            </td>
                                            <td class="text-end text-nowrap o_annual_amount" t-if="variance">
                                                <span t-if="a.get('variance_pct') is not False" t-att-style="style"
                                                      t-out="a.get('variance_pct')" t-options="{'widget': 'float', 'precision': 1}"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </t>

                    <!-- ============================ cash flow, when it was asked for -->
                    <t t-if="cash_flow">
                        <t t-set="currency" t-value="cash_flow['currency']"/>
                        <div style="page-break-before: always;">
                            <h2>Cash Flow Statement</h2>

                            <table class="table table-sm table-reports">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th class="text-end">
                                            <t t-if="comparing"><span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                                            <t t-else="">Amount</t>
                                        </th>
                                        <th class="text-end" t-if="comparing">
                                            <span t-out="data['date_to_cmp']" t-options="{'widget': 'date'}"/>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="fw-bold">
                                        <td>Cash and cash equivalents at the beginning of the period</td>
                                        <td class="text-end text-nowrap o_annual_amount"><span t-out="cash_flow['opening']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        <td class="text-end text-nowrap o_annual_amount" t-if="comparing"><span t-out="cash_flow['opening_cmp']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    </tr>
                                    <t t-foreach="cash_flow['sections']" t-as="section">
                                        <tr class="fw-bold">
                                            <td t-att-colspan="comparing and 3 or 2" class="pt-3"><span t-out="section['name']"/></td>
                                        </tr>
                                        <tr t-if="not section['lines']">
                                            <td class="ps-4 text-muted">No cash movement</td>
                                            <td/>
                                            <td t-if="comparing"/>
                                        </tr>
                                        <tr t-foreach="section['lines']" t-as="line">
                                            <td class="ps-4"><span t-out="line['name']"/></td>
                                            <td class="text-end text-nowrap o_annual_amount"><span t-out="line['amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                            <td class="text-end text-nowrap o_annual_amount" t-if="comparing"><span t-out="line['amount_cmp']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        </tr>
                                        <tr class="fw-bold border-top">
                                            <td class="ps-4">Net cash from <span t-out="section['name'].lower()"/></td>
                                            <td class="text-end text-nowrap o_annual_amount"><span t-out="section['total']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                            <td class="text-end text-nowrap o_annual_amount" t-if="comparing"><span t-out="section['total_cmp']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        </tr>
                                    </t>
                                    <tr class="fw-bold border-top border-dark">
                                        <td>Net increase (decrease) in cash and cash equivalents</td>
                                        <td class="text-end text-nowrap o_annual_amount"><span t-out="cash_flow['net_change']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        <td class="text-end text-nowrap o_annual_amount" t-if="comparing"><span t-out="cash_flow['net_change_cmp']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td>Cash and cash equivalents at the end of the period</td>
                                        <td class="text-end text-nowrap o_annual_amount"><span t-out="cash_flow['closing']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                        <td class="text-end text-nowrap o_annual_amount" t-if="comparing"><span t-out="cash_flow['closing_cmp']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>

                    <!-- ============================ notes -->
                    <t t-if="notes">
                        <div style="page-break-before: always;">
                            <h2>Notes to the Financial Statements</h2>
                            <p style="white-space: pre-wrap;" t-out="notes"/>
                        </div>
                    </t>

                    <!-- ============================ approval -->
                    <t t-if="data.get('include_signatures')">
                        <div style="page-break-before: always;">
                            <h2>Approval</h2>
                            <p class="text-muted">
                                These financial statements were prepared for
                                <span t-out="res_company.name"/> for the period
                                <span t-out="data['date_from']" t-options="{'widget': 'date'}"/> to
                                <span t-out="data['date_to']" t-options="{'widget': 'date'}"/>.
                            </p>
                            <table class="table table-sm" style="margin-top: 60px;">
                                <tbody>
                                    <tr>
                                        <t t-foreach="['Prepared by', 'Reviewed by', 'Approved by']" t-as="role">
                                            <td style="width: 33%; border-top: 1px solid #000; padding-top: 6px;">
                                                <strong t-out="role"/>
                                                <div class="text-muted" style="margin-top: 34px;">Name</div>
                                                <div class="text-muted" style="margin-top: 22px;">Date</div>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>

                </div>
            </t>
        </t>
    </template>

</odoo>
