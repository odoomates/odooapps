<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_journal_entries">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="layout_document_title">
                    <span>Journal Entry</span> <span t-field="o.name"/>
                </t>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div id="informations" class="row mb-4">
                            <div class="col">
                                <strong>Journal</strong>
                                <div t-field="o.journal_id"/>
                            </div>
                            <div class="col">
                                <strong>Date</strong>
                                <div t-field="o.date"/>
                            </div>
                            <div class="col" t-if="o.partner_id">
                                <strong>Partner</strong>
                                <div t-field="o.partner_id"/>
                            </div>
                            <div class="col" t-if="o.ref">
                                <strong>Reference</strong>
                                <div t-field="o.ref"/>
                            </div>
                            <div class="col">
                                <strong>Status</strong>
                                <div t-field="o.state"/>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th class="text-start">Account</th>
                                    <th class="text-start">Partner</th>
                                    <th class="text-start">Label</th>
                                    <th class="text-start">Analytic Account</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.account_id"/></td>
                                    <td><span t-field="line.partner_id"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-out="', '.join(line.distribution_analytic_account_ids.mapped('display_name'))"/></td>
                                    <td class="text-end text-nowrap">
                                        <span t-field="line.debit" t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-field="line.credit" t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold border-top border-dark">
                                    <td colspan="4">Total</td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="sum(o.line_ids.mapped('debit'))"
                                              t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="sum(o.line_ids.mapped('credit'))"
                                              t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <div t-if="o.narration" class="mt-4" t-field="o.narration"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
