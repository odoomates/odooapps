<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_trialbalance">
        <t t-call="web.html_container"
            data_report_margin_top="12"
            data_report_header_spacing="9"
            data_report_dpi="110">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2>Trial Balance</h2>

                    <div id="informations" class="row mb-4">
                        <div class="col" t-if="data['date_from'] or data['date_to']">
                            <strong>Period:</strong>
                            <div>
                                <t t-if="data['date_from'] and data['date_to']"><span t-out="data['date_from']" t-options="{'widget': 'date'}"/> - <span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                                <t t-elif="data['date_from']">From <span t-out="data['date_from']" t-options="{'widget': 'date'}"/></t>
                                <t t-else="">Until <span t-out="data['date_to']" t-options="{'widget': 'date'}"/></t>
                            </div>
                        </div>
                        <div class="col">
                            <strong>Target Moves:</strong>
                            <div t-if="data['target_move'] == 'all'">All Entries</div>
                            <div t-if="data['target_move'] == 'posted'">All Posted Entries</div>
                        </div>
                        <div class="col">
                            <strong>Display Account:</strong>
                            <div t-if="data['display_account'] == 'all'">All accounts</div>
                            <div t-if="data['display_account'] == 'movement'">With movements</div>
                            <div t-if="data['display_account'] == 'not_zero'">With balance not equal to zero</div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col">
                            <strong>Journals:</strong>
                            <div t-out="', '.join([journal or '' for journal in print_journal])"/>
                        </div>
                        <div class="col" t-if="analytic_accounts">
                            <strong>Analytic Accounts:</strong>
                            <div t-out="', '.join([analytic_account or '' for analytic_account in analytic_accounts])"/>
                        </div>
                    </div>

                    <table class="table table-sm table-reports">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Account</th>
                                <th class="text-end">Debit</th>
                                <th class="text-end">Credit</th>
                                <th class="text-end">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="Accounts" t-as="account">
                                <td>
                                    <span t-att-style="style" t-out="account['code']"/>
                                </td>
                                <td>
                                    <span t-att-style="style" t-out="account['name']"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-att-style="style" t-out="account['debit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-att-style="style" t-out="account['credit']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span t-att-style="style" t-out="account['balance']" t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
