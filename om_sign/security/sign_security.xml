<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="privilege_sign" model="res.groups.privilege">
            <field name="name">Sign</field>
        </record>

        <record id="group_sign_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_sign"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sign_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_sign"/>
            <field name="implied_ids" eval="[(4, ref('group_sign_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
