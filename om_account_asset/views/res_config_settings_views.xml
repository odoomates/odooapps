<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_account_asset</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="default_accounts" position="inside">
                <setting string="Asset gains and losses" company_dependent="1"
                         help="Accounts booking the difference between the sale price and the book value of sold or disposed assets.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="asset_gain_account_id" string="Gain" class="col-lg-4 o_light_label"/>
                            <field name="asset_gain_account_id"/>
                        </div>
                        <div class="row mt8">
                            <label for="asset_loss_account_id" string="Loss" class="col-lg-4 o_light_label"/>
                            <field name="asset_loss_account_id"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>

</odoo>
