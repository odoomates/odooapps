<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_asset_group_list" model="ir.ui.view">
        <field name="name">account.asset.group.list</field>
        <field name="model">account.asset.group</field>
        <field name="arch" type="xml">
            <list string="Asset Groups" editable="bottom">
                <field name="name"/>
                <field name="asset_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_account_asset_group_form" model="ir.ui.view">
        <field name="name">account.asset.group.form</field>
        <field name="model">account.asset.group</field>
        <field name="arch" type="xml">
            <form string="Asset Group">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_assets" type="object" icon="fa-cubes">
                            <field string="Assets" name="asset_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Production line 1"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_asset_group" model="ir.actions.act_window">
        <field name="name">Asset Groups</field>
        <field name="res_model">account.asset.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an asset group</p>
            <p>Group the assets that belong together, whatever their category: the machines of a production line,
                the equipment of an office.</p>
        </field>
    </record>

    <menuitem id="menu_account_asset_group"
              name="Asset Groups"
              parent="account.account_account_menu"
              action="action_account_asset_group"
              sequence="111"
              groups="account.group_account_manager"/>

    <record id="asset_standard_categories_form" model="ir.ui.view">
        <field name="name">asset.standard.categories.form</field>
        <field name="model">asset.standard.categories</field>
        <field name="arch" type="xml">
            <form string="Standard Asset Categories">
                <field name="company_id" invisible="1"/>
                <p class="text-muted">
                    The usual asset categories, with a linear depreciation over their usual life, Land without
                    depreciation. Check the accounts once; change any category afterwards as you need.
                </p>
                <group>
                    <group string="Accounts">
                        <field name="account_asset_id" options="{'no_create': True}"/>
                        <field name="account_depreciation_id" options="{'no_create': True}"/>
                        <field name="account_depreciation_expense_id" options="{'no_create': True}"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Categories">
                        <field name="buildings"/>
                        <field name="furniture"/>
                        <field name="vehicles"/>
                        <field name="machinery"/>
                        <field name="computers"/>
                        <field name="land"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create" string="Create" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_standard_categories" model="ir.actions.act_window">
        <field name="name">Create Standard Categories</field>
        <field name="res_model">asset.standard.categories</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_account_asset_category"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>

</odoo>
