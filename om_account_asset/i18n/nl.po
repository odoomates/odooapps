#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"\"%(asset)s\" heeft geboekte afschrijvingen na %(date)s (%(entries)s): kies "
"een datum op of na de laatste geboekte afschrijving."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr "\"%(asset)s\" is gepauzeerd op %(date)s, hervat het na die dag."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "\"%s\" kan niet worden afgestoten vóór de aanschaf."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "\"%s\" kan niet worden gewijzigd vóór de aanschaf."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "\"%s\" kan niet worden gepauzeerd vóór de aanschaf."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr "\"%s\" heeft geboekte afschrijvingen, annuleer het in plaats daarvan."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr ""
"\"%s\" heeft lopende waardevermeerderingen: stoot deze af voordat je het "
"verkoopt."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"\"%s\" heeft lopende waardevermeerderingen: verkoop of stoot het hele "
"activum af."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" staat niet meer in de boeken: alleen een activum dat loopt, "
"gepauzeerd of volledig afgeschreven is, kan worden verkocht of afgestoten."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "\"%s\" wordt niet afgeschreven: verkoop of stoot het hele activum af."

