#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"\"%(asset)s\" มีรายการค่าเสื่อมสภาพที่ลงรายการแล้วหลังวันที่ %(date)s "
"(%(entries)s) ให้เลือกวันที่ตรงกับหรือหลังรายการที่ลงรายการล่าสุด"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr "\"%(asset)s\" ถูกหยุดชั่วคราวเมื่อ %(date)s ให้ดำเนินการต่อหลังจากวันนั้น"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "ไม่สามารถตัดจำหน่าย \"%s\" ก่อนวันที่ได้มา"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "ไม่สามารถแก้ไข \"%s\" ก่อนวันที่ได้มา"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "ไม่สามารถหยุดชั่วคราว \"%s\" ก่อนวันที่ได้มา"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr "\"%s\" มีรายการค่าเสื่อมสภาพที่ลงรายการแล้ว ให้ยกเลิกแทน"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr "\"%s\" มีการเพิ่มมูลค่าที่ยังดำเนินอยู่: ตัดจำหน่ายรายการเหล่านั้นก่อนขาย"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"\"%s\" มีการเพิ่มมูลค่าที่ยังดำเนินอยู่: ขายหรือตัดจำหน่ายสินทรัพย์ทั้งหมด"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" ไม่อยู่ในบัญชีแล้ว: เฉพาะสินทรัพย์ที่กำลังดำเนินการ หยุดชั่วคราว "
"หรือคิดค่าเสื่อมสภาพครบแล้วเท่านั้นที่สามารถขายหรือตัดจำหน่ายได้"

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "\"%s\" ไม่ได้คิดค่าเสื่อมสภาพ: ขายหรือตัดจำหน่ายสินทรัพย์ทั้งหมด"

