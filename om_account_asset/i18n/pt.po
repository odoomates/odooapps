#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"\"%(asset)s\" tem lançamentos de depreciação publicados após %(date)s "
"(%(entries)s); escolha uma data igual ou posterior à do último lançamento "
"publicado."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr "\"%(asset)s\" foi suspenso em %(date)s; retome-o após esse dia."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "\"%s\" não pode ser abatido antes da sua aquisição."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "\"%s\" não pode ser modificado antes da sua aquisição."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "\"%s\" não pode ser suspenso antes da sua aquisição."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr ""
"\"%s\" tem lançamentos de depreciação publicados; em alternativa, cancele-o."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr "\"%s\" tem aumentos de valor em curso: abata-os antes de o vender."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr "\"%s\" tem aumentos de valor em curso: venda ou abata o ativo completo."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" já não está nos livros: só um ativo em curso, suspenso ou totalmente "
"depreciado pode ser vendido ou abatido."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "\"%s\" não está a ser depreciado: venda ou abata o ativo completo."

