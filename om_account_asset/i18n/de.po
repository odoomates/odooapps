#: model:ir.model.fields,help:om_account_asset.field_res_config_settings__asset_loss_account_id
msgid ""
"Account used to book the loss when an asset is sold below its book value or "
"disposed of."
msgstr ""
"Konto zum Buchen des Verlusts, wenn eine Anlage unter ihrem Buchwert "
"verkauft wird oder abgeht."

#. module: om_account_asset
#: model:ir.model.fields,help:om_account_asset.field_account_asset_asset__account_asset_id
#: model:ir.model.fields,help:om_account_asset.field_account_asset_category__account_asset_id
