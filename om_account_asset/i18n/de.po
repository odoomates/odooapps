#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"„%(asset)s“ hat nach dem %(date)s gebuchte Abschreibungsbuchungen "
"(%(entries)s): Wählen Sie ein Datum am oder nach dem Datum der letzten "
"gebuchten Buchung."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr ""
"„%(asset)s“ wurde am %(date)s pausiert, setzen Sie sie nach diesem Tag fort."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "„%s“ kann nicht vor ihrer Anschaffung abgegangen werden."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "„%s“ kann nicht vor ihrer Anschaffung geändert werden."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "„%s“ kann nicht vor ihrer Anschaffung pausiert werden."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr ""
"„%s“ hat gebuchte Abschreibungsbuchungen, stornieren Sie sie stattdessen."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr ""
"„%s“ hat laufende Werterhöhungen: Lassen Sie diese abgehen, bevor Sie sie "
"verkaufen."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"„%s“ hat laufende Werterhöhungen: Verkaufen Sie die gesamte Anlage oder "
"lassen Sie sie abgehen."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"„%s“ ist nicht mehr im Bestand: Nur eine laufende, pausierte oder "
"vollständig abgeschriebene Anlage kann verkauft werden oder abgehen."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr ""
"„%s“ wird nicht abgeschrieben: Verkaufen Sie die gesamte Anlage oder lassen "
"Sie sie abgehen."

