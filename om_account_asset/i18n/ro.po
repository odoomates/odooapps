msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"\"%(asset)s\" are note de amortizare postate după %(date)s (%(entries)s): "
"alegeți o dată egală cu sau ulterioară ultimei note postate."

