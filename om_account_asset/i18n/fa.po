#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"«%(asset)s» پس از %(date)s دارای داده‌های استهلاک ثبت‌شده است "
"(%(entries)s): تاریخی برابر با تاریخ آخرین داده ثبت‌شده یا پس از آن انتخاب "
"کنید."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr ""
"«%(asset)s» در %(date)s متوقف شده است، آن را پس از آن روز از سر بگیرید."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "«%s» را نمی‌توان پیش از تحصیل آن واگذار کرد."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "«%s» را نمی‌توان پیش از تحصیل آن تغییر داد."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "«%s» را نمی‌توان پیش از تحصیل آن متوقف کرد."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr "«%s» دارای داده‌های استهلاک ثبت‌شده است، به جای آن، آن را لغو کنید."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr ""
"«%s» دارای افزایش ارزش‌های در جریان است: پیش از فروش، آن‌ها را واگذار کنید."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"«%s» دارای افزایش ارزش‌های در جریان است: کل دارایی را بفروشید یا واگذار "
"کنید."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"«%s» دیگر در دفاتر نیست: فقط دارایی در حال اجرا، متوقف یا کاملاً مستهلک‌شده "
"قابل فروش یا واگذاری است."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "«%s» در حال استهلاک نیست: کل دارایی را بفروشید یا واگذار کنید."

