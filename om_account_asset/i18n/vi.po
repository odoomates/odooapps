#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"\"%(asset)s\" có bút toán khấu hao được vào sổ sau ngày %(date)s "
"(%(entries)s): hãy chọn ngày bằng hoặc sau ngày của bút toán đã vào sổ gần "
"nhất."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr "\"%(asset)s\" đã tạm dừng vào ngày %(date)s, hãy tiếp tục sau ngày đó."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "Không thể thanh lý \"%s\" trước ngày mua."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "Không thể điều chỉnh \"%s\" trước ngày mua."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "Không thể tạm dừng \"%s\" trước ngày mua."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr "\"%s\" đã có bút toán khấu hao được vào sổ, hãy hủy nó thay vì xóa."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr ""
"\"%s\" có các khoản tăng giá trị đang hoạt động: hãy thanh lý chúng trước "
"khi bán tài sản."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"\"%s\" có các khoản tăng giá trị đang hoạt động: hãy bán hoặc thanh lý toàn "
"bộ tài sản."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" không còn trên sổ sách: chỉ tài sản đang hoạt động, tạm dừng hoặc đã "
"khấu hao hết mới có thể bán hoặc thanh lý."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "\"%s\" không được khấu hao: hãy bán hoặc thanh lý toàn bộ tài sản."

