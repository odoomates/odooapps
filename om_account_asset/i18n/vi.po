"Account used in the periodical entries to record a part of the asset as "
"expense."
msgstr ""
"Tài khoản dùng trong các bút toán định kỳ để ghi nhận một phần tài sản vào "
"chi phí."

#. module: om_account_asset
#: model:ir.model.fields,help:om_account_asset.field_asset_sell__asset_gain_account_id
