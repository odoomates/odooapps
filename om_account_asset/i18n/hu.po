#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"A(z) „%(asset)s” eszköznek %(date)s után könyvelt értékcsökkenési tételei "
"vannak (%(entries)s): válasszon az utolsó könyvelt tétel napjával egyező "
"vagy későbbi dátumot."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr ""
"A(z) „%(asset)s” eszköz %(date)s napon szüneteltetve lett, ezt a napot "
"követően folytassa."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "A(z) „%s” nem selejtezhető a beszerzése előtt."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "A(z) „%s” nem módosítható a beszerzése előtt."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "A(z) „%s” nem szüneteltethető a beszerzése előtt."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr ""
"A(z) „%s” eszköznek vannak könyvelt értékcsökkenési tételei, inkább vonja "
"vissza."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr ""
"A(z) „%s” eszköznek futó értéknövekedései vannak: selejtezze ezeket az "
"eladás előtt."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"A(z) „%s” eszköznek futó értéknövekedései vannak: adja el vagy selejtezze a "
"teljes eszközt."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"A(z) „%s” már nem szerepel a nyilvántartásban: csak futó, szüneteltetett "
"vagy teljesen leírt eszköz adható el vagy selejtezhető."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr ""
"A(z) „%s” nem amortizálódik: adja el vagy selejtezze a teljes eszközt."

