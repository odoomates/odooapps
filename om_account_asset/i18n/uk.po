#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"\"%(asset)s\" має опубліковані записи амортизації після %(date)s "
"(%(entries)s): виберіть дату останнього опублікованого запису або пізнішу."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr "\"%(asset)s\" було призупинено %(date)s, відновіть його після цього дня."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "\"%s\" не можна списати до його придбання."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "\"%s\" не можна змінити до його придбання."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "\"%s\" не можна призупинити до його придбання."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr "\"%s\" має опубліковані записи амортизації, скасуйте його натомість."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr "\"%s\" має діючі збільшення вартості: спишіть їх перед продажем."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr "\"%s\" має діючі збільшення вартості: продайте або спишіть увесь актив."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" більше не обліковується: продати або списати можна лише актив, який "
"діє, призупинений або повністю амортизований."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "\"%s\" не амортизується: продайте або спишіть увесь актив."

