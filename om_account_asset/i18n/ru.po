#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"У \"%(asset)s\" есть амортизационные проводки, проведённые после %(date)s "
"(%(entries)s): выберите дату последней проведённой проводки или более "
"позднюю."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr "\"%(asset)s\" приостановлен %(date)s, возобновите его после этой даты."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "\"%s\" не может выбыть до даты его приобретения."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "\"%s\" нельзя изменить до даты его приобретения."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "\"%s\" нельзя приостановить до даты его приобретения."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr ""
"У \"%s\" есть проведённые амортизационные проводки, вместо этого отмените "
"его."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr ""
"У \"%s\" есть действующие увеличения стоимости: спишите их перед продажей."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"У \"%s\" есть действующие увеличения стоимости: продайте или спишите актив "
"целиком."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" больше не числится на балансе: продать или списать можно только "
"действующий, приостановленный или полностью амортизированный актив."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "\"%s\" не амортизируется: продайте или спишите актив целиком."

