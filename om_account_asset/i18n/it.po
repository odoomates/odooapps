#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"\"%(asset)s\" ha registrazioni di ammortamento confermate dopo il %(date)s "
"(%(entries)s): scegli una data uguale o successiva a quella dell'ultima "
"registrazione confermata."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr ""
"\"%(asset)s\" è stata messa in pausa il %(date)s, riprendila dopo tale data."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "\"%s\" non può essere dismessa prima della sua acquisizione."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "\"%s\" non può essere modificata prima della sua acquisizione."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "\"%s\" non può essere messa in pausa prima della sua acquisizione."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr "\"%s\" ha registrazioni di ammortamento confermate, annullala invece."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr "\"%s\" ha incrementi di valore in corso: dismettili prima di venderla."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"\"%s\" ha incrementi di valore in corso: vendi o dismetti l'intera "
"immobilizzazione."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" non è più nei libri contabili: solo un'immobilizzazione in corso, in "
"pausa o completamente ammortizzata può essere venduta o dismessa."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "\"%s\" non è in ammortamento: vendi o dismetti l'intera immobilizzazione."

