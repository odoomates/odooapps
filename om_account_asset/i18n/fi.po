#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"Omaisuuserällä \"%(asset)s\" on kirjattuja poistokirjauksia päivän %(date)s "
"jälkeen (%(entries)s): valitse viimeisen kirjatun kirjauksen päivä tai sitä "
"myöhäisempi päivä."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr ""
"\"%(asset)s\" keskeytettiin %(date)s, jatka sitä vasta tämän päivän jälkeen."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "Omaisuuserää \"%s\" ei voi poistaa käytöstä ennen sen hankintaa."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "Omaisuuserää \"%s\" ei voi muuttaa ennen sen hankintaa."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "Omaisuuserää \"%s\" ei voi keskeyttää ennen sen hankintaa."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr ""
"Omaisuuserällä \"%s\" on kirjattuja poistokirjauksia, peruuta se sen sijaan."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr ""
"Omaisuuserällä \"%s\" on käynnissä olevia arvonkorotuksia: poista ne "
"käytöstä ennen myyntiä."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"Omaisuuserällä \"%s\" on käynnissä olevia arvonkorotuksia: myy tai poista "
"käytöstä koko omaisuuserä."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" ei ole enää kirjanpidossa: vain käynnissä oleva, keskeytetty tai "
"kokonaan poistettu omaisuuserä voidaan myydä tai poistaa käytöstä."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr ""
"Omaisuuserästä \"%s\" ei tehdä poistoja: myy tai poista käytöstä koko "
"omaisuuserä."

