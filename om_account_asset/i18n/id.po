msgstr ""
"Akun yang digunakan dalam entri penyusutan, untuk mengurangi nilai aset."

#. module: om_account_asset
#: model:ir.model.fields,help:om_account_asset.field_account_asset_asset__account_depreciation_expense_id
#: model:ir.model.fields,help:om_account_asset.field_account_asset_category__account_depreciation_expense_id
