msgstr "Akun yang dikredit oleh entri yang menaikkan nilai bruto aset."

#. module: om_account_asset
#: model:ir.model.fields,help:om_account_asset.field_account_asset_asset__account_depreciation_id
#: model:ir.model.fields,help:om_account_asset.field_account_asset_category__account_depreciation_id
