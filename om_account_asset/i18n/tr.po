#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%(asset)s\" has depreciation entries posted after %(date)s (%(entries)s): "
"choose a date on or after the last posted entry."
msgstr ""
"\"%(asset)s\" %(date)s tarihinden sonra onaylanmış amortisman kayıtlarına "
"sahip (%(entries)s): son onaylanmış kaydın tarihi veya sonrası bir tarih "
"seçin."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%(asset)s\" was paused on %(date)s, resume it after that day."
msgstr ""
"\"%(asset)s\" %(date)s tarihinde duraklatıldı, o günden sonra devam ettirin."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be disposed of before its acquisition."
msgstr "\"%s\" edinim tarihinden önce elden çıkarılamaz."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/wizard/asset_modify.py:0
msgid "\"%s\" cannot be modified before its acquisition."
msgstr "\"%s\" edinim tarihinden önce değiştirilemez."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" cannot be paused before its acquisition."
msgstr "\"%s\" edinim tarihinden önce duraklatılamaz."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has posted depreciation entries, cancel it instead."
msgstr "\"%s\" onaylanmış amortisman kayıtlarına sahip, bunun yerine iptal edin."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: dispose of them before selling it."
msgstr ""
"\"%s\" devam eden değer artışlarına sahip: satmadan önce bunları elden "
"çıkarın."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" has running value increases: sell or dispose of the whole asset."
msgstr ""
"\"%s\" devam eden değer artışlarına sahip: varlığın tamamını satın veya "
"elden çıkarın."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid ""
"\"%s\" is no longer in the books: only an asset that is running, paused or "
"fully depreciated can be sold or disposed of."
msgstr ""
"\"%s\" artık defterlerde değil: yalnızca devam eden, duraklatılmış veya "
"tamamen amorti edilmiş bir varlık satılabilir veya elden çıkarılabilir."

#. module: om_account_asset
#. odoo-python
#: code:addons/om_account_asset/models/account_asset.py:0
msgid "\"%s\" is not depreciating: sell or dispose of the whole asset."
msgstr "\"%s\" amorti edilmiyor: varlığın tamamını satın veya elden çıkarın."

