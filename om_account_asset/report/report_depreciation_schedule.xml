<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_depreciation_schedule" model="report.paperformat">
        <field name="name">Depreciation Schedule (A4 landscape)</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">12</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_depreciation_schedule" model="ir.actions.report">
        <field name="name">Depreciation Schedule</field>
        <field name="model">asset.depreciation.schedule</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">om_account_asset.report_depreciation_schedule</field>
        <field name="paperformat_id" ref="paperformat_depreciation_schedule"/>
    </record>

    <template id="report_depreciation_schedule">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.internal_layout">
                    <div class="page" style="font-size: 11px;">
                        <h2><span t-out="o.company_id.name"/>: Depreciation Schedule</h2>
                        <p>
                            <strong>From</strong> <span t-field="o.date_from"/>
                            <strong>to</strong> <span t-field="o.date_to"/>
                        </p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th colspan="3"/>
                                    <th colspan="4" class="text-center">Asset Value</th>
                                    <th colspan="4" class="text-center">Accumulated Depreciation</th>
                                    <th/>
                                </tr>
                                <tr>
                                    <th>Asset</th>
                                    <th>Acquisition</th>
                                    <th>Method</th>
                                    <th class="text-end"><span t-field="o.date_from"/></th>
                                    <th class="text-end">+</th>
                                    <th class="text-end">-</th>
                                    <th class="text-end"><span t-field="o.date_to"/></th>
                                    <th class="text-end"><span t-field="o.date_from"/></th>
                                    <th class="text-end">+</th>
                                    <th class="text-end">-</th>
                                    <th class="text-end"><span t-field="o.date_to"/></th>
                                    <th class="text-end">Book Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="groups" t-as="group">
                                    <tr t-if="o.group_by_category" class="fw-bold">
                                        <td colspan="3"><span t-out="group['name']"/></td>
                                        <t t-set="row" t-value="group['totals']"/>
                                        <td t-foreach="columns" t-as="column" class="text-end">
                                            <span t-out="row[column]" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                    <tr t-foreach="group['lines']" t-as="line">
                                        <td><span t-out="line['asset'].display_name"/></td>
                                        <td><span t-field="line['asset'].date"/></td>
                                        <td><span t-out="line['method']"/></td>
                                        <t t-set="row" t-value="line"/>
                                        <td t-foreach="columns" t-as="column" class="text-end">
                                            <span t-out="row[column]" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="fw-bold border-top">
                                    <td colspan="3">Total</td>
                                    <t t-set="row" t-value="total"/>
                                    <td t-foreach="columns" t-as="column" class="text-end">
                                        <span t-out="row[column]" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
