<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_create_from_lines_form" model="ir.ui.view">
        <field name="name">asset.create.from.lines.form</field>
        <field name="model">asset.create.from.lines</field>
        <field name="arch" type="xml">
            <form string="Create an Asset">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="category_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="value"/>
                        <field name="date"/>
                        <field name="confirm"/>
                    </group>
                </group>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="date"/>
                        <field name="move_id"/>
                        <field name="account_id"/>
                        <field name="name"/>
                        <field name="company_currency_id" column_invisible="1"/>
                        <field name="balance" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create" string="Create" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_create_from_lines" model="ir.actions.act_window">
        <field name="name">Create Asset</field>
        <field name="res_model">asset.create.from.lines</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="asset_create_from_lines_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>

</odoo>
