<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_modify_form" model="ir.ui.view">
        <field name="name">wizard.asset.modify.form</field>
        <field name="model">asset.modify</field>
        <field name="arch" type="xml">
            <form string="Modify Asset">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <p class="text-muted">
                    The running period is depreciated up to the date, then the rest of the board is computed
                    with the new duration and values.
                </p>
                <group>
                    <group string="New Duration" name="new_duration">
                        <field name="date"/>
                        <field name="method_number" invisible="asset_method_time != 'number'"/>
                        <field name="method_end" invisible="asset_method_time != 'end'"
                               required="asset_method_time == 'end'"/>
                        <field name="method_rate" invisible="asset_method_time != 'rate'"
                               required="asset_method_time == 'rate'"/>
                        <label for="method_period" string="One Entry Every"/>
                        <div>
                            <field name="method_period" class="oe_inline"/> months
                        </div>
                    </group>
                    <group string="New Values" name="new_values">
                        <field name="value_at_date"/>
                        <field name="new_depreciable_value"/>
                        <field name="new_salvage_value"/>
                        <field name="increase_counterpart_account_id" invisible="not is_value_increase"
                               required="is_value_increase"/>
                    </group>
                </group>
                <field name="note" placeholder="Why is the asset modified?"/>
                <footer>
                    <button name="modify" string="Apply" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_modify" model="ir.actions.act_window">
         <field name="name">Modify Asset</field>
         <field name="res_model">asset.modify</field>
         <field name="type">ir.actions.act_window</field>
         <field name="view_mode">form</field>
         <field name="view_id" ref="asset_modify_form"/>
         <field name="target">new</field>
   </record>

</odoo>
