<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="asset_sell_form" model="ir.ui.view">
        <field name="name">asset.sell.form</field>
        <field name="model">asset.sell</field>
        <field name="arch" type="xml">
            <form string="Sell or Dispose">
                <field name="asset_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <group>
                        <field name="asset_currency_id" invisible="1"/>
                        <field name="action" widget="radio" options="{'horizontal': true}"/>
                        <field name="scope" widget="radio" options="{'horizontal': true}"/>
                        <field name="disposed_percent" invisible="scope != 'partial'" required="scope == 'partial'"/>
                        <field name="disposed_value" invisible="scope != 'partial'"/>
                        <field name="date"/>
                        <field name="book_value"/>
                    </group>
                    <group>
                        <field name="asset_gain_account_id" required="action == 'sell'"/>
                        <field name="asset_loss_account_id" required="1"/>
                    </group>
                </group>
                <group invisible="action != 'sell'">
                    <field name="sale_invoice_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="sale_line_ids" options="{'no_create': True}" required="action == 'sell'">
                        <list>
                            <field name="move_id"/>
                            <field name="name"/>
                            <field name="account_id"/>
                            <field name="balance" string="Amount"/>
                        </list>
                    </field>
                    <field name="sale_amount"/>
                </group>
                <group>
                    <field name="note" placeholder="Why is the asset sold or disposed of?"/>
                </group>
                <p class="text-muted" invisible="scope != 'partial'">
                    The asset is depreciated up to the date, then a posted entry removes the share of its gross value
                    and accumulated depreciation and books the difference with the sale price as a gain or a loss.
                    The rest of the asset keeps depreciating over the same life.
                </p>
                <p class="text-muted" invisible="scope != 'full'">
                    The asset is depreciated up to the date, then a draft entry removes its gross value and
                    accumulated depreciation and books the difference with the sale price as a gain or a loss.
                </p>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_asset_sell" model="ir.actions.act_window">
        <field name="name">Sell or Dispose</field>
        <field name="res_model">asset.sell</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="asset_sell_form"/>
        <field name="target">new</field>
    </record>

</odoo>
