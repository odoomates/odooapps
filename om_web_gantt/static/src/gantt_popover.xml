<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_web_gantt.GanttPopover">
        <CardPopover t-props="this.cardPopoverProps">
            <t t-set-slot="footer">
                <button type="button" class="btn btn-sm btn-primary o_gantt_popover_edit" t-on-click="() => this.onEdit()">
                    <t t-if="this.canEdit">Edit</t>
                    <t t-else="">View</t>
                </button>
                <button t-if="this.canDelete" type="button" class="btn btn-sm btn-secondary o_gantt_popover_delete" t-on-click="() => this.onDelete()">
                    Delete
                </button>
            </t>
        </CardPopover>
    </t>

</templates>
