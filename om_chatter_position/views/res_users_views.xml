<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Under the language and time zone of My Preferences. -->
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.om.chatter.position</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="after">
                <group name="om_chatter_position_preferences" string="Chatter">
                    <field name="om_chatter_position" readonly="0"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
