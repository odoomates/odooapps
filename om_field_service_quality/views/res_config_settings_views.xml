<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_field_service_quality</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="om_field_service.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="fs_time" position="before">
                <block title="Quality" name="fs_quality">
                    <setting id="fs_quality_required" string="Quality Checks Required"
                        help="A job cannot be marked as done while one of its quality checks is still to do">
                        <field name="fs_quality_required"/>
                        <div class="mt-2">
                            <button name="%(action_om_fs_quality_point)d" type="action" string="Control Points"
                                icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
