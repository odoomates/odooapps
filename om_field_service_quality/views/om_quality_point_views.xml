<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_om_quality_point_form_fs" model="ir.ui.view">
        <field name="name">om.quality.point.form.field.service</field>
        <field name="model">om.quality.point</field>
        <field name="inherit_id" ref="om_quality.view_om_quality_point_form"/>
        <field name="arch" type="xml">
            <field name="point_type" position="after">
                <field name="fs_job_type_ids" widget="many2many_tags" invisible="point_type != 'fs_job'"
                    required="point_type == 'fs_job'" placeholder="e.g. Yearly Boiler Maintenance"
                    options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="view_om_quality_point_list_fs" model="ir.ui.view">
        <field name="name">om.quality.point.list.field.service</field>
        <field name="model">om.quality.point</field>
        <field name="inherit_id" ref="om_quality.view_om_quality_point_list"/>
        <field name="arch" type="xml">
            <field name="point_type" position="after">
                <field name="fs_job_type_ids" widget="many2many_tags" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_om_fs_quality_point" model="ir.actions.act_window">
        <field name="name">Quality Control Points</field>
        <field name="res_model">om.quality.point</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('point_type', '=', 'fs_job')]</field>
        <field name="context">{'default_point_type': 'fs_job'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a quality control point for your jobs</p>
            <p>The jobs of its job types get the check: pass or fail, a measure with its tolerance, a photo or instructions.</p>
        </field>
    </record>

    <menuitem id="menu_om_fs_quality_points" name="Quality Control Points" parent="om_field_service.menu_om_fs_config"
        action="action_om_fs_quality_point" sequence="15" groups="om_quality.group_om_quality_manager"/>

</odoo>
