<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_connector_job_rule_company" model="ir.rule">
        <field name="name">om.connector.job: multi-company</field>
        <field name="model_id" ref="model_om_connector_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="om_connector_order_workflow_rule_company" model="ir.rule">
        <field name="name">om.connector.order.workflow: multi-company</field>
        <field name="model_id" ref="model_om_connector_order_workflow"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
