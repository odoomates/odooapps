<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_connector" model="res.groups.privilege">
        <field name="name">Connectors</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_om_connector_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_connector"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sees the connections and their jobs, and tries failed jobs again.</field>
    </record>

    <record id="group_om_connector_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_connector"/>
        <field name="implied_ids" eval="[Command.link(ref('group_om_connector_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Sets up the connections and their credentials.</field>
    </record>
</odoo>
