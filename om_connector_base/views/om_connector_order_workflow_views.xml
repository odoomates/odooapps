<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="om_connector_order_workflow_view_list" model="ir.ui.view">
        <field name="name">om.connector.order.workflow.list</field>
        <field name="model">om.connector.order.workflow</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="confirm_order"/>
                <field name="create_invoice"/>
                <field name="register_payment"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="om_connector_order_workflow_view_form" model="ir.ui.view">
        <field name="name">om.connector.order.workflow.form</field>
        <field name="model">om.connector.order.workflow</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Paid online"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="confirm_order"/>
                            <field name="create_invoice" invisible="not confirm_order"/>
                            <field name="post_invoice" invisible="not confirm_order or not create_invoice"/>
                            <field name="register_payment" invisible="not post_invoice or not create_invoice or not confirm_order"/>
                            <field name="journal_id" invisible="not register_payment" required="register_payment"/>
                        </group>
                        <group>
                            <field name="invoice_date_is_order_date" invisible="not create_invoice"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="om_connector_order_workflow_action" model="ir.actions.act_window">
        <field name="name">Order Workflows</field>
        <field name="res_model">om.connector.order.workflow</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an order workflow</p>
            <p>A workflow says what Odoo does with an imported order: confirm it, invoice it and register its payment.</p>
        </field>
    </record>
</odoo>
