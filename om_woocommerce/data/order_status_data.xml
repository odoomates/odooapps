<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="order_status_pending" model="om.woocommerce.order.status">
        <field name="name">Pending Payment</field>
        <field name="code">pending</field>
        <field name="sequence">10</field>
    </record>
    <record id="order_status_processing" model="om.woocommerce.order.status">
        <field name="name">Processing</field>
        <field name="code">processing</field>
        <field name="sequence">20</field>
    </record>
    <record id="order_status_on_hold" model="om.woocommerce.order.status">
        <field name="name">On Hold</field>
        <field name="code">on-hold</field>
        <field name="sequence">30</field>
    </record>
    <record id="order_status_completed" model="om.woocommerce.order.status">
        <field name="name">Completed</field>
        <field name="code">completed</field>
        <field name="sequence">40</field>
    </record>
    <record id="order_status_cancelled" model="om.woocommerce.order.status">
        <field name="name">Cancelled</field>
        <field name="code">cancelled</field>
        <field name="sequence">50</field>
    </record>
    <record id="order_status_refunded" model="om.woocommerce.order.status">
        <field name="name">Refunded</field>
        <field name="code">refunded</field>
        <field name="sequence">60</field>
    </record>
    <record id="order_status_failed" model="om.woocommerce.order.status">
        <field name="name">Failed</field>
        <field name="code">failed</field>
        <field name="sequence">70</field>
    </record>
    <record id="order_status_checkout_draft" model="om.woocommerce.order.status">
        <field name="name">Draft</field>
        <field name="code">checkout-draft</field>
        <field name="sequence">80</field>
    </record>
</odoo>
