<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="product_woo_shipping" model="product.product">
        <field name="name">Shipping (WooCommerce)</field>
        <field name="type">service</field>
        <field name="invoice_policy">order</field>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0</field>
        <field name="taxes_id" eval="[Command.clear()]"/>
    </record>
    <record id="product_woo_fee" model="product.product">
        <field name="name">Fee (WooCommerce)</field>
        <field name="type">service</field>
        <field name="invoice_policy">order</field>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0</field>
        <field name="taxes_id" eval="[Command.clear()]"/>
    </record>
    <record id="product_woo_custom" model="product.product">
        <field name="name">Unknown Item (WooCommerce)</field>
        <field name="type">consu</field>
        <field name="invoice_policy">order</field>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0</field>
    </record>
    <record id="product_woo_refund_adjustment" model="product.product">
        <field name="name">Refund Adjustment (WooCommerce)</field>
        <field name="type">service</field>
        <field name="invoice_policy">order</field>
        <field name="purchase_ok" eval="False"/>
        <field name="sale_ok" eval="False"/>
        <field name="list_price">0</field>
        <field name="taxes_id" eval="[Command.clear()]"/>
    </record>
</odoo>
