<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_om_woocommerce" model="ir.ui.view">
        <field name="name">account.move.form.om.woocommerce</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="woo_order_id" invisible="1"/>
                <button name="action_woo_refund" type="object" string="Refund in WooCommerce"
                        invisible="move_type != 'out_refund' or state != 'posted' or woo_refund_id or not woo_order_id"
                        groups="om_woocommerce.group_om_woocommerce_user"/>
            </header>
            <field name="ref" position="after">
                <field name="woo_refund_id" invisible="not woo_refund_id"/>
            </field>
        </field>
    </record>
</odoo>
