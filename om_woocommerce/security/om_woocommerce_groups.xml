<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_woocommerce" model="ir.module.category">
        <field name="name">WooCommerce</field>
        <field name="parent_id" ref="base.module_category_sales"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_om_woocommerce_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_woocommerce"/>
        <field name="implied_ids" eval="[Command.link(ref('om_connector_base.group_om_connector_user'))]"/>
        <field name="comment">Sees the WooCommerce stores, runs the imports and exports, and follows their jobs.</field>
    </record>

    <record id="group_om_woocommerce_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_woocommerce"/>
        <field name="implied_ids" eval="[Command.link(ref('group_om_woocommerce_user')), Command.link(ref('om_connector_base.group_om_connector_manager'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Connects the WooCommerce stores, sees their credentials and sets them up.</field>
    </record>
</odoo>
