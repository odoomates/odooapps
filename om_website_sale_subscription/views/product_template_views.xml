<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_subscription" model="ir.ui.view">
        <field name="name">product.template.form.subscription.website</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="om_sale_subscription.product_template_form_view_subscription"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='subscription_pricing_ids']/list/field[@name='price']" position="after">
                <field name="plan_website_published" optional="show"/>
            </xpath>
            <xpath expr="//page[@name='subscription_pricing']/div[hasclass('text-muted')]" position="after">
                <div class="text-muted">
                    On the website, the product offers the plans published on the website that have a recurring
                    price here. With one plan, it is applied without asking the customer.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
