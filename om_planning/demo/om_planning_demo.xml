<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="base.main_company" model="res.company">
            <field name="planning_min_rest_hours" eval="11"/>
            <field name="planning_max_hours_week" eval="48"/>
        </record>

        <record id="group_planning_user" model="res.groups">
            <field name="user_ids" eval="[Command.link(ref('base.user_demo'))]"/>
        </record>

        <!-- Templates -->
        <record id="template_morning" model="om.planning.template">
            <field name="name">Morning</field>
            <field name="code">M</field>
            <field name="start_time" eval="6"/>
            <field name="end_time" eval="14"/>
            <field name="break_hours" eval="0.5"/>
            <field name="color" eval="3"/>
        </record>
        <record id="template_evening" model="om.planning.template">
            <field name="name">Evening</field>
            <field name="code">E</field>
            <field name="start_time" eval="14"/>
            <field name="end_time" eval="22"/>
            <field name="break_hours" eval="0.5"/>
            <field name="color" eval="5"/>
        </record>
        <record id="template_night" model="om.planning.template">
            <field name="name">Night</field>
            <field name="code">N</field>
            <field name="start_time" eval="22"/>
            <field name="end_time" eval="6"/>
            <field name="break_hours" eval="0.5"/>
            <field name="color" eval="8"/>
        </record>
        <record id="template_day" model="om.planning.template">
            <field name="name">Day</field>
            <field name="code">D</field>
            <field name="start_time" eval="8"/>
            <field name="end_time" eval="17"/>
            <field name="break_hours" eval="1"/>
        </record>

        <!-- Roles -->
        <record id="role_technician" model="om.planning.role">
            <field name="name">Technician</field>
            <field name="color" eval="4"/>
            <field name="sequence" eval="1"/>
            <field name="template_id" ref="template_day"/>
            <field name="slot_properties_definition" eval="[
                {'name': 'site', 'string': 'Site', 'type': 'char'},
                {'name': 'customer_contact', 'string': 'Customer Contact', 'type': 'char'},
            ]"/>
        </record>
        <record id="role_driver" model="om.planning.role">
            <field name="name">Driver</field>
            <field name="color" eval="2"/>
            <field name="sequence" eval="2"/>
            <field name="template_id" ref="template_day"/>
        </record>
        <record id="role_cashier" model="om.planning.role">
            <field name="name">Cashier</field>
            <field name="color" eval="10"/>
            <field name="sequence" eval="3"/>
        </record>
        <record id="role_forklift" model="om.planning.role">
            <field name="name">Forklift</field>
            <field name="color" eval="9"/>
            <field name="sequence" eval="4"/>
        </record>
        <record id="template_morning" model="om.planning.template">
            <field name="role_id" ref="role_cashier"/>
        </record>
        <record id="template_evening" model="om.planning.template">
            <field name="role_id" ref="role_cashier"/>
        </record>

        <!-- Working schedule of the store staff -->
        <record id="calendar_store" model="resource.calendar">
            <field name="name">Store Shifts (06:00 - 22:00)</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="attendance_ids" eval="[Command.clear()] + [
                Command.create({'dayofweek': str(day), 'hour_from': 6, 'hour_to': 22}) for day in range(6)]"/>
        </record>

        <!-- Resources -->
        <record id="resource_sam" model="resource.resource">
            <field name="name">Sam Rivera (contractor)</field>
            <field name="resource_type">user</field>
            <field name="tz">Europe/Brussels</field>
            <field name="planning_role_ids" eval="[Command.set([ref('role_technician'), ref('role_driver')])]"/>
