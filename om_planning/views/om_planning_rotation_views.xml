<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_planning_rotation_view_list" model="ir.ui.view">
        <field name="name">om.planning.rotation.list</field>
        <field name="model">om.planning.rotation</field>
        <field name="arch" type="xml">
            <list string="Rotations">
                <field name="name"/>
                <field name="cycle_length"/>
                <field name="role_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="om_planning_rotation_view_form" model="ir.ui.view">
        <field name="name">om.planning.rotation.form</field>
        <field name="model">om.planning.rotation</field>
        <field name="arch" type="xml">
            <form string="Rotation">
                <header>
                    <button name="action_apply" type="object" string="Apply to Resources" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. 2 mornings, 2 evenings, 2 days off"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="role_id"/>
                            <field name="cycle_length"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="day_number"/>
                            <field name="template_id" placeholder="Day off"/>
                            <field name="is_day_off"/>
                        </list>
                    </field>
                    <field name="note" placeholder="Description of the rotation"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_om_planning_rotation" model="ir.actions.act_window">
        <field name="name">Rotations</field>
        <field name="res_model">om.planning.rotation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a rotation</p>
            <p>A rotation is a cycle of shift templates and days off, applied to resources from a date.</p>
        </field>
    </record>

</odoo>
