<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="om_planning.PlanningGanttButtons">
        <t t-call="om_web_gantt.GanttController.Buttons"/>
        <t t-if="this.model.canCreate">
            <button type="button" class="btn btn-secondary o_planning_button_copy"
                title="Copy the slots of the previous period as drafts"
                t-on-click="() => this.onClickCopyPrevious()">
                Copy Previous
            </button>
            <button type="button" class="btn btn-secondary o_planning_button_rotation"
                t-on-click="() => this.onClickRotation()">
                Apply Rotation
            </button>
            <button type="button" class="btn btn-secondary o_planning_button_publish"
                t-on-click="() => this.onClickPublish()">
                Publish &amp; Send
            </button>
        </t>
    </t>

</templates>
