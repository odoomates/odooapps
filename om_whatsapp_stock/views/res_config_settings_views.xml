<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.om_whatsapp_stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="stock_text_confirmation" position="after">
                <setting id="om_whatsapp_stock_account" string="WhatsApp Confirmation" company_dependent="1"
                         help="Choose on each operation type the WhatsApp sent when its transfers are done (Delivery: Shipped, with the tracking link)">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="om_whatsapp_stock_account_id" string="Send From" class="col-lg-4 o_light_label"/>
                            <field name="om_whatsapp_stock_account_id" options="{'no_create': True}"
                                   placeholder="The account of the template or of the user"/>
                        </div>
                        <div class="mt8">
                            <button name="%(stock.action_picking_type_list)d" type="action" icon="east"
                                    string="Operation Types" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>

</odoo>
