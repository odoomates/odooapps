<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.om_whatsapp_stock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_return']" position="before">
                <button name="action_om_whatsapp_send" type="object" string="Send by WhatsApp"
                        groups="om_whatsapp_base.group_om_whatsapp_user"
                        invisible="picking_type_code != 'outgoing' or state not in ('assigned', 'done') or not partner_id"/>
            </xpath>
        </field>
    </record>

</odoo>
