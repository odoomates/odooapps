<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.om_whatsapp_stock</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <field name="create_backorder" position="after">
                <field name="om_whatsapp_done_template_id" options="{'no_create': True}"
                       placeholder="No message" groups="om_whatsapp_base.group_om_whatsapp_user"/>
            </field>
        </field>
    </record>

</odoo>
