<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base.user_demo" model="res.users">
        <field name="group_ids" eval="[(4, ref('om_documents.group_documents_user'))]"/>
    </record>

    <record id="folder_finance" model="om.documents.folder">
        <field name="name">Finance</field>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="access_internal">edit</field>
        <field name="write_user_ids" eval="[(4, ref('base.user_demo'))]"/>
        <field name="alias_name">finance-docs</field>
    </record>

    <record id="folder_finance_bills" model="om.documents.folder">
        <field name="name">Vendor Bills</field>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="parent_id" ref="folder_finance"/>
    </record>

    <record id="folder_hr" model="om.documents.folder">
        <field name="name">Human Resources</field>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="access_internal">none</field>
        <field name="read_group_ids" eval="[(4, ref('om_documents.group_documents_manager'))]"/>
    </record>

    <record id="folder_marketing" model="om.documents.folder">
        <field name="name">Marketing</field>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="access_internal">view</field>
        <field name="write_user_ids" eval="[(4, ref('base.user_demo'))]"/>
    </record>

    <record id="folder_legal" model="om.documents.folder">
        <field name="name">Legal</field>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="access_internal">view</field>
    </record>

    <record id="folder_management" model="om.documents.folder">
        <field name="name">Management</field>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="access_internal">none</field>
    </record>

    <record id="tag_category_status" model="om.documents.tag.category">
        <field name="name">Status</field>
    </record>
    <record id="tag_to_validate" model="om.documents.tag">
        <field name="name">To Validate</field>
        <field name="category_id" ref="tag_category_status"/>
        <field name="sequence">1</field>
        <field name="color">3</field>
    </record>
    <record id="tag_validated" model="om.documents.tag">
        <field name="name">Validated</field>
        <field name="category_id" ref="tag_category_status"/>
        <field name="sequence">2</field>
        <field name="color">10</field>
    </record>
    <record id="tag_rejected" model="om.documents.tag">
        <field name="name">Rejected</field>
        <field name="category_id" ref="tag_category_status"/>
        <field name="sequence">3</field>
        <field name="color">1</field>
    </record>

    <record id="tag_category_finance" model="om.documents.tag.category">
        <field name="name">Type</field>
        <field name="folder_id" ref="folder_finance"/>
    </record>
    <record id="tag_bill" model="om.documents.tag">
        <field name="name">Bill</field>
        <field name="category_id" ref="tag_category_finance"/>
        <field name="sequence">1</field>
        <field name="color">4</field>
    </record>
    <record id="tag_receipt" model="om.documents.tag">
        <field name="name">Receipt</field>
        <field name="category_id" ref="tag_category_finance"/>
        <field name="sequence">2</field>
        <field name="color">2</field>
    </record>
    <record id="tag_contract" model="om.documents.tag">
        <field name="name">Contract</field>
        <field name="category_id" ref="tag_category_finance"/>
        <field name="sequence">3</field>
        <field name="color">7</field>
    </record>

    <record id="tag_category_media" model="om.documents.tag.category">
        <field name="name">Media</field>
        <field name="folder_id" ref="folder_marketing"/>
    </record>
    <record id="tag_image" model="om.documents.tag">
        <field name="name">Image</field>
        <field name="category_id" ref="tag_category_media"/>
        <field name="sequence">1</field>
        <field name="color">5</field>
    </record>
    <record id="tag_brochure" model="om.documents.tag">
        <field name="name">Brochure</field>
        <field name="category_id" ref="tag_category_media"/>
        <field name="sequence">2</field>
        <field name="color">8</field>
    </record>
    <record id="tag_notes" model="om.documents.tag">
        <field name="name">Notes</field>
        <field name="category_id" ref="tag_category_media"/>
        <field name="sequence">3</field>
        <field name="color">9</field>
    </record>

    <record id="folder_finance" model="om.documents.folder">
        <field name="alias_tag_ids" eval="[(4, ref('tag_to_validate')), (4, ref('tag_bill'))]"/>
    </record>

    <record id="document_vendor_bill" model="om.documents.document">
        <field name="name">Azure Interior - INV-2026-0042.pdf</field>
        <field name="file_name">vendor_bill_azure.pdf</field>
        <field name="datas" type="bytes" file="om_documents/demo/vendor_bill_azure.pdf"/>
        <field name="folder_id" ref="folder_finance_bills"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(4, ref('tag_bill')), (4, ref('tag_to_validate'))]"/>
        <field name="partner_id" ref="base.res_partner_12"/>
    </record>

    <record id="document_agreement" model="om.documents.document">
        <field name="name">Service Agreement - Deco Addict.pdf</field>
        <field name="file_name">service_agreement.pdf</field>
        <field name="datas" type="bytes" file="om_documents/demo/service_agreement.pdf"/>
        <field name="folder_id" ref="folder_legal"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(4, ref('tag_contract'))]"/>
        <field name="partner_id" ref="base.res_partner_2"/>
    </record>

    <record id="document_brochure" model="om.documents.document">
        <field name="name">Product Brochure 2027.pdf</field>
        <field name="file_name">product_brochure.pdf</field>
        <field name="datas" type="bytes" file="om_documents/demo/product_brochure.pdf"/>
        <field name="folder_id" ref="folder_marketing"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(4, ref('tag_brochure'))]"/>
    </record>

    <record id="document_office" model="om.documents.document">
        <field name="name">Showroom photo.png</field>
        <field name="file_name">office_photo.png</field>
        <field name="datas" type="bytes" file="om_documents/demo/office_photo.png"/>
        <field name="folder_id" ref="folder_marketing"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(4, ref('tag_image'))]"/>
    </record>

    <record id="document_logo" model="om.documents.document">
        <field name="name">Logo draft.png</field>
        <field name="file_name">logo_draft.png</field>
        <field name="datas" type="bytes" file="om_documents/demo/logo_draft.png"/>
        <field name="folder_id" ref="folder_marketing"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(4, ref('tag_image')), (4, ref('tag_to_validate'))]"/>
    </record>

    <record id="document_notes" model="om.documents.document">
        <field name="name">Meeting notes.txt</field>
        <field name="file_name">meeting_notes.txt</field>
        <field name="datas" type="bytes" file="om_documents/demo/meeting_notes.txt"/>
        <field name="folder_id" ref="folder_marketing"/>
        <field name="owner_id" ref="base.user_admin"/>
        <field name="tag_ids" eval="[(4, ref('tag_notes'))]"/>
    </record>

    <record id="document_handbook" model="om.documents.document">
        <field name="name">Employee Handbook.pdf</field>
        <field name="file_name">employee_handbook.pdf</field>
        <field name="datas" type="bytes" file="om_documents/demo/employee_handbook.pdf"/>
        <field name="folder_id" ref="folder_hr"/>
        <field name="owner_id" ref="base.user_admin"/>
    </record>

    <record id="document_minutes" model="om.documents.document">
        <field name="name">Board Meeting Minutes.pdf</field>
        <field name="file_name">board_minutes.pdf</field>
        <field name="datas" type="bytes" file="om_documents/demo/board_minutes.pdf"/>
        <field name="folder_id" ref="folder_management"/>
        <field name="owner_id" ref="base.user_admin"/>
    </record>

    <record id="document_link_guide" model="om.documents.document">
        <field name="name">Brand guidelines (online)</field>
        <field name="type">url</field>
        <field name="url">https://www.odoo.com/documentation</field>
        <field name="folder_id" ref="folder_marketing"/>
        <field name="owner_id" ref="base.user_admin"/>
    </record>

    <record id="action_validate" model="om.documents.action">
        <field name="name">Validate</field>
        <field name="folder_id" ref="folder_finance"/>
        <field name="required_tag_ids" eval="[(4, ref('tag_to_validate'))]"/>
        <field name="add_tag_ids" eval="[(4, ref('tag_validated'))]"/>
        <field name="remove_tag_ids" eval="[(4, ref('tag_to_validate'))]"/>
    </record>

    <record id="action_reject" model="om.documents.action">
        <field name="name">Reject</field>
        <field name="folder_id" ref="folder_finance"/>
        <field name="required_tag_ids" eval="[(4, ref('tag_to_validate'))]"/>
        <field name="add_tag_ids" eval="[(4, ref('tag_rejected'))]"/>
        <field name="remove_tag_ids" eval="[(4, ref('tag_to_validate'))]"/>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="activity_summary">Tell the vendor the bill is rejected</field>
    </record>

    <record id="action_contact" model="om.documents.action">
        <field name="name">Create a Contact</field>
        <field name="folder_id" ref="folder_legal"/>
        <field name="create_model">record</field>
        <field name="model_id" ref="base.model_res_partner"/>
    </record>

    <record id="share_marketing" model="om.documents.share">
        <field name="name">Marketing kit</field>
        <field name="share_type">folder</field>
        <field name="folder_id" ref="folder_marketing"/>
        <field name="partner_ids" eval="[(4, ref('base.partner_demo_portal'))]"/>
        <field name="date_expiry" eval="(DateTime.today() + relativedelta(months=1)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="share_old_price_list" model="om.documents.share">
        <field name="name">Old price list</field>
        <field name="share_type">documents</field>
        <field name="folder_id" ref="folder_marketing"/>
        <field name="document_ids" eval="[(4, ref('document_brochure'))]"/>
        <field name="date_expiry" eval="(DateTime.today() - relativedelta(days=3)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="share_upload" model="om.documents.share">
        <field name="name">Send us your receipts</field>
        <field name="share_type">documents</field>
        <field name="folder_id" ref="folder_finance"/>
        <field name="allow_upload" eval="True"/>
        <field name="allow_download" eval="False"/>
        <field name="upload_tag_ids" eval="[(4, ref('tag_receipt')), (4, ref('tag_to_validate'))]"/>
        <field name="partner_ids" eval="[(4, ref('base.res_partner_12'))]"/>
    </record>

</odoo>
