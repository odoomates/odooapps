<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_documents_folder_view_search" model="ir.ui.view">
        <field name="name">om.documents.folder.search</field>
        <field name="model">om.documents.folder</field>
        <field name="arch" type="xml">
            <search string="Folders">
                <field name="complete_name" string="Folder"/>
                <field name="owner_id"/>
                <filter name="mine" string="Owned by Me" domain="[('owner_id', '=', uid)]"/>
                <filter name="private" string="My Drive" domain="[('is_private', '=', True)]"/>
                <filter name="top" string="Top Folders" domain="[('parent_id', '=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_parent" string="Parent Folder" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="om_documents_folder_view_list" model="ir.ui.view">
        <field name="name">om.documents.folder.list</field>
        <field name="model">om.documents.folder</field>
        <field name="arch" type="xml">
            <list string="Folders">
                <field name="sequence" widget="handle"/>
                <field name="complete_name" string="Folder"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="eff_access_internal" string="Internal Users"/>
                <field name="alias_email" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="document_count" string="Documents"/>
            </list>
        </field>
    </record>

    <record id="om_documents_folder_view_form" model="ir.ui.view">
        <field name="name">om.documents.folder.form</field>
        <field name="model">om.documents.folder</field>
        <field name="arch" type="xml">
            <form string="Folder">
                <header>
                    <button name="action_share" type="object" string="Share" invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_documents" type="object" class="oe_stat_button" icon="description">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="My Drive" bg_color="text-bg-info" invisible="not is_private"/>
                    <field name="active" invisible="1"/>
                    <field name="is_private" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Contracts"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" invisible="is_private"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <label for="alias_name" string="Upload by Email"/>
                            <div class="o_row" dir="ltr">
                                <field name="alias_name" placeholder="e.g. invoices"/>
                                <span>@</span>
                                <field name="alias_domain_id" placeholder="e.g. mycompany.com" options="{'no_create': True, 'no_open': True}"/>
                            </div>
                            <field name="alias_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"
                                   invisible="not alias_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Access" name="access">
                            <group>
                                <group>
                                    <field name="inherit_access" invisible="not parent_id"/>
                                    <field name="access_internal" invisible="(inherit_access and parent_id) or is_private"/>
                                    <field name="eff_access_internal" invisible="not (inherit_access and parent_id)"
                                           string="Internal Users (inherited)"/>
                                </group>
                                <group>
                                    <div class="text-muted" colspan="2">
                                        The owner always reaches the folder. The groups and the users below are added
                                        to the access the folder inherits.
                                    </div>
                                </group>
                            </group>
                            <group>
                                <group string="Read">
                                    <field name="read_group_ids" widget="many2many_tags" string="Groups"/>
                                    <field name="read_user_ids" widget="many2many_avatar_user" string="Users"/>
                                </group>
                                <group string="Edit">
                                    <field name="write_group_ids" widget="many2many_tags" string="Groups"/>
                                    <field name="write_user_ids" widget="many2many_avatar_user" string="Users"/>
                                </group>
                            </group>
                        </page>
                        <page string="Tags" name="tags">
                            <field name="tag_category_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1"/>
                                    <field name="tooltip"/>
                                </list>
                            </field>
                        </page>
                        <page string="Actions" name="actions">
                            <field name="action_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="create_model"/>
                                    <field name="move_folder_id"/>
                                    <field name="add_tag_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subfolders" name="subfolders">
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="owner_id" widget="many2one_avatar_user"/>
                                    <field name="eff_access_internal" string="Internal Users"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_folders" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="res_model">om.documents.folder</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="om_documents_folder_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a folder</p>
            <p>Folders hold the documents, in a tree. Each folder says who reads and who edits it.</p>
        </field>
    </record>

</odoo>
