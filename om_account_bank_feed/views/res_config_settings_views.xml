<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bank.feed</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="bank_cash" position="inside">
                <setting id="bank_feed_settings" string="Bank Feeds"
                         help="Fetch the transactions of your banks automatically into the bank journals.">
                    <div class="content-group">
                        <div class="row mt-2">
                            <label for="bank_feed_sync_interval" class="col-lg-5 o_light_label"/>
                            <field name="bank_feed_sync_interval"/>
                        </div>
                        <div class="row">
                            <label for="bank_feed_reminder_days" class="col-lg-5 o_light_label"/>
                            <field name="bank_feed_reminder_days"/>
                        </div>
                        <div name="bank_feed_providers"/>
                    </div>
                    <div class="mt-2">
                        <button name="%(om_account_bank_feed.action_bank_feed_connection)d" type="action"
                                string="Bank Feeds" icon="east" class="btn-link"/>
                    </div>
                </setting>
            </block>
        </field>
    </record>

</odoo>
