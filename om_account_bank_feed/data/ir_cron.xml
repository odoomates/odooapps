<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_bank_feed_sync" model="ir.cron">
        <field name="name">Bank Feeds: fetch the new transactions</field>
        <field name="model_id" ref="model_bank_feed_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">4</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="ir_cron_bank_feed_consent" model="ir.cron">
        <field name="name">Bank Feeds: consent expiry reminders</field>
        <field name="model_id" ref="model_bank_feed_connection"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_consents()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
